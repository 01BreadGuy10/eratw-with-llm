;※※※※※※※※※※※※※※※※※※※※※※※※※※※※
;弹幕胜负口上模板
;经过eraTheWorld 4.972 环境测试
;※※※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
; ※ABL:戰鬥能力 == 0 的角色初始是无法进行弹幕胜负的※
; ※角色技能发动的口上接口只有【乾坤一掷】【怪力乱神】【残忍酷薄】这三个
;==================================================
;整体流程与时点：
;（无→跳转则全部顺下，序号仅做跳转标识，并非实际顺序）
;==================================================
; 决斗前   		① 调用 COM480 决定是否进行决斗
; 					☇ **调用 “戰鬥前” 的口上内容**
; 开始决斗	      ② 调用 DANMAKU_BATTLE 运行决斗过程
; 			    ③ 决斗循环
; 					☇ ⑥ 处理骰子数值（如果启用了 胖次决斗 的DLC，还会调用 PANNOQIKALA_BATTLE 进行胖次的处理，进一步增减双方数值）
; 						☇ **调用 "ハンデ" 的口上内容**
; 					   ⑦ 掷骰子，生成第一次的骰子值让玩家做出选择
; 						☇ ⑨ 选择专心回避，如果HP归零 → ⑮
; 						   ⑩ 选择一决胜负
; 							☇ 双方发动技能【乾坤一掷】
; 								☇ **调用 “乾坤一擲” 的口上内容**
; 							   ⑪ 拼点，TARGET骰子值更大 → ⑫，MASTER更大 → ⑬，相等 → ⑭
; 								☇ ⑫ TARGET攻击
; 									☇ MASTER发动技能【怪力乱神】/使用BOMB进行防御 → ⑭
; 									   ⑮ MASTER被弹
; 										☇ **调用 “击破” 的口上内容**
; 										符合条件时TARGET发动技能【残忍酷薄】
; 											☇  **调用 “残忍酷薄” 的口上内容** → ⑧
; 								   ⑬ MASTER攻击
; 									☇ TARGET发动技能【怪力乱神】进行防御
; 										☇ **调用 “怪力乱神” 的口上内容** → ⑭
; 									   TARGET被弹
; 										☇ **调用 “被弹” 的口上内容** → ⑧
; 								   ⑭ 平手
; 					   ⑧ 一方残归零 → ④ ，否则 → ③
; 决斗结束	      ④ 宣布败犬/人生的胜利者，处理乐谱
; 决斗后		⑤ **调用 "戦闘後" 的口上内容**， 进行各种决斗后的数据处理
;==================================================
@M_KOJO_MOKA_MESSAGE_COM_K24_DANMAKU(ARGS, 对手残机, 自机残机)
#DIM 对手残机	;残机值除了“戰鬥前”没有意义以外，其余时点都能生效
#DIM 自机残机
;--------------------------------------------------
;启用（0，不显示以下内容；1，显示以下内容）
LOCAL = 1
;--------------------------------------------------
IF LOCAL
	SIF FLAG:1031
		TRYCALLFORM M_KOJO_MOKA_COLOR_K24
	;-------------------------------------------------
	;允许口上侧进行的对 MASTER的 战斗力补正
	;-------------------------------------------------
	; HANDICAP_FIXED 是直接对 MASTER 骰子修正值的补正，而 HANDICAP_RAND 则是以 RAND:HANDICAP_RAND 的形式进行的补正
	; 因为算式是 修正值 -= HANDICAP ，所以数值越高 MASTER 的骰子修正值就越低，如果输入负数，则变成增加 MASTER  的修正值
	; （虽然代码写的是给 MASTER 的补正，但是口上文本写成对 TARGET 的补正也是可以的）

	; （要注意的是，HANDICAP_RAND 的算式是：修正値 -= RAND:(HANDICAP_RAND + TFLAG:GipsLV（大角虫装甲负荷等级） * ABL:MASTER:戦闘能力 + 1)
	; 这样的写法导致了如果 HANDICAP_RAND 是较大的负值而令最终计算值也为负的话就会报错。想要大幅度增强 MASTER 稳妥起见请用 HANDICAP_FIXED）

	; HANDICAP 的补正无关 TARGET 本身的战斗能力，所以你甚至可以做到让1级的⑨暴打6级的MASTER（⑨是最强的）

	; HANDICAP 值是每回合都重新计算一遍的，所以你可以整一点越战越勇之类的花活
	; BTW,就这样写在这里的话就是全时点每次调用时都为 HANDICAP 赋值一遍，所以 HANDICAP = XX 之类的直接赋值建议还是做好条件限制。
	; 或者干脆把这里删掉，在时点内给 HANDICAP 赋值。（"戰鬥前"生效一次，决斗循环中的生效顺序见上方 整体流程与时点 ，"戰鬥後"不生效）
	
	;-------------------------------------------------
	;决斗前
	;-------------------------------------------------
	IF ARGS == "戦闘前"
		;CFLAG:24:1300 连败计数
		;TCVAR:24:355 记录强化模式的开关
		IF CFLAG:24:1002 >= 1 ;恋慕不高兴状态直接怯战
			PRINTFORMDW %CALLNAME:MASTER%正准备找橙对战、却发现橙已经不知什么时候跑掉了...
			CFLAG:24:320 = 0
			CFLAG:0:320 = 0
			CFLAG:24:300 = CFLAG:24:311
			CALL DOKU_KM_RENEW_TARGET(24) 
			RETURN -1
		ELSEIF FIRSTTIME ("初次弹幕胜负")
			PRINTFORML 「诶？%CALLNAME:MASTER%要和橙弹幕对战吗？」
			PRINTFORMDL 听到请求的橙、如同不相信听见的话一般瞪大了眼睛、朝%CALLNAME:MASTER%上下打量着
			PRINTFORML 「唔姆唔姆...没想到%CALLNAME:MASTER%居然会找橙做对手呢！」
			PRINTFORMW 「虽然橙不是很厉害的家伙、但是%CALLNAME:MASTER%也绝对不可以小瞧哦！」
			PRINTFORMDW 这样说着的小猫妖跳到了不远处、摆好了发射弹幕的架势、等待着%CALLNAME:MASTER%准备完毕 
			IF CFLAG:24:300 == CFLAG:25:300 ;蓝在同一位置
				PRINTFORML 
				CALL CHARA_TEXT,[[蓝]],@"『哦呀？%CALLNAME:MASTER%在和橙做什么呢？』","W"
				PRINTFORMDW 正准备着的%CALLNAME:MASTER%、突然发现橙的一旁多出了金发的九尾式神、带着微妙的警觉眼神注视着自己...
				PRINTFORMDW 不过在身旁的小猫妖凑近耳朵低语了几声后、蓝的表情便渐渐缓和了下来
				CALL CHARA_TEXT,[[蓝]],@"『原来是要进行弹幕对战啊...那我就在一旁看着了哦』","W"
				PRINTFORMDW 这样说着的蓝、似乎什么都没做...吗？
				CALL CHARA_TEXT,[[蓝]],@"『哎呀、好像被%CALLNAME:MASTER%发现了呢』","W"
				CALL CHARA_TEXT,[[蓝]],@"『橙是我的式神、所以待在我身边的时候、她的能力会增强哦』","W"
				CALL CHARA_TEXT,[[蓝]],@"『当然、如果%CALLNAME:MASTER%觉得不公平的话、我也可以让你和原本力量的橙战斗呢』","W"
				CALL CHARA_TEXT,[[蓝]],@"『那么、%CALLNAME:MASTER%打算怎么做呢？』","W"
				PRINTFORML
				PRINTFORMDW 要和强化过的橙对战吗？（橙的战斗力会获得强化、如果获胜则会提高战斗经验的获取、还会获得一些额外的奖励）
				;ps.这是彩蛋级别的差分所以发的东西很慷慨哦
				CALL ASK_YN ("战！","算了")
				IF !RESULT ;是、数值需要测试、大概在3级战斗能力的数值...
					CALL CHARA_TEXT,[[蓝]],@"『这样啊...我知道了』","W"
					CALL CHARA_TEXT,[[蓝]],@"『那就请%CALLNAME:MASTER%做好准备吧』","W"
					PRINTFORMDW 随着蓝的话音落下、%CALLNAME:MASTER%立马感受到橙身上的力量变得更强了...！
					PRINTFORMW 「橙变得更厉害了哦！%CALLNAME:MASTER%要小心啦！」
					PRINTFORMDW 兴奋地大喊着的小猫妖飞到了半空中、开始旋转着发射出弹幕！ 
					HANDICAP_FIXED = 200
					HANDICAP_RAND = 50
					TCVAR:24:355 = 1
				ELSE ;否
					CALL CHARA_TEXT,[[蓝]],@"『嗯...毕竟这样确实不公平呢』","W"
					CALL CHARA_TEXT,[[蓝]],@"『打扰%CALLNAME:MASTER%了』","W"
					PRINTFORMDW 蓝的身影退到了一旁、目光却一刻也没有从橙的身上移开...
					PRINTFORMW 「就算没有蓝大人的帮助、橙也不会输的哦！」
					PRINTFORMDW 宣言一般喊着话的小猫妖跳到了半空中、开始旋转着发射出弹幕！
				ENDIF 
			ENDIF 
		ELSE
			IF CFLAG:24:1300 >= 10 ;连败10次以上、真的有人能做到嘛...
				PRINTFORML 「...」
				PRINTFORMDW 即使听见了%CALLNAME:MASTER%的对战请求、橙也毫无反应地蹲在一旁、不知道在干什么...
				PRINTFORMW 「...笨蛋」
				PRINTFORMDW 似乎听见了什么呢...好奇的%CALLNAME:MASTER%凑到了埋着脑袋的小猫妖眼前
				PRINTFORML 「...%CALLNAME:MASTER%...就是个...只会欺负橙的笨蛋！！！」
				PRINTFORMW 「橙不想再看见%CALLNAME:MASTER%了啦！！呜...呜哇哇啊啊～......！」
				PRINTFORMDW 突然爆发的小猫妖猛地推开了%CALLNAME:MASTER%、捂着哭红了的眼睛、一下子就跑没了踪影...
				CFLAG:24:1300 += 1 ;将连败次数+1、触发道歉剧情
				CFLAG:24:318 = 1
				TALENT:24:15 = -1
				MARK:24:3 += 1
				CFLAG:24:320 = 0
				CFLAG:0:320 = 0
				CFLAG:24:300 = CFLAG:24:311
				CALL DOKU_KM_RENEW_TARGET(24)
				RETURN -1
			ELSEIF CFLAG:24:1300 > 5 ;连败5次以上
				PRINTFORML 「呜喵哇啊啊啊...不要来了嘛...！」
				PRINTFORML 「总是欺负橙有什么意思嘛！哼！」
				PRINTFORMDW 撅起小嘴的小猫妖紧紧捂住了头顶的猫耳、像躲瘟神一样躲避着%CALLNAME:MASTER%
				PRINTFORML 「...呜呜...%CALLNAME:MASTER%还是那么想打嘛...」
				PRINTFORML 「那就...来吧...」
				PRINTFORMDW 最后在%CALLNAME:MASTER%缠住对方、不停的请求下、橙才不情不愿地准备战斗
			ELSEIF CFLAG:24:1300 > 3 ;连败3次以上
				PRINTFORML 「诶？！要和橙弹幕对战？呜...那个...」
				PRINTFORMDW 一听见%CALLNAME:MASTER%的话、小猫妖就如同被吓到了一样跳了起来
				PRINTFORML 「%CALLNAME:MASTER%不考虑一下去找蓝大人、或者紫大人去对战吗...」
				PRINTFORML 「橙都已经输给%CALLNAME:MASTER%很多次了吧...」
				PRINTFORMDW 看着低着脑袋、用手指对戳着的小猫妖、%CALLNAME:MASTER%坏笑着问她是不是害怕了
				PRINTFORML 「害怕...才、才没有呢！哼！%CALLNAME:MASTER%把橙当什么了啊！」
				PRINTFORML 「不就是弹幕对战嘛！橙接受就是了！」
				PRINTFORMDW 鼓起小脸的小猫妖迅速跳到了半空中、一副随时都会发射弹幕的样子呢...
			ELSEIF CFLAG:24:930 ;输过了
				PRINTFORML 「诶...？%CALLNAME:MASTER%还想和橙来弹幕对战吗？」
				PRINTFORML 「唔...明明之前都输给%CALLNAME:MASTER%过了吧？」
				PRINTFORMDL 听见%CALLNAME:MASTER%再战的请求、小猫妖似乎有些犹豫的样子
				PRINTFORMDW 不过没过一会儿、橙就握紧了小小拳头、决定好了一般跳到了%CALLNAME:MASTER%的对侧
				PRINTFORML 「就算这样、橙也不会拒绝%CALLNAME:MASTER%的请求的！」
				PRINTFORMW 「这次橙一定会赢回来的哦！」 
			ELSE
				PRINTFORML 「还想和橙来玩弹幕对战吗？没问题哦！」
				PRINTFORMDL 听到%CALLNAME:MASTER%的请求、小猫妖的眼里就亮起了光、一副迫不及待的样子呢
				PRINTFORML 「上回橙都没想到能赢过%CALLNAME:MASTER%呢...」
				PRINTFORMW 「不过这回、就算%CALLNAME:MASTER%变强了、橙也不会轻松地输掉的哦！」 
			ENDIF
				IF CFLAG:24:300 == CFLAG:25:300 ;蓝在同一位置
					IF FIRSTTIME ("初次触发强化模式")
						CALL CHARA_TEXT,[[蓝]],@"『哦呀？%CALLNAME:MASTER%在和橙做什么呢？』","W"
						PRINTFORMDW 正准备着的%CALLNAME:MASTER%、突然发现橙的一旁多出了金发的九尾式神、带着微妙的警觉眼神注视着自己...
						PRINTFORMDW 不过在身旁的小猫妖凑近耳朵低语了几声后、蓝的表情便渐渐缓和了下来
						CALL CHARA_TEXT,[[蓝]],@"『原来是要进行弹幕对战啊...那我就在一旁看着了哦』","W"
						PRINTFORMDW 这样说着的蓝、似乎什么都没做...吗？
						CALL CHARA_TEXT,[[蓝]],@"『哎呀、好像被%CALLNAME:MASTER%发现了呢』","W"
						CALL CHARA_TEXT,[[蓝]],@"『橙是我的式神、所以待在我身边的时候、她的能力会增强哦』","W"
						CALL CHARA_TEXT,[[蓝]],@"『当然、如果%CALLNAME:MASTER%觉得不公平的话、我也可以让你和原本力量的橙战斗呢』","W"
						CALL CHARA_TEXT,[[蓝]],@"『那么、%CALLNAME:MASTER%打算怎么做呢？』","W"
						PRINTFORML
						PRINTFORMDW 要和强化过的橙对战吗？（橙的战斗力会获得强化、如果获胜则会提高战斗经验的获取、还会获得一些额外的奖励）
						;ps.这是彩蛋级别的差分所以发的东西很慷慨哦
						CALL ASK_YN ("战！","算了")
						IF !RESULT ;是、数值需要测试、大概在3级战斗能力的数值...
							CALL CHARA_TEXT,[[蓝]],@"『这样啊...我知道了』","W"
							CALL CHARA_TEXT,[[蓝]],@"『那就请%CALLNAME:MASTER%做好准备吧』","W"
							PRINTFORMDW 随着蓝的话音落下、%CALLNAME:MASTER%立马感受到橙身上的力量变得更强了...！
							PRINTFORMW 「橙变得更厉害了哦！%CALLNAME:MASTER%要小心啦！」
							PRINTFORMDW 兴奋地大喊着的小猫妖飞到了半空中、开始旋转着发射出弹幕！ 
							HANDICAP_FIXED = 200
							HANDICAP_RAND = 50
							TCVAR:24:355 = 1
						ELSE ;否
							CALL CHARA_TEXT,[[蓝]],@"『嗯...毕竟这样确实不公平呢』","W"
							CALL CHARA_TEXT,[[蓝]],@"『打扰%CALLNAME:MASTER%了』","W"
							PRINTFORMDW 蓝的身影退到了一旁、目光却一刻也没有从橙的身上移开...
							PRINTFORMW 「就算没有蓝大人的帮助、橙也不会输的哦！」
							PRINTFORMDW 宣言一般喊着话的小猫妖跳到了半空中、开始旋转着发射出弹幕！
						ENDIF
					ELSEIF CFLAG:24:1300 >= 5 ;连败5次以上强制开启比平时更厉害的强化模式！
						CALL CHARA_TEXT,[[蓝]],@"『哎呀、好像被我抓住了』","W"
						CALL CHARA_TEXT,[[蓝]],@"『%CALLNAME:MASTER%最近把橙欺负得很惨呢...』","W"
						PRINTFORMDW 这样说着的蓝站到了橙的身后、看起来像是要和小猫妖一同出击似的...
						CALL CHARA_TEXT,[[蓝]],@"『啊啊、不会二打一的哦、毕竟那样很不公平嘛』","W"
						CALL CHARA_TEXT,[[蓝]],@"『所以只是给橙更多的力量而已哦』","W"
						PRINTFORMDW 随着蓝举起手上的符纸、%CALLNAME:MASTER%立马感觉到橙的身上传来了比平时更加强大的力量！
						CALL CHARA_TEXT,[[蓝]],@"『请%CALLNAME:MASTER%好好反思吧～』","W"
						HANDICAP_FIXED = 500
						HANDICAP_RAND = 300
						TCVAR:24:355 = 1
					ELSE
						PRINTFORML
						PRINTFORMDW 蓝又一次站在了橙的身边、看着%CALLNAME:MASTER%、似乎在等待自己做决定呢...
						PRINTFORML
						PRINTFORMDW 要和强化过的橙对战吗？（橙的战斗力会获得强化、如果获胜则会提高战斗经验的获取、还会获得一些额外的奖励）
						;ps.这是彩蛋级别的差分所以发的东西很慷慨哦
						CALL ASK_YN ("战！","算了")
						IF !RESULT ;是、数值需要测试、大概在3级战斗能力的数值...
							PRINTFORMDW %CALLNAME:MASTER%点了点头、橙身上的力量便一下子变得更强了！
							IF CFLAG:24:930 
								PRINTFORMW 「这回一定要赢过%CALLNAME:MASTER%哦！喵哇哇～——！」
							ELSE
								PRINTFORMW 「橙变得更厉害了哦！%CALLNAME:MASTER%要小心啦！」
							ENDIF
						HANDICAP_FIXED = 200
						HANDICAP_RAND = 50
						TCVAR:24:355 = 1
						ELSE ;否
							PRINTFORMDW %CALLNAME:MASTER%摇了摇头、蓝便默默地退到了一边
							IF CFLAG:24:930 
								PRINTFORMW 「就算没有蓝大人帮忙...橙也有机会赢的哦！」
							ELSE
								PRINTFORMW 「就算没有蓝大人帮忙、橙也不会那么容易就输掉的哦！」
							ENDIF
						ENDIF 
					ENDIF
				ENDIF
			PRINTFORMW
		ENDIF
		; 在这里返回-1的话可以口上强制中止决斗
		RETURN 0
	ENDIF
	;-------------------------------------------------
	; HANDICAP 用口上
	; 如果 HANDICAP_FIXED 和 HANDICAP_RAND 都为假那么就不会显示这个
	; 你可以写文本，也可以写数值的更改。这个时点是刚好卡在计算骰子值的前一步。
	;-------------------------------------------------
	IF ARGS == "ハンデ"

		; PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;决斗中 MASTER 被弹时口上（4960新增接口）
	;-------------------------------------------------
	IF ARGS == "击破" 
		;此处可填写通用文本

		; MASTER获得残机的手段较多，基础是3，技能【洽览深识】+1，TALENT:0:大角虫+1，道具【命之卡片】+1
		; 不启用 胖次决斗DLC 的话最高6残，是先减少残机再调用的“击破”和“被弹”的口上内容
		; 默认大于4残的情况是高于橙战斗能力的情况、不做分歧
		SELECTCASE 自机残机
			CASE 5,4,3,2,1 ;还有残机的情况
				IF ABL:0:42 > ABL:24:42 ;主角的战斗能力大于橙的
					IF TCVAR:24:355 == 1 ;强化模式
						SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「呼哇～好像命中了啊」
							PRINTFORML 「要是没有蓝大人帮忙的话、%CALLNAME:MASTER%刚才肯定能躲过去的吧...」
							PRINTFORMDL 橙说着话的同时、不由自主地转头看向了自己的主人
							CALL CHARA_TEXT,[[蓝]],@"『再怎么说、发射弹幕的也是橙哦、所以是橙的功劳呢～』","L"
							PRINTFORMDW 九尾式神似乎看透了小猫妖的心思、解答般地轻语着						
