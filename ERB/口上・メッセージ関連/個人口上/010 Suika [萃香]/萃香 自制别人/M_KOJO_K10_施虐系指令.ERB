;维护人：狂气刘俊海
;维护日期：2026年4月29日

;编号100~108号的施虐系指令（SM系）
;*均为诶嘿嘿中指令

;如果不知道指令的含义，或不知道如何设计差分，金标准是参照该指令的情景描写文本。
;本系列的情景描写在EVENT_MESSAGE_COM_SM系.ERB

;-------------------------------------------------
;指令列表
;-------------------------------------------------
;100,打屁股（Spanking/Spanking）— 用手掌拍打对象的臀部
;101,鞭（鞭/Whip）— [未使用]用鞭子抽打对象的身体
;102,蜡烛（蜡烛/Candle）— [未使用]将灼热的蜡油滴在对象身上
;103,针（针/Needle）— [未使用]用针戳刺对象的敏感部位
;104,眼罩（Blindfold/Blindfold）— 装备型指令，给对象戴上或解除眼罩
;105,绳（Rope/Rope）— 装备型指令，用绳子缚住或解开对象
;106,口球（Ball Gag/Ball Gag）— 装备型指令，给对象塞上或取下口球
;107,拘束PLAY（Restraint Play/Restraint Play）— 装备型指令，束缚或解除对象的行动
;108,打胸部（乳Spanking/Breast Spanking）— 用手掌或手指拍打对象的胸部

;==================================================
;基本陷落嵌套模板
;==================================================
[SKIPSTART]
	;恋人
	IF TALENT:恋人
		PRINTFORML 
		RETURN 1
	;恋慕（炮友）
	ELSEIF TALENT:恋慕
		PRINTFORML 
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 
		RETURN 1
	;思慕
	ELSEIF TALENT:思慕
		PRINTFORML 
		RETURN 1
	;其他
	ELSE
		PRINTFORML 
		RETURN 1
	ENDIF
[SKIPEND]

;==================================================
;100,打屁股
;==================================================
;说明：用手掌拍打对象的臀部。关键差分：时奸中、初次、通常陷落嵌套。
;受虐属性高时可增加角色兴奋表现的差分。
;情景描写参考@MESSAGE_COM100

@M_KOJO_MOMO_MESSAGE_COM_K10_100
#LOCALSIZE 1
#LOCALSSIZE 1
	;时奸中
	IF FLAG:70
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMDL 在静止的时间里，你把萃香轻轻翻过来搁在膝盖上——她的臀部悬在半空，两团小巧的臀肉维持着被你翻动后微翘的角度，臀沟刚好卡在你大腿前侧的正中线上
				PRINTFORMDL 你把掌心悬在她右臀最高点正上方，隔着一层静止的空气，你的掌纹和她的皮肤之间还有最后半厘米没落下
				PRINTFORMDL 你在时停中连续挥了十几掌——每一掌都停在离她臀峰不到一毫米的位置，被打散的空气分子在静止中保持着向外扩散的波纹状
				PRINTFORMDL 她的皮肤依然是平滑的，没有泛红，没有凹陷，没有回弹
				PRINTFORMDL 十几道空气波纹叠成一片朝外扩散的透明涟漪，悬在她臀部上方
				PRINTFORMDW 你解开时停——十几掌在同一个瞬间落到了她右臀上
				PRINTFORMDW 右臀从微白变成浅粉再变成深红只用了一秒，臀肉在时停结束之后自己回弹了两次，每一次回弹都让她的骨盆在膝盖上往上颠了半寸
				PRINTFORML 「唔——」
			CASE 1
				PRINTFORMDL 时停中你把萃香摆成跪姿——上半身趴在枕头上，臀部翘高，臀缝在静止中微微张开
				PRINTFORMDL 你的左手展开贴在左臀正中央，右手抬起准备击打右臀——手指在空气中张开成扇形，四道指缝间的空气被分成四条静止的气流
				PRINTFORMDL 你在静止中交替击打她的左右臀——左手在左臀上压着固定，右手在右臀上连打了十几掌，每一掌都悬在离臀峰不到一毫米的位置
				PRINTFORMDL 右臀在你每次挥掌的瞬间微微下凹——不是被打的，是时停把臀肉和气压锁在了即将被击中的前一瞬间
				PRINTFORMDW 你解开时停——左手上的温度和右臀上积攒的掌击在同一个时间轴上开始播放
				PRINTFORMDW 左臀被掌心压得发烫，右臀在连续回弹中把臀沟挤成了一条越来越细的线，从臀峰到臀沟边缘逐渐泛出一片不规则的深粉色
				PRINTFORML 「……嗯？」
		ENDSELECT
	;睡姦中
	ELSEIF CFLAG:MASTER:恶作剧 == 2
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMDL 萃香在睡梦中趴着——双腿微微分开，臀部的轮廓在薄被下勾出两道柔和的弧线
				PRINTFORMDL 你把被子从她身上慢慢掀到腰部，她的臀肉在月光下泛着一层极淡的蓝白色反光
				PRINTFORMDL 你的手掌第一次落在她左臀上时，她的臀肉轻轻颤了一下——不是被打的痛感，是梦中身体对突然触感的自然回应
				PRINTFORMDL 左臀浮现出一个极浅的手掌轮廓，从臀峰边缘渐渐泛红，那道红色从掌心中央慢慢往外洇，像一滴红墨落进清水里
				PRINTFORMDL 第二掌落在右臀正中时，她的两条大腿微微夹了一下——无意识的肌肉反应
				PRINTFORMDL 右臀往里凹了一毫米然后立刻弹回来，臀肉振了两次才停
				PRINTFORMDW 她翻了个身——臀部的掌印从臀峰压进了床单里
				PRINTFORMDW 那两片被击打过的臀肉在接触到床单凉面时微微缩了一下，她在梦里嗯了两声然后继续睡了
				PRINTFORMDW 臀上的掌印在她翻身之后叠在了同一侧床单上——被单上多出了两道对称的浅粉弧线
			CASE 1
				PRINTFORMDL 萃香侧躺在床沿——大腿微弯，臀部正对着你
				PRINTFORMDL 你把她的睡衣从腰际轻轻掀到背的中段，脊椎两侧的臀肉在睡梦中完全放松
				PRINTFORMDL 你的掌心从她臀峰最低处往上推——不是打，是抚摸，尾骨周围的皮肤在你的掌沿接触下慢慢升温
				PRINTFORMDL 然后你开始交替拍打左右臀——各五次
				PRINTFORMDL 力度从轻开始：第一掌只用指节的力，臀肉几乎不动；第三掌用了掌心的力，往里凹了两毫米；第五掌用了手腕的力，凹进去将近半厘米然后弹了三次才趋于静止
				PRINTFORMDL 臀型在打完之后比之前微微翘了一点——那是被连续击打之后盆骨底部血流增加导致臀大肌轻度充血膨胀
				PRINTFORMDW 她的大腿在梦中自己打开了——臀肌在无意识松弛中把那两片被击打过的臀肉往外翻了半厘米
				PRINTFORMDW 最后她就维持着这个姿势：臀上盖着掌印，腿心的入口在臀肉外翻的作用下略微张开，在梦境深处安静地闭合、再分开——屁股尖上还在做着一场无人醒着的梦
		ENDSELECT
	;醉奸中
	ELSEIF TCVAR:10:烂醉 == 1
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMDL 萃香醉醺醺地趴在桌上，手边倒着一个空了的酒盏，脸颊枕在自己的手臂上
				PRINTFORMDL 你把她的裙摆掀起来，酒精让她的屁股比平时热了将近两度，掌印落上去颜色格外鲜艳
				PRINTFORMDL 第一掌拍在臀峰正中，她迷迷糊糊地笑了一声——醉酒之后的痛觉被错位成了某种痒痒的愉快
				PRINTFORMDL 第二掌落在尾骨左侧，她把腿往旁边挪了半个身位，然后把酒盏从脸边推开了——怕打翻
				PRINTFORMDW 第三掌横贯臀腿交界，被酒精稀释了血管收缩反射之后，掌痕比平时扩散得更宽更模糊
				PRINTFORMDW 她伸手在空气里抓了抓没摸到酒瓶，于是把手缩回来在自己被打了三掌的屁股上拍了拍，嘟囔了一句只有醉鬼才听得懂的话
			CASE 1
				PRINTFORMDL 萃香抱着酒葫芦趴在床上，葫芦口还挂着最后一滴没掉下来的酒
				PRINTFORMDL 你把她的裙子撩到腰际，她的臀肉在酒精作用下泛着一层温热的绯红色泽
				PRINTFORMDL 第一掌落下去她嗯了一声——不是疼，是在半梦半醉之间被掌心的温度惊醒了皮肤
				PRINTFORMDL 第二掌落在对称位置，她把脸往枕头里蹭了蹭，打完一个酒嗝才反应过来自己正在挨打
				PRINTFORMDL 第三掌从臀沟边缘拍上去，她把手伸到背后摸了摸自己被打过的地方——摸到掌痕之后捏了捏自己还在发热的屁股
				PRINTFORMDW 然后把酒葫芦重新抱紧了，用脸在葫芦的漆面上蹭了蹭
				PRINTFORMW 「再来一瓶我就告诉你……我现在感觉还挺好的……嗝。」
		ENDSELECT
	;それ以外
	ELSE
		;恋人
		IF TALENT:恋人
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMDL 萃香趴上你的膝盖，自己把屁股挪到了你最顺手下掌的位置，臀峰微翘
					PRINTFORMDL 第一掌落在右臀，臀肉软软地凹了半指节然后弹回来——她已经学会了在被你打之前就把肌肉彻底松开
					PRINTFORMDL 第二掌落在左臀对称处，她没哼哼，只是把埋在手臂里的脸往外偏了一点点
					PRINTFORMDL 半只耳朵从碎发间露了出来，耳根在掌落之后慢悠悠地红了——不是疼，是她知道自己正被你打
					PRINTFORMDL 第三掌横贯臀腿交界处，这是她肉最厚的一层，掌力被脂肪吸掉大半，印子比前两道更浅更宽
					PRINTFORMDW 打完以后她的脚尖踩了一下你的小腿——不是踢，脚趾在你骨头上的力道轻得像在试探湖面的冰
					PRINTFORMDW 她把脸从手臂里抬起来侧眼看你，眼神在说够了吧，然后又把头埋回去了，屁股却悄悄往上翘了半寸
					PRINTFORMDL ——
					PRINTFORML 「……还没完吗——」
				CASE 1
					PRINTFORMDL 萃香跪在床上双手撑枕头，回头看了你一眼——不是确认位置，是确认你是不是认真的
					PRINTFORMDL 你绕到她身后，臀沟从尾骨到会阴的弧线在这个角度比平时更深更直
					PRINTFORMDL 第一掌拍在右臀外侧，她用牙齿咬住了自己的下唇，臀肉往内挤了半厘弹回来，咬合的力度和回弹的幅度完全同步
					PRINTFORMDL 第二掌拍在左臀内侧，离臀沟只差了一指宽，掌力在臀沟边缘激起一道细密的肉纹，纹路沿着肌纤维的方向放射出去，在臀峰处消散
