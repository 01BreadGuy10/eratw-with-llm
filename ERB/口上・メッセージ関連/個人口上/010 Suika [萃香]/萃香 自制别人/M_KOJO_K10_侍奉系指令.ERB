;==================================================
;80,手淫
;==================================================
@M_KOJO_MOMO_MESSAGE_COM_K10_80
	IF FIRSTTIME(SELECTCOM)
		IF TALENT:恋慕 || TALENT:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「%CALLNAME:MASTER%……想让我用手帮你……弄出来？」
					PRINTFORMDL 萃香看着%CALLNAME:MASTER%隆起的裤裆，脸一下子红了，但双手已经主动伸了过来
					PRINTFORML 「虽然用手做还是第一次……但是为了%CALLNAME:MASTER%，我会努力的……」
					PRINTFORMDW 她跪在%CALLNAME:MASTER%面前，小心翼翼地把肉棒从裤子里释放出来——然后又因为它的尺寸倒吸了一口气
				CASE 1
					PRINTFORML 「用手帮%CALLNAME:MASTER%做……这样就可以了吗？」
					PRINTFORMDL 萃香的指尖在触碰到龟头的一瞬间微微发抖，然后慢慢合拢掌心
					PRINTFORMW 「好烫……而且在跳……我能感觉到它的脉搏……这就是%CALLNAME:MASTER%想要我的证明吗……」
				CASE 2
					PRINTFORML 「虽然平时总是说我变态……但现在的%CALLNAME:MASTER%，只是用手碰一下就硬成这样了呢」
					PRINTFORMDL 萃香带着七分害羞三分得意，将手掌轻轻覆上了肉棒的侧面
					PRINTFORMW 「好吧……既然是%CALLNAME:MASTER%想要的话……那我会让她舒服的——第一次好好看着我哦……」
			ENDSELECT
		ELSEIF TALENT:思慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「用手……帮你做吗……」
					PRINTFORMDL 萃香犹豫了几秒，然后像是下了什么决心似的坐在了%CALLNAME:MASTER%腿边
					PRINTFORMW 「虽然不太确定能不能做好……但你既然主动提出来了，我就试试看吧——教我怎么动……」
				CASE 1
					PRINTFORML 「手的话……应该不会太困难吧……毕竟手是自己能控制的东西……」
					PRINTFORMDL 萃香搓了搓掌心，让手指暖和起来，然后小心翼翼地握了上去
					PRINTFORMW 「呜……比想象中还要硬……你这家伙到底忍耐了多久啊……」
			ENDSELECT
		ELSEIF TALENT:炮友 || TALENT:愛欲
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「手淫？就这么简单的要求？我还以为你要来更猛的~」
					PRINTFORMDL 萃香大大方方地坐到%CALLNAME:MASTER%身侧，活动了一下手指关节，像是在做运动前的准备操
					PRINTFORMW 「来吧，把裤子脱了——让我看看今天的小冠军状态如何~」
				CASE 1
					PRINTFORML 「用手帮你弄出来？可以啊——不过我手法可是很专业的，你做好心理准备了么？」
					PRINTFORMDL 萃香舔了一下自己的手指，嘴角挂着坏笑
					PRINTFORMW 「我的目标是在五分钟之内让你缴械——不许偷偷忍耐，我可是认真在给你做的~」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「用手……给你做……你是说用手握着那里然后上下动？」
					PRINTFORMDL 萃香的表情从困惑到震惊到羞耻，短短几秒内切换了好几个频道
					PRINTFORMW 「你再说一遍你想让我干什么！！你是不是把我和人类搞混了！鬼才不会做这种事——虽然最后还是做了……」
				CASE 1
					PRINTFORML 「就……就这样握着……然后这样动？是这样吗……」
					PRINTFORMDL 萃香僵硬地模仿着%CALLNAME:MASTER%教给她的动作，力度忽大忽小
					PRINTFORMW 「你别用那种眼神看我……我确实是第一次做这种事……不满意的话就说出来……我尽量调整……」
				CASE 2
					PRINTFORML 「你让我用手帮你弄下面……这已经是今天第几个过分的要求了……」
					PRINTFORMDL 萃香红着脸叹了口气，但还是伸出了手
					PRINTFORMW 「算了……反正前面那么多事情都做了，现在再拒绝也没什么意义……来吧，告诉我具体怎么做……」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;時姦中
	IF FLAG:70
		IF TALENT:恋慕 || TALENT:恋人
			PRINTFORMDW %CALLNAME:MASTER%抓住时停中萃香的手
			PRINTFORMDL 让她的小手握住自己的肉棒，上下的抽动起来。在静止的时间里，只有肉棒在她指间摩擦的声音
			PRINTFORMDW 虽然她毫不知情，但那双手的温度却是真实的——也许在时停中握住她的手，不只是为了物理上的快感
		ELSEIF TALENT:思慕
			PRINTFORMDL 在静止的时间中，%CALLNAME:MASTER%将萃香的手引向了自己的胯间
			PRINTFORMDL 手指被摆成环状扣住柱身，在静止的世界里这幅构图有种微妙的背德美感
			PRINTFORMDW 如果她知道自己的手在我身上留下过这样的痕迹，大概会先呆住三秒然后抄起酒葫芦砸过来吧
		ELSE
			PRINTFORMDW %CALLNAME:MASTER%抓住时停中萃香的手
			PRINTFORMDL 让她的小手握住自己的肉棒,上下的抽动起来
			PRINTFORMDW 趁着她毫无反应，%CALLNAME:MASTER%甚至把她另一只手也拉了过来，两只手合在一起包裹住整个肉棒——在时间停止中，可以肆无忌惮
		ENDIF
		RETURN 1
	;恋人
	ELSEIF TALENT:恋人
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「%CALLNAME:MASTER%今天也想让我用手来帮你吗~」
				PRINTFORMDL 萃香主动跪在%CALLNAME:MASTER%面前，用双手轻轻捧起了已经隆起的小帐篷
				PRINTFORMW 「嗯……先从这里开始……慢慢按摩，让它完全醒过来——然后等它完全精神了我再正式开始……你觉得呢？」
			CASE 1
				PRINTFORML 「手淫虽然比不上真正做爱……但是用手的时候我可以一直看着%CALLNAME:MASTER%的脸哦」
				PRINTFORMDL 萃香一边说着一边用掌心包裹住龟头，拇指在上面轻轻画着圈
				PRINTFORML 「看你因为我手指的每一寸移动而皱眉、叹气、最后忍不住呻吟出来——这才是手淫最大的乐趣呢」
				PRINTFORMDW 她的手指顺着肉棒的弧度滑了下去，在根部多施加了几分力道，然后缓缓往上推——整个动作流畅得像在弹一件熟悉的乐器
			CASE 2
				PRINTFORML 「今天试试新学的手法——是从一本古书上看来的，说是什么'鬼族秘传'……虽然我很怀疑是不是真的鬼族传承……」
				PRINTFORMDL 萃香将双手搓热，然后左右手交替着从不同方向旋转着包裹住肉棒，每一次旋转的角度和力度都在微妙地变化
				PRINTFORMW 「怎么样？是不是感觉很不一样？……哎？你想知道那本书叫什么名字？——不行，这是秘密。不过效果好的话，下次再给你做~」
			CASE 3
				PRINTFORML 「把手借给我一下——不是让你牵手啦，是让你把手放在我的手上面……」
				PRINTFORMDL 萃香用自己的手握着%CALLNAME:MASTER%的肉棒，然后把%CALLNAME:MASTER%的手叠在自己手背上，引导着他的手指感受自己的节奏
				PRINTFORMW 「感觉到了吗……这是我喜欢你的节奏——每次在你里面或外面，最后都会回到这个节奏上……记住了就自己多动动，别总是让我一个人忙~」
		ENDSELECT
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「呀啊~……哈啊~出，出来吧……射到我的手上吧……」
				PRINTFORMDW 萃香在用手套弄的同时，嘴里也在说着一些污言秽语
				PRINTFORMW 「什么吗……还不出来么？那就试试这招吧」
				PRINTFORMDW 萃香在撸动肉棒的同时，用手轻抚着%CALLNAME:MASTER%的阴囊。
				PRINTFORMDL 你已经很努……
				PRINTFORMDW %CALLNAME:MASTER%的话说到一半，萃香突然用牙齿开始摩擦起%CALLNAME:MASTER%的龟头
				PRINTFORMW 「嘿嘿………这次算我得一分………」
			CASE 1
				PRINTFORMW 「要用手做么？嘛，也不是说不行」
				PRINTFORMW 「只是相比于用手做，直接做爱不是更好么？」
				PRINTFORMDW 萃香在说话的同时，用娴熟的手法抚弄着龟头
				PRINTFORMDL 手法确实大有进步呢，真是辛苦你了  
				PRINTFORMDL 萃香抬起头看了一眼%CALLNAME:MASTER%、又低下头去，保持爱抚龟头的同时，撸动起%CALLNAME:MASTER%的肉棒
				PRINTFORMW 「如果真的觉得辛苦，就应该给我想要的吧！」
				PRINTFORMDL 额………………
			CASE 2
				PRINTFORML 「今天……想让我快一点还是慢一点？」
				PRINTFORMDL 萃香在开始前认真地问着，手指已经在龟头周围轻轻地打着转
				PRINTFORML 「快的话我可以用两只手交替着来……慢的话我可以一边做一边跟你说说话……你想要哪一种——还是我帮你选？」
				PRINTFORMDL 她没等%CALLNAME:MASTER%回答就开始了——先慢后快，循序渐进，显然在心里早就有了答案
				PRINTFORMW 「果然不出所料——你是想慢一点的。因为你想让我多碰你一会，对吧？」
			CASE 3
				PRINTFORML 「有时候看着%CALLNAME:MASTER%认真享受我手淫的样子……就觉得%CALLNAME:MASTER%像只大猫……」
				PRINTFORMDL 萃香的手指在肉棒上不紧不慢地滑动着，另一只手托着下巴，微笑着观察%CALLNAME:MASTER%的表情变化
				PRINTFORML 「这里是有感觉的位置……这里是特别有感觉的位置……这里是一碰就会想叫的位置……」
				PRINTFORMDW 她的指尖像地图测绘员一样仔细地探索着每一寸皮肤，然后用嘴唇轻轻碰了一下龟头的顶端——那是她测绘到的"最敏感坐标"
		ENDSELECT
		RETURN 1
	;思慕
	ELSEIF TALENT:思慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「………………」
				PRINTFORMDW 萃香在用手上下的套弄着%CALLNAME:MASTER%的肉棒的同时,时不时观察着%CALLNAME:MASTER%的表情
				PRINTFORMW 「怎样？有没有感到舒服？」
				PRINTFORMDW 萃香在说话的同时，稍微加快了手上的速度
				PRINTFORMDW 嗯……非要说的话，确实有所进步呢，但还是没有………
				PRINTFORMDL %CALLNAME:MASTER%还没有说完后面的话，就被萃香狠狠的掐了一下肉棒
				PRINTFORMDL 在那一瞬间，%CALLNAME:MASTER%的脸上汇聚了千种表情，万种心情
				PRINTFORMDL 萃香在观察了一会%CALLNAME:MASTER%的表情后，又专心套弄起%CALLNAME:MASTER%的肉棒
			CASE 1
				PRINTFORML 「今天我想试一种新的节奏……上次观察你表情的时候发现，这样你会皱眉头……但是这样你会松一口气……」
				PRINTFORMDL 萃香像个认真的学徒一样，一边试验一边记录着%CALLNAME:MASTER%的反馈
				PRINTFORMW 「所以综合起来……应该先是慢的，然后加快，然后再慢下来让它休息一下，再加快……这样循环——你看我分析得对不对？」
			CASE 2
				PRINTFORML 「感觉现在比以前熟练很多了吧……至少不会手忙脚乱了……」
				PRINTFORMDL 萃香的手法确实越来越稳定，从简单的上下套弄变成了更复杂的组合动作
				PRINTFORML 「以前给你做的时候总想着'快点结束吧好丢脸'……现在反而会想'什么时候可以再帮你做一次'……人是会变的，对吧」
				PRINTFORMDW 她说这话的时候没有看%CALLNAME:MASTER%，但耳根的颜色出卖了她——那是比任何语言都更直接的表达
		ENDSELECT
		RETURN 1
	;炮友
	ELSEIF TALENT:炮友
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「今天想用什么手法？标准式、旋转式、还是新研发的'鬼族指尖闪电'——好吧最后一个是我刚编的」
				PRINTFORMDL 萃香将双手在%CALLNAME:MASTER%面前晃了晃，像是在展示她的"工具"
				PRINTFORMW 「开个玩笑而已啦。不过说真的——你喜欢快的还是慢的，直接告诉我，我好定制服务。毕竟，效率很重要~」
			CASE 1
				PRINTFORML 「手淫有个很大的优点——就是可以一边做一边跟你聊天，完全不会影响嘴上的功能」
				PRINTFORMDL 萃香手上的动作行云流水，嘴里的话也不停
				PRINTFORML 「你想聊什么？今天的天气？昨晚的酒好不好喝？还是——你为什么每次我碰到这个位置的时候表情都会扭曲成这样？」
				PRINTFORMDW 她精准地用指腹按住肉棒背面某条突起的筋，手指在上面来回滑动，然后饶有兴致地看着%CALLNAME:MASTER%的脸皱成一团
			CASE 2
				PRINTFORML 「你知道我最喜欢手淫的什么部分吗——是快结束的时候，你那根东西在我手里跳得像要爆炸一样」
				PRINTFORMDL 萃香凑到%CALLNAME:MASTER%耳边小声说着，手上的速度和力度同时增加了
				PRINTFORMW 「那种又想忍又忍不了的表情，每次都让我觉得——这比什么都值。所以，今天也别忍了，早点投降吧~」
		ENDSELECT
		RETURN 1
	;愛欲
	ELSEIF TALENT:愛欲
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「手淫……我最会的技能没有之一……♡」
				PRINTFORMDL 萃香还没开始动手，光是想象接下来要做的事情就已经兴奋到呼吸急促了
				PRINTFORML 「我每天都在研究%CALLNAME:MASTER%的肉棒呢——用眼睛、用嘴唇、用手、用脑子……所以我的手比任何人都懂它……♡」
				PRINTFORMDW 她的手指以精准到变态的角度扣住了冠状沟的下沿，在那里反复揉搓——那是只有经过无数次实践才能找到的、精确到毫米的甜蜜点
			CASE 1
				PRINTFORML 「来，看清楚——这是我的手指，这是你的龟头，现在它们要长时间进行友好交流了……♡」
				PRINTFORMDL 萃香把双手的掌心都贴上肉棒——一手握住根部固定，另一手呈螺旋状从下往上推
				PRINTFORML 「每一圈推到龟头的时候我会多停留一秒，让龟头在我的掌心里转一圈……然后重新回到下面再来……♡」
				PRINTFORMDW 她的解说配合着动作，像是在做某种优雅的料理示范——只是食材是%CALLNAME:MASTER%的肉棒，烹饪方法是持续的高强度刺激
			CASE 2
				PRINTFORML 「嗯……%CALLNAME:MASTER%……能感觉到吗……我的手指在你铃口那里画圈……♡」
				PRINTFORMDL 萃香一边用双手交替着套弄柱身，一边不时用拇指指腹擦过龟头的顶端——每一次都带走一两滴先走汁
				PRINTFORML 「先走汁流了好多……是不是很舒服？诚实告诉我……我手法好还是你的右手手法好？——不许撒谎……♡」
				PRINTFORMDW 她弯下腰用舌尖把那滴挂在龟头上的透明黏液舔掉，然后继续手上的工作，故意把沾了口水的指尖滑到%CALLNAME:MASTER%最受不了的位置上去
		ENDSELECT
		RETURN 1
	;それ以外
	ELSE
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 「什么,让我给你用手做么？」
				PRINTFORMDW 萃香随意的抓住%CALLNAME:MASTER%的命根，左右的摆弄了起来
				PRINTFORMW 「这样真的会有快感么？不太理解啊。」
				PRINTFORMDW 萃香在摆弄的同时，加大了手上挤压的力度
				PRINTFORMW 「等下，这里会怎样啊？」
				PRINTFORMDL 萃香的另一只手抓在了龟头上，用力的搓揉起来
				PRINTFORMDL %CALLNAME:MASTER%不得不强忍着痛感，让萃香稍微轻一点
				PRINTFORMW 「什么吗，原来这里这么脆弱么？平时的时候不是都会很硬么？」
			CASE 1
				PRINTFORML 「你这个变态……居然真的要我用手给你弄……」
				PRINTFORMDL 萃香嘴上骂着，手上却没有停。虽然动作生疏得像在握方向盘，但至少方向是对的
				PRINTFORMW 「别催我啊……我又没有经验……快了？好那我快一点——等下、是不是太快了！！你自己说的快了！！到底要快还是要慢！！」
			CASE 2
				PRINTFORML 「唔……这个东西握在手上的感觉真奇妙……凉凉的又滑滑的……还有脉搏在跳……」
				PRINTFORMDL 萃香像是发现了新大陆一样专心研究着手中的肉棒，完全忘了这本该是件羞耻的事
				PRINTFORMW 「人类的身体好神奇……女的和男的差别这么大——啊，你刚才是不是表情变了一下？是我碰到什么地方了吗——这里？还是这里？」
			CASE 3
				PRINTFORML 「好吧……但只许用手哦……不许得寸进尺……」
				PRINTFORMDL 萃香把双手搓暖，然后闭上眼睛猛地握了上去——像是跳进冷水之前做的那一下心理建设
				PRINTFORMW 「唔……比想象中要更……光滑？不对，更粗糙？——算了反正就是很奇怪的触感……你习惯就好……是我在帮你做，应该我习惯……」
		ENDSELECT
		RETURN 1
	ENDIF

