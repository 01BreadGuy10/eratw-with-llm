@M_KOJO_MOMO_MESSAGE_COM_K10_81
	IF FIRSTTIME(SELECTCOM) && !FLAG:70
		IF TALENT:恋慕 || TALENT:恋人
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「%CALLNAME:MASTER%……是变态……」
					PRINTFORMW 「想让我给你口交什么的，真是个变态……」
					PRINTFORMDW 虽然嘴上这么说，但是萃香还是慢慢地用舌头舔起肉棒
					PRINTFORMW 「也不是说，我很讨厌这么做」
					PRINTFORMW 「只是…唔嗯…和男人做这种事情……」
					PRINTFORMW 「哎？也没有和女孩子这样做过啦………啾嗯~」
					PRINTFORMW 「只是想着，能将第一次献给%CALLNAME:MASTER%什么的……呀啊」
					PRINTFORMW 「嘛啊，我会努力的哦！」
				CASE 1
					PRINTFORML 「%CALLNAME:MASTER%……想我用嘴帮你吸吗……」
