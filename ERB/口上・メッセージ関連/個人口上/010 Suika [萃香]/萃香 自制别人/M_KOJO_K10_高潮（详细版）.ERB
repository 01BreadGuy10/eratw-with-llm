@M_KOJO_MOMO_MESSAGE_PALAMCNG_A_K10_6(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
	;时奸中
	IF FLAG:70
		SELECTCASE RAND:2
			CASE 0
