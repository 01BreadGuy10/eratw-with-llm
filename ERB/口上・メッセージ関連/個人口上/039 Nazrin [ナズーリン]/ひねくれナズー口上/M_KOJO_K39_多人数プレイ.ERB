@M_KOJO_MESSAGE_SCOM_K39_11_2
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;一人目のID＠胸で,MASTERの陰茎を,このターンに占有中の角色
	;行儀悪いけど楽なのでLOCALに代入
	;一人目口上の後に呼び出されるため、台詞は『』でくくるようにしています
	LOCAL = MASTER_POSE(5,1)
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 
		RETURN 1
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 『哈啊、哈啊、库、嗯嗯…』
				PRINTFORML 『你也是…有相当不得了的、姻缘之人呐……哈呜、…』
				CALL HPH_PRINT,@"『被这样、两个人一起央求…啊、呜哇…HPH　喂、不要恶作剧啦…』","L"
				PRINTFORMDW 用指尖轻轻拨弄了下尖挺着的樱色乳尖、纳兹琳红着脸抗议了起来…
			CASE 1
				CALL HPH_PRINT,@"『这、这样…咕呜HPH　前面、蹭到了…』","L"
				PRINTFORMDW 在重复着侍奉动作时、纳兹琳的小樱桃与%CALLNAME:LOCAL%%OPPAI_DESCRIPTION(LOCAL)%不时会碰到、鼠少女此刻因摩擦的快乐而身体颤抖着
			CASE 2
				;胸の尺寸差が大きい、または貧乳同士
				IF TALENT:LOCAL:胸围 - TALENT:39:胸围 >= 2 || (TALENT:LOCAL:胸围 < 0 && TALENT:39:胸围 < 0)
					CALL HPH_PRINT,@"『唔，呼……嗯嗯！HPH　虽然每次都这样……你的品味可真是够特别的啊』","L"
					PRINTFORMD 纳兹琳比较着%CALLNAME:LOCAL%%OPPAI_DESCRIPTION(LOCAL,1)%与自己胸部的差距、像是怨恨般的轻声嘀咕着
				;それ以外
				ELSE
					PRINTFORML 『唔、唔嗯…真是令人无语呢……你就这么喜欢胸吗？』
					PRINTFORMDW 纳兹琳注视着在重叠的四个乳房之间颤动着跳跃的肉棒、轻轻地喘了口气
				ENDIF
				;一人目が星
				IF LOCAL == 87
					PRINTFORML
					CALL HPH_PRINT,@"『主人也真是的。…HPH　像这样、两个人给一个人做侍奉什么的…真是寡廉鲜耻、呀…HPH』","W"
				;其他寺メンバー 恋:38 小傘:40,鵺:41，聖:55, 心:57 猯藏:69,一輪:85, 村紗:86, 響子:88, 女苑:125
				ELSEIF GROUPMATCH(LOCAL,38,40,41,55,57,69,85,86,88,125)
					PRINTFORMDL
					CALL HPH_PRINT,@"『…哈呜、哈啊……HPH　更别提还要这样、让自己人一起做…』","L"
					PRINTFORMW 『真是的、你这家伙可真是个人物呢…嗯嗯…这不是在夸你哦…』
				ELSE
					PRINTFORMDW …
				ENDIF
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF



