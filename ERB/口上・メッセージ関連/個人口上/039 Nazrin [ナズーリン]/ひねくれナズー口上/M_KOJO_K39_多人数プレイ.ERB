;二人目口上
@M_KOJO_MESSAGE_SCOM_K39_9_2
VARSET LOCAL
;一人目
LOCAL:101 = MASTER_POSE(SET_M,SET_P)
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;一人目のID＠口で,MASTERの陰茎を,このターンに占有中の角色
	;上ですでにLOCAL:101に一人目のIDを代入してもらっているものの、
	;行儀悪いけど楽なのでLOCALに代入
	;一人目口上の後に呼び出されるため、台詞は『』でくくるようにしています
	LOCAL =  MASTER_POSE(4,1)
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 
		RETURN 1
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 『哈姆…嗯、舔舔、舔舔哦…』
				PRINTFORML 『唔…我一个人做的时候更兴奋吗？…不过嘛、算了、怎样都好就是啦……』
				PRINTFORMDW 纳兹琳与%CALLNAME:LOCAL%一起、将舌头缠绕在了%CALLNAME:MASTER%的肉棒上…
			CASE 1
				PRINTFORML 『啾噜噜、舔啾、啾噜噜…哈姆、咔噗…嗯…』
				PRINTFORMDL 抚摸着热心侍奉着的纳兹琳的头、她回以了一个有些不好意思的微笑
				PRINTFORML 『…噗啊…在这样的亲热时候把人家当小孩子哄吗？』
				IF TALENT:LOCAL:恋慕 && RAND:2 == 0
					PRINTFORML 『……我倒是无所谓啦…不过、那个…』
					PRINTFORMDW 感受到%CALLNAME:LOCAL%有些羡慕的视线、%CALLNAME:MASTER%轻轻地摸了两个人的头…
				ELSE
					PRINTFORML 『……嘛、随你喜欢吧。啾、啾噜啾…』
					PRINTFORMDW 纳兹琳的尾巴轻摇了一下、随后更加黏腻地亲吻起肉棒来…
				ENDIF
			CASE 2
				PRINTFORML 『库噗、啾噗噜、舔舔哦…』
				PRINTFORM 『呵呵、
				;一人目が星
				IF LOCAL == 87
					PRINTFORM 主人
				ELSE
					PRINTFORM %CALLNAME:LOCAL%
				ENDIF
				PRINTFORML 和我的侍奉感觉如何呢？』
				PRINTFORMDW 回答说再好不过了、纳兹琳的嘴角不易察觉地微微上扬了一下、继续用嘴侍奉起你来
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF

