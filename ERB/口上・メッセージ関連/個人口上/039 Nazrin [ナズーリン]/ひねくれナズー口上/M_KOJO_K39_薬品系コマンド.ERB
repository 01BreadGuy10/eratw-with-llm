;=================================================
;特殊コマンド
;=================================================
;-------------------------------------------------
;180,ローション
;-------------------------------------------------
@M_KOJO_MESSAGE_COM_K39_180
CALL M_KOJO_MESSAGE_COM_K39_180_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K39_180_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMDW 
		RETURN 1
	ENDIF
	;基本セット
	;恋慕
	IF TALENT:恋慕
		PRINTFORMDW 
		RETURN 1
	;不埒3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMDW 
		RETURN 1
	;それ以外
	ELSE
		PRINTFORMDW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1

