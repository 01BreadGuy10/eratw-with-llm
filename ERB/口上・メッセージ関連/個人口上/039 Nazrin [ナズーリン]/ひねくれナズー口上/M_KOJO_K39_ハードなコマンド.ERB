;==================================================
;144,放尿
;好きな指令だが持ちネタの少なさに絶望。間違いなく手抜き口上No.1
;==================================================
@M_KOJO_MESSAGE_COM_K39_144
CALL M_KOJO_MESSAGE_COM_K39_144_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K39_144_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;過激な恶作剧中
	IF CFLAG:恶作剧 && CFLAG:睡眠
		IF RAND:3 == 0 
			PRINTFORMW 「哈…呼……」
		ELSEIF RAND:2 == 0 
			PRINTFORMW 「呼…呜…呜…」
		ELSE
			PRINTFORMW 「…嗯…哈啊…」
		ENDIF
		IF RAND:3 == 0 
			PRINTFORMDW 尽管纳兹琳还是熟睡着、但从少女幼嫩的秘裂里淅淅沥沥地流出黄金色液体…
		ELSEIF RAND:2 == 0 
			PRINTFORMDW 从股间漏出来的液体将床垫弄脏、染出一大片水渍…
		ELSE
			PRINTFORMDW 温热的液体从被充分爱抚了的尿道口排出、房间里一下子充斥着一股刺激性的味道…
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:恋人
			PRINTFORMW 「…不好意思没听清楚、能再说一遍吗？」
			PRINTFORMDW 于是你再次向纳兹琳传达想要看着少女放尿的姿态。
			PRINTFORML 「…哈啊。该怎么说呢、人类的罪业可真是深重啊。」
			PRINTFORMW 「顺便问一下、这也可以解释为是你的一种爱情表现吗？」
			PRINTFORMDW 『当然如此』、听到这样的回答、纳兹琳再次深深叹了一口气
			PRINTFORMW 「…唉、毕竟不会弄疼我、让你看看就让你看看吧。…真的是、怎么就选了这样的人当自己的恋人呢…」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「…不好意思没听清楚、能再说一遍吗？」
			PRINTFORMDW 于是你再次向纳兹琳传达想要看着少女放尿的姿态。
			PRINTFORML 「…哈。当然我是能理解你的话语啦、你应该知道这么做的话会让我经历不如一死了之级别的羞耻的吧？」
			;/むしろそれが目的ですが？
			PRINTFORMDW 给予肯定的答复后、纳兹琳美目含泪地狠狠瞪了这里一眼…
			PRINTFORMW 「呜ー…等会你可给我记住了哦…」
		ELSE
			PRINTFORMW 「…不好意思没听清楚、能再说一遍吗？」
			PRINTFORMDW 于是你再次向纳兹琳传达想要看着少女放尿的姿态。
			PRINTFORMW 「…哈啊。没想到你会变态到那个地步啊…变态成这样反而让人觉得清爽了」
			PRINTFORMW 「可以哟、啊不过话是这么说、我现在可是超级、超——级想把你扔出去这个世界的呢…」
		ENDIF
		RETURN 1
	ENDIF
	;風呂場　というか、風呂場しか書けそうにない。そしてネタ切れ、恋慕と露出癖高い時の分岐誰か書いてー
	IF BATHROOM()
		;恋慕
		IF TALENT:恋慕
			IF RAND:3 == 0
				PRINTFORMW 「又、又来啊？呜ー…」
				PRINTFORMDW 纳兹琳面露苦涩的表情、但还是乖乖地面向排水口开始动作…
			ELSEIF RAND:2 == 0
				PRINTFORMW 「呜…咕…～～～！」
				PRINTFORMDW 纳兹琳的悲鸣声响起的同时、少女的尿道口开始有黄金色的液体飞溅而出、形成一道发源自少女下体中止于排水口的小瀑布…
			ELSE
				PRINTFORMW 「呜呜…这绝对是特别特别糟糕的兴趣的说…」
				PRINTFORMW 「果然还是要做…？嗯ー…　嗯、咕、～～～～」
			ENDIF
			RETURN 1
		;それ以外
		ELSE
			IF RAND:3 == 0
				PRINTFORMW 「又、又来啊？呜ー…」
				PRINTFORMDW 纳兹琳面露苦涩的表情、但还是乖乖地面向排水口开始动作…
			ELSEIF RAND:2 == 0
				PRINTFORMW 「呜…咕…～～～！」
				PRINTFORMDW 纳兹琳的悲鸣声响起的同时、少女的尿道口开始有黄金色的液体飞溅而出、形成一道发源自少女下体中止于排水口的小瀑布…
			ELSE
				PRINTFORMW 「呜呜…这绝对是特别特别糟糕的兴趣的说…」
				PRINTFORMW 「果然还是要做…？嗯ー…　嗯、咕、～～～～」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1

