						PRINTFORMW 「稍微习惯一点了…就…这样、慢慢地、花上足够的时间…做…」
					ENDIF
				;こんなの気持ちよくなるわけ無いだろ状態　しかし子宮口開発経験を増やせるのはこれくらいなのだ
				ELSEIF EXP:子宮口開発経験 < 25
				;DATAFORM %CALLNAME:TARGET%はぎゅっと目を閉じて異物感に耐えている…
				;DATAFORM %CALLNAME:TARGET%は子宮口をこじ開けられる感覚に顔を歪めている…
					;正常位から、または対面座位からでランダム分岐2つ追加
					IF RAND:5 == 0 && (PREVCOM == 60 || PREVCOM == 60)
						PRINTFORML 「哈呜…、哈、深处、不要那样咕噜咕噜地转啦…」
						PRINTFORMW 「真、真的不行的啦…」
						PRINTFORMDW 纳兹琳被你覆在身下，对不熟悉的刺激发出怨言…
					ELSEIF RAND:4 == 0 && (PREVCOM == 60 || PREVCOM == 60)
						PRINTFORML 「啊　啊呜、哈　顶、顶到不妙的地方来了…好难受…」
						PRINTFORMW 「咕、呜呜…就算你再怎么往里顶、也进不去的啦…」
					ELSEIF RAND:3 == 0
						PRINTFORML 「呜、呜咕　到最深处、呜呜…怎么可能、会舒服嘛…」
						PRINTFORMDW 每当\@ TALENT:PLAYER:2 & 2 ? 阴茎 # 假阳具 \@蹭到深处入口时、纳兹琳都会发出苦闷的声音…
					ELSEIF RAND:2 == 0
						PRINTFORMW 「呼、啊…啊啊…　啊、唏！？　进、进到奇怪的地方去了…」
						PRINTFORMW 「呜啊！？不、不要动啦、唏　不要顶深处啦……」
					ELSE
						PRINTFORMW 「呜呜…到最深处了……啊　啊呜、顶到好厉害的地方来了…」
						PRINTFORMW 「就…这样、慢慢地…啊、不要太用力顶啦……」
					ENDIF
					PRINTFORMDW 看来对于%TEXTR("子宫口/最深处/花芯")%的快乐还远远不够有经验呢…
				ENDIF
			ENDIF
		ENDIF
	[SKIPSTART]
	;連続
	ELSE
		DRAWLINE
		;正常位、対面立位
		IF TEQUIP:体位 == 1
			;MASTERについている
			IF TALENT:PLAYER:2 & 2
				PRINTFORMDW 品味着%CALLNAME:TARGET%膣内的触感、你再次动起腰突刺起来…
			ELSE
				PRINTFORMDW 保持着将肉枪插在%CALLNAME:TARGET%蜜壶的姿势、你再次动腰开始突刺…
			ENDIF
			PRINTFORMDL 
			CALL M_KOJO_MESSAGE_COM_K39_60_1
		;後背位、背面立位
		ELSEIF TEQUIP:体位 == 2
			;MASTERについている
			IF TALENT:PLAYER:2 & 2
				PRINTFORMDW 品味着%CALLNAME:TARGET%膣内的触感、你再次动起腰突刺起来…
			ELSE
				PRINTFORMDW 保持着将肉枪插在%CALLNAME:TARGET%蜜壶的姿势、你再次动腰开始突刺…
			ENDIF
			PRINTFORMDL 
			CALL M_KOJO_MESSAGE_COM_K39_61_1
		;騎乗位
		ELSEIF TEQUIP:体位 == 3
			PRINTFORMDW %CALLNAME:TARGET%下腹用力收紧腔室包裹住插着的肉棒、再次摆动起腰肢来…
			PRINTFORMDL 
			CALL M_KOJO_MESSAGE_COM_K39_65_1
		;対面座位
		ELSEIF TEQUIP:体位 == 4
			PRINTFORMDW %CALLNAME:TARGET%与%CALLNAME:PLAYER%激烈地接着吻、两条舌头相互缠绕交换着唾液的同时腰部也再次动作起来…
			PRINTFORMDL 
			CALL M_KOJO_MESSAGE_COM_K39_67_1
		;背面座位
		ELSE
			PRINTFORMDW 从背后抱住%CALLNAME:TARGET%、再次贪恋起%CALLNAME:TARGET%美妙的身体…
			PRINTFORMDL 
			CALL M_KOJO_MESSAGE_COM_K39_68_1
		ENDIF
	ENDIF
	[SKIPEND]
	RETURN 1
ENDIF
