@SPECIAL_MENU_89
#LOCALSIZE 1
#LOCALSSIZE 1
DISH_NAME = 塩辛納豆
RESULTS = 軽食
CALL 材料設定("汎用")
DISH_TASTE = 和食/豆/野菜/野趣/咸/濃厚/質素/怪诞/
DISH_COMMENT = 使用曲霉菌发酵大豆制成的料理。虽然名为纳豆，但不会拉丝。
RETURN 1

;IMAGE_I89_特殊服装(CHARA)-------------------------------------------------------------------
;角色特有の服装表示条件
;エフェクトを共有する服装差分はこちらで指定する
;使用時注意点:
;	RESULTSに特殊服装を格納すること
;	書式は %服装%%特殊服装% 適宜"_"等入れること
;-------------------------------------------------------------------------------------------
@IMAGE_I89_特殊服装(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
VARSET RESULTS
SELECTCASE CFLAG:89:差し替え適用
	CASE 2
		IF CHECK_NUDE(CHARA)
			IF GROUPMATCH(1, TEQUIP:CHARA:縄, TEQUIP:CHARA:拘束)
				RESULTS = _ミイラ
			ENDIF
		ELSE
			IF IS_BUNNY(CHARA)
				RESULTS = _バニーギャル
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[晚宴礼服套装]]
				RESULTS = _フォーマルドレス2
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[一套道士服]]
				RESULTS = _フォーマルドレス
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[女仆装]]
				RESULTS = _メイド
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[纯色连衣裙套装]]
				RESULTS = _私服
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
				RESULTS = _セーラー服
			ELSEIF CHECK_CLO("bra_visible", CHARA)
				RESULTS = _下着
			ENDIF
		ENDIF
	CASE 0
		IF CHECK_NUDE(CHARA)
		ELSE
		ENDIF
ENDSELECT

;IMAGE_I89_特殊表情COM(CHARA, 指令)-------------------------------------------------------
;直前の指令で変化する角色特有の表情表示条件
;時間停止中は変化しない表情はこちら
;使用時注意点:
;   RESULTS:0に表情を格納
;   RESULTS:1にマウスオーバー時の表情を格納すること
;   "自慰","愛撫","性交"は本編で実装済み
;-------------------------------------------------------------------------------------------
@IMAGE_I89_特殊表情COM(CHARA, 指令)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
#DIM 指令

SELECTCASE CFLAG:89:差し替え適用
	;替换用画像
	CASE 2
		IF CHECK_NUDE(CHARA)
			IF GROUPMATCH(1, TEQUIP:CHARA:縄, TEQUIP:CHARA:拘束)
			ENDIF
		ELSE
			IF IS_BUNNY(CHARA)
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[晚宴礼服套装]]
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[一套道士服]]
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[女仆装]]
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[纯色连衣裙套装]]
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
			ELSEIF CHECK_CLO("bra_visible", CHARA)
			ELSE
				SELECTCASE 指令
					CASE 305
						RESULTS = 膝枕覆盖
					CASE 6,12,313
						RESULTS = 揉胸覆盖
				ENDSELECT
			ENDIF
		ENDIF
	CASEELSE
		;通常画像
		IF FLAG:立絵種類
			;顔絵
		ELSE
			;立絵
		ENDIF
ENDSELECT
