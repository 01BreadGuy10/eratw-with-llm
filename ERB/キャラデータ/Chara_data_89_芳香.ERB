@CHARAMOVE_DATA_89(ARG, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = 89
SELECTCASE ARG
	;連動設定（RETURN=依存する角色, RESULT:1～3=対等に連動する角色）
	CASE 1
		RETURN [[青娥]]
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;命蓮寺メンバーの私室は入らない
			CASE P113納茲琳私室, P114村紗私室, P115星私室, P116一輪私室, P117鵺私室, P118白蓮私室, P109女苑私室, P136響子私室
				RETURN -100
			;神霊廟メンバーの私室は入らない
			CASE P125屠自古私室, P127布都私室, P128神子私室
				RETURN -100
			;墓地によく居る
			CASE P121墓地
				RETURN 5
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 地蔵小路, 倒垂的柳樹下, 墓地, 神霊廟広場
				RETURN 1
			CASE 再思之道, 無縁塚
				RETURN 1
		ENDSELECT
	;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
		;よく墓地に行く
		SIF CFLAG:LOCAL:今日の運勢 % 4 == 0 && INRANGE(TIME, 0, 360)
			TCVAR:LOCAL:引力点 = P121墓地
ENDSELECT

@EXIST_キャラデータ89
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ89(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "芳香")
;こっから衣装設定
CASE "今天的睡衣"
	CALLF MAKE_STR(V_NAME, "睡衣（裤子）套")

CASE "便装：帽子"
	CALLF MAKE_INT(V_NAME, [[頭装備_帽子]])
CASE "便装：飾品"
	CALLF MAKE_INT(V_NAME, [[飾品_御札]])
CASE "便装：靴"
	CALLF MAKE_INT(V_NAME, [[靴_鞋子]])
CASE "便装：裙子"
	CALLF MAKE_INT(V_NAME, [[裙子_裙子]])
CASE "便装：上身衣服１"
	CALLF MAKE_INT(V_NAME, [[上身衣服_はだけ不可_上衣]])

CASE "固有内衣形容詞"
	CALLF MAKE_STR(V_NAME, "类似青娥穿的")
CASE "固有下半身内衣名"
	CALLF MAKE_STR(V_NAME, "三层褶边短裤")
CASE "固有上半身内衣"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身内衣名"
	CALLF MAKE_STR(V_NAME, "褶边胸罩")
CASE "固有内衣着用条件"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(前)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(後)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣布料厚度"
	CALLF MAKE_INT(V_NAME, 2)


;料理関連
CASE "料理：喜欢的味道"
	CALLF MAKE_STR(V_NAME, "肉料理/中華/和食/油炸食品/ジャンキー/濃厚/冷/質素/野趣/黏稠/妖力/霊障/甜/甜/酸/酸/丰盛/丰盛/" + "怪诞/" * 3)
CASE "料理：讨厌的味道"
	CALLF MAKE_STR(V_NAME, "温暖/神力/" + "咸/简易/淡白/" * 2 + "健康/" * 3)
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "未知の味/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "黒/混沌/可怕的/奇妙/" + "死生/妖術/生体品/" * 3 + "死霊の/不滅の/" * 5)
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "秩序/知的/" + "光/神霊/書物/护符/機械/" * 3)
ENDSELECT

;-------------------------------------------------
