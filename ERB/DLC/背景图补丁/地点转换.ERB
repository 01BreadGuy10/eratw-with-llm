@BACKGROUND_SETTING
CALL RELINE(1,1)
$LOOP
CALL RELINE(1)
SELECTCASE 背景展示开关
	CASE 0
		LOCALS =  背景图片:禁用
	CASE 1
		LOCALS =  背景图片:启用
ENDSELECT
CALL PRINTBUTTON_EX(@"[%LOCALS%]", 11, !背景展示开关)

IF 背景展示开关
	PRINT ==
	SELECTCASE 高亮背景图开关
		CASE 1
			LOCALS =  高亮/有文字衬底
		CASE 0
			LOCALS =  低亮/无文字衬底
	ENDSELECT
	CALL PRINTBUTTON_EX(@"[背景图显示模式:%LOCALS%]", 13)
	PRINT ==
		SELECTCASE 高亮背景图开关
		CASE 1
			LOCALS:1 =  衬底透明度
		CASE 0
			LOCALS:1 =  图片明亮度
	ENDSELECT
	CALL PRINTBUTTON_EX(@"[%LOCALS:1%:{10 - 衬底透明度}]", 14)
ENDIF
PRINTL
CALL PRINTBUTTON_EX("[确定]", 15)
INPUT

IF RESULT == 11
	背景展示开关 = !背景展示开关
	IF !背景展示开关 
		CALL 背景图片打印()
	ELSE 
		CALL 背景展示
	ENDIF
	GOTO LOOP
ELSEIF RESULT == 13
	高亮背景图开关 = !高亮背景图开关
	CALL 背景展示
	GOTO LOOP
ELSEIF RESULT == 14
	IF 衬底透明度 < 10
		衬底透明度 ++
	ELSE
		衬底透明度 = 0
	ENDIF
	IF 背景展示开关 && 高亮背景图开关
		CALL 背景展示
		TEXT_BGC_ON GET_MAP_WEATHER_BGCOLOR(), LIMIT(衬底透明度 * 10 + 1, 1, 100)
	ELSE
		CALL 背景展示
	ENDIF
	GOTO LOOP
ELSEIF RESULT == 15
	RETURN
ENDIF

