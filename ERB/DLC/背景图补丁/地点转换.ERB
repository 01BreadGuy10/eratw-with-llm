@背景展示
#DIMS DYNAMIC 地点名
#DIM DYNAMIC 季节编号
#DIM DYNAMIC 时间编号
#DIMS DYNAMIC 背景名
#DIM DYNAMIC 无季节差分
#DIM DYNAMIC 无时间差分
#DIM DYNAMIC 特殊地点
#DIM DYNAMIC CHARA
地点暂存 = 0
差分类型暂存 = 0
IF IS_GAP_GUEST(MASTER)
	地点名 '= "隙间"
	无季节差分 ++
ELSEIF GROUPMATCH(CFLAG:MASTER:現在位置 % 100, 99, 98)
	SIF !CFLAG:MASTER:招待
		GOTO 非招待地点
	CHARA = CFLAG:MASTER:招待
	PRINTFORMW {CHARA}
	SIF !INRANGE(CHARA, 1, CHARANUM)
		GOTO 非招待地点
	SIF !EXISTCSV(CHARA)
		GOTO 非招待地点
	特殊地点 = CSVCFLAG(CHARA, GETNUM(CFLAG, "初期位置"))
	SIF GMF_AT_MAP(特殊地点) != 1
		GOTO 非招待地点
	TRYCALLFORM MAP_{GET_MAPID(特殊地点)}_INFO(特殊地点)
	地点名 '= 地点暂存
	无季节差分 = GETBIT(差分类型暂存, 0)
	无时间差分 = GETBIT(差分类型暂存, 1)
	$非招待地点
ELSE
	TRYCALLFORM MAP_{GET_MAPID(CFLAG:MASTER:現在位置)}_INFO(CFLAG:MASTER:現在位置)
	地点名 '= 地点暂存
	无季节差分 = GETBIT(差分类型暂存, 0)
	无时间差分 = GETBIT(差分类型暂存, 1)
ENDIF
IF !无季节差分
	季节编号 = DAY:季節
ELSE
	季节编号 = 0
ENDIF
IF !无时间差分
	时间编号 = TIME >= 360 && TIME < 1080 ? 0 # 1
ELSE
	时间编号 = 0
ENDIF
背景名 += @"%地点名%_{季节编号}_{时间编号}"
;PRINTFORMW 背景名 = %背景名% 地点名 = %地点名%
IF 地点名 != ""
	CALL 背景图片打印(背景名)
ELSE
	CALL 背景图片打印()
ENDIF

@背景检查
FOR LOCAL, 0, 1200
	地点暂存 = 
	SIF GMF_AT_MAP(LOCAL) != 1
		CONTINUE
	TRYCALLFORM MAP_{GET_MAPID(LOCAL)}_INFO(LOCAL)
	IF 地点暂存 == ""
		PRINTFORMW %NAME_FROM_PLACE2(LOCAL)%-{LOCAL}地点暂存为空
		LOCAL:1 ++
		CONTINUE
	ENDIF
	IF 差分类型暂存 == 0
		LOCALS '= @"%地点暂存%_4_1"
	ELSEIF 差分类型暂存 == 1
		LOCALS '= @"%地点暂存%_0_1"
	ELSE
		LOCALS '= @"%地点暂存%_0_0"
	ENDIF
	IF SPRITEWIDTH(LOCALS) == 0
		PRINTFORMW %LOCALS% 背景图片不存在
		LOCAL:1 ++
	ENDIF
NEXT
IF LOCAL:1 == 0
	PRINTFORMW 所有地点背景图片都存在
ENDIF