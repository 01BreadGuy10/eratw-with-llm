@SET_EVENT_CLOTHES(C_ID, SET_ID, L_SOURCE = 0)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC C_ID
#DIM DYNAMIC SET_ID
#DIM DYNAMIC L_SOURCE
;show a warning if a nonexisting clothing set is called
SIF INRANGE(SET_ID, 0, OBJ_ID_LAST) && !GET_EXIST("衣装セット", SET_ID)
	PRINTFORMDL ＊WARNING＊: Clothing set {SET_ID} does not exist. %CALLNAME:C_ID% will be nude.
;将当前事件衣装压栈，支持最多10层嵌套（如约会→游泳→宴会→…）
FOR LOCAL, 0, 10
	SIF EVENT_CLOTHING_SET_STACK:C_ID:LOCAL == 0
		BREAK
NEXT
IF LOCAL >= 10
	PRINTFORMDL ＊WARNING＊: 事件换装栈溢出，%CALLNAME:C_ID%的换装历史被丢弃
	LOCAL = 9
ENDIF
EVENT_CLOTHING_SET_STACK:C_ID:LOCAL = TCVAR:C_ID:EVENT_CLOTHING_SET
EVENT_CLOTHING_SET_SOURCE:C_ID:LOCAL = L_SOURCE
TCVAR:C_ID:EVENT_CLOTHING_SET = SET_ID
CALL CHANGE_CLOTHES(C_ID, "复原衣服")
CALL CLOTHES_SETTING_TRAIN(C_ID)

@RESET_EVENT_CLOTHES(C_ID, L_SOURCE = 0)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC C_ID
#DIM DYNAMIC L_SOURCE
#DIM DYNAMIC L_DEPTH
;弹出上一层事件衣装（如游泳结束后恢复约会浴衣）
;L_SOURCE=0时弹出栈顶一层（向后兼容）
;SOURCE非0时找到匹配SOURCE的栈条目并弹出至该层（如约会结束弹出所有嵌套事件）
L_DEPTH = -1
IF L_SOURCE
	;从栈顶向下搜索匹配SOURCE的条目
	FOR LOCAL, 9, -1, -1
		IF EVENT_CLOTHING_SET_SOURCE:C_ID:LOCAL == L_SOURCE && EVENT_CLOTHING_SET_STACK:C_ID:LOCAL != 0
			L_DEPTH = LOCAL
			BREAK
		ENDIF
	NEXT
ENDIF
IF L_DEPTH >= 0
	TCVAR:C_ID:EVENT_CLOTHING_SET = EVENT_CLOTHING_SET_STACK:C_ID:L_DEPTH
	;清除L_DEPTH及以上的所有栈条目（嵌套的子事件一并清理）
	FOR LOCAL, L_DEPTH, 10
		EVENT_CLOTHING_SET_STACK:C_ID:LOCAL = 0
		EVENT_CLOTHING_SET_SOURCE:C_ID:LOCAL = 0
	NEXT
ELSE
	;默认或SOURCE未命中：弹出栈顶一层
	FOR LOCAL, 9, -1, -1
		IF EVENT_CLOTHING_SET_STACK:C_ID:LOCAL != 0
			TCVAR:C_ID:EVENT_CLOTHING_SET = EVENT_CLOTHING_SET_STACK:C_ID:LOCAL
			EVENT_CLOTHING_SET_STACK:C_ID:LOCAL = 0
			EVENT_CLOTHING_SET_SOURCE:C_ID:LOCAL = 0
			BREAK
		ENDIF
	NEXT
ENDIF
CALL CHANGE_CLOTHES(C_ID, "复原衣服")
CALL CLOTHES_SETTING_TRAIN(C_ID)

@CLEAR_EVENT_CLOTHES(C_ID)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM C_ID
;清除所有事件换装栈，直接恢复到日常衣装（用于约会结束等场景）
TCVAR:C_ID:EVENT_CLOTHING_SET = 0
FOR LOCAL, 0, 10
	EVENT_CLOTHING_SET_STACK:C_ID:LOCAL = 0
	EVENT_CLOTHING_SET_SOURCE:C_ID:LOCAL = 0
NEXT
CALL CHANGE_CLOTHES(C_ID, "复原衣服")
CALL CLOTHES_SETTING_TRAIN(C_ID)
[SKIPSTART]
@SET_CURRENT_CLOTHES_VALUES(C_ID)
#DIM C_ID
#DIM SET_ID
#LOCALSIZE 2
#LOCALSSIZE 1
SET_ID = CURRENT_CLOTHES_SET(C_ID)

IF SET_ID > 套装范围
	LOCAL:1 = SET_ID - 套装范围
	FOR LOCAL, 1, 23
		CFLAG:C_ID:(200 + LOCAL) = GETMETH_INT(C_ID, "キャラデータ", LOCAL:1, @"便装：%EQUIPNAME:LOCAL%")
	NEXT
ELSE
	FOR LOCAL, 1, 23
		CFLAG:C_ID:(200 + LOCAL) = GETMETH_INT(C_ID, "衣装セット", SET_ID, EQUIPNAME:LOCAL)
	NEXT
ENDIF
[SKIPEND]
;为任何事件时点设计的换装行为
;行为同换装系统，无需关心换回衣服的时点  暂时只设计换上套装，因为只有套装才有立绘支持。
@EVENT_设置暂时变更套装(SET_ID,C_ID = -1)
#DIM DYNAMIC C_ID
#DIM DYNAMIC SET_ID
#LOCALSIZE 1
#LOCALSSIZE 1
SIF C_ID == -1
	C_ID = TARGET
IF STRLENS(GETMETH_STR(C_ID, "衣装セット", SET_ID, "名前"))
	FOR LOCAL, 1, 23
		EQUIP:C_ID:(LOCAL) = GETMETH_INT(C_ID, "衣装セット", SET_ID, EQUIPNAME:(LOCAL))
		CFLAG:C_ID:(600 + LOCAL) = EQUIP:C_ID:(LOCAL)
	NEXT
	CFLAG:C_ID:衣装一時変更 = 100
	CALL CLOTHES_SETTING_TRAIN(C_ID)
	RETURN 1
ENDIF
