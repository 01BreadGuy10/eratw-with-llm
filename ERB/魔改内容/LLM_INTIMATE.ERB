; ────────────────────────────────────────────────────────────────────────────
;  ★★ 对话界面的**计量表**：部位高潮值 + 觉醒值（2026-09-21）
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ 格式（拼进每轮的数值提示行）：
;      胸■■■□□□□□38 阴■□□□□□□□4 蒂□□□□□□□□0 臀□□□□□□□□0 口□□□□□□□□0 觉■■□□□□□□25
;     · ★★ **一直显示**（用户：「我想让这些计量表都一直显示 无论增加或减少」）✓
;     · 每项 = 名字 + 8 格进度条 + 绝对值 ✓
;     · 觉 = 觉醒值（0~100）✓   半醒时最前面加 `【半醒】` ✓
;  ⚠️ 上限：部位 600、觉醒 100（`TRACHECK_ORGASM.ERB:390-391`）✓
; ────────────────────────────────────────────────────────────────────────────
@LLM_INT_METERS(LLM_CID, REF_OUT)
#DIM  LLM_CID
#DIMS REF REF_OUT
#LOCALSIZE 4
REF_OUT = ""
SIF LLM_MODE != 1
	RETURN
; ★ 半醒标记
SIF LLM_HALFAWAKE
	REF_OUT += @"【半醒】"
; ── 五个部位（★ 一直显示，不判断是否非零）──
REF_OUT += @"胸%LLM_BARSTR(BASE:(LLM_CID):Ｂ絶頂余韻 * 100 / 600, 8)%{BASE:(LLM_CID):Ｂ絶頂余韻} "
REF_OUT += @"阴%LLM_BARSTR(BASE:(LLM_CID):Ｖ絶頂余韻 * 100 / 600, 8)%{BASE:(LLM_CID):Ｖ絶頂余韻} "
REF_OUT += @"蒂%LLM_BARSTR(BASE:(LLM_CID):Ｃ絶頂余韻 * 100 / 600, 8)%{BASE:(LLM_CID):Ｃ絶頂余韻} "
REF_OUT += @"臀%LLM_BARSTR(BASE:(LLM_CID):Ａ絶頂余韻 * 100 / 600, 8)%{BASE:(LLM_CID):Ａ絶頂余韻} "
REF_OUT += @"口%LLM_BARSTR(BASE:(LLM_CID):Ｍ絶頂余韻 * 100 / 600, 8)%{BASE:(LLM_CID):Ｍ絶頂余韻} "
; ── 觉醒值 ──
REF_OUT += @"觉%LLM_BARSTR(LLM_AWAKE:(LLM_CID):0, 8)%{LLM_AWAKE:(LLM_CID):0}"
RETURN
