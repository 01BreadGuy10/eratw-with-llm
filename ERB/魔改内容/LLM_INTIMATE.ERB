; ========================================================================
;  **关键词判断部位**（2026-10-08 用户决定）——
;  用户原话：「这不是我们的，是我在进入自由互动前和美铃接吻了，
;            只能说明我们的检测计量槽有用，但是我们自行写的增加部分没用」
;  ⚠️ 真因：模型（deepseek-v4.1-Flash）**从不输出 ###BODY###**
;     （项目注释早有记录：`LLM_CONVERSATION.ERB:4127`）
;  ⇒ 所以在 ERB 侧用**玩家输入的关键词**直接判部位，不依赖模型 ✓
;  ⚠️ 判据表（玩家输入里出现任意一个词就算碰了那里）：
;     B 胸   ⇒ 胸 奶 乳 乳头 乳房 揉胸 摸胸 搓揉 捏
;     V 阴道 ⇒ 下面 小穴 里面 插入 阴道 穴 花心 内壁 抽插
;     C 阴蒂 ⇒ 豆豆 阴蒂 蒂 花核
;     A 肛门 ⇒ 后面 屁股 菊花 肛门 后穴 臀
;     M 口   ⇒ 嘴 舌 亲 吻 舔 吸 口
;  ⚠️ 强度按**关键词命中数**给（1 个词 = 5，2 个以上 = 8）✓
; ========================================================================
@LLM_INT_GUESS_BODY(LLM_TEXT, REF_OUT)
#DIMS LLM_TEXT
#DIMS REF REF_OUT
#LOCALSIZE 4
#LOCALSSIZE 4
#DIM LLM_HIT
REF_OUT = ""
; ★★ **入口标记**（2026-10-08 诊断）—— 只要函数被调用就写下 ✓
LLM_GUESS_OUT = @"[入口]%LLM_TEXT%"
IF STRLENS(LLM_TEXT) <= 0
	RETURN
ENDIF

; ── 逐个部位查关键词 ──
; ⚠️ ERB 没有 OR 短路，只能一个个 STRFIND 然后加 ✓
LLM_HIT = 0
SIF STRFIND(LLM_TEXT, "胸") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "奶") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "乳") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "揉") >= 0
	LLM_HIT ++
IF LLM_HIT > 0
	IF LLM_HIT >= 2
		REF_OUT += @"B+8,"
	ELSE
		REF_OUT += @"B+5,"
	ENDIF
ENDIF

LLM_HIT = 0
SIF STRFIND(LLM_TEXT, "下面") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "小穴") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "里面") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "插入") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "穴") >= 0
	LLM_HIT ++
IF LLM_HIT > 0
	IF LLM_HIT >= 2
		REF_OUT += @"V+8,"
	ELSE
		REF_OUT += @"V+5,"
	ENDIF
ENDIF

LLM_HIT = 0
SIF STRFIND(LLM_TEXT, "豆豆") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "阴蒂") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "蒂") >= 0
	LLM_HIT ++
IF LLM_HIT > 0
	IF LLM_HIT >= 2
		REF_OUT += @"C+8,"
	ELSE
		REF_OUT += @"C+5,"
	ENDIF
ENDIF

LLM_HIT = 0
SIF STRFIND(LLM_TEXT, "后面") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "屁股") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "菊花") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "肛门") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "臀") >= 0
	LLM_HIT ++
IF LLM_HIT > 0
	IF LLM_HIT >= 2
		REF_OUT += @"A+8,"
	ELSE
		REF_OUT += @"A+5,"
	ENDIF
ENDIF

LLM_HIT = 0
SIF STRFIND(LLM_TEXT, "舌") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "吻") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "舔") >= 0
	LLM_HIT ++
SIF STRFIND(LLM_TEXT, "口") >= 0
	LLM_HIT ++
IF LLM_HIT > 0
	IF LLM_HIT >= 2
		REF_OUT += @"M+8,"
	ELSE
		REF_OUT += @"M+5,"
	ENDIF
ENDIF

; ── 去掉末尾多余的逗号 ──
SIF STRLENS(REF_OUT) > 0 && SUBSTRING(REF_OUT, STRLENS(REF_OUT) - 1, 1) == ","
	REF_OUT = %SUBSTRING(REF_OUT, 0, STRLENS(REF_OUT) - 1)%
; ⚠️ 补上分号后的觉醒增量（没碰就不醒）
SIF STRLENS(REF_OUT) > 0
	REF_OUT += @";0"
RETURN














; ========================================================================
;  **关键词判断「要脱哪件」**（2026-10-08 用户要求）——
;  用户原话：「我们的脱衣系统 应该接入自由互动里」
;  ⚠️ 原来靠 `###DELTA###` 的 `act=7` 触发，但模型从不输出那个标记 ⚠️
;  ⇒ 改成从**双方文本**里提取：出现「脱/褪/扒/扯掉」+ 服装名 ⇒ 就脱 ✓
;  ⚠️ 只返回**服装名**（交给 `@LLM_STRIP_PART` 去匹配槽位 + 把关分级）✓
; ========================================================================
@LLM_INT_GUESS_STRIP(LLM_CID, LLM_TEXT, REF_OUT)
#DIM  LLM_CID
#DIM  LLM_DBG_SLOT   ; ★ 匹配到的槽号（诊断用）
#DIMS LLM_TEXT
#DIMS REF REF_OUT
#LOCALSIZE 4
#LOCALSSIZE 4
#DIM  LLM_GOT
#DIM  LLM_SLOT
#DIMS LLM_CW
