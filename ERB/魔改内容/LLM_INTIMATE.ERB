; ========================================================================
;  **同步官方着装状态**（2026-10-08 用户要求）——
;  用户原话：「感觉穿着还是要注入官方的着装判定里 不然 llm 不知道自己是裸着的」
;  ⚠️ 官方读的是这些变量（`@CHECK_NUDE` 就看 `着衣状況`）：
;     · `上半身着衣状況` = 0 全裸 / 1 穿着 / 2 只穿内衣
;     · `上衣脱衣完毕`   = 1 表示上衣已脱光
;     · `上半身裸露状態` = 1 表示裸露
;  ⇒ 我们改完 `EQUIP` 之后**立刻**按它现算一遍 ✓
; ========================================================================
@LLM_INT_SYNC_CLOTHES(LLM_CID)
#DIM  LLM_CID
#LOCALSIZE 4
#LOCALSSIZE 4
#DIM  LLM_SLOT
#DIM  LLM_FLAG
#DIM CONST LLM_TOP, 7 = 18, 17, 16, 10, 9, 13, 14    ; ★ 上身外衣（同 @LLM_STRIP_PART）
#DIM CONST LLM_BOT, 5 = 15, 12, 11, 13, 14          ; ★ 下身外衣（★ 不含 19~21：那是装饰件）
#DIM CONST LLM_INNER, 4 = 8, 7, 6, 5       ; ★ 内衣（胸罩×2 / 内裤×2）

; ── ① 上半身：有外衣吗？ ──
LLM_FLAG = 0
FOR LOCAL, 0, 7
	LLM_SLOT = LLM_TOP:LOCAL
	SIF EQUIP:(LLM_CID):LLM_SLOT
		LLM_FLAG = 1
NEXT
IF LLM_FLAG
	; 有外衣 ⇒ 正常穿着
	TEQUIP:(LLM_CID):上半身着衣状況 = 1
	TEQUIP:(LLM_CID):上衣脱衣完毕 = 0
	TEQUIP:(LLM_CID):上半身裸露状態 = 0
ELSE
	; 外衣全空 ⇒ 看还有没有内衣
	LLM_FLAG = 0
	FOR LOCAL, 0, 4
		LLM_SLOT = LLM_INNER:LOCAL
		SIF EQUIP:(LLM_CID):LLM_SLOT
			LLM_FLAG = 1
	NEXT
	IF LLM_FLAG
		; 只剩内衣 ⇒ 官方值 2
		TEQUIP:(LLM_CID):上半身着衣状況 = 2
		TEQUIP:(LLM_CID):上衣脱衣完毕 = 1
		TEQUIP:(LLM_CID):上半身裸露状態 = 1
	ELSE
		; 全脱光 ⇒ 0
		TEQUIP:(LLM_CID):上半身着衣状況 = 0
		TEQUIP:(LLM_CID):上衣脱衣完毕 = 1
		TEQUIP:(LLM_CID):上半身裸露状態 = 1
	ENDIF
ENDIF

; ── ② 下半身：同样处理 ──
LLM_FLAG = 0
FOR LOCAL, 0, 5
	LLM_SLOT = LLM_BOT:LOCAL
	SIF EQUIP:(LLM_CID):LLM_SLOT
		LLM_FLAG = 1
NEXT
IF LLM_FLAG
	TEQUIP:(LLM_CID):下半身着衣状況 = 1
ELSE
	LLM_FLAG = 0
	SIF EQUIP:(LLM_CID):6 || EQUIP:(LLM_CID):5
		LLM_FLAG = 1
	IF LLM_FLAG
		TEQUIP:(LLM_CID):下半身着衣状況 = 2
	ELSE
		TEQUIP:(LLM_CID):下半身着衣状況 = 0
	ENDIF
ENDIF
RETURN


; ========================================================================
;  ★★★ **安全取衣装名**（2026-10-09 真事故）——
;   用户报错：「错误内容:不明な部位 ／ 函数: @LLM_SELFTEST」
;   ⚠️⚠️ **真因**：官方 `@CLOTHNAME` 内部会 `THROW 不明な部位%ARGS%`
;      （`ERB/衣服/CLOTHES.ERB:364`）——
;      它的 `SELECTCASE` 里**没有「下身衣服」（槽 12）** ⇒
;      对槽 12 调用会**直接抛异常、整段脚本中断** ⚠️
;      （我原来的诊断从槽 0 开始 ⇒ 槽 0 也不在列表 ⇒ 当场炸）
;   ⇒ 统一走这个包装：**取不到就返回空串**，绝不让游戏崩 ✓
;   ⚠️ `TRY` **不能跨 `FOR`**（会报 `Extra closing tag 'NEXT'`，实测）——
;      所以必须**包在函数里**，调用方照常写在循环里 ✓
;   ⚠️ 支持的槽（`CLOTHES.ERB:345~362`）：
;      1 飾品／2 帽子／3 靴／4 襪子／5,6 下半身内衣／7,8 上半身内衣／
;      9 レオタード／10 ボディースーツ／11 裤子／13 連衣裙／14 和服／
;      15 裙子／16,17 上身衣服／18 外搭／19~21 其他／22 腕部装束
;      ✗ **不支持 12（下身衣服）** ⚠️
; ========================================================================
@LLM_SAFE_CLOTH(LLM_SLOT, LLM_CID, REF_OUT)
#DIM  LLM_SLOT
#DIM  LLM_CID
#DIMS REF REF_OUT
#LOCALSIZE 1

REF_OUT = ""
; ⚠️ 槽 0 之类根本取不到名字 ⇒ 直接空串
SIF LLM_SLOT <= 0
	RETURN
SIF !EXISTFUNCTION(@"CLOTHNAME")
	RETURN
; ⚠️⚠️ **本版 Emuera 不认识裸 `TRY`**（2026-10-09 实测）——
;   报错：「第1727行:无法解析的行 TRY」+「缺少对应的TRYG系统命令」
;   官方只用了 `TRYCCALLFORM` / `TRYCALLFORM`（那两个能跑）⚠️
;   ⇒ **不能用 try/catch 兜底** ⇒ 改成**白名单放行** ✓
; ⚠️ 槽 12（下身衣服）调 `CLOTHNAME` 会 `THROW 不明な部位`
;    （`CLOTHES.ERB:364` 的 `SELECTCASE` 里没有它）⇒ **直接跳过、返回空串** ✓
;    ⇒ 代价：槽 12 的衣物**取不到名字**（但它本来就没在官方分类里）✓
SIF LLM_SLOT == 12
	RETURN
; ⚠️ 槽号越界（0 / 23+）同样会让 `EQUIPNAME:` 取空 ⇒ 跳过 ✓
SIF LLM_SLOT < 1 || LLM_SLOT > 22
	RETURN
REF_OUT = %CLOTHNAME(LLM_SLOT, EQUIP:(LLM_CID):LLM_SLOT, LLM_CID)%
RETURN





