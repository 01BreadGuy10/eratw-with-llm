		LLM_TMP += @"**后面**（快到了、又涨又麻）"
	ELSEIF CUP:(LLM_CID):快Ａ + PALAM:(LLM_CID):快Ａ >= PALAMLV:3
		LLM_TMP += @"**后面**（很敏感、有种奇怪的感觉）"
	ELSEIF CUP:(LLM_CID):快Ａ + PALAM:(LLM_CID):快Ａ >= PALAMLV:2
		LLM_TMP += @"**后面**（有感觉了）"
	ELSEIF CUP:(LLM_CID):快Ａ + PALAM:(LLM_CID):快Ａ >= PALAMLV:1
		LLM_TMP += @"**后面**（刚被碰到）"
	ENDIF
	SIF LLM_TMP != ""
		LLM_TMP += @"；"
