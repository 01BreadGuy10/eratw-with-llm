#DIM CONST LLM_BOT, 5 = 15, 12, 11, 13, 14          ; ★ 下身外衣（★ 不含 19~21：那是装饰件）
#DIM CONST LLM_INNER, 4 = 8, 7, 6, 5       ; ★ 内衣（胸罩×2 / 内裤×2）
#DIM CONST LLM_ALL, 22 = 18, 2, 1, 22, 13, 14, 9, 10, 17, 16, 15, 12, 11, 3, 4, 19, 20, 21, 8, 7, 6, 5  ; ★ 全部可脱

REF_OUT = ""
IF STRLENS(LLM_TEXT) <= 0
	RETURN
ENDIF
	; ⚠️ 必须有「脱」这个动作 —— 否则她随口提一句衣服就会脱 ✓
	; ★★★ **先排除合成词**（2026-10-08 用户提出防误判）——
	;   ⚠️ 「脱力 / 摆脱 / 脱落 / 超脱 / 脱线」不是脱衣服 ⚠️
	SIF STRFIND(LLM_TEXT, "脱力") >= 0
		RETURN
	SIF STRFIND(LLM_TEXT, "摆脱") >= 0
		RETURN
	SIF STRFIND(LLM_TEXT, "脱落") >= 0
		RETURN
	SIF STRFIND(LLM_TEXT, "超脱") >= 0
		RETURN
	SIF STRFIND(LLM_TEXT, "脱线") >= 0
		RETURN
	; ★★★ **再排除否定句**（2026-10-08 用户提出防误判）——
	;   ⚠️「别脱」「不要脱」「先别脱」⇒ 那是**拒绝** ⇒ 不该脱 ⚠️
	SIF STRFIND(LLM_TEXT, "别脱") >= 0
		RETURN
	SIF STRFIND(LLM_TEXT, "不要脱") >= 0
		RETURN
	SIF STRFIND(LLM_TEXT, "不用脱") >= 0
		RETURN
	SIF STRFIND(LLM_TEXT, "不能脱") >= 0
		RETURN
	SIF STRFIND(LLM_TEXT, "不许脱") >= 0
		RETURN
	SIF STRFIND(LLM_TEXT, "先别") >= 0 && STRFIND(LLM_TEXT, "脱") >= 0
		RETURN
	; ★ **最后确认有「脱」这个动作** ✓
	LLM_GOT = 0
	SIF STRFIND(LLM_TEXT, "脱") >= 0
		LLM_GOT = 1
	SIF STRFIND(LLM_TEXT, "褪") >= 0
		LLM_GOT = 1
	SIF STRFIND(LLM_TEXT, "扒") >= 0
		LLM_GOT = 1
	SIF STRFIND(LLM_TEXT, "扯掉") >= 0
		LLM_GOT = 1
	SIF STRFIND(LLM_TEXT, "解开") >= 0
		LLM_GOT = 1
	SIF LLM_GOT == 0
	RETURN

; ★★★ **和她当前衣着匹配**（2026-10-08 用户要求）——
;   用户原话：「关键词表能不能不是写死的 而是和角色当前的衣着匹配」
;   ⇒ 遍历她身上**所有可脱的槽**，用官方 `@CLOTHNAME` 取名字，
;      看哪个名字出现在文本里 ⇒ 就是那件 ✓
SIF !EXISTFUNCTION(@"CLOTHNAME")
	RETURN
FOR LOCAL, 0, 22
	; ⚠️ 槽号表：LLM_ALL（含鞋袜/配饰/外衣/全身装）✓
	LLM_SLOT = LLM_ALL:LOCAL
	SIF !EQUIP:(LLM_CID):LLM_SLOT
		CONTINUE
	CALL LLM_SAFE_CLOTH(LLM_SLOT, LLM_CID, LLM_CW)
			; ⚠️ `CLOTHNAME` 有时返回 `@"xxx"`（带引号）⇒ 只在**确以 @ 开头**时才剥壳 ✓
			SIF STRLENS(LLM_CW) >= 3 && STRFIND(SUBSTRING(LLM_CW, 0, 2), "@") >= 0
			LLM_CW = %SUBSTRING(LLM_CW, 2, STRLENS(LLM_CW) - 3)%
	SIF STRLENS(LLM_CW) < 3
		CONTINUE
	; ★ 双向包含：文本里有衣服名，或衣服名里有文本片段 ✓
	IF STRFIND(LLM_TEXT, LLM_CW) >= 0
		REF_OUT = %LLM_CW%
		; ★ 诊断：记录匹配到的槽号（2026-10-08）✓
		LLM_DBG_SLOT = LLM_SLOT
		RETURN
	ENDIF
	SIF STRFIND(LLM_TEXT, LLM_CW) >= 0
		RETURN
NEXT

; ── ② 退一步：按**槽位名**匹配（她这件可能叫得很特别）──
;   ⚠️ 用 LLM_TOP / LLM_BOT / LLM_INNER 的槽号 + 玩家的笼统说法 ✓
IF STRFIND(LLM_TEXT, "上衣") >= 0 || STRFIND(LLM_TEXT, "外衣") >= 0 || STRFIND(LLM_TEXT, "衣服") >= 0
	FOR LOCAL, 0, 7
		LLM_SLOT = LLM_TOP:LOCAL
		SIF EQUIP:(LLM_CID):LLM_SLOT
			CALL LLM_SAFE_CLOTH(LLM_SLOT, LLM_CID, REF_OUT)
		SIF EQUIP:(LLM_CID):LLM_SLOT
			RETURN
	NEXT
ENDIF
IF STRFIND(LLM_TEXT, "下衣") >= 0 || STRFIND(LLM_TEXT, "下身") >= 0 || STRFIND(LLM_TEXT, "裤子") >= 0
	FOR LOCAL, 0, 5
		LLM_SLOT = LLM_BOT:LOCAL
		SIF EQUIP:(LLM_CID):LLM_SLOT
			CALL LLM_SAFE_CLOTH(LLM_SLOT, LLM_CID, REF_OUT)
		SIF EQUIP:(LLM_CID):LLM_SLOT
			RETURN
	NEXT
ENDIF
IF STRFIND(LLM_TEXT, "内衣") >= 0 || STRFIND(LLM_TEXT, "胸罩") >= 0 || STRFIND(LLM_TEXT, "内裤") >= 0
	FOR LOCAL, 0, 4
		LLM_SLOT = LLM_INNER:LOCAL
		SIF EQUIP:(LLM_CID):LLM_SLOT
			CALL LLM_SAFE_CLOTH(LLM_SLOT, LLM_CID, REF_OUT)
		SIF EQUIP:(LLM_CID):LLM_SLOT
			RETURN
	NEXT
ENDIF

; ── ③ 再退一步：**没指定哪件 ⇒ 脱最外面那件**（按 LLM_TOP 的顺序）──
FOR LOCAL, 0, 7
	LLM_SLOT = LLM_TOP:LOCAL
	SIF !EQUIP:(LLM_CID):LLM_SLOT
		CONTINUE
	CALL LLM_SAFE_CLOTH(LLM_SLOT, LLM_CID, REF_OUT)
	RETURN
NEXT
FOR LOCAL, 0, 5
	LLM_SLOT = LLM_BOT:LOCAL
	SIF !EQUIP:(LLM_CID):LLM_SLOT
		CONTINUE
	CALL LLM_SAFE_CLOTH(LLM_SLOT, LLM_CID, REF_OUT)
	RETURN
NEXT
; 全裸 ⇒ 空 ✓
RETURN

