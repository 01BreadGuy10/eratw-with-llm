@LLM_INT_PARSE_BODY(REF_TEXT, REF_OUT)
#DIMS REF REF_TEXT
#DIMS REF REF_OUT
#LOCALSIZE 2
#LOCALSSIZE 4
#DIMS LLM_TAG
REF_OUT = ""
LLM_TAG = "###BODY###"
LOCAL = STRFIND(REF_TEXT, LLM_TAG)
SIF LOCAL < 0
	RETURN
LOCAL:1 = LOCAL + STRLENS(LLM_TAG)
REF_OUT = %SUBSTRING(REF_TEXT, LOCAL:1)%
	; ★★ **遇到下一个 ### 也截断**（2026-10-08）——
	;   ⚠️ 实测模型会把 `###DELTA### ... ###BODY###B+4;5` 写在**同一行** ⚠️
	;   ⇒ 只按换行截断的话，会把后面的东西一起吞进来 ✓
LOCAL = STRFIND(REF_OUT, "\n")
IF LOCAL >= 0
	REF_OUT = %SUBSTRING(REF_OUT, 0, LOCAL)%
ENDIF
	REF_OUT = %SUBSTRING(REF_OUT, 0, LOCAL)%
	LOCAL = STRFIND(REF_OUT, "###")
	IF LOCAL >= 0
		REF_OUT = %SUBSTRING(REF_OUT, 0, LOCAL)%
	ENDIF
		REF_OUT = %SUBSTRING(REF_OUT, 0, LOCAL)%
REF_OUT '= TRIM_STRING(REF_OUT)
RETURN


; ── 通用：从 "B+8,C-2" 里取某个字母的增量（返回值）──
@LLM_INT_GETVAL(LLM_S, LLM_CH)
#DIMS LLM_S
#DIMS LLM_CH
#LOCALSIZE 4
#LOCALSSIZE 2
#DIMS LLM_NUM
LOCAL = STRFIND(LLM_S, LLM_CH)
SIF LOCAL < 0
	RETURN 0
LOCAL:1 = LOCAL + 1
LOCAL:2 = STRFIND(SUBSTRING(LLM_S, LOCAL:1, STRLENS(LLM_S) - LOCAL:1), ",")
IF LOCAL:2 < 0
	LOCAL:3 = STRLENS(LLM_S) - LOCAL:1
ELSE
	LOCAL:3 = LOCAL:2
ENDIF
LLM_NUM = %SUBSTRING(LLM_S, LOCAL:1, LOCAL:3)%
; ★★ **去掉开头的 `+`**（2026-09-21 修）——
;   ⚠️ 模型输出的是 `B+8` ⇒ 子串是 `+8` ⇒
;      Emuera 的 `TOINT("+8")` **不认前导加号** ⇒ 返回 0 ⚠️
;   ⇒ 这就是「标记收到了、值却全是 0」的真因 ✓
SIF STRFIND(LLM_NUM, "+") == 0
	LLM_NUM = %SUBSTRING(LLM_NUM, 1)%
RETURN TOINT(LLM_NUM)
@LLM_INT_APPLY_BODY(LLM_CID, LLM_TAG)
#DIM  LLM_STEP     ; ★ 快感系数：20=穿衣/全裸 13=内衣（2026-10-08）
#DIM  LLM_BASE     ; ★ 快感基数：500=穿衣 / 1000=全裸（2026-10-08）
#DIM  LLM_CID
#DIMS LLM_TAG
#LOCALSIZE 8
#LOCALSSIZE 4
#DIM  LLM_V
#DIMS LLM_BP
#DIMS LLM_AK
SIF LLM_TAG == ""
	RETURN
LOCAL = STRFIND(LLM_TAG, ";")
IF LOCAL < 0
	LLM_BP = %LLM_TAG%
	LLM_AK = "0"
ELSE
	LLM_BP = %SUBSTRING(LLM_TAG, 0, LOCAL)%
	LLM_AK = %SUBSTRING(LLM_TAG, LOCAL + 1)%
ENDIF
	LLM_DBG_BP = %LLM_BP%
	; ★★ **快感值分档**（2026-10-08 用户要求）——
	;   用户原话：「穿衣服状态下涨 500-800，全裸状态下接触部位涨 1000-1300」
	;   ⚠️ 官方判"脱光"：`上半身着衣状況 == 0 && 下半身着衣状況 == 0`
	;      （`Chara_data_9_夢美.ERB:582`）✓
	;   ⚠️ 换算（LLM_V 是 0~15）：穿衣 `500 + V*20`／全裸 `1000 + V*20` ✓
	; ★★ **快感值三档**（2026-10-08 用户要求）——
	;   · 穿外衣   ⇒ 500~800
	;   · 穿内衣   ⇒ 800~1000   ← ★ 新增
	;   · 全裸     ⇒ 1000~1300
	;   ⚠️ 官方判据（`Chara_data_9_夢美.ERB:582` / `Add_CUSTOM_COM12`）：
	;     · 外衣：`上半身着衣状況 == 0 && 下半身着衣状況 == 0` ⇒ 外衣脱了
	;     · 内衣：`EQUIP:上半身内衣１/２` 或 `EQUIP:下半身内衣１/２` 非零 ⇒ 还穿着
	; ⚠️ 系数：穿衣/全裸 20（0~15 ⇒ 0~300）；内衣 13（⇒ 0~195，上限压在 1000 内）✓
	LLM_STEP = 20
	LLM_BASE = 500
	IF TEQUIP:(LLM_CID):上半身着衣状況 == 0 && TEQUIP:(LLM_CID):下半身着衣状況 == 0
		; ★ 外衣脱了 ⇒ 至少是内衣档
		LLM_BASE = 800
		; ⚠️ 内衣档系数小一点，上限压在 1000 内 ✓
		LLM_STEP = 13
		; ★ 连内衣都没有 ⇒ 全裸
		IF !(EQUIP:(LLM_CID):上半身内衣１ || EQUIP:(LLM_CID):上半身内衣２) && !(EQUIP:(LLM_CID):下半身内衣１ || EQUIP:(LLM_CID):下半身内衣２)
			LLM_BASE = 1000
		ENDIF
	ENDIF
; ★ 五个部位逐个处理（ERB 不能动态取 BASE 编号 ⇒ 只能展开）✓
	; ★★★ **变量修正**（2026-10-08，用户提示）——
	;   ⚠️ 原来用 `BASE:X絶頂余韻`（**绝顶余韵**：高潮后消退的值）⇒ 用错了 ⚠️
	;   ✅ 正确变量是 `PALAM:快X`（**实时快感值**，见 `CSV\Palam.csv`）——
	;      0,快Ｃ 1,快Ｖ 2,快Ａ 3,快Ｂ 4,快Ｍ ✓
	;   ⚠️ 官方高潮判定：`EX:X絶頂*10000 + PALAM:快X + PALAM:欲情 >= 10000`
	;      （`_TR Lib.ERB:532`）⇒ 所以 `PALAMLV:4 = 10000` 就是"到高潮" ✓
	;   ⚠️ 换算：LLM 给 0~15 ⇒ `* 100` ⇒ 0~1500（约 15% 进度）✓
	; ★★ **部位熟练度也跟着涨**（2026-10-08 用户要求）——
	;   用户原话：「能让互动时的各种动作增加对应部位的经验和快感积累吗」
	;   ⚠️ 映射（CSV\Abl.csv：50,指 51,舌 52,胸 53,腰 54,膣 55,肛門 56,足）：
	;     B(胸) ⇒ 胸 ／ V(阴道) ⇒ 膣 ／ C(阴蒂) ⇒ 膣（归入）／ A(肛门) ⇒ 肛門 ／ M(口) ⇒ 舌 ✓
	;   ⚠️ 换算 `快感 / 5`（15 ⇒ +3），至少 1 ⇒ 涨得慢但不至于没有 ✓
CALL LLM_INT_GETVAL(LLM_BP, "B")
LLM_V = RESULT
IF LLM_V != 0
	; ★★ **官方路线：加到 CUP（本轮快感）**（2026-10-08 用户指出）——
	CUP:(LLM_CID):快Ｂ += LLM_BASE + LLM_V * LLM_STEP
ENDIF
CALL LLM_INT_GETVAL(LLM_BP, "V")
LLM_V = RESULT
IF LLM_V != 0
	; ★★ **官方路线：加到 CUP（本轮快感）**（2026-10-08 用户指出）——
	CUP:(LLM_CID):快Ｖ += LLM_BASE + LLM_V * LLM_STEP
ENDIF
CALL LLM_INT_GETVAL(LLM_BP, "C")
LLM_V = RESULT
IF LLM_V != 0
	; ★★ **官方路线：加到 CUP（本轮快感）**（2026-10-08 用户指出）——
	CUP:(LLM_CID):快Ｃ += LLM_BASE + LLM_V * LLM_STEP
	LLM_DBG_V = LLM_V
ENDIF
CALL LLM_INT_GETVAL(LLM_BP, "A")
LLM_V = RESULT
IF LLM_V != 0
	; ★★ **官方路线：加到 CUP（本轮快感）**（2026-10-08 用户指出）——
	CUP:(LLM_CID):快Ａ += LLM_BASE + LLM_V * LLM_STEP
ENDIF
CALL LLM_INT_GETVAL(LLM_BP, "M")
LLM_V = RESULT
IF LLM_V != 0
	; ★★ **官方路线：加到 CUP（本轮快感）**（2026-10-08 用户指出）——
	CUP:(LLM_CID):快Ｍ += LLM_BASE + LLM_V * LLM_STEP
ENDIF
	CALL LLM_INT_GETVAL(LLM_BP, "B")
	SIF RESULT > 0
		ABL:(LLM_CID):胸 = MIN(ABL:(LLM_CID):胸 + MAX(RESULT / 5, 1), 20)
	CALL LLM_INT_GETVAL(LLM_BP, "V")
	SIF RESULT > 0
		ABL:(LLM_CID):膣 = MIN(ABL:(LLM_CID):膣 + MAX(RESULT / 5, 1), 20)
	CALL LLM_INT_GETVAL(LLM_BP, "C")
	SIF RESULT > 0
		ABL:(LLM_CID):膣 = MIN(ABL:(LLM_CID):膣 + MAX(RESULT / 5, 1), 20)
	CALL LLM_INT_GETVAL(LLM_BP, "A")
	SIF RESULT > 0
		ABL:(LLM_CID):肛門 = MIN(ABL:(LLM_CID):肛門 + MAX(RESULT / 5, 1), 20)
	CALL LLM_INT_GETVAL(LLM_BP, "M")
	SIF RESULT > 0
		ABL:(LLM_CID):舌 = MIN(ABL:(LLM_CID):舌 + MAX(RESULT / 5, 1), 20)

; ★ 觉醒值（半醒后每回合更容易醒 ⇒ 加 LLM_AWAKE_BOOST）✓
; ⚠️⚠️ **必须也去掉前导 `+`**（2026-09-27 用 `tool/body_parse_test.py` 验出来的真 bug）——
;   部位那边（`@LLM_INT_GETVAL`）早就做了这个兼容，但**觉醒增量这边漏了**：
;   模型写 `###BODY###B+8;+5` 时，`TOINT("+5")` 在 Emuera 里**不认前导加号** ⇒ 得 0 ⚠️
;   ⇒ 后果：**觉醒值永远涨不上去 ⇒ 她永远不会惊醒/转半醒**，而这**完全看不出来**
;     （部位值照常生效、计量表照常动）—— 正是本项目最怕的"静默失效" ⚠️
;   ⚠️ 提示词里的示例写的是 `;A+5` 这种**不带 +** 的形式，所以模型写不写 `+` 全看它心情 ✓
SIF STRFIND(LLM_AK, "+") == 0
	LLM_AK = %SUBSTRING(LLM_AK, 1)%
LLM_V = TOINT(LLM_AK)
SIF LLM_V < 0
	LLM_V = 0
LLM_V += LLM_AWAKE_BOOST
LLM_AWAKE:(LLM_CID):0 = LIMIT(LLM_AWAKE:(LLM_CID):0 + LLM_V, 0, 100)
	; ★★★ **手动汇总 CUP → PALAM**（2026-10-08 用户报告）——
	;   用户原话：「快感数值并没有和官方的计量槽联动，官方的计量槽还是不涨的」
	;   ⚠️ 官方是**回合末**才汇总（`SOURCE.ERB:1097~1102`）——
	;      而**自由互动不走官方回合** ⇒ CUP 一直留着、PALAM 不涨 ⚠️
	;   ⚠️ 官方 UI 读的是 **PALAM** ⇒ 所以玩家看不到 ✓
	;   ⇒ 这里**立刻**跑一遍官方汇总，公式完全照抄：
	;      `PALAM += CUP - CDOWN` / `CUP = 0` / `CDOWN = 0` ✓
	PALAM:(LLM_CID):快Ｃ += CUP:(LLM_CID):快Ｃ - CDOWN:(LLM_CID):0
	CUP:(LLM_CID):快Ｃ = 0
	CDOWN:(LLM_CID):0 = 0
	PALAM:(LLM_CID):快Ｖ += CUP:(LLM_CID):快Ｖ - CDOWN:(LLM_CID):1
	CUP:(LLM_CID):快Ｖ = 0
	CDOWN:(LLM_CID):1 = 0
	PALAM:(LLM_CID):快Ａ += CUP:(LLM_CID):快Ａ - CDOWN:(LLM_CID):2
	CUP:(LLM_CID):快Ａ = 0
	CDOWN:(LLM_CID):2 = 0
	PALAM:(LLM_CID):快Ｂ += CUP:(LLM_CID):快Ｂ - CDOWN:(LLM_CID):3
	CUP:(LLM_CID):快Ｂ = 0
	CDOWN:(LLM_CID):3 = 0
	PALAM:(LLM_CID):快Ｍ += CUP:(LLM_CID):快Ｍ - CDOWN:(LLM_CID):4
	CUP:(LLM_CID):快Ｍ = 0
	CDOWN:(LLM_CID):4 = 0
RETURN


; ── 觉醒满了 ⇒ 骰「是否惊醒」──
;    返回：1 = 惊醒了 / 0 = 没醒（转半醒）
@LLM_INT_WAKE_CHECK(LLM_CID)
#DIM LLM_CID
#LOCALSIZE 4
#DIM LLM_RATE
SIF LLM_AWAKE:(LLM_CID):0 < 100
	RETURN 0
; ★ 基础 60%，好感/信赖越高越不容易醒（用户设计）——
;   好感 2400 ⇒ -60；信赖 700 ⇒ -35 ⇒ 很亲近的人几乎不会醒 ✓
LLM_RATE = 60
LLM_RATE -= CFLAG:(LLM_CID):好感度 / 40
LLM_RATE -= CFLAG:(LLM_CID):信赖度 / 20
; ★ 半醒状态下更容易醒（用户：「每回合做出的行动更容易提高觉醒率」）✓
SIF LLM_HALFAWAKE
	LLM_RATE += 25
LLM_RATE = LIMIT(LLM_RATE, 5, 95)
; 觉醒值归零（不管醒没醒都要重来）
LLM_AWAKE:(LLM_CID):0 = 0
SIF RAND:100 < LLM_RATE
	RETURN 1
; 没醒 ⇒ 进入半醒 + 以后更容易醒 ✓
LLM_HALFAWAKE = 1
LLM_AWAKE_BOOST += 3
RETURN 0


; ── 退出互动时复位 ──
@LLM_INT_RESET
LLM_HALFAWAKE = 0
LLM_AWAKE_BOOST = 0
RETURN

; ────────────────────────────────────────────────────────────────────────────
;  ★★ 半醒时的「幻想对象」文本（2026-09-20 用户设计）
; ────────────────────────────────────────────────────────────────────────────
