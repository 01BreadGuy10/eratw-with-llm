		LLM_TMP += @"**豆豆**（快到了、碰都碰不得）"
	ELSEIF CUP:(LLM_CID):快Ｃ + PALAM:(LLM_CID):快Ｃ >= PALAMLV:3
		LLM_TMP += @"**豆豆**（很敏感、一碰就腿软）"
