@LLM_INT_PARSE_BODY(REF_TEXT, REF_OUT)
#DIMS REF REF_TEXT
#DIMS REF REF_OUT
#LOCALSIZE 2
#LOCALSSIZE 4
#DIMS LLM_TAG
REF_OUT = ""
LLM_TAG = "###BODY###"
LOCAL = STRFIND(REF_TEXT, LLM_TAG)
SIF LOCAL < 0
	RETURN
LOCAL:1 = LOCAL + STRLENS(LLM_TAG)
REF_OUT = %SUBSTRING(REF_TEXT, LOCAL:1)%
LOCAL = STRFIND(REF_OUT, "\n")
SIF LOCAL >= 0
	REF_OUT = %SUBSTRING(REF_OUT, 0, LOCAL)%
REF_OUT '= TRIM_STRING(REF_OUT)
RETURN


; ── 通用：从 "B+8,C-2" 里取某个字母的增量（返回值）──
@LLM_INT_GETVAL(LLM_S, LLM_CH)
#DIMS LLM_S
#DIMS LLM_CH
#LOCALSIZE 4
#LOCALSSIZE 2
#DIMS LLM_NUM
LOCAL = STRFIND(LLM_S, LLM_CH)
SIF LOCAL < 0
	RETURN 0
LOCAL:1 = LOCAL + 1
LOCAL:2 = STRFIND(SUBSTRING(LLM_S, LOCAL:1, STRLENS(LLM_S) - LOCAL:1), ",")
IF LOCAL:2 < 0
	LOCAL:3 = STRLENS(LLM_S) - LOCAL:1
ELSE
	LOCAL:3 = LOCAL:2
ENDIF
LLM_NUM = %SUBSTRING(LLM_S, LOCAL:1, LOCAL:3)%
; ★★ **去掉开头的 `+`**（2026-09-21 修）——
;   ⚠️ 模型输出的是 `B+8` ⇒ 子串是 `+8` ⇒
;      Emuera 的 `TOINT("+8")` **不认前导加号** ⇒ 返回 0 ⚠️
;   ⇒ 这就是「标记收到了、值却全是 0」的真因 ✓
SIF STRFIND(LLM_NUM, "+") == 0
	LLM_NUM = %SUBSTRING(LLM_NUM, 1)%
RETURN TOINT(LLM_NUM)
@LLM_INT_APPLY_BODY(LLM_CID, LLM_TAG)
#DIM  LLM_CID
#DIMS LLM_TAG
#LOCALSIZE 8
#LOCALSSIZE 4
#DIM  LLM_V
#DIMS LLM_BP
#DIMS LLM_AK
SIF LLM_TAG == ""
	RETURN
LOCAL = STRFIND(LLM_TAG, ";")
IF LOCAL < 0
	LLM_BP = %LLM_TAG%
	LLM_AK = "0"
ELSE
	LLM_BP = %SUBSTRING(LLM_TAG, 0, LOCAL)%
	LLM_AK = %SUBSTRING(LLM_TAG, LOCAL + 1)%
ENDIF
; ★ 五个部位逐个处理（ERB 不能动态取 BASE 编号 ⇒ 只能展开）✓
CALL LLM_INT_GETVAL(LLM_BP, "B")
LLM_V = RESULT
SIF LLM_V != 0
	BASE:(LLM_CID):Ｂ絶頂余韻 = LIMIT(BASE:(LLM_CID):Ｂ絶頂余韻 + LLM_V, 0, 600)
CALL LLM_INT_GETVAL(LLM_BP, "V")
LLM_V = RESULT
SIF LLM_V != 0
	BASE:(LLM_CID):Ｖ絶頂余韻 = LIMIT(BASE:(LLM_CID):Ｖ絶頂余韻 + LLM_V, 0, 600)
CALL LLM_INT_GETVAL(LLM_BP, "C")
LLM_V = RESULT
SIF LLM_V != 0
	BASE:(LLM_CID):Ｃ絶頂余韻 = LIMIT(BASE:(LLM_CID):Ｃ絶頂余韻 + LLM_V, 0, 600)
CALL LLM_INT_GETVAL(LLM_BP, "A")
LLM_V = RESULT
SIF LLM_V != 0
	BASE:(LLM_CID):Ａ絶頂余韻 = LIMIT(BASE:(LLM_CID):Ａ絶頂余韻 + LLM_V, 0, 600)
CALL LLM_INT_GETVAL(LLM_BP, "M")
LLM_V = RESULT
SIF LLM_V != 0
	BASE:(LLM_CID):Ｍ絶頂余韻 = LIMIT(BASE:(LLM_CID):Ｍ絶頂余韻 + LLM_V, 0, 600)
; ★ 觉醒值（半醒后每回合更容易醒 ⇒ 加 LLM_AWAKE_BOOST）✓
; ⚠️⚠️ **必须也去掉前导 `+`**（2026-09-27 用 `tool/body_parse_test.py` 验出来的真 bug）——
;   部位那边（`@LLM_INT_GETVAL`）早就做了这个兼容，但**觉醒增量这边漏了**：
;   模型写 `###BODY###B+8;+5` 时，`TOINT("+5")` 在 Emuera 里**不认前导加号** ⇒ 得 0 ⚠️
;   ⇒ 后果：**觉醒值永远涨不上去 ⇒ 她永远不会惊醒/转半醒**，而这**完全看不出来**
;     （部位值照常生效、计量表照常动）—— 正是本项目最怕的"静默失效" ⚠️
;   ⚠️ 提示词里的示例写的是 `;A+5` 这种**不带 +** 的形式，所以模型写不写 `+` 全看它心情 ✓
SIF STRFIND(LLM_AK, "+") == 0
	LLM_AK = %SUBSTRING(LLM_AK, 1)%
LLM_V = TOINT(LLM_AK)
SIF LLM_V < 0
	LLM_V = 0
LLM_V += LLM_AWAKE_BOOST
LLM_AWAKE:(LLM_CID):0 = LIMIT(LLM_AWAKE:(LLM_CID):0 + LLM_V, 0, 100)
RETURN


; ── 觉醒满了 ⇒ 骰「是否惊醒」──
;    返回：1 = 惊醒了 / 0 = 没醒（转半醒）
@LLM_INT_WAKE_CHECK(LLM_CID)
#DIM LLM_CID
#LOCALSIZE 4
#DIM LLM_RATE
SIF LLM_AWAKE:(LLM_CID):0 < 100
	RETURN 0
; ★ 基础 60%，好感/信赖越高越不容易醒（用户设计）——
;   好感 2400 ⇒ -60；信赖 700 ⇒ -35 ⇒ 很亲近的人几乎不会醒 ✓
LLM_RATE = 60
LLM_RATE -= CFLAG:(LLM_CID):好感度 / 40
LLM_RATE -= CFLAG:(LLM_CID):信赖度 / 20
; ★ 半醒状态下更容易醒（用户：「每回合做出的行动更容易提高觉醒率」）✓
SIF LLM_HALFAWAKE
	LLM_RATE += 25
LLM_RATE = LIMIT(LLM_RATE, 5, 95)
; 觉醒值归零（不管醒没醒都要重来）
LLM_AWAKE:(LLM_CID):0 = 0
SIF RAND:100 < LLM_RATE
	RETURN 1
; 没醒 ⇒ 进入半醒 + 以后更容易醒 ✓
LLM_HALFAWAKE = 1
LLM_AWAKE_BOOST += 3
RETURN 0


; ── 退出互动时复位 ──
@LLM_INT_RESET
LLM_HALFAWAKE = 0
LLM_AWAKE_BOOST = 0
RETURN

; ────────────────────────────────────────────────────────────────────────────
;  ★★ 半醒时的「幻想对象」文本（2026-09-20 用户设计）
; ────────────────────────────────────────────────────────────────────────────
;  用户原话：
;    「让角色在半醒状态下会把玩家当成她最亲密的好友在与她做爱（恶作剧）
;      如果和玩家关系在思慕以上 则她脑中幻想的对象改为玩家」
;
;  ⚠️ 好友 = `RELATION:她:对方` **最高**的那个（官方人际关系数值）✓
;     `QoL_ShowRelation.ERB` 用的就是它；分档：
;       <60 很不合 / 60~99 有点疏远 / 100~129 普通 / 130~199 还算亲近 / >=200 很亲近
;  ⚠️ 判据 `LLM_REL_LEVEL(她) >= 2`（思慕及以上）⇒ 换成「认出是玩家」✓
;  ⚠️ 思慕以上时**两种表现都给**（用户：让模型根据性格自己选）：
;       ① 半梦半醒地认出是他 ⇒ 害羞、心跳、半推半就
;       ② 当成一场绮梦 ⇒ 主动迎合（反正梦里的，醒来不算数）
; ────────────────────────────────────────────────────────────────────────────
; ── 找「她最亲近的那个角色」的名字（官方 RELATION 数值 2026-09-20）──
;   ⚠️ 抽成独立函数：半醒文本和旁白都要用 ✓
@LLM_INT_BESTIE_NAME(LLM_CID, REF_OUT)
#DIM  LLM_CID
#DIMS REF REF_OUT
#LOCALSIZE 2
#DIM  LLM_BEST
#DIM  LLM_BV
REF_OUT = ""
LLM_BEST = -1
LLM_BV = 0
FOR LOCAL, 1, CHARANUM
	SIF LOCAL == LLM_CID
		CONTINUE
	SIF RELATION:LLM_CID:LOCAL <= 0
		CONTINUE
	IF RELATION:LLM_CID:LOCAL > LLM_BV
		LLM_BV = RELATION:LLM_CID:LOCAL
		LLM_BEST = LOCAL
	ENDIF
NEXT
SIF LLM_BEST > 0
	REF_OUT = %CALLNAME:(LLM_BEST)%
RETURN


; ── 取「她平时怎么叫玩家」（从长期记忆里找含「叫他」的那条）──
;   ⚠️ 称呼不是独立槽 —— 已废弃，统一写进 LLM_MEMO（重要度 3）✓
;   ⚠️ 原样返回那条记忆，不自己解析引号：模型比我们更懂那句话 ✓
@LLM_INT_CALLHIM(LLM_CID, REF_OUT)
#DIM  LLM_CID
#DIMS REF REF_OUT
#LOCALSIZE 2
#DIMS LLM_T
REF_OUT = ""
SIF LLM_MEMO_CNT:(LLM_CID):0 <= 0
	RETURN
FOR LOCAL, 0, LLM_MEMO_CNT:(LLM_CID):0
	LLM_T = %LLM_MEMO:(LLM_CID):LOCAL%
	SIF STRFIND(LLM_T, "叫他") < 0
		CONTINUE
	REF_OUT = %LLM_T%
	RETURN
NEXT
RETURN


@LLM_INT_HALFAWAKE_TEXT(LLM_CID, REF_OUT)
