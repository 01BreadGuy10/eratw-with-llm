		LLM_TMP += @"**嘴**（快到了、合不拢）"
	ELSEIF CUP:(LLM_CID):快Ｍ + PALAM:(LLM_CID):快Ｍ >= PALAMLV:3
		LLM_TMP += @"**嘴**（很敏感、舌头都麻了）"
	ELSEIF CUP:(LLM_CID):快Ｍ + PALAM:(LLM_CID):快Ｍ >= PALAMLV:2
		LLM_TMP += @"**嘴**（有感觉了）"
	ELSEIF CUP:(LLM_CID):快Ｍ + PALAM:(LLM_CID):快Ｍ >= PALAMLV:1
