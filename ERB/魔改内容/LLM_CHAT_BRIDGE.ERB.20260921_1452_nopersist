; ============================================================================
;  LLM_CHAT_BRIDGE.ERB —— 「自由对话」入口桥接
; ============================================================================
;  作用：把 LLMBridge 插件的开关变成一个**游戏里可点**的指令。
;
;  设计约束：
;    · 本文件是**新增文件**，不修改任何现有 ERB / CSV
;    · 不改变任何游戏数值（本版只做入口 + 开关显示，不含 LLM 调用）
;    · 删除本文件即可完全恢复原状
;
;  依赖：plugins\LLMBridge.dll
;
;  入口位置：与角色互动时的指令界面 → `[自定义]` 指令块 → 「自由对话」
;    （`[自定义]` 按钮控制 ADD_CUSTOM_COM_SWITCH，默认关闭，点一次即记住）
;
;  自定义指令编号：30（0~19, 100~102, 228, 500 已占用）
;
;  用到的 CFLAG 下标（本 mod 空闲区）：
;    1100 = LLM 自由对话「游戏内临时开关」
;
;  ⚠️ 实现约定（踩过的坑，勿改）：
;    1. 不要用 EXISTS 系列判断插件方法是否存在 —— 它们只查 ERB 方法，
;       不认 CALLSHARP 插件方法，会把入口永久挡住。
;       插件不存在时 CALLSHARP 只会报一条 "No native method" 警告并回填空串。
;       判断插件是否可用，应直接用 CALLSHARP 调 LLM_IS_READY 的返回值。
;    2. BUILD_COM_BUTTON_HTML 是 #FUNCTIONS 类型，必须用 `'=` 接返回值，不能 CALL。
;    3. 具名 CFLAG 需先在 CSV\CFLAG.csv 登记；不改 CSV 就用数字下标。
;    4. `%...%` 只能用于字符串字面量内部；变量单独作参数时不加百分号。
;    5. `ARGS` 是 Emuera 保留变量名，不可用作自定义函数的参数名。
; ============================================================================


; ────────────────────────────────────────────────────────────────────────────
;  一、是否显示这个指令
; ────────────────────────────────────────────────────────────────────────────
@ADD_CUSTOM_COM_ABLE30
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS LLM_TMP

; 必须是常规指令时机
SIF !TFLAG:100
	RETURN 0

; 必须有明确目标角色
SIF TARGET < 1 || TARGET >= CHARANUM
	RETURN 0

; 插件全局开关必须打开（插件缺失时返回空串，同样不显示）
CALLSHARP LLM_IS_READY(LLM_TMP)
SIF LLM_TMP != "1"
	RETURN 0

RETURN 1


; ────────────────────────────────────────────────────────────────────────────
;  二、指令本体（点击后进入）
; ────────────────────────────────────────────────────────────────────────────
@ADD_CUSTOM_COM30
#LOCALSIZE 4
#LOCALSSIZE 2

CALL LLM_CHAT_MENU
RETURN -1


; ────────────────────────────────────────────────────────────────────────────
;  三、MOD 菜单里的按钮文字
; ────────────────────────────────────────────────────────────────────────────
@ADD_CUSTOM_COM_PRINT30
#LOCALSIZE 1
#LOCALSSIZE 2
#DIMS LLM_TMP

LOCALS = 自由对话

; 本角色被插件允许时加标记
CALLSHARP LLM_HAS_FREE_TALK(TARGET, LLM_TMP)
SIF LLM_TMP == "1"
	LOCALS = 自由对话 ★

LOCALS:1 '= BUILD_COM_BUTTON_HTML(Add_Custom_COM_To_Number(30), LOCALS)
SIF LOCALS:1 != ""
	HTML_PRINTC LOCALS:1
RETURN 1


; ────────────────────────────────────────────────────────────────────────────
;  ★★ 「自由互动」（编号 31）—— 2026-09-20 用户要求
; ────────────────────────────────────────────────────────────────────────────
;  用户原话：「做一个新的按钮 叫自由互动 它脱离于我们的自由对话系统独立运作」
;            「进入推倒模式时可用（推倒/睡姦/醉姦）」✓
;
;  ⚠️ **推倒模式的判据**（`COMF350 押し倒す.ERB` 推倒成功时设的）：
;      `CFLAG:(cid):诶嘿嘿 == 1`  ← 推倒 / 性行为中
;      `CFLAG:(cid):睡眠`          ← 睡姦
;      `TCVAR:(cid):烂醉`          ← 醉姦
;    ⚠️ `TFLAG:100` 只是「常规指令时机」，**所有指令共用** ⇒ 区分不了推倒 ⚠️
;
;  ⚠️ 和「自由对话」的区别：
;      · 入口独立（本按钮只在**推倒模式**出现）
;      · 提示词独立（露骨尺度、场景是"他正在对你做什么"）
;      · **历史共用**（用户决定：醉酒/睡姦本来话就少；诶嘿嘿是相爱才做的，
;        所以需要对方的性格和两人的关系 —— 共用才有这些上下文 ✓）

@ADD_CUSTOM_COM_ABLE31
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS LLM_TMP

; 必须是常规指令时机
SIF !TFLAG:100
	RETURN 0

; 必须有明确目标角色
SIF TARGET < 1 || TARGET >= CHARANUM
	RETURN 0

; 插件全局开关必须打开
CALLSHARP LLM_IS_READY(LLM_TMP)
SIF LLM_TMP != "1"
	RETURN 0

; ★★ **只在推倒模式显示**（三条任一）——
;   ⚠️ 用 IF/ENDIF 而不是 SIF：下面要 return 的分支是多行 ⚠️
IF CFLAG:TARGET:诶嘿嘿 || CFLAG:TARGET:睡眠 || TCVAR:TARGET:烂醉
	RETURN 1
ENDIF

RETURN 0


@ADD_CUSTOM_COM31
#LOCALSIZE 4
#LOCALSSIZE 2

; ★ 引擎还没接上 —— 先给个占位，确认按钮能出现在正确的地方 ✓
; ★★ **接通「自由互动」引擎**（2026-09-20）——
;   ⚠️ 用**文件级模式变量**而不是改 `@LLM_CHAT_LOOP` 的签名：
;      那个签名被 `@LLM_BUILD_SYSTEM_PROMPT` 牵连，动它要改一串调用点 ⚠️
;   ⚠️ 历史**共用**（用户决定：醉酒/睡姦话少，诶嘿嘿是相爱才做的，
;      需要对方的性格和两人的关系 ⇒ 共用才有这些上下文）✓
LLM_MODE = 1
; ★ 退出互动时把半醒/觉醒加成复位（下一场重新算）✓
;   ⚠️ 用 CALL 一个可能不存在的函数 —— Emuera 不报错、不执行 ✓
CALL LLM_INT_RESET
CALL LLM_CHAT_LOOP(TARGET)
; ★ 对话结束后复位半醒/觉醒加成（2026-09-20 审计补）——
;   ⚠️ Emuera 里 CALL 不存在的函数不报错 ⇒ 删掉模块也不影响 ✓
CALL LLM_INT_RESET
RETURN -1


@ADD_CUSTOM_COM_PRINT31
#LOCALSIZE 1
#LOCALSSIZE 2
#DIMS LLM_TMP

LOCALS = 自由互动 ★

LOCALS:1 '= BUILD_COM_BUTTON_HTML(Add_Custom_COM_To_Number(31), LOCALS)
SIF LOCALS:1 != ""
	HTML_PRINTC LOCALS:1
RETURN 1


; ────────────────────────────────────────────────────────────────────────────
;  占位：确认按钮接对了（接引擎后删掉）
; ────────────────────────────────────────────────────────────────────────────
@LLM_INT_PLACEHOLDER(LLM_CID)
#DIM LLM_CID
#LOCALSIZE 2

PRINTL
PRINTFORML 【自由互动】—— 按钮已经接上了 ✓
PRINTFORML 　目标：%CALLNAME:(LLM_CID)%
PRINTFORML 　（对话引擎还没接 —— 下一步做）
PRINTFORML 　　CFLAG:诶嘿嘿 = {CFLAG:(LLM_CID):诶嘿嘿}
PRINTFORML 　　CFLAG:睡眠   = {CFLAG:(LLM_CID):睡眠}
PRINTFORML 　　TCVAR:烂醉   = {TCVAR:(LLM_CID):烂醉}
PRINTL
PRINTFORML （按回车继续）
INPUT
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  四、菜单本体
; ────────────────────────────────────────────────────────────────────────────
@LLM_CHAT_MENU
#LOCALSIZE 8
#LOCALSSIZE 10
#DIMS LLM_TMP
#DIM  LLM_READY
#DIMS LLM_KOJO      ; 剧本标识符（函数名中缀，基础剧本为空）
#DIMS LLM_KOJO_LBL  ; UI 短标签，如「初始」「《少女之梦》版」
#DIMS LLM_KOJO_DESC ; 剧本说明
#DIMS LLM_KOJO_SHOW ; 实际显示的 persona 名
#DIM  LLM_READY_KOJO ; 该角色是否有口上剧本（1/0）
#DIMS LLM_BTN       ; 菜单正文的 HTML（**只放显示内容，绝不放 <button>**）
#DIMS LLM_APINAME   ; 当前接口名
#DIM  LLM_API_CNT   ; 可用接口条目数
#DIM  LLM_API_ALL   ; 接口条目总数（含不完整的）
; 说明：persona 相关变量（LLM_KOJO*）的**文件级声明在 LLM_CONVERSATION.ERB**，
;       名称必须与那边保持一致。

; ── 排版说明【build 8，勿改回旧写法】──────────────────────────────────
;  这个菜单栽过两次，两次都是**输出方式**的错，改回去就会复发：
;
;  ① build 6：把正文+选项拼成一个 HTML 串、一次 `HTML_PRINT ... , 1` 输出。
;     症状 = 选项点了完全没反应（没有报错、插件侧连 TRACE 都没有），
;     因为多个 <button> 落在同一次打印里，点击回填不进 RESULT。
;
;  ② build 7：正文改用 `HTML_PRINTC LLM_BTN`（多行 HTML + 尾随 <br>）。
;     症状 = 点进菜单直接 NullReferenceException：
;       ErrorLine = 魔改内容\LLM_CHAT_BRIDGE.ERB（即 PRINTC 那一行）
;       functionList = ... ADD_CUSTOM_COM30 -> LLM_CHAT_MENU
;     PRINTc 的分列逻辑处理多行 HTML 会炸。
;
;  现在（build 8）只用两样**本作已验证**的东西：
;    · 正文：引擎原生 `HTML_PRINT` + `PRINTL`（TITLE.ERB / DLCEVENT.ERB 同款）
;    · 选项：mod 的 `CALL PRINTBUTTON_EX(...)`（地点转换.ERB:11-33 同款），
;            一个按钮一次调用、各自一行
;  验证时看标题右侧的 build 号：显示 [build 8] 才说明这份脚本真的生效了。
; ────────────────────────────────────────────────────────────────

CALL RELINE(1, 1)   ; 记录起始行号（1 号位；0 号位留给子函数）

; 按钮值集中赋值（声明在 LLM_KOJO.ERH）。
; 这样"按钮显示的值"和"CASE 比较的值"必然一致，不会因为改编号而错位。
LLM_BTN_TALK   = 4
LLM_BTN_APIS   = 1
LLM_BTN_CLEAR  = 2
LLM_BTN_TOGGLE = 0
LLM_BTN_DEBUG  = 3
LLM_BTN_SELF   = 5
LLM_BTN_MEMO   = 6      ; ★ 当前角色的持久记忆
LLM_BTN_BACK   = 9

WHILE 1
	CALL RELINE(1)  ; 清掉上一轮画面

	; 问插件：可用吗？（空串 = 插件没加载）
	CALLSHARP LLM_IS_READY(LLM_TMP)
	LLM_READY = (LLM_TMP == "1")

	; 当前生效的口上剧本 = 未来的 persona 来源
	;
	; ⚠️ 关键：RESULTS / RESULTS:1 / RESULTS:2 是**引擎临时变量**，
	;   KOJO_ACTIVE_INFO 在"该角色没有口上剧本"时**不会写它们**，
	;   于是会残留上一次调用的内容（实测：留琴读到了孙美天的剧本标签）。
	;   因此必须**先清空**，并**以 KOJO_ACTIVE_INFO 的返回值为准**判断有无剧本。
	;
	; ⚠️ 字符串赋值正确写法（官方文档 Emuera/expression.html 明载）：
	;   字符串变量 ← 另一字符串变量的**内容**，必须用 FORM 语法 %...%：
	;       LLM_A = %RESULTS%
	;   裸写变量名会被当成**字面字符串**（`LLM_A = RESULTS` 得到 "RESULTS"）。
	;   本作 config 里 `STRING VARIABLE ASSIGNMENT ON VALID WITH STRING
	;   EXPRESSION:NO`，所以 `'=` 不可用。
	VARSET RESULTS
	LLM_KOJO      = ""
	LLM_KOJO_LBL  = ""
	LLM_KOJO_DESC = ""
	LLM_KOJO_SHOW = ""

	CALL KOJO_ACTIVE_INFO(TARGET)
	LLM_READY_KOJO = RESULT          ; 1 = 该角色有口上剧本
	IF LLM_READY_KOJO
		LLM_KOJO      = %RESULTS%
		LLM_KOJO_LBL  = %RESULTS:1%
		LLM_KOJO_DESC = %RESULTS:2%
		; 优先用短标签；为空则用说明文字；再为空则视为初始剧本
		LLM_KOJO_SHOW = %LLM_KOJO_LBL%
		SIF LLM_KOJO_SHOW == ""
			LLM_KOJO_SHOW = %LLM_KOJO_DESC%
		SIF LLM_KOJO_SHOW == ""
			LLM_KOJO_SHOW = 初始
	ENDIF

	; ── 组装菜单正文（**纯显示**，一律不含 <button>）──
	;  换行用显式 <br> 写进 HTML；整体交给引擎原生 HTML_PRINT + PRINTL 输出。
	;  注：正文里不要塞 <button>，按钮一律交给下面独立的 PRINTBUTTON_EX 调用。
	LLM_BTN '= @"【自由对话】 目标：%CALLNAME:TARGET%   [build 8]<br>"

	; persona
	IF LLM_READY_KOJO
		LLM_BTN += "　本次 persona：" + HTML_ESCAPE(LLM_KOJO_SHOW) + "<br>"
		SIF LLM_KOJO != ""
			LLM_BTN += "　剧本标识：" + HTML_ESCAPE(LLM_KOJO) + "<br>"
		SIF STRCOUNT(LLM_KOJO_DESC, "<") > 0
			LLM_BTN += "　（该剧本带说明文字，接 LLM 后将作为 persona 参考）<br>"
	ELSE
		LLM_BTN += "　本次 persona：&lt;该角色没有口上剧本&gt;<br>"
		LLM_BTN += "　（将回退到通用反应文本）<br>"
	ENDIF

	; ── 接口（apis.txt）──
	CALLSHARP LLM_API_COUNT(LLM_TMP)
	LLM_API_CNT = TOINT(LLM_TMP)
	CALLSHARP LLM_API_TOTAL(LLM_TMP)
	LLM_API_ALL = TOINT(LLM_TMP)
	CALLSHARP LLM_API_ACTIVE_NAME(LLM_APINAME)
	SIF LLM_APINAME == ""
		LLM_APINAME = <未配置>

	; 插件状态 + 接口状态
	IF LLM_TMP == ""
		LLM_BTN += "　状态：&lt;插件未加载&gt;<br>"
		LLM_BTN += "　请确认 plugins\LLMBridge.dll 存在，且没有多个游戏实例占用它<br>"
	ELSEIF !LLM_READY
		LLM_BTN += "　状态：&lt;插件已加载，但全局开关为关&gt;<br>"
		LLM_BTN += "　请在 plugins\LLMBridge\config.txt 中<br>"
		LLM_BTN += "　把 enable_free_talk 设为 1，保存后立即生效<br>"
	ELSE
		CALLSHARP LLM_HAS_FREE_TALK(TARGET, LLM_TMP)
		SIF LLM_TMP == "1"
			LLM_BTN += "　插件开关：&lt;允许&gt;<br>"
		SIF LLM_TMP != "1"
			LLM_BTN += "　插件开关：&lt;禁止&gt;<br>"
		SIF CFLAG:TARGET:1100
			LLM_BTN += "　临时开关：&lt;开&gt;<br>"
		SIF !CFLAG:TARGET:1100
			LLM_BTN += "　临时开关：&lt;关&gt;<br>"
		LLM_BTN += "　使用接口：" + HTML_ESCAPE(LLM_APINAME) + "<br>"
		; ⚠️ 必须 IF/ENDIF：`SIF` 只绑紧随的一行，写成 SIF+多行的话，
		;    后面几行会**无条件执行** —— 实测表现为"明明有可用接口，
		;    菜单却总是显示『接口：0 条可用 / 请点 [1] 查看具体缺什么』"。
		IF LLM_API_CNT <= 0
			LLM_BTN += "　接口：0 条可用"
			SIF LLM_API_ALL > 0
				LLM_BTN += @"（apis.txt 里有 {LLM_API_ALL} 条，但都不完整）"
			LLM_BTN += "<br>"
			LLM_BTN += "　请点 [1] 查看具体缺什么<br>"
		ENDIF
		; 历史条数
		CALLSHARP LLM_HISTORY_COUNT(TARGET, LLM_TMP)
		LLM_BTN += "　对话记忆：" + LLM_TMP + " 条<br>"
	ENDIF

	LLM_BTN += "<br>"
	; 用引擎原生 HTML_PRINT 一行一行输出（见上）。**不要**改回 HTML_PRINTC ——
	; 实测 `HTML_PRINTC LLM_BTN`（多行 HTML）会在引擎内抛
	;   NullReferenceException @ LLM_CHAT_BRIDGE.ERB
	; 直接崩掉菜单，原因在 PRINTc 的分列逻辑处理多行 HTML 上。
	HTML_PRINT LLM_BTN
	PRINTL

	; ── 选项：**一个按钮一次打印调用**，各自独占一行 ──
	;   用本文件自带的 @LLM_BTN_EX（内部即引擎原生 PRINTBUTTON 命令），
	;   不再依赖 mod 的 PRINTBUTTON_EX 包装 —— 少一层间接、少一个变量。
	;   每个按钮后跟 PRINTL 换行。
	IF LLM_READY
		; 有可用接口 + 本角色被允许 → 才给"开始对话"
		IF LLM_API_CNT > 0
			CALL LLM_BTN_EX(@"[4] ▶ 开始自由对话", 4)
			PRINTL
		ENDIF
		CALL LLM_BTN_EX(@"[1] 接口列表 / 重载 apis.txt", 1)
		PRINTL
		CALL LLM_BTN_EX(@"[2] 清空与该角色的对话记忆", 2)
		PRINTL
		CALL LLM_BTN_EX(@"[0] 切换本角色的临时开关", 0)
		PRINTL
		CALL LLM_BTN_EX(@"[3] 打印插件调试信息", 3)
		PRINTL
		CALL LLM_BTN_EX(@"[5] 自检（函数是否已注册）", 5)
		PRINTL
		CALL LLM_BTN_EX(@"[6] 当前角色的持久记忆", 6)
		PRINTL
		CALL LLM_BTN_EX(@"[9] 返回", 9)
		PRINTL
	ELSE
		CALL LLM_BTN_EX(@"[3] 打印插件调试信息", 3)
		PRINTL
		CALL LLM_BTN_EX(@"[5] 自检（函数是否已注册）", 5)
		PRINTL
		CALL LLM_BTN_EX(@"[6] 当前角色的持久记忆", 6)
		PRINTL
		CALL LLM_BTN_EX(@"[9] 返回", 9)
		PRINTL
	ENDIF

	INPUT
	SELECTCASE RESULT
		CASE 0
			; 【重要】这里**刻意不再静默翻转开关**。
			;  之前这分支只改 CFLAG、什么都不打印，结果"点错按钮"在界面上
			;  完全看不出来，排查时误判成"没反应"。现在无条件打印当前状态，
			;  既做功能提示，也当"按钮值到底传没传对"的活体探针。
			IF LLM_READY
				CFLAG:TARGET:1100 = !CFLAG:TARGET:1100
			ENDIF
			SIF CFLAG:TARGET:1100
				PRINTFORML 临时开关已切换为：开
			SIF !CFLAG:TARGET:1100
				PRINTFORML 临时开关已切换为：关
			PRINTL
			WAIT
		CASE 1
			; 接口列表 / 重载
			CALL LLM_SHOW_APIS
			PRINTL
			WAIT
		CASE 2
			; 清空该角色记忆
			CALLSHARP LLM_HISTORY_CLEAR(TARGET, LLM_TMP)
			PRINTFORML 已清空与 %CALLNAME:TARGET% 的对话记忆。
			PRINTL
			WAIT
		CASE 3
			CALL LLM_PRINT_DEBUG
			PRINTL
			WAIT
		CASE 5
			; 自检：确认 LLM_CONVERSATION.ERB 里的函数是否真的被注册了。
			; 若这里显示"缺失"，说明那个文件没加载 / 该函数有 Lv1 错误，
			; 那 CALL 它自然"点了没反应"。
			CALL LLM_SELFTEST
			PRINTL
			WAIT
		CASE 6
			; ★ **查看她记得什么**（用户要求加这个按钮）
			;  ⚠️ 只读，不改任何东西 ✓
			CALL LLM_SHOW_MEMORY(TARGET)
			PRINTL
			WAIT
		CASE 4
			; ★ 开始自由对话
			; ⚠️⚠️ 这里**必须**用 IF/ENDIF，不能图省事写成 SIF！
			;    `SIF` 只作用于紧随的**一行**：
			;        SIF LLM_API_CNT <= 0
			;            PRINTFORML ...
			;            WAIT          ← 这两行不受 SIF 约束！
			;            BREAK         ← 无条件执行 → 点 [4] 后菜单直接退出，
			;                            看起来就是"点了没反应、什么都没有"。
			;    实测踩过这个坑（改用 SIF 之后就进不去对话了）。
			IF !LLM_READY
				BREAK
			ENDIF
			IF LLM_API_CNT <= 0
				PRINTFORML 请先在 plugins\LLMBridge\apis.txt 里填写接口。
				WAIT
				BREAK
			ENDIF
			; ★★ **自由对话 ⇒ 模式回到 0**（2026-09-20）——
			;   ⚠️ `LLM_MODE` 是文件级变量，同一局里会残留 ⇒ 必须显式清 ✓
			LLM_MODE = 0
			CALL LLM_CHAT_LOOP(TARGET)
			; ★ 对话结束后复位半醒/觉醒加成（2026-09-20 审计补）——
			;   ⚠️ Emuera 里 CALL 不存在的函数不报错 ⇒ 删掉模块也不影响 ✓
			CALL LLM_INT_RESET
			; 她拒绝交谈时 @LLM_CHAT_LOOP 返回 1：
			; 直接退出菜单，把拒绝台词**留在画面上**给玩家看。
			; （若留在菜单里，WEND 回到循环开头会 CALL RELINE 清屏，台词会被冲掉）
			; 注：这里只判断一行，用 SIF 是安全的。
			SIF RESULT == 1
				BREAK
		CASE 9
			BREAK
		CASEELSE
			; 兜底：键盘输入了编号但没匹配上（或点了未知按钮）时给出可见反馈，
			; 便于排查"点了没反应"到底是没点到还是分支没进去。
			PRINTFORML [调试] 未识别的选择：RESULT=%TOSTR(RESULT)%
			WAIT
	ENDSELECT
WEND

RETURN


; ────────────────────────────────────────────────────────────────────────────
;  菜单按钮的最小封装
; ────────────────────────────────────────────────────────────────────────────
;  为什么不直接用 mod 的 @PRINTBUTTON_EX：
;    它内部走 PRINTBUTTON 命令，多一层自定义函数间接；而这个菜单反复
;    出现"按钮点了没反应/值对不上"，链路越短越好定位。
;    `PRINTBUTTON` 是**引擎内置命令**（已确认存在于 Emuera_skiaV10_x64.exe），
;    本作大量文件直接用它，所以这里只做一字不差的封装。
;
;  参数：LLM_TEXT = 按钮显示文本
;        LLM_VAL  = 按钮值（点击后由 INPUT 回填到 RESULT）
; ────────────────────────────────────────────────────────────────────────────
@LLM_BTN_EX(LLM_TEXT, LLM_VAL)
#DIMS LLM_TEXT
#DIM  LLM_VAL
#LOCALSIZE 1
#LOCALSSIZE 1
PRINTBUTTON LLM_TEXT, LLM_VAL
RETURN


