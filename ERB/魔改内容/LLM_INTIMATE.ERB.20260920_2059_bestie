; ────────────────────────────────────────────────────────────────────────────
;  ★★ 睡姦 / 醉姦系统（2026-09-20 用户设计）
; ────────────────────────────────────────────────────────────────────────────
;  ① 部位高潮值 ⇒ 直接用游戏现有的 `BASE:Ｃ/Ｖ/Ａ/Ｂ/Ｍ絶頂余韻`（30~34）✓
;     ⚠️ 上限：部位 600、整体 800（`TRACHECK_ORGASM.ERB:390-391`）
;     ⇒ 满了**游戏自己**会触发绝顶 ⇒ 不用我们管 ✓
;  ② 觉醒值 ⇒ `LLM_AWAKE`（0~100，存盘）
;  ③ 满了 ⇒ **骰惊醒判定**，与好感/信赖挂钩 ⇒ **越喜欢玩家越不容易醒**（用户设计）
;  ④ 没醒 ⇒ **半醒**（迷糊反应）+ 觉醒值归零；
;     ⚠️ 半醒后**每回合行动更容易提高觉醒率**（用户原话）✓
;
;  ⚠️ 标记格式：`###BODY###B+8,V+3,C+2;A+5`
;     分号前 = 部位增量 / 分号后 = 觉醒增量
;     部位：B=胸 V=阴道 C=阴蒂 A=肛门 M=口
; ────────────────────────────────────────────────────────────────────────────

; ── 从回复里解析出 ###BODY### 的内容 ──
@LLM_INT_PARSE_BODY(REF_TEXT, REF_OUT)
#DIMS REF REF_TEXT
#DIMS REF REF_OUT
#LOCALSIZE 2
#LOCALSSIZE 4
#DIMS LLM_TAG
REF_OUT = ""
LLM_TAG = "###BODY###"
LOCAL = STRFIND(REF_TEXT, LLM_TAG)
SIF LOCAL < 0
	RETURN
LOCAL:1 = LOCAL + STRLENS(LLM_TAG)
REF_OUT = %SUBSTRING(REF_TEXT, LOCAL:1)%
LOCAL = STRFIND(REF_OUT, "\n")
SIF LOCAL >= 0
	REF_OUT = %SUBSTRING(REF_OUT, 0, LOCAL)%
REF_OUT '= TRIM_STRING(REF_OUT)
RETURN


; ── 通用：从 "B+8,C-2" 里取某个字母的增量（返回值）──
@LLM_INT_GETVAL(LLM_S, LLM_CH)
#DIMS LLM_S
#DIMS LLM_CH
#LOCALSIZE 4
LOCAL = STRFIND(LLM_S, LLM_CH)
SIF LOCAL < 0
	RETURN 0
LOCAL:1 = LOCAL + 1
LOCAL:2 = STRFIND(SUBSTRING(LLM_S, LOCAL:1, STRLENS(LLM_S) - LOCAL:1), ",")
IF LOCAL:2 < 0
	LOCAL:3 = STRLENS(LLM_S) - LOCAL:1
ELSE
	LOCAL:3 = LOCAL:2
ENDIF
RETURN TOINT(SUBSTRING(LLM_S, LOCAL:1, LOCAL:3))


; ── 应用：加部位快感 + 加觉醒值 ──
@LLM_INT_APPLY_BODY(LLM_CID, LLM_TAG)
#DIM  LLM_CID
#DIMS LLM_TAG
#LOCALSIZE 8
#LOCALSSIZE 4
#DIM  LLM_V
#DIMS LLM_BP
#DIMS LLM_AK
SIF LLM_TAG == ""
	RETURN
LOCAL = STRFIND(LLM_TAG, ";")
IF LOCAL < 0
	LLM_BP = %LLM_TAG%
	LLM_AK = "0"
ELSE
	LLM_BP = %SUBSTRING(LLM_TAG, 0, LOCAL)%
	LLM_AK = %SUBSTRING(LLM_TAG, LOCAL + 1)%
ENDIF
; ★ 五个部位逐个处理（ERB 不能动态取 BASE 编号 ⇒ 只能展开）✓
LLM_V '= LLM_INT_GETVAL(LLM_BP, "B")
SIF LLM_V != 0
	BASE:(LLM_CID):Ｂ絶頂余韻 = LIMIT(BASE:(LLM_CID):Ｂ絶頂余韻 + LLM_V, 0, 600)
LLM_V '= LLM_INT_GETVAL(LLM_BP, "V")
SIF LLM_V != 0
	BASE:(LLM_CID):Ｖ絶頂余韻 = LIMIT(BASE:(LLM_CID):Ｖ絶頂余韻 + LLM_V, 0, 600)
LLM_V '= LLM_INT_GETVAL(LLM_BP, "C")
SIF LLM_V != 0
	BASE:(LLM_CID):Ｃ絶頂余韻 = LIMIT(BASE:(LLM_CID):Ｃ絶頂余韻 + LLM_V, 0, 600)
LLM_V '= LLM_INT_GETVAL(LLM_BP, "A")
SIF LLM_V != 0
	BASE:(LLM_CID):Ａ絶頂余韻 = LIMIT(BASE:(LLM_CID):Ａ絶頂余韻 + LLM_V, 0, 600)
LLM_V '= LLM_INT_GETVAL(LLM_BP, "M")
SIF LLM_V != 0
	BASE:(LLM_CID):Ｍ絶頂余韻 = LIMIT(BASE:(LLM_CID):Ｍ絶頂余韻 + LLM_V, 0, 600)
; ★ 觉醒值（半醒后每回合更容易醒 ⇒ 加 LLM_AWAKE_BOOST）✓
LLM_V = TOINT(LLM_AK)
SIF LLM_V < 0
	LLM_V = 0
LLM_V += LLM_AWAKE_BOOST
LLM_AWAKE:(LLM_CID):0 = LIMIT(LLM_AWAKE:(LLM_CID):0 + LLM_V, 0, 100)
RETURN


; ── 觉醒满了 ⇒ 骰「是否惊醒」──
;    返回：1 = 惊醒了 / 0 = 没醒（转半醒）
@LLM_INT_WAKE_CHECK(LLM_CID)
#DIM LLM_CID
#LOCALSIZE 4
#DIM LLM_RATE
SIF LLM_AWAKE:(LLM_CID):0 < 100
	RETURN 0
; ★ 基础 60%，好感/信赖越高越不容易醒（用户设计）——
;   好感 2400 ⇒ -60；信赖 700 ⇒ -35 ⇒ 很亲近的人几乎不会醒 ✓
LLM_RATE = 60
LLM_RATE -= CFLAG:(LLM_CID):好感度 / 40
LLM_RATE -= CFLAG:(LLM_CID):信赖度 / 20
; ★ 半醒状态下更容易醒（用户：「每回合做出的行动更容易提高觉醒率」）✓
SIF LLM_HALFAWAKE
	LLM_RATE += 25
LLM_RATE = LIMIT(LLM_RATE, 5, 95)
; 觉醒值归零（不管醒没醒都要重来）
LLM_AWAKE:(LLM_CID):0 = 0
SIF RAND:100 < LLM_RATE
	RETURN 1
; 没醒 ⇒ 进入半醒 + 以后更容易醒 ✓
LLM_HALFAWAKE = 1
LLM_AWAKE_BOOST += 3
RETURN 0


; ── 退出互动时复位 ──
@LLM_INT_RESET
LLM_HALFAWAKE = 0
LLM_AWAKE_BOOST = 0
RETURN

; ────────────────────────────────────────────────────────────────────────────
;  ★★ 半醒时的「幻想对象」文本（2026-09-20 用户设计）
; ────────────────────────────────────────────────────────────────────────────
;  用户原话：
;    「让角色在半醒状态下会把玩家当成她最亲密的好友在与她做爱（恶作剧）
;      如果和玩家关系在思慕以上 则她脑中幻想的对象改为玩家」
;
;  ⚠️ 好友 = `RELATION:她:对方` **最高**的那个（官方人际关系数值）✓
;     `QoL_ShowRelation.ERB` 用的就是它；分档：
;       <60 很不合 / 60~99 有点疏远 / 100~129 普通 / 130~199 还算亲近 / >=200 很亲近
;  ⚠️ 判据 `LLM_REL_LEVEL(她) >= 2`（思慕及以上）⇒ 换成「认出是玩家」✓
;  ⚠️ 思慕以上时**两种表现都给**（用户：让模型根据性格自己选）：
;       ① 半梦半醒地认出是他 ⇒ 害羞、心跳、半推半就
;       ② 当成一场绮梦 ⇒ 主动迎合（反正梦里的，醒来不算数）
; ────────────────────────────────────────────────────────────────────────────
@LLM_INT_HALFAWAKE_TEXT(LLM_CID, REF_OUT)
#DIM  LLM_CID
#DIMS REF REF_OUT
#LOCALSIZE 4
#LOCALSSIZE 4
#DIM  LLM_BEST
#DIM  LLM_BV
REF_OUT = ""
LLM_BEST = -1
LLM_BV = 0
FOR LOCAL, 1, CHARANUM
	SIF LOCAL == LLM_CID
		CONTINUE
	SIF RELATION:LLM_CID:LOCAL <= 0
		CONTINUE
	SIF RELATION:LLM_CID:LOCAL > LLM_BV
		LLM_BV = RELATION:LLM_CID:LOCAL
		LLM_BEST = LOCAL
NEXT
REF_OUT += @"\n  ── 情境：**你被弄醒了，但还没真正清醒** ——"
REF_OUT += @"\n     眼睛半睁着、眼神对不上焦，脑子糊成一团。"
IF LLM_REL_LEVEL(LLM_CID) >= 2
	REF_OUT += @"\n     ⚠️ 但潜意识里，你**隐约认得出这个人是「他」** ——"
	REF_OUT += @"\n     那个你心里一直放着的人 ✓"
	REF_OUT += @"\n   · ★ **两种表现都行，依你的性格挑一个**："
	REF_OUT += @"\n     ① **半梦半醒地认出来** ⇒ 心里一惊、脸烫、不敢完全睁眼，"
	REF_OUT += @"\n        想推又推不动，半推半就（嘴硬的角色更适合这个）"
	REF_OUT += @"\n     ② **当成一场绮梦** ⇒ 反正是梦里的、醒来不算数 ⇒ 主动迎合、"
	REF_OUT += @"\n        放任自己（坦率 / 大胆的角色更适合这个）"
	REF_OUT += @"\n   · 能写的：含糊的短句、叫他的时候声音发软、"
	REF_OUT += @"\n     「……是你……？」这种说不清的疑问 ✓"
