; ────────────────────────────────────────────────────────────────────────────
;  ★★ 自由互动的「动作 / 场景描写」——独立请求（2026-09-20 用户要求）
; ────────────────────────────────────────────────────────────────────────────
;  用户原话：「XX粗暴地抓起（角色名）的奶子，乳肉在其贪婪的揉搓之中不断地变形
;            当然这个是要按照玩家输入的语气以及两人当前的关系而定的」
;
;  ⚠️ 为什么**独立请求**（而不是同一条回复里加标记）：
;     这段是**第三人称旁白**，而她那句是**第一人称台词** ——
;     塞进同一条回复里，模型很容易把两种视角混起来 ⚠️
;  ⚠️ 代价：每轮多一次往返（3~6 秒）—— 用户已确认接受 ✓
@LLM_SCENE_WRITE(LLM_CID, LLM_PIN, LLM_RLY, REF_OUT)
#DIM  LLM_CID
#DIMS LLM_PIN          ; 玩家这一轮输入
#DIMS LLM_RLY          ; 她这一轮的回复
#DIMS REF REF_OUT
#LOCALSIZE 4
#LOCALSSIZE 8
#DIM  LLM_REQ
#DIM  LLM_STATE
#DIMS LLM_SYS
#DIMS LLM_TMP
#DIMS LLM_OUT
#DIMS LLM_T
REF_OUT = ""
; ⚠️ 玩家什么都没输入就别写了（空串会让模型瞎编）⚠️
SIF LLM_PIN == ""
	RETURN
LLM_SYS = @"你在为一段 18+ 的互动场景写**旁白**（第三人称）。"
LLM_SYS += @"\n【角色】%CALLNAME:(LLM_CID)%"
; ★ 关系 —— 决定"他能不能这么对她" ✓
LLM_SYS += @"\n【你们的关系】"
CALL LLM_REL_DESC(LLM_REL_LEVEL(LLM_CID), LLM_T)
SIF LLM_T != ""
	LLM_SYS += @"%LLM_T%"
; ★ 她此刻的状态（睡着 / 烂醉 / 清醒）—— 决定旁白的分寸 ✓
SIF CFLAG:(LLM_CID):睡眠
	LLM_SYS += @"\n【她此刻的状态】**正在熟睡，没有意识**"
SIF TCVAR:(LLM_CID):烂醉
	LLM_SYS += @"\n【她此刻的状态】**醉得不省人事**"
IF !CFLAG:(LLM_CID):睡眠 && !TCVAR:(LLM_CID):烂醉
	LLM_SYS += @"\n【她此刻的状态】清醒"
ENDIF
; ★**穿着**和**外形**（写动作要碰到哪里，必须知道）✓
CALL LLM_SHOW_CLOTHES(LLM_CID, LLM_T)
SIF LLM_T != ""
	LLM_SYS += @"\n【她的穿着】%LLM_T%"
CALL LLM_CHARA_FORM(LLM_CID, LLM_T)
SIF LLM_T != ""
	LLM_SYS += @"\n【她的外形】%LLM_T%"
LLM_SYS += @"\n【玩家刚才说 / 做的】%LLM_PIN%"
LLM_SYS += @"\n【她的回应】%LLM_RLY%"
LLM_SYS += @"\n【任务】用**第三人称**写 1~2 句动作 / 场景描写 ——"
LLM_SYS += @"\n  写**玩家对她做了什么**、她的**身体**因此有什么反应。"
LLM_SYS += @"\n   · ⚠️ **不要写她的台词**（那已经有了）—— 只写动作和身体 ✓"
LLM_SYS += @"\n   · ⚠️ **用她的名字**，不要用「她」「少女」这种代词（会像另一个人）✓"
LLM_SYS += @"\n   · ★ **依玩家语气定分寸**：粗暴就写粗暴（抓、掐、按），"
LLM_SYS += @"\n     温柔就写温柔（抚、贴、托）—— 别把温柔写成粗暴、反之亦然 ✓"
LLM_SYS += @"\n   · ★ **依关系定分寸**：恋人可以亲密放得开；关系浅的要有距离感、"
LLM_SYS += @"\n     她可能抗拒或僵住 ✓"
	LLM_SYS += @"\n   · ⚠️⚠️ **绝对不要文艺化** —— 别写「温软的弧度」「呼吸沉缓」"
	LLM_SYS += @"\n     「指尖陷进」这类抒情腔 ✗ 那是小说，不是这里要的东西 ✓"
	LLM_SYS += @"\n   · ★ **动作要实**：谁的手 → 抓 / 揉 / 捏 / 掐 / 按 了哪里 →"
	LLM_SYS += @"\n     怎么动的 → 肉、皮肤、衣服 怎么变形 ✓"
	LLM_SYS += @"\n   · ★ **部位直接说** —— 奶子 / 乳房 / 乳头 / 屁股 / 小穴 / 大腿 /"
	LLM_SYS += @"\n     鸡巴；**别用**「胸口」「那里」「下面」绕圈子 ✗"
	LLM_SYS += @"\n   · ★ **示范**（要这种感觉）——"
	LLM_SYS += @"\n     「他粗暴地抓起芙兰的奶子，乳肉在他贪婪的揉搓里不断变形」"
	LLM_SYS += @"\n     「他两根手指夹住芙兰的乳尖捻了一下，她整个人抖了抖」"
	LLM_SYS += @"\n   · ⚠️ 别拿「轻轻」「微微」「隐隐」堆句子 —— 该重就重、该狠就狠 ✓"
	LLM_SYS += @"\n   · ⚠️ 尺度**直白** —— 写湿了、硬了、陷进去、被顶开，都可以直接写 ✓"
LLM_SYS += @"\n   · ⚠️ 如果玩家这句**没有身体动作**（只是说话），就写**场景氛围 + 她的姿态** ✓"
LLM_SYS += @"\n【输出】只输出那 1~2 句，**不要**任何标记、引号、或说明"
CALLSHARP LLM_CHAT_SEND(LLM_CID, LLM_SYS, "（描写一下此刻的画面。）", 0, LLM_TMP)
; ⚠️⚠️ 必须把请求 id 接出来 —— 漏了这步 `@LLM_POLL` 会问上一个请求 ⚠️
IF TOINT(LLM_TMP) <= 0
	RETURN
ENDIF
LLM_REQ = TOINT(LLM_TMP)
CALL LLM_POLL(LLM_REQ, LLM_STATE, LLM_OUT)
; ⚠️ 失败就算了，不阻塞（旁白是锦上添花）
SIF LLM_STATE != 1
	RETURN
CALL LLM_SANITIZE_REPLY(LLM_OUT)
REF_OUT = %LLM_OUT%
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  旁白的显示：**加粗白色**（和她的台词区分开）
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ `FONTBOLD` 用 `FONTREGULAR` 复位（照抄 `CASINO_CHARISMA.ERB:485-487`）✓
