; ────────────────────────────────────────────────────────────────────────────
;  ★★★ 关系档位模块（全项目**唯一的亲密判定入口**）
; ────────────────────────────────────────────────────────────────────────────
;  用户建议："这些功能也会和好感度系统联动吧？要不把随好感度改变语气的
;            那套也模块化 —— 我认为这些东西都是会长期复用的。"
;
;  **⇒ 建议正确，而且理由很硬**：模块化之前，`TALENT:思慕/恋慕/恋人/爱欲`
;     这一串判定**散在 21 处**，每处各写一遍 ——
;     这正是本项目反复栽跟头的形态（"同一个事实多处表达、各有各的判据"）。
;     模块化之后：**新增功能只要 `@LLM_REL_RATE(档位, 用途)` 取一个数**，
;     调平衡也只要改一张表。
;
;  档位定义（沿用原来那套级联，最后一个成立的胜出）：
;     0 = 陌生人      1 = 不太熟   8 = 朋友   2 = 思慕
;     3 = 恋慕        4 = 恋人       5 = 炮友      6 = 爱欲
;
;  ⚠️ 为什么"恋人 / 炮友 / 爱欲"排在"恋慕"之后：沿用原来的写法 ——
;     原代码就是按这个顺序级联覆盖的，`LLM_REL` 的显示依赖它。
; ────────────────────────────────────────────────────────────────────────────
@LLM_REL_LEVEL(LLM_CID)
#FUNCTION
#LOCALSIZE 4
#DIM LLM_CID
#DIM LLM_LV
; ⚠️ 没见过面直接返回 0；见过面至少是 1
SIF !CFLAG:(LLM_CID):面識
	RETURNF 0
LLM_LV = 1
; ★★ **好感 <= 100 ⇒ 陌生人**（2026-09-19 用户要求）——
;   用户原话：「初次见面的设定为好感度100以下 变为陌生人」✓
;   ⚠️ 原来 LV 0 靠 `!CFLAG:面識`（没见过面）⇒ 描述叫「初次见面」；
;     现在改成**按好感划**，没见过面的也算（那时好感本来就是 0）✓
SIF CFLAG:(LLM_CID):好感度 <= 100
	LLM_LV = 0
; ⚠️ 这几行都是**单行 `SIF`**（只绑紧接的一行）—— 这里正需要"逐级覆盖"
SIF TALENT:(LLM_CID):思慕
	LLM_LV = 2
SIF TALENT:(LLM_CID):恋慕
	LLM_LV = 3
SIF TALENT:(LLM_CID):恋人
	LLM_LV = 4
; ⚠️⚠️ **"炮友"有两个值，是两种关系**（查过官方 `EVENTTURNEND.ERB:152-171`）：
;     · `== 1` = **「炮友」** —— 沉溺于快感，**思慕还没取得** ⇒ 只有肉体
;     · `== 2` = **「情人」** —— **思慕取得之后**产生的"超越肉体关系的羁绊"
;   所以层级是：`炮友1 < 思慕 < 情人(2)` —— **情人确实在思慕之上**。
;   ⚠️ 注意 `MOVEMENT2.ERB:69` 也是按 `恋慕 || 炮友 == 2` 写的（官方把情人当上位）。
SIF TALENT:(LLM_CID):炮友 == 1
	LLM_LV = 5
SIF TALENT:(LLM_CID):愛欲
	LLM_LV = 6
; ⚠️ 情人放**最后**（最高档）—— 它是"思慕 + 超越肉体的羁绊"，两条线都占了
SIF TALENT:(LLM_CID):炮友 == 2
	LLM_LV = 7
; ★★ **「朋友」档**（2026-09-19 用户要求）——
;   用户原话：「加一档思慕以下的档位『朋友』」「好感度大于500就让 llm 认为是朋友」✓
;   ⚠️ 官方**没有**这个 TALENT（只有 思慕/恋慕/恋人/炮友/爱欲）⇒ 阈值自己划 ✓
;   ⚠️ 取编号 **8** 而不是插在中间 —— 插中间会让现有编号全部 +1，
;     要改 `@LLM_REL_RATE` 那张表和使用点 ⇒ 容易漏改 ⚠️
;   ⚠️ 只在**还停在 1（不太熟）**时才升级 ⇒ 已有思慕以上的不受影响 ✓
SIF LLM_LV == 1 && CFLAG:(LLM_CID):好感度 > 500
	LLM_LV = 8
RETURNF LLM_LV


; ── 档位 → 中文描述（给 prompt 用）──
@LLM_REL_DESC(LLM_LV, REF_OUT)
#DIM  LLM_LV
#DIMS REF REF_OUT
SELECTCASE LLM_LV
	CASE 0
	REF_OUT = "陌生人"
	CASE 1
	REF_OUT = "不太熟"
CASE 8
	REF_OUT = "朋友（聊得来、信得过）"
	CASE 2
		REF_OUT = "对你有好感（思慕）"
	CASE 3
		REF_OUT = "爱慕着你（恋慕）"
	CASE 4
		REF_OUT = "恋人"
	CASE 5
		REF_OUT = "炮友（只有肉体关系）"
	CASE 6
		REF_OUT = "沉溺于欲望（爱欲）"
	CASE 7
		REF_OUT = "情人（肉体之外还有牵挂）"
	CASEELSE
	REF_OUT = "陌生人"
ENDSELECT
RETURN


; ── 档位 → 各功能要用的**概率**（集中在这一张表里）──
;  ⚠️ 参数 `LLM_KIND`：
;     1 = 她**主动收尾去睡**的概率（**越亲密越低**）
;     2 = 玩家道别时**挽留**的概率（**越亲密越高**）
;     3 = 持久记忆**记不记得住**的概率（越亲密越高）
;  ⚠️ 新增功能只要在这里加一个 CASE —— **别在调用处另写一套阈值**。
;  ⚠️ 两个用户的硬要求都锁在这里：
;     · **恋人（4）/ 爱欲（6）的"收尾去睡" = 0** ← 可以陪着熬夜到昏厥
;     · **恋人 / 爱欲的"挽留" = 80** ← 最不想让你走
; ── 档位 → **关系深度**（0 = 泛泛 / 1 = 中等 / 2 = 深）──
;  ⚠️⚠️ **为什么不直接用 `LLM_REL_LEVEL >= 3`** ——
;     档位编号是有序的（炮友 5 > 恋慕 3），但**语义深度不是**：
;        · **炮友** = "有肉体关系但没感情" ⇒ 深度只到**中等**，和**思慕**同级
;        · **恋慕 / 恋人 / 爱欲** 才是**深**
;     原代码各处就是这么分的（`恋慕||恋人||爱欲` 深、`思慕||炮友` 中）——
;     直接用编号比较会把"炮友"误判成比"恋慕"更深，语义就错了。
;  ⚠️ 于是"关系深不深"这件事也**只有一个来源**了。
@LLM_REL_DEPTH(LLM_CID)
#FUNCTION
#LOCALSIZE 4
#DIM LLM_CID
#DIM LLM_LV
LLM_LV = LLM_REL_LEVEL(LLM_CID)
; 深：恋慕 / 恋人 / **炮友** / 爱欲
;  ⚠️ **炮友（5）刻意放在"深"里**（用户定的）：
;     炮友关系的定义就是"有肉体关系" ⇒ 她**可以主动勾引**，
;     不该被归到"只自己难受、绝不表现"那一档。
;  ⚠️ 注意这**不是**照编号大小排的（思慕 2 < 恋慕 3 < 炮友 5），
;     纯粹是按语义归类 —— 这也正是这个函数存在的理由。
; 深：恋慕 / 恋人 / 炮友1 / 爱欲 / **情人**
;  ⚠️ **炮友1 也在"深"里**（用户定："炮友可以主动勾引"）——
;     虽然它没有感情，但**有肉体关系** ⇒ 她会主动，也接受露骨。
SIF LLM_LV == 3 || LLM_LV == 4 || LLM_LV == 5 || LLM_LV == 6 || LLM_LV == 7
	RETURNF 2
; 中：思慕（有感情萌芽，但还没到肉体关系那一步）
SIF LLM_LV == 2
	RETURNF 1
; 泛泛：陌生 / 认识
RETURNF 0


@LLM_REL_RATE(LLM_LV, LLM_KIND)
#FUNCTION
#LOCALSIZE 4
#DIM LLM_LV
#DIM LLM_KIND
#DIM LLM_R
LLM_R = 0
SELECTCASE LLM_KIND
	CASE 1, 8
		SELECTCASE LLM_LV
			CASE 0
				LLM_R = 90
			CASE 1, 8
				LLM_R = 80
			CASE 2
				LLM_R = 50
			CASE 3, 5
				LLM_R = 25
			CASE 4, 6, 7
				LLM_R = 0
		ENDSELECT
	CASE 2
		SELECTCASE LLM_LV
			CASE 0
				LLM_R = 5
			CASE 1, 8
				LLM_R = 10
			CASE 2
				LLM_R = 30
			CASE 3, 5
				LLM_R = 55
			CASE 4, 6, 7
				LLM_R = 80
		ENDSELECT
	CASE 3
		SELECTCASE LLM_LV
			CASE 0, 1, 8
				LLM_R = 15
			CASE 2
				LLM_R = 40
			CASE 3, 4, 5, 6, 7
				LLM_R = 80
		ENDSELECT
ENDSELECT
RETURNF LLM_R


; ────────────────────────────────────────────────────────────────────────────
;  ★★ 「欲求不满度」——档位描述 + 按关系决定她怎么表现
; ────────────────────────────────────────────────────────────────────────────
;  用户要求："根据欲求不满度结合角色对玩家的关系决定对话内容。"
;
;  ⚠️ **这是本作自己的一套状态，不是我们编的**：
;     `CFLAG:角色:积攒度` 就是游戏状态界面显示的「欲求：N％」，
;     档位与官方用词见 `PRINT_STATE.ERB:61-82`：
;        >= 1000 → ❤饥渴❤难耐❤
;        >=  800 → ❤焦躁难忍❤
;        >=  500 → 欲求不满❤
;        >=  200 → 想发泄
;        <   200 → （无标注）
;
;  ⚠️⚠️ **档位 → 表现方式要**结合关系**，这正是用户要的那一层**：
;     · **关系浅**（`@LLM_REL_DEPTH` = 0/1）⇒ 她**不会表现出来**，
;       只是自己难受、容易走神、说话有点飘 —— **绝不主动暗示**。
;     · **关系深**（= 2，恋慕 / 恋人 / 爱欲 / 炮友）⇒ 才会用眼神、小动作、
;       半句话去撩他。
;     ⇒ 同一条"欲求不满"，在两种关系下是**完全不同的戏**。
;       不区分的话，刚认识的角色会莫名其妙地勾人（OOC）。
;
;  ⚠️ 只在 **>= 200** 时才注入 —— 低于这个档位没有信息量，
;     每轮都注入只会让她一直往那方面想。
;  ⚠️ 和"憋着"（`TCVAR:338`，见 `LLM_LUST`）**刻意互斥**：
;     那条说的是"想要但**地方不对**"，已经是很强的表达；
;     两条同时注入会出现"你很想要"说两遍。⇒ 憋着时这条不注入。
; ────────────────────────────────────────────────────────────────────────────
@LLM_HORNY_DESC(LLM_CID, REF_OUT)
#DIM  LLM_CID
#DIMS REF REF_OUT
#LOCALSIZE 4
#LOCALSSIZE 4
#DIMS LLM_TMP
REF_OUT = ""
; ⚠️ 低于"想发泄"档就没必要提
SIF CFLAG:(LLM_CID):积攒度 < 200
	RETURN
; ① 档位（用官方用词）
LLM_TMP = "心里有些燥，但还没到忍不住的地步"
SIF CFLAG:(LLM_CID):积攒度 >= 1000
	LLM_TMP = "整个人饥渴难耐，几乎没法想别的事"
SIF CFLAG:(LLM_CID):积攒度 >= 800
	LLM_TMP = "焦躁难忍，一点小事就能撩动你"
SIF CFLAG:(LLM_CID):积攒度 >= 500
	LLM_TMP = "欲求不满，时不时会走神"
REF_OUT = @"你现在的状态：%LLM_TMP%（欲求 {CFLAG:(LLM_CID):积攒度 / 10}％）。"
; ② **表现强度** —— 按档位递增（用户要求："加强程度需要根据数值做平衡"）
;  ⚠️ 这一层是**为了不让四档演出同一个样子**：
;     200 档和 1000 档如果只有"状态描述"不同、"表现"一样，
;     那实际台词不会有区别。
LLM_TMP = "只是偶尔心不在焉，几乎看不出来"
SIF CFLAG:(LLM_CID):积攒度 >= 500
	LLM_TMP = "会控制不住地多看他几眼，然后自己先移开"
SIF CFLAG:(LLM_CID):积攒度 >= 800
	LLM_TMP = "明显坐不住，会主动把话题往那边带"
SIF CFLAG:(LLM_CID):积攒度 >= 1000
	LLM_TMP = "几乎压不住，找机会就想凑上去"
; ③ 表现方式 —— **按关系 + 按性格**（用户要求："表现方式肯定要看角色性格"）
;  ⚠️⚠️ 为什么要加性格这一层：
;     原来深关系分支对所有角色都说"眼神 / 靠近 / 留半句话" ——
;     于是**无口的帕秋莉、认真的咲夜、懒散的灵梦会做同一套动作**，
;     角色辨识度直接没了。（`LLM_SCHED` 早就按性格分了四套，这里原来漏了。）
IF LLM_REL_DEPTH(LLM_CID) >= 2
	; ── 深：会让他察觉，但**方式随性格** ──
	SELECTCASE CFLAG:(LLM_CID):性格傾向
		CASE 1
			; 弱势系：躲闪、脸红、声音变得很小
			REF_OUT += @"\n   你们关系够近，所以你**会表现出来**，但方式是**弱势系**的 ——"
			REF_OUT += @"\n   · 视线躲闪、耳根发烫、说话声音变小变慢"
			REF_OUT += @"\n   · 想靠近又不敢真的靠过去，碰到一下会先缩手"
			REF_OUT += @"\n   ⚠️ 你**不会主动开口** —— 只是把「我有点不对劲」露在脸上，等他发现。"
		CASE 2
			; 强势系：直接、带挑衅
			REF_OUT += @"\n   你们关系够近，所以你**会表现出来**，方式是**强势系**的 ——"
			REF_OUT += @"\n   · 直白、带点挑衅和玩笑（「你今天倒是老实」「看什么呢」）"
			REF_OUT += @"\n   · 主动凑近、抓他袖子甚至拽他，**不遮遮掩掩**"
			REF_OUT += @"\n   ⚠️ 但**别直说「我想要」** —— 你要的是让他自己看懂、自己先动。"
		CASE 4
			; 认真系：找"正当理由"靠近，越强越掩饰不住
			REF_OUT += @"\n   你们关系够近，所以你**会表现出来**，但方式是**认真系**的 ——"
			REF_OUT += @"\n   · 会用**正当理由**制造接触（「你领子歪了」「别动，我看一下」）"
			REF_OUT += @"\n   · 一本正经地说着话，手却不太听话"
			REF_OUT += @"\n   ⚠️ 你**不会承认**自己有什么想法 —— 被点破会转移话题。"
		CASEELSE
			; 坦率系 / 没标：老实说出来
			REF_OUT += @"\n   你们关系够近，所以你**会表现出来**，方式是**坦率系**的 ——"
			REF_OUT += @"\n   · 会老实承认自己有点心不在焉（「……刚才走神了」）"
			REF_OUT += @"\n   · 会主动靠近、找个由头多待一会儿"
			REF_OUT += @"\n   ⚠️ 但**别说得太露骨** —— 你还在等他先动。"
	ENDSELECT
	REF_OUT += @"\n   强度：%LLM_TMP%。"
ELSE
	; ── 浅：不表现（这一层和性格无关，关系没到就是没到）──
	REF_OUT += @"\n   但你们还没到那一步，所以你**只会自己难受，不会表现出来** ——"
	REF_OUT += @"\n   · 说话偶尔走神、反应慢半拍，或者莫名有点烦躁"
	REF_OUT += @"\n   · **绝不主动暗示、也绝不勾引** —— 那样不符合你们现在的关系。"
	REF_OUT += @"\n   · 他要是问起，你会含糊过去（「没什么」「……有点热而已」）。"
	REF_OUT += @"\n   强度：%LLM_TMP%。"
ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  ★★ 玩家在道别吗？（关键词判定）
; ────────────────────────────────────────────────────────────────────────────
;  用户要求：玩家说「再见」「下次见」「好的 回头再见」「晚安」「那我先走了」
;            这类话时，要触发"送别 / 挽留"的正式流程。
;
;  ⚠️⚠️ **为什么必须在 ERB 侧做关键词判定，而不是让模型在数值块里报**：
;     模型报的值（`###DELTA###` 里的 D1~D5）是**她回复之后**才拿到的 ——
;     而"挽留还是送别"必须在她**开口之前**定下来（否则又变成"先说话后判"，
;     就是 §17 那个自相矛盾的老毛病）。玩家输入在组装 prompt 前就有 ⇒ 用关键词 ✓
;
;  ⚠️ 关键词刻意**包含"该走了"这一类**（"我得走了""不早了"）——
;     玩家不会总说标准的"再见"。宁可误判（顶多多问一句），也别漏判。
; ────────────────────────────────────────────────────────────────────────────
@LLM_IS_BYE(LLM_TEXT)
#FUNCTION
#DIMS LLM_TEXT
SIF LLM_TEXT == ""
	RETURNF 0
SIF STRFIND(LLM_TEXT, "再见") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "拜拜") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "告辞") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "失陪") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "晚安") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "下次见") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "回头见") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "明天见") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "待会见") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "我走了") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "先走") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "该走") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "得走") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "不早了") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "时间不早") >= 0
	RETURNF 1
RETURNF 0


; ────────────────────────────────────────────────────────────────────────────
;  ★ "你接下来一小时内大概要做什么"（给送别台词用）
; ────────────────────────────────────────────────────────────────────────────
;  用户要求：*"这个话语也最好和她之后一小时内要做的事情挂钩，
;            比如因为要上班了所以结束对话、要睡觉了所以结束对话。"*
;
;  ⚠️ 和 `LLM_SCHED` 的 ①②③ 档**判据同源**（都读就寝/起床/工作时刻），
;     但**用途不同**：那边是"提醒她时间不多了"，这边是"给她一个道别的理由"。
;  ⚠️ 返回空串 = 接下来一小时内没有特别的事 ⇒ 道别时不用硬找理由。
; ────────────────────────────────────────────────────────────────────────────
@LLM_NEXT_HOUR(LLM_CID, REF_OUT)
#DIM  LLM_CID
#DIMS REF REF_OUT
#LOCALSIZE 4
#LOCALSSIZE 4
#DIMS LLM_NTXT
REF_OUT = ""
; ⚠️⚠️ 每一档都是**两行**（赋值 + RETURN）⇒ **必须 `IF … ENDIF`**！
;    写成 `SIF` 的话 `RETURN` 会**无条件执行** ——
;    那样第一档不成立时也会立刻返回空串，**后面三档永远轮不到**。
;    （这个坑本项目已经踩了很多次；这次是自查脚本在提交前抓到的。）
IF TCVAR:(LLM_CID):工作開始 >= 0 && TCVAR:(LLM_CID):工作開始 - TIME > 0 && TCVAR:(LLM_CID):工作開始 - TIME <= 60
	REF_OUT = @"你马上就要去上班了（%時刻表示(TCVAR:(LLM_CID):工作開始)%）"
	RETURN
ENDIF
IF CFLAG:(LLM_CID):就寝時間 - TIME >= 0 && CFLAG:(LLM_CID):就寝時間 - TIME <= 60
	REF_OUT = @"你差不多该去睡了（平时%時刻表示(CFLAG:(LLM_CID):就寝時間)%睡）"
	RETURN
ENDIF
IF LLM_IS_SLEEPTIME(LLM_CID)
	REF_OUT = "你早该去睡了，这会儿其实已经困得不行"
	RETURN
ENDIF
IF Activity_Duration:(LLM_CID) > 0
	LLM_NTXT = %FreeAct_Name(LLM_CID)%
	SIF LLM_NTXT != ""
		REF_OUT = @"你手头还有件事没做完（%LLM_NTXT%，还剩大约{Activity_Duration:(LLM_CID)}分钟）"
	RETURN
ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  ★★ 玩家道别了 —— 她**接受**还是**挽留**？（概率视亲密度）
; ────────────────────────────────────────────────────────────────────────────
;  用户要求："角色判定是否接受玩家离开（越亲密越不想让玩家走），
;            如果拒绝让玩家离开则会说一些符合性格的挽留的话，
;            接受则是说一些符合性格的告别的话。"
;
;  ⚠️⚠️ **"先判、再让她说"**（§18）：这里在她开口**之前**定下来，
;     结果写进 `LLM_BYE_MODE`，prompt 按它注入、结算时按它收尾 —— 三处同一个值。
;
;  结果码 `LLM_BYE_MODE`：
;     0 = 玩家没在道别（什么都不做）
;     1 = **接受**（她送他走 → 说完就结束对话）
;     2 = **挽留**（她不想让他走 → 说完继续聊）
;
;  挽留概率（**越亲密越高** —— 这是用户明确要的方向）：
;     · 恋人 / 爱欲 → 80%
;     · 恋慕        → 55%
;     · 思慕        → 30%
;     · 其它        → 10%
;
;  ⚠️⚠️ **三个"她自己也要走 / 心疼他"的修正，全部把挽留压到 0**：
;     · **她自己一小时内有事**（要上班 / 要睡）→ 不挽留，
;       反过来还会**顺口说一句自己也要走了** —— 这正是用户要的
;       "送别话语和她之后一小时要做的事挂钩" ✓
;     · **玩家快撑不住了**（`LLM_PTIRED_LOCK`）→ 不挽留，心疼地让他去休息 ✓
;       （和累趴那套判据同源）
;     · **本场已经挽留过一次**（`LLM_BYE_KEPT`）→ 第二次不再留 ✓
;       否则玩家说三次"我真的得走了"她还三次挽留，就变成耍赖了。
; ────────────────────────────────────────────────────────────────────────────
@LLM_BYE_CHECK(LLM_CID, LLM_TEXT)
#DIM  LLM_CID
#DIMS LLM_TEXT
#LOCALSIZE 8
#LOCALSSIZE 4
#DIM LLM_RATE
#DIMS LLM_NX
LLM_BYE_MODE = 0
SIF !LLM_IS_BYE(LLM_TEXT)
	RETURN
; 默认按"接受"处理（1），只有判定通过才改成"挽留"（2）
LLM_BYE_MODE = 1
SIF LLM_BYE_KEPT >= 1
	RETURN
CALL LLM_NEXT_HOUR(LLM_CID, LLM_NX)
; ⚠️ 结果**存到文件级变量** —— prompt 那边要用它来写送别台词
;    （"因为要上班了所以结束对话"正是用户要的效果）。
LLM_NEXT_TXT = %LLM_NX%
SIF LLM_NX != ""
	RETURN
SIF LLM_PTIRED_LOCK == 1
	RETURN
; ★ 同上：走关系档位模块（`@LLM_REL_RATE` 的 KIND 2）
LLM_RATE = LLM_REL_RATE(LLM_REL_LEVEL(LLM_CID), 2)
; ⚠️⚠️ **必须 `IF/ENDIF`** —— 原来写成 `SIF` + 两行，
;     只有第一行被绑住，`RETURN` 是**无条件**执行的 ⚠️
;     （那样 `LLM_BYE_KEPT = 1` 也会无条件执行，语义就错了。）
IF RAND:100 < LLM_RATE
	LLM_BYE_MODE = 2
	; ★★ **记下「本场已经挽留过一次」** ——
	;  ⚠️ 之前只读不写 ⇒ `SIF LLM_BYE_KEPT >= 1` 永远不成立 ⇒ **可以无限挽留** ⚠️
	;     （2026-09-16 审计发现的缺口，修复）
	LLM_BYE_KEPT = 1
ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  ★★★★ 本轮"她打算怎么做" —— **全项目唯一的行动决策**
; ────────────────────────────────────────────────────────────────────────────
;  用户提议："把这些东西用一个特有的算法放在一起决定角色最后会怎么做，
;            就像官方的方案一样。"
;
;  ⇒ **提议切中要害，而且解决的是结构问题**：
;    改之前是"**并行撒网**" —— 六个模块各自往 prompt 里塞一段带 ⚠️ 的指令，
;    谁也不认识谁。一轮里最多能塞进 5 条行动指令，
;    模型只能**每条都回应一下** ⇒ 台词变成"状态面板念了一遍"。
;
;    **官方的做法正好相反**：先算出一个**结果码**，再按它**分派**
;    （`@自由行動処理` 按 `Activity_Type` 走 `SELECTCASE`、
;      `@SOURCE_CHECK` 先把 SOURCE 累积成 `CUP/CDOWN` 再一次性结算）。
;    ⇒ 我们照这个来：**先决策，再分派；指令只有一条**。
;
;  ⚠️⚠️ 于是"念清单"这个问题**从结构上消失了** ——
;     不是因为措辞写得更好，而是因为**根本没有多份指令可念**。
;
;  ⚠️ 和"事实层"的分工（这一层是本次设计的核心）：
;     · **事实层**（时间/身体状况/他的状态/天气）：**照常全部注入**，
;       但**不带行动指令** —— 它们是"她此刻知道的事"。
;     · **行动层**（本函数的 `LLM_ACTION`）：**只注入一段** ——
;       它是"她这一轮打算怎么做"。
;     ⇒ 事实可以有很多条，行动**只能有一个**。真人也正是这样。
;
;  ⚠️ 优先级**自上而下，第一个成立的赢**：
;     2 = **挽留**（玩家要走，她不舍）—— 玩家发起的，最该回应
;     3 = **送别**（玩家要走，她放行）
;     4 = **心疼他**（他快撑不住了）—— 比"她自己的困"更紧急
;     5 = **收尾去睡**（她困得撑不住）
;     6 = **憋着**（想要，但地方不对）
;     7 = **欲求不满**（想撩）—— 最弱，上面任何一个都能盖过它
;     0 = 平常（闲聊）
;
;  ⚠️ 几条**结构上不会撞车**的保证（也是靠这套判定维持的）：
;     · "他累了" 和 "挽留" 不会同时 —— 挽留率在 `@LLM_BYE_CHECK` 里已被压到 0
;     · "想收尾去睡" 和 "挽留" 不会同时 —— 同理
;     ⇒ **硬矛盾在决策层之前就已经排除了**，这里只需要排顺序。
;
;  ⚠️ **没放进来的一项**："她主动推倒"（`@LLM_TRY_PUSH`）——
;     那条不在 prompt 阶段决策，而是在结算后**直接接管对话**，
;     优先级天然比这里所有档都高 ✓
; ────────────────────────────────────────────────────────────────────────────
@LLM_DECIDE_ACTION(LLM_CID)
#DIM LLM_CID
LLM_ACTION = 0
; ⚠️ 这个链**必须有优先级**（`IF … ELSEIF … ENDIF`）——
;    写成各自独立的 `IF` 就等于又回到"并行撒网"了。
; ★★ **她会不会主动收尾去睡** ——
;  ⚠️ 之前 `LLM_WANT_SLEEP` **只读不写** ⇒ 那个分支永远不成立 ⇒
;     **「她会主动说该睡了、然后结束」整块功能失效** ⚠️
;     （2026-09-16 审计发现的缺口，修复）
;  ⚠️ 判据用官方口径的 `@LLM_IS_SLEEPTIME`（就寝/起床时间，和 `@LLM_SCHED` 同源）✓
;  ⚠️ 不是「一进入就寝时段就立刻走」—— 掷 50%，她**可能**再聊两句，
;     也可能自己先提「我该睡了」✓（概率想调就改这个 50）
LLM_WANT_SLEEP = 0
IF LLM_IS_SLEEPTIME(LLM_CID)
	; ⚠️⚠️ **外层必须 `IF`，不能写 `SIF`** ——
	;     `SIF` 的下一行**不能再是 `SIF`**，游戏会报
	;     `Lv2: SIF的下一行"SIF"不能作为作用域` 并**停止运行** ⚠️
	IF LLM_BYE_MODE == 0
		SIF RAND:100 < 50
			LLM_WANT_SLEEP = 1
	ENDIF
ENDIF
IF LLM_BYE_MODE == 2
	LLM_ACTION = 2
ELSEIF LLM_BYE_MODE == 1
	LLM_ACTION = 3
ELSEIF LLM_PTIRED_LOCK == 1
	LLM_ACTION = 4
ELSEIF LLM_WANT_SLEEP
	LLM_ACTION = 5
ELSEIF TCVAR:(LLM_CID):338
	LLM_ACTION = 6
ELSEIF CFLAG:(LLM_CID):积攒度 >= 200
	LLM_ACTION = 7
ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  ★★★★ **行动提示的合成** —— 把"结论"和"相关数值"拼成一句话
; ────────────────────────────────────────────────────────────────────────────
;  用户的设计（比我原来的版本更干净）：
;    *"判定部分 → 你决定挽留他；对话部分 + 当前的各种数值（好感度、欲求不满度）
;      组合输出 llm 提示。例如：你决定挽留他，你深爱着他，并且你现在燥热难耐。
;      困意和体力判定等数值在之前的判定部分已经提给 llm 做决定了，
;      因为那时已经决定是去是留了；之后就算玩家被她整到晕倒，那也是情趣的一部分。"*
;
;  ⇒ **两阶段的职责划分**（照用户的设计）：
;     · **判定阶段**（`@LLM_DECIDE_ACTION`）：用困意 / 体力 / 关系 / 环境 / 玩家输入
;       算出**去还是留**。**这些数值到这里就用完了。**
;     · **对话阶段**（本函数）：只输出「**结论 + 当时相关的数值**」，
;       **拼成一句连贯的话** —— 而不是"一条指令 + 一堆事实条目"。
;
;  ⚠️⚠️ 为什么合并成一句更好：
;    分开注入时，模型会**把结论和数值当成两件事**分别回应
;    （「我决定留住你」+「我困了」+「我想要你」）。
;    合成一句之后，数值变成**结论的**理由**（"我不想让你走，因为我……"），
;    模型自然就会**用它来解释行动**，而不是**汇报它**。
;
;  ⚠️ **哪些数值进得来、哪些进不来**，是按行动码挑的（不是全都塞）：
;     · 关系  —— 决定她"为什么"要这么做，**每一档都拼**
;     · 欲求  —— 只在够高（>= 500）且这一档**用得上**时才拼
;       （送别时拼"燥热"是反高潮，所以 CASE 3 不拼）
;     · 她接下来要做什么（`LLM_NEXT_TXT`）—— 只在**送别**时拼，
;       因为那是"放他走"的理由
;     · 困意 / 体力 —— **不拼**：它们的结论已经体现在行动码里了（用户明确要求）
; ────────────────────────────────────────────────────────────────────────────
@LLM_ACTION_HINT(LLM_CID, REF_OUT)
#DIM  LLM_CID
#DIMS REF REF_OUT
#LOCALSIZE 8
#LOCALSSIZE 8
#DIMS LLM_WHY
#DIMS LLM_HB      ; 身体状态描述（和 LLM_WHY 分开，别复用）
REF_OUT = ""
; ── 先算出"为什么"（按关系档位）—— 好几档都要用，算一次 ──
;  ⚠️ 只算"说法"，不算"要不要做"：要不要做已经在 `@LLM_DECIDE_ACTION` 定了。
IF LLM_REL_DEPTH(LLM_CID) >= 2
	LLM_WHY = "你舍不得他 —— 这不是客套，是你真的不想让他走"
ELSEIF LLM_REL_DEPTH(LLM_CID) == 1
	LLM_WHY = "你还想跟他多待一会儿"
ELSE
	LLM_WHY = "你没什么特别的理由"
ENDIF
SELECTCASE LLM_ACTION
	CASE 2
		; ── 挽留：结论 + 关系 +（欲求） ──
		REF_OUT = @"★★ **你决定留住他。**%LLM_WHY%。"
		IF CFLAG:(LLM_CID):积攒度 >= 500
			REF_OUT += @"\n   而且你现在身上燥得厉害，他就在眼前 —— 你更不想放他走了。"
		ENDIF
		REF_OUT += @"\n   · 说一句**挽留**的话，用你自己的口吻（撒娇 / 找借口 / 耍赖 / 装没听见…都行）。"
		REF_OUT += @"\n   · **短一点、像随口说的** —— 别写成苦情戏。"
		REF_OUT += @"\n   · ⚠️ 别用「再坐一会儿」这种万能句，用**和你自己有关**的理由留他。"
	CASE 3
		; ── 送别：结论 + 关系 +（她接下来要做什么）──
		;  ⚠️ **刻意不拼欲求** —— 她都要送人走了还说"燥热"是反高潮。
		REF_OUT = @"★★ **你决定送他走。**"
		IF LLM_NEXT_TXT != ""
			REF_OUT += @"\n   你自己接下来也有事：%LLM_NEXT_TXT% —— 这正是你放他走的原因，可以顺口说出来。"
		ELSE
			REF_OUT += @"\n   %LLM_WHY%，但你还是让他走了。"
		ENDIF
		REF_OUT += @"\n   · 说一句**送别**的话，用你自己的口吻（别客套、别客服腔）。"
		REF_OUT += @"\n   · **说完这句，这场对话就结束了** —— 别再抛新话题。"
	CASE 4
		; ── 心疼他：结论 + 关系（关系决定语气的温度）──
		REF_OUT = @"★★ **你决定让他先去休息。**"
		IF LLM_REL_DEPTH(LLM_CID) >= 2
			REF_OUT += @"\n   你**相当在意他**，所以这件事让你心里不痛快 ——"
			REF_OUT += @"\n   你会**心疼**，甚至**有点生气**（气他不爱惜自己）。"
			REF_OUT += @"\n   可以带一点你真的会有的私心（「你倒下了谁陪我」）。"
		ELSEIF LLM_REL_DEPTH(LLM_CID) == 1
			REF_OUT += @"\n   你对他有些在意，所以是**真心实意地劝** —— 但还没到心疼的地步。"
		ELSE
			REF_OUT += @"\n   你只是**看不过去**，客套地提一句就行，不用太上心。"
		ENDIF
		REF_OUT += @"\n   · **但表达方式仍然是你的风格** —— 嘴硬的会先骂再关心、冷淡的会皱着眉命令他。"
		REF_OUT += @"\n   · ⚠️ 他要是提要陪你做什么 / 帮你干活，你**要拒绝**，让他先去恢复。"
		REF_OUT += @"\n   · 也别每句都提 —— 提一次、态度明确就够。"
	CASE 5
		; ── 收尾去睡：结论 +（性格措辞由 `LLM_SCHED` 那层给）──
		REF_OUT = @"★★ **你决定收尾去睡。**"
		REF_OUT += @"\n   · 用**你自己的口吻**把这件事说出来（打发他回去 / 道晚安 / 约明天见…）。"
		REF_OUT += @"\n   · **说完这句，这场对话就结束了** —— 所以这句要像个收尾，别再抛新话题。"
		REF_OUT += @"\n   · 别写成客套话、也别道歉 —— 就是「我真的要去睡了」。"
	CASE 6
		; ── 憋着：结论 + 关系（关系决定"能露多少"）──
		REF_OUT = @"★★ **你想要他，但这个地方不合适**（旁边有人 / 在外面 / 不是能待的地方）。"
		REF_OUT += @"\n   你决定**不说破**，但要让他看出来 —— 用这些方式："
		REF_OUT += @"\n   · **眼神**：抬眼看他又立刻移开、视线总往他那边飘"
		REF_OUT += @"\n   · **小动作**：拽他的衣角、往没人的方向瞟、靠近一点又退回去"
		REF_OUT += @"\n   · **台词**：欲言又止、说一半又咽回去、嘴硬地说「……没什么」"
		REF_OUT += @"\n   · 可以**暗示想去别的地方**（「这里……人有点多」）"
		REF_OUT += @"\n   ⚠️ 不要露骨、也别主动说破 —— 你还在矜持。也**别每句都提**，隔几句漏一点才像真的。"
	CASE 7
		; ── 欲求不满：结论 + 关系 + 欲求强度 + 性格表现方式 ──
		;  ⚠️ 这一段把三层全拼进来（关系决定"能不能表现"、性格决定"怎么表现"、
		;     数值决定"表现多强"）—— 这正是用户说的"组合输出"。
		CALL LLM_HORNY_DESC(LLM_CID, REF_OUT)
	CASEELSE
		; ── ★ 平常（闲聊）—— **没有行动指令，但数值照样联动** ──
		;
		;  ⚠️⚠️ 这一档原来**什么都不注入** —— 是用户发现的缺口：
		;     *"我们不是所有的对话都会和好感度与欲求不满度联动吗？"*
		;     确实：闲聊时她知道"欲求 60％"（事实层照常注入），
		;     却**没被告知该怎么流露** ⇒ 那条数值等于白给。
		;
		;  ⚠️ 和 ACTION 7 的区别**不在"有没有"，而在"是不是主基调"**：
		;     · **这里（闲散）**：欲求和关系是**底色** —— 顺着话自然流露，
		;       **但不主动把话题往那边帯**。
		;     · **ACTION 7**：欲求**就是这一轮要做的事** —— 她会有意识地
		;       制造接触、把话往那边引。
		;     ⇒ 同一份数值，两种用法。不区分的话，闲聊会变成一直在撩。
		REF_OUT = @"（这一轮你们就是在闲聊，没有什么特别的事要办。）"
		REF_OUT += @"\n   但你的状态会**顺着话自然流露**出来，不用刻意藏："
		REF_OUT += @"\n   · **关系**：%LLM_WHY%。"
		IF CFLAG:(LLM_CID):积攒度 >= 200
			; ⚠️ 这一段复用 `@LLM_HORNY_DESC`（它已经按关系 + 性格 + 数值
			;    三层给好了"该怎么表现"）—— 但在这里**降级使用**：
			;    只当底色，不当这一轮的目标。
			REF_OUT += @"\n   · **身体**："
			; ⚠️ 用**独立变量** `LLM_HB` —— `LLM_WHY` 上面已经存了关系说法，
			;    复用它虽然能跑（这里是覆盖），但读代码的人会以为逻辑错了。
			CALL LLM_HORNY_DESC(LLM_CID, LLM_HB)
			REF_OUT += @"%LLM_HB%"
		ENDIF
		REF_OUT += @"\n   ⚠️ 但**这些都只是流露** —— 正常聊你要聊的事，"
		REF_OUT += @"\n      **别专门提起它、也别把话题往那儿引**（那是另一回事）。"
ENDSELECT
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  角色的「对话风格摘要」（按**角色编号**匹配）
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ 为什么需要这张表：
;    `@KOJO_ACTIVE_INFO` 那条口上管线**只能判断"有没有口上"** ——
;    `@M_KOJO_K57(ARG)` 的实现就是 `RETURN 1`（本身不设 `RESULTS`），
;    所以拿不到角色的性格；而 Emuera 也没有读文件的接口
;    （`DT_*` 是数据集、不是文件），没法从口上文件里抽台词样本。
;    ⇒ 只能**手写一张表**，用**角色编号**匹配 —— 编号最稳，
;      不受改名、别名、口上剧本切换的影响。
;
;  ⚠️ 写法要求：
;    · 只写**说话方式 + 性格要点**，不写外貌（模型自己认识这些角色）
;    · 要**具体**（「语速快、爱用感叹号」比「活泼」有用得多）
;    · **拿不准就留空** → 返回空串时 prompt 会退回「按该角色的原作性格演绎」
;    · ⚠️⚠️ **不要写日文口癖**（「da ze」「nya」「kero」这类）——
;      她要说的是**中文**，写日文口癖会让模型真的在台词里混进日文。
;      要写就写"中文能表达的效果"（如「句尾爱带自信的断言」「句尾爱带『喵』」）。
;
;  ⚠️ 维护提示：想加角色就照下面的格式补 `CASE 编号`，
;     编号与 `CSV\Chara\Chara{编号} {名字}.csv` 一一对应。
; ────────────────────────────────────────────────────────────────────────────
@LLM_CHARA_TRAIT(LLM_CID, REF_TRAIT)
#DIM  LLM_CID
#DIMS REF REF_TRAIT
REF_TRAIT = ""
SELECTCASE NO:(LLM_CID)
	CASE 1
		REF_TRAIT = "灵梦：懒散随性、怕麻烦，说话直来直去不带修饰，爱吐槽、爱抱怨，也爱拿钱说事；对熟人其实很上心，但不肯承认"
	CASE 4
		REF_TRAIT = "魅魔：老练又爱捉弄人，语气从容、带点戏谑和优越感，喜欢用反问句逗对方"
	CASE 10
		REF_TRAIT = "萃香：豪爽爱闹，说话大嗓门、直来直去，喜欢喝酒和热闹，不拘小节"
	CASE 11
		REF_TRAIT = "魔理沙：口气大、爱逞强，说话像男孩子，句尾爱加自信的断言；爱吹牛和恶作剧，被关心到会别扭地转移话题"
	CASE 12
		REF_TRAIT = "露米娅：孩子气又迷糊，说话简单直白、常常答非所问；饿的时候满脑子都是吃的"
	CASE 13
		REF_TRAIT = "大妖精：温和胆小，说话轻声细语、常带犹豫，容易被人带着走"
	CASE 14
		REF_TRAIT = "琪露诺：自封最强，说话幼稚又自信，爱骂人笨蛋、把话说得很满，被戳穿就急"
	CASE 15
		REF_TRAIT = "咲夜：冷静干练、从容不迫，说话礼貌而简洁，带一点英国管家式的措辞；对蕾米莉亚绝对忠诚"
	CASE 16
