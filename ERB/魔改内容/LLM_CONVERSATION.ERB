		LLM_TOUCH_OK = 0
		; ⚠️ **不结算时也要记下原因** —— 让**下一轮**的 prompt 能让她对此有反应。
		;    用户要求："不结算时能不能让我们的 llm 也有反馈，说一直摸会不会有点奇怪之类的话，
		;              当然这个肯定是要跟人设来的。"
		;    ⇒ 这里只记**事实原因**，怎么说是她自己（由人设/关系决定）。
		LLM_TOUCH_NOTE = 0
		IF CFLAG:(LLM_CID):睡眠 || CFLAG:(LLM_CID):陪睡中
			LLM_TOUCH_NOTE = 2          ; 她睡着 / 陪睡中
		ELSEIF CFLAG:(LLM_CID):行動 == 5
			LLM_TOUCH_NOTE = 3          ; 她在工作
		ELSEIF BASE:MASTER:気力 <= 0
			LLM_TOUCH_NOTE = 4          ; 他自己气力见底
		ELSEIF FLAG:70
			LLM_TOUCH_NOTE = 5          ; 停止中
		ELSEIF TIME_PROGRESS(TCVAR:303) < 60 && !IS_DATING_WITH_PLAYER(LLM_CID) && ABL:(LLM_CID):親密 <= 5
			LLM_TOUCH_NOTE = 1          ; ★ **1 小时内已经碰过了** ← 最常见的一种
			;  ⚠️ **`親密 > 5`（即第 3 档起）不判冷却** —— 用户定：
			;     "亲密大于 5 之后不再有一小时内第二次的限制，可以自由身体接触"
			;     "**第三档开始就没有冷却吧**" ✓
			;  ⇒ 和下面的收益档**正好对齐**：
			;       第 1 档 ≤3  → 有冷却
			;       第 2 档 ≤5  → 有冷却
			;       第 3 档 6~10 → **无冷却**
			;       第 4 档 ≥11  → 无冷却
			;     都到这一步了还掐着表太见外 ✓
		ENDIF
		; ★★ **不结算时要在明细里给玩家一行提示** ——
		;  用户要求：「摸完以后不能应该体现在对话之中，有提示（刚刚才亲密接触完），
		;            然后 llm 会有拒绝相关的言论『刚刚不是才摸过吗 不可以』」
		;  ⚠️⚠️ 之前这里**只记了原因给下一轮的 prompt 用**，**界面上什么都没有** ⇒
		;     玩家看到的是「摸了但完全没反应」，根本不知道是冷却还是坏了 ⚠️
		;  ⚠️ 所以两份都要：`LLM_MSG` 给**玩家**看事实，`LLM_TOUCH_NOTE` 给**她**看原因 ✓
		IF LLM_TOUCH_NOTE != 0
			SELECTCASE LLM_TOUCH_NOTE
				CASE 1
					; ⚠️ 用户要求："提示变成（身体接触奖励冷却中）"
				;  ⇒ **只说明"这次没有奖励"**，不评价她该不该接受 ✓
				LLM_MSG += @"（身体接触奖励冷却中）"
									CASE 2
					LLM_MSG += @"（她睡得正沉。）"
				CASE 3
					LLM_MSG += @"（她正忙着，手上没停。）"
				CASE 4
					LLM_MSG += @"（你实在没力气了。）"
				CASE 5
					LLM_MSG += @"（现在不是做这种事的时候。）"
			ENDSELECT
		ENDIF
		IF CFLAG:(LLM_CID):睡眠 == 0 && CFLAG:(LLM_CID):陪睡中 == 0 && CFLAG:(LLM_CID):行動 != 5 && BASE:MASTER:気力 > 0 && !FLAG:70
			; ⚠️⚠️ **两处必须同时改**（上面记原因、这里定准入）——
			;     只改一处会出现"受理了、却又说离上次不到一小时"的自相矛盾。
			;     （这正是 §2.4b 那条教训：加条件前先 grep 它出现在几处。）
			;  ⚠️ 条件和上面**互补**（德摩根律）：那边 `親密 <= 5 且未约会且不到 60 分`
			;     才记冷却；这里 `已过 60 分 或 约会中 或 親密 > 5` 就受理 ✓
			SIF TIME_PROGRESS(TCVAR:303) >= 60 || IS_DATING_WITH_PLAYER(LLM_CID) || ABL:(LLM_CID):親密 > 5
				LLM_TOUCH_OK = 1
		ENDIF
		IF LLM_TOUCH_OK
			LLM_TOUCH_NOTE = 0          ; 受理了 → 清掉，别让她下一轮还提
			; ── ① 气力消耗（照抄 `COMF302:80-81`）──
			;  ⚠️⚠️ 官方扣的是**双方各 30**。`DOWNBASE` 是"**待扣量**"，
			;     必须 `CALL SOURCE_DOWNBASE(角色)` 结算**并手动清零** ——
			;     这是本项目栽过多次的铁律，不清零会累积到下一轮。
			DOWNBASE:(LLM_CID):気力 += 30
			DOWNBASE:MASTER:気力 += 30
			CALL SOURCE_DOWNBASE(LLM_CID)
			CALL SOURCE_DOWNBASE(MASTER)
			DOWNBASE:(LLM_CID):気力 = 0
			DOWNBASE:MASTER:気力 = 0

			; ── ② 固定 SOURCE（照抄 `:84-88`）──
			;  ⚠️ 这四条是**赋值**（`=`），会**覆盖**同轮别的来源 —— 照抄，别自作聪明。
			SOURCE:(LLM_CID):歓楽 = 100
			SOURCE:(LLM_CID):情愛 = 100
			SOURCE:(LLM_CID):露出 = 20
			SOURCE:(LLM_CID):反感 = 50

			; ── ③ 按 `ABL:親密` 分档加成（照抄 `:90-108`）──
			;  ⚠️ 这是**主体**，我第一版整段漏了 —— 越亲密收益越大，但**分六档**。
			IF ABL:(LLM_CID):親密 <= 1
				SOURCE:(LLM_CID):情愛 += (ABL:(LLM_CID):親密 * 30)
			ELSEIF ABL:(LLM_CID):親密 <= 3
				SOURCE:(LLM_CID):歓楽 += 100 + (ABL:(LLM_CID):親密 * 40)
				SOURCE:(LLM_CID):情愛 += 200 + (ABL:(LLM_CID):親密 * 30)
			ELSEIF ABL:(LLM_CID):親密 <= 5
				SOURCE:(LLM_CID):歓楽 += 400 + (ABL:(LLM_CID):親密 * 50)
				SOURCE:(LLM_CID):情愛 += 400 + (ABL:(LLM_CID):親密 * 30)
			ELSEIF ABL:(LLM_CID):親密 <= 8
				SOURCE:(LLM_CID):歓楽 += 700 + (ABL:(LLM_CID):親密 * 60)
				SOURCE:(LLM_CID):情愛 += 600 + (ABL:(LLM_CID):親密 * 40)
			ELSEIF ABL:(LLM_CID):親密 <= 11
				SOURCE:(LLM_CID):歓楽 += 1200 + (ABL:(LLM_CID):親密 * 80)
				SOURCE:(LLM_CID):情愛 += 800 + (ABL:(LLM_CID):親密 * 40)
			ELSE
				SOURCE:(LLM_CID):歓楽 += 2000 + (ABL:(LLM_CID):親密 * 50)
				SOURCE:(LLM_CID):情愛 += 1800 + (ABL:(LLM_CID):親密 * 20)
			ENDIF

			; ── ④ 按好感度加成（照抄 `:110-119`）──
			IF CFLAG:(LLM_CID):2 <= 500
				SOURCE:(LLM_CID):歓楽 += CFLAG:(LLM_CID):2
			ELSEIF CFLAG:(LLM_CID):2 <= 5000
				SOURCE:(LLM_CID):歓楽 += 500 + (CFLAG:(LLM_CID):2 - 500) / 3
			ELSE
				SOURCE:(LLM_CID):歓楽 += 2000 + (CFLAG:(LLM_CID):2 - 5000) / 5
			ENDIF
			SIF SOURCE:(LLM_CID):歓楽 < 0
				SOURCE:(LLM_CID):歓楽 = 0

			; ── ⑤ ★「她反不反感」（照抄 `:121-137`）──
			;  ⚠️⚠️ **两个值都要够**才不掉好感：
			;       好感 > 250　且　親密 >= 3
			;     这是官方判据，不是我们拍的。
			LLM_TOUCH_P = 0
			IF ABL:(LLM_CID):親密 == 0
				LLM_TOUCH_P -= 3
			ELSEIF ABL:(LLM_CID):親密 == 1
				LLM_TOUCH_P -= 2
			ELSEIF ABL:(LLM_CID):親密 == 2
				LLM_TOUCH_P -= 1
			ENDIF
			IF CFLAG:(LLM_CID):2 <= 50
				LLM_TOUCH_P -= 3
			ELSEIF CFLAG:(LLM_CID):2 <= 100
				LLM_TOUCH_P -= 2
			ELSEIF CFLAG:(LLM_CID):2 <= 250
				LLM_TOUCH_P -= 1
			ENDIF
			LLM_D1 += LLM_TOUCH_P
			; ── ⑥ 受人型 SOURCE（照抄 `:140-141`）──
			;  ⚠️ 官方这两条是**赋值**不是累加 —— 照抄。
			SOURCE:(LLM_CID):受動 = 100 + 200 * ABL:(LLM_CID):従順
			SOURCE:(LLM_CID):征服 = 100 + 200 * ABL:(LLM_CID):施虐属性

			; ── ⑦ 情绪加成 / 时间 / 冷却戳（照抄 `:156/164/170`）──
			;  ⚠️ 官方还有"成败倍率"（失败 ×0.1/0.5、大成功 ×2.0）——
			;     对话里**不掷骰**，所以固定按"成功"档（×1.00、情绪 +20）✓
			TFLAG:情緒BONUS = 20
			TIME += 10
			TCVAR:303 = 1440 * DAY + TIME
			; ── ⑦b ★★ **身体接触的收益**（三档，用户定）──
			;  ⚠️⚠️ 这一层**官方没有**（官方 `COMF302` 只扣不加）—— 是我们加的。
			;     设计定位（用户）："**普通对话的进阶、性骚扰的前奏**，
			;     是和角色真正步入亲密关系的前奏。"
			;
			;  ⚠️ **分档依据是 `ABL:親密`** —— 而親密 5+ 是"满好感 + 信赖 1600+"
			;     才会自动跳上去的（`EVENTTURNEND.ERB:23-28` 的 `SQRT(信赖)/8`）。
			;     所以"能否接受更深的行为"跟着它走，是有官方依据的 ✓
			;
			;  ⚠️ **走陪伴同款：直接 `CFLAG:2 += N`** —— 绕过台词的"单场 ±10"上限。
			;     这是"动作"不是"台词"。
			;
			;  | 親密 | 能接受 | 好感 | 信赖 | 欲求不满 | 理性 |
			;  |------|--------|------|------|----------|------|
			;  | <=3  | 轻度（握手/摸头）| +10 | +5  | — | — |
			;  | <=5  | 牵手/靠肩等较亲密 | +30 | +20 | +上限5% | -50 |
			;  | >5   | **什么都行（含性骚扰）** | +30 | +20 | +上限5% | -50 |
			LLM_TF = 0
			LLM_TT = 0
			;  ⚠️ **情绪（`LLM_D2`）也随档位** —— 用户提醒："我们忘记情绪值的增减了，
			;     这个也要随动"。身体接触本身就该让她心情变好，越亲密越好 ✓
			LLM_TE = 0
			IF ABL:(LLM_CID):親密 <= 3
				; ── 第 1 档：只能接受"轻度"（握手 / 摸头）──
				LLM_TF = 10
				LLM_TT = 5
				LLM_TE = 10
			ELSEIF ABL:(LLM_CID):親密 <= 5
				; ── 第 2 档：**思慕门槛** —— 可以牵手 / 靠肩 ──
				LLM_TF = 30
				LLM_TT = 20
				LLM_TE = 20
			ELSEIF ABL:(LLM_CID):親密 <= 10
				; ── 第 3 档：比刚思慕更亲密，**但还没到恋慕** ──
				;     ⚠️ 用户定："亲密 7 比较合理 —— 没达到恋慕，
				;        但也比刚思慕更亲密，这个时候**性骚扰可以被接受，
				;        但也只是被接受**。"
				;     ⇒ 所以这一档开始，露骨的话（t=2）也走收益层
				;       （门槛 `>= 7`，见下面 ⑨ 的关系分级）
				LLM_TF = 50
				LLM_TT = 30
				LLM_TE = 30
			ELSE
				; ── 第 4 档：**恋慕达成**（用户定"亲密 11"）──
				;     官方界面写的是"亲密 10 以上"，用户取 **11** 作为达成线 ✓
				LLM_TF = 80
				LLM_TT = 50
				LLM_TE = 40
			ENDIF

			; ── ⑦b2 情绪落地（叠加到模型给的值上，用 += 别覆盖）──
			SIF LLM_TE > 0
				LLM_D2 += LLM_TE

			; ── ⑦c 好感 / 信赖落地 ──
			; 好感：**直接加**（陪伴同款，绕过台词上限）
			;  ⚠️ 1000000 是游戏自己用的上限（`TRACHECK_好感度上昇処理.ERB:415`）
			; ★ **浮动**（用户要求："把固定加的好感度和信赖值也改成浮动"）——
			;  ⚠️ 每次 ±20%，避免"每次摸都涨一样多"的死板手感 ✓
			; ★★ 同时**记下"浮动结果相对基准偏高还是偏低"**，给**下一轮**的台词用 ——
			;    用户要求："可以根据浮动微调一下角色的 LLM 回复" ✓
			;    ⚠️ 时序：浮动在她说完**之后**才算出来 ⇒ 只能影响下一轮 ✓
			LLM_TF0 = LLM_TF
			LLM_TT0 = LLM_TT
			SIF LLM_TF > 0
				LLM_TF = LLM_VARY(LLM_TF)
			SIF LLM_TT > 0
				LLM_TT = LLM_VARY(LLM_TT)
			SIF LLM_TE > 0
				LLM_TE = LLM_VARY(LLM_TE)
			; 判断"这一下比别人平均值更受用，还是更平淡"
			LLM_FEEL = 0
			IF LLM_TF > LLM_TF0 || LLM_TT > LLM_TT0
				LLM_FEEL = 1
			ELSEIF LLM_TF < LLM_TF0 || LLM_TT < LLM_TT0
				LLM_FEEL = -1
			ENDIF
			SIF LLM_TF > 0
				CFLAG:(LLM_CID):2 = LIMIT(CFLAG:(LLM_CID):2 + LLM_TF, 0, 1000000)
			; 信赖：走官方的 `TFLAG:信頼度管理`（和陪伴/帮忙同款）
			SIF LLM_TT > 0
				TFLAG:信頼度管理 += LLM_TT
			; ⚠️⚠️ **必须置这两个标志，否则 ④e 的官方结算根本不会跑！**
			;    用户实测："还是没有加信赖 莫名其妙的" ——
			;    根因就是**这里漏了标志**：
			;      · ④e 的闸门是 `IF LLM_SRC_ANY || LLM_TRST_ANY`
			;      · 身体接触**写了 SOURCE、写了信赖档位，却一个标志都没置**
			;      ⇒ `TRUST_CALC` 不跑 ⇒ 档位白写（还会残留到下一轮）⚠️
			;
			;  ⚠️ 对照组：**陪伴 / 帮忙**在 `:4843-4844` / `:5018-5019`
			;     都置了这两个标志 ⇒ 所以它们的信赖**一直是正常的** ✓
			;     （用户问："陪伴工作之类的时候为什么信赖是正常增加的" —— 就是这个差别。）
			;
			;  ⚠️ 教训：**"写了累积量"和"打开结算闸门"是两件事**，
			;     漏了后者就是**静默失效**（本项目同类 bug 第五个）。以后加新的
			;     `SOURCE` / `TFLAG:信頼度管理` 写入点时，**必须同时置标志** ✓
			LLM_SRC_ANY = 1
			LLM_TRST_ANY = 1

			; ── ⑦d 欲求不满 +5% / 理性下降（親密 > 3 才有）──
			;  ⚠️ 欲求不满度**必须钳到上限**（`@积攒度上限` 自己按关系分档）
			;  ⚠️ 欲求/理性也**跟着四档走**（第 1 档不动）
			LLM_TP = 0
			IF ABL:(LLM_CID):親密 > 3 && ABL:(LLM_CID):親密 <= 5
				LLM_TP = 5
			ELSEIF ABL:(LLM_CID):親密 > 5 && ABL:(LLM_CID):親密 <= 10
				LLM_TP = 8
			ELSEIF ABL:(LLM_CID):親密 > 10
				LLM_TP = 12
			ENDIF
			IF LLM_TP > 0
				CFLAG:(LLM_CID):积攒度 += 积攒度上限(LLM_CID) * LLM_TP / 100
				CFLAG:(LLM_CID):积攒度 = MIN(CFLAG:(LLM_CID):积攒度, 积攒度上限(LLM_CID))
; ⚠️⚠️ 抑制力：按欲求档位等比降（5% / 8% / 12%）——
;     ⚠️ **必须按 `MAXBASE` 算比例，不能硬扣 50/80/120**：
;        官方 `BASE自然変動.ERB:102` 是 `LIMIT(理性, 0, MAXBASE:理性)`
;        ⇒ 上限由角色决定、**不一定是 1000** ⚠️
	BASE:(LLM_CID):理性 = MAX(BASE:(LLM_CID):理性 - MAXBASE:(LLM_CID):理性 * LLM_TP / 100, 0)
			ENDIF

			; ── ⑧ 提示 + 明细 ──
			;  ⚠️ SOURCE（歓楽/情愛/露出/反感）**要等回合末**才由 `@SOURCE_CHECK`
			;     换算成 PALAM，对话里根本算不出来 ⇒ **不能写进明细**（写了就是骗人）。
			;     能立刻确定的只有**气力**和**时间** ⇒ 只显示这两个。
			IF LLM_TOUCH_P < 0
				LLM_MSG += @"（你想碰她，她微微躲了一下。）"
			ELSE
				LLM_MSG += @"（身体接触，她并不排斥。）"
			ENDIF
			; ⚠️ 双方各扣 30 —— 明细里标"（双方）"以免误以为是单方消耗
			CALL LLM_GAIN_COST(LLM_MSG, "气力（双方）", 30)
			; ★ 额外好感 / 信赖（这一层是官方没有、我们加的，见 ⑦b）
			CALL LLM_GAIN_GET(LLM_MSG, "好感度", LLM_TF)
			; ⚠️⚠️ **不在这里显示信赖度** —— 用户实测发现「怪怪的」：
			;    明细写「信赖度＋2」、实际涨了 5 ⚠️
			;    根因：这里只是**投入量**，而 `@TRUST_CALC` 会再按
			;    亲密度/心情/性格修正一次 ⇒ 落地的值与这里写的**不是一回事**。
			;  ⇒ 改成在 ④e **结算之后**算**实际差值**，统一显示（见 ④f）✓
			CALL LLM_GAIN_GET(LLM_MSG, "情绪", LLM_TE)
			; ⚠️ 欲求不满 / 理性 只在親密 > 3 时动（和上面同一判据）
	; ⚠️ 显示"抑制力"而不是"理性" —— 玩家看不懂"理性－50"；
	;    而"抑制力"直接对应"她更容易越界"，那是玩家能感知的 ✓
	CALL LLM_GAIN_COST(LLM_MSG, "抑制力", MAXBASE:(LLM_CID):理性 * LLM_TP / 100)
		ENDIF
	ENDIF


	; ══ ⑦e ★★ **记录"按行为的合意"**（持久化）═══════════════════════════════
	;  用户要求："把角色持久记忆里增加各种合意 —— 如牵手、拥抱、揉胸之类的
	;  互动时的合意。这些合意可以偶尔被 llm 提起，如果其欲求不满度较高
	;  甚至会主动请求玩家做某事。"
	;
	;  ⚠️ 和 `CFLAG:態度` 的区别：那个是**总的**合意（0~3），**不区分行为**；
	;     这里**每个行为一条**（`LLM_AGREE`，见 `LLM_KOJO.ERH`）✓
	;  ⚠️ 只在**模型报了具体行为**（`LLM_D6`）时才动 —— 没报就什么都不做 ✓
	IF LLM_D6 >= 1 && LLM_D6 <= 7
		IF LLM_D4 >= 5 && LLM_D4 <= 7
			; 她**同意了**（亲密接触那三档）→ 至少记成"接受"
			;
			;  ⚠️⚠️ **必须同时要求 `LLM_TOUCH_OK`（真的受理了）** ——
			;     只判 `LLM_D4 >= 5` 是不够的：她**睡着 / 在工作 / 1 小时内重复过**
			;     的时候 `LLM_TOUCH_OK = 0`，**接触根本没发生**；
			;     那时候还记"接受"，就等于**记了一件没发生过的事** ⚠️
			;     （用户追问"之前拒绝了、现在亲密够高可以接受会不会有漏洞"时查出来的。）
			;  ⚠️⚠️ **必须 `IF … ENDIF`，不能写 `SIF`** ——
			;     `SIF` **只绑紧随的一行**，这里有三行要一起管：
			;       写成 `SIF LLM_TOUCH_OK` + 两个内层 `SIF`，
			;       第二个 `SIF CFLAG:態度 >= 3` 会**脱离保护、无条件执行** ⚠️
			;       （自查脚本抓到的，见避坑清单 §5j。）
			IF LLM_TOUCH_OK
				;  ⚠️ 只升不降（`< 2` 才写）—— 已经"乐意"的别被降回"接受"
				IF LLM_AGREE:(LLM_CID):LLM_D6 < 2
					; ★★ **这个行为是第一次被接受** ⇒ 在这里 roll 一次"最爱" ✓
					;  用户设计："只在第一次合意完成时出现；后来的也有机会顶掉
					;  前面的，但只有一次机会。"
					;  ⚠️ 「只有一次」靠 `LLM_FAVROLL` 的位标志记 —— 只 roll 一次 ✓
					CALL LLM_FAV_ROLL(LLM_CID, LLM_D6)
					LLM_FAV_HIT = RESULT
					; ★★ **`act=7`（脱衣服）⇒ 真的脱掉一件**（用户要求）——
					;  ⚠️ 用户说"在最爱里都整合成脱衣服就好，不用搞出那么多花样" ⇒
					;     **`act` 只有一个值（7）**，但**每次受理就脱掉最外面的一件** ✓
					;  ⚠️ 那是**改游戏状态**（`EQUIP`）—— 是整个对话系统里唯一这么做的地方 ⚠️
					;  ⚠️ mod 不在 ⇒ 静默跳过，不报错 ✓
					IF LLM_D6 == 7
						CALL LLM_STRIP_PART(LLM_CID, LLM_STRIP_WANT, LLM_STRIP_WHAT)
						IF LLM_STRIP_WHAT != ""
							LLM_MSG += @"（%CALLNAME:(LLM_CID)%的%LLM_STRIP_WHAT%被脱掉了。）"
							LLM_STRIPPED = 1
							; ⚠️ **换掉 act 的语义**：脱完之后，这一轮对"脱衣服"这件事
							;    就不再是"刚做了一次"了 ⇒ 记合意时算**成功过一次** ✓
							;    （`LLM_D6` 不动，照常记进 `LLM_AGREE` / `LLM_PREF`）✓
						ELSE
							; 已经全裸、没得脱了 ⇒ 这一轮不算"真的脱成"
							LLM_MSG += @"（她已经没剩什么可脱的了。）"
						ENDIF
					ENDIF
					; ★ **记一笔「他对这个角色做过什么」** —— 累积出「他的偏好」✓
					;  ⚠️ 用户纠正过：这是**按角色**的，不是跨角色的全局偏好 ✓
					LLM_PREF:(LLM_CID):LLM_D6 = MIN(LLM_PREF:(LLM_CID):LLM_D6 + 1, 9999)
					LLM_AGREE:(LLM_CID):LLM_D6 = 2
					; ★ 中了 ⇒ **三重反馈**（用户要求："中了最爱时应该有一些文本提示，
					;   并且 llm 会根据这段文本生成符合「最爱」的对应文本"）：
					;     ① 当场给玩家一行提示
					;     ② 这一轮的收益**加成**（×1.5，取整至少 +1）
					;     ③ 把"感觉"档位拉到最高（2）⇒ **下一轮**她表现得更投入 ✓
					;   ⚠️ 时序：roll 发生在她说完**之后**，所以"她的表现"只能到下一轮 ✓
					IF LLM_FAV_HIT
						CALL LLM_AGREE_NAME(LLM_D6, LLM_FAV_NAME)
						LLM_MSG += @"（……她好像特别喜欢%LLM_FAV_NAME%。）"
						; 收益加成：好感 / 信赖 / 情绪 各 ×1.5
						LLM_TF = LLM_TF + MAX(LLM_TF / 2, 1)
						LLM_TT = LLM_TT + MAX(LLM_TT / 2, 1)
						LLM_TE = LLM_TE + MAX(LLM_TE / 2, 1)
						LLM_FEEL = 2
					ENDIF
				ENDIF
				; ★ **"乐意"的判据**：官方 `CFLAG:態度 >= 3`（"会主动迎合"）
				;  ⇒ 到这一步她已经不只是"接受"了，升到 3 ✓
				;  ⚠️ 这样值 3 才不会变成**永远设不上的死值**
				IF CFLAG:(LLM_CID):態度 >= 3
					LLM_AGREE:(LLM_CID):LLM_D6 = 3
				ENDIF
			ENDIF
		ELSEIF LLM_D4 == 2
			; 她**没同意**（拒绝 / 被拒还来）→ 记成"拒绝过"
			;  ⚠️ 这里**可以覆盖** —— "拒绝过"是更近的事实，该盖掉旧的"接受"
			;  ⚠️ 但**不是永久的**：她后来亲密够了、同意了，上面的分支会把 1 升回 2 ✓
			;     （用户问的正是这个 —— 设计上**允许恢复**，不是一票否决。）
			LLM_AGREE:(LLM_CID):LLM_D6 = 1
		ENDIF
	ENDIF

; ⓪ 关系分级（只在"露骨的性骚扰 / 越界"时覆盖模型给的数）
;
;  ★ 顺便在这里累计「**连续越界轮数**」（存 `TCVAR:角色:337`）——
;    它是"她会不会主动推倒你"的判据之一（见 `@LLM_TRY_PUSH`）。
;    ⚠️ **只有关系够深时才累加** —— 关系浅的时候她是在**生气**，不是在心动；
;       那种越界不该让她"越想越来劲"，反而该把这个计数器清零。
IF LLM_D4 == 2
	; ══ 露骨的话（`t=2`）—— **按 `ABL:親密` 四档** ════════════════════════════
	;  ⚠️⚠️ 原来这里只有**三个粗分支**，判据还混用（关系档位 + 好感门槛 + 親密7），
	;     而**身体接触那侧早就做成了四档** ⇒ 两边不对称（用户指出）。
	;  ⇒ 现在统一成和身体接触**同样的四档、同样的判据（`ABL:親密`）** ✓
	;
	;  | 親密 | 她的反应 | 好感 | 情绪 | 愤怒 | 欲求 | 理性 |
	;  |------|----------|------|------|------|------|------|
	;  | <=3  | **讨厌 / 翻脸** | -5 | -40 | +150 | — | — |
	;  | <=5  | **尴尬、嗔怪** | -1 | -20 | +40 | — | — |
	;  | 6~10 | **害羞（被接受）** | +10 | +20 | -30 | +5% | -30 |
	;  | >=11 | **害羞 / 有点心动** | +20 | +40 | -40 | +8% | -50 |
	;
	;  ⚠️ 用户定："性骚扰**也只是被接受**" ⇒ **每一档收益都低于身体接触的对应档** ✓
	;     （第 3 档 +10 vs 身体接触 +50、第 4 档 +20 vs +80）
	;
	;  ⚠️⚠️ **不给信赖**（用户定："性骚扰不涨信赖比较好，因为毕竟是性骚扰嘛，
	;     对**身体的欲求**"）——
	;     · **身体接触** = 亲近 ⇒ 给**信赖**
	;     · **性骚扰**   = 欲望 ⇒ 给**欲求**、**不给信赖**
	;     ⇒ 所以这里的欲求给得比身体接触更狠（5% / 8% vs 身体接触的 5% / 12%... 见下）
	;     ⚠️ 这条区分很重要：**信赖是"信任"，不该被骚扰推进** ✓
	;
	;  ⚠️⚠️ **好感度走"直加 `CFLAG:2`"**（和身体接触同款）——
	;     走 `LLM_D1` 会被"单轮 ±3"钳掉，`+20` 变 `+3` 就白设计了 ✓
	LLM_SF = 0
	LLM_SE = 0
	LLM_SP = 0
	IF ABL:(LLM_CID):親密 <= 3
		; ── 第 1 档：翻脸 ──
		LLM_SF = -5
		LLM_SE = -40
		LLM_D3 = 150
		; 她在翻脸，不是在心动 → 清零
		TCVAR:(LLM_CID):337 = 0
	ELSEIF ABL:(LLM_CID):親密 <= 5
		; ── 第 2 档：尴尬、嗔怪 ──
		LLM_SF = -1
		LLM_SE = -20
		LLM_D3 = 40
		TCVAR:(LLM_CID):337 = 0
	ELSEIF ABL:(LLM_CID):親密 <= 10
		; ── 第 3 档：害羞（**被接受**）──
		; ⚠️ **不给信赖**（见上面的说明）
		LLM_SF = 10
		LLM_SE = 20
		LLM_SP = 5
		LLM_D3 = -30
		LLM_SEXY = 1
	ELSE
		; ── 第 4 档：恋慕达成 —— 害羞、甚至有点心动 ──
		; ⚠️ **不给信赖**（同上）
		LLM_SF = 20
		LLM_SE = 40
		LLM_SP = 8
		LLM_D3 = -40
		LLM_SEXY = 1
	ENDIF
	; ★★ **"会主动推倒你"仍然只认 `恋慕 / 爱欲 / 炮友`**（用户定）——
	;     ⇒ 第 3/4 档也**不累加越界轮数**：她可以"不介意"，
	;       但**不等于**"马上想推倒你"。两件事刻意分开 ✓
	;     （官方数据支持：思慕只要親密 5，恋慕要 10 ⇒ 親密 7~10 还远不够）
	SIF TALENT:(LLM_CID):恋慕 || TALENT:(LLM_CID):愛欲 || TALENT:(LLM_CID):炮友
		TCVAR:(LLM_CID):337 = MIN(TCVAR:(LLM_CID):337 + 1, 20)
	; ── 落地 ──
	; ★ **浮动**（同身体接触：±20%，避免死板手感）✓
	LLM_TF0 = LLM_SF
	SIF LLM_SF > 0
		LLM_SF = LLM_VARY(LLM_SF)
	SIF LLM_SE > 0
		LLM_SE = LLM_VARY(LLM_SE)
	; ★ 同上：记下"比基准好还是差"，给下一轮用 ✓
	LLM_FEEL = 0
	SIF LLM_SF > LLM_TF0 && LLM_TF0 > 0
		LLM_FEEL = 1
	SIF LLM_SF < LLM_TF0 && LLM_TF0 > 0
		LLM_FEEL = -1
	; 好感：**直加**（绕过台词 ±3/±10 上限）
	SIF LLM_SF != 0
		CFLAG:(LLM_CID):2 = LIMIT(CFLAG:(LLM_CID):2 + LLM_SF, 0, 1000000)
	; ⚠️ **没有信赖** —— 性骚扰不推进"信任"（用户定）✓
	; 情绪：叠加到模型给的值上（`+=`，别覆盖）
	SIF LLM_SE != 0
		LLM_D2 += LLM_SE
	; 欲求不满 / 理性（只在被接受的档位）
	IF LLM_SP > 0
		CFLAG:(LLM_CID):积攒度 += 积攒度上限(LLM_CID) * LLM_SP / 100
		CFLAG:(LLM_CID):积攒度 = MIN(CFLAG:(LLM_CID):积攒度, 积攒度上限(LLM_CID))
	BASE:(LLM_CID):理性 = MAX(BASE:(LLM_CID):理性 - MAXBASE:(LLM_CID):理性 * LLM_SP / 100, 0)
	ENDIF
	; ⚠️ `LLM_D1` 置 0 —— 好感已经直加了，再走台词通道就是**双重**
	LLM_D1 = 0


ELSEIF LLM_D4 == 3 || LLM_D4 == 4
	; 陪伴轮次：不算撩，但也不冷却（她可以一边干活一边被你撩着）
ELSE
	; 普通轮次：**慢慢冷却** —— 隔几轮不撩就会淡下去
	TCVAR:(LLM_CID):337 = MAX(TCVAR:(LLM_CID):337 - 1, 0)
ENDIF

; ⓪d ★ **信赖度**（数值块的第 5 个字段）—— 稀有加分项
;
;  ⚠️ 为什么单独给：信赖度在游戏里是**另一条线**（`CFLAG:角色:信赖度`），
;     靠 `TFLAG:信頼度管理` 这个"档位"经 `@TRUST_CALC` 换算而来。
;     所以这里只往档位里加，换算交给 ④e 的官方结算 —— 这样限幅、
;     亲密修正、愤怒修正全都自动生效，不用我们操心。
;  ⚠️ **上限 2**：模型偶尔会给大，钳住。设计上它就该是"整场一次"的量级。
;  ⚠️ 必须放在 ④e（官方结算）**之前** —— 否则加了也不会被换算。
LLM_D5 = LIMIT(LLM_D5, 0, 2)
IF LLM_D5 > 0
	; ⚠️⚠️ **不走 `TFLAG:信頼度管理` + `@TRUST_CALC`** —— 用户实测：
	;    "这个值没有和游戏内的真值联动，只是书面上写着增加了，实际并没有加" ✓
	;
	;  **根因**（读 `TRACHECK_信頼度上昇処理.ERB:265-275`）：
	;    `@TRUST_CALC` 末尾有这么一段 ——
	;      ```erb
	;      FOR LOCAL,0,100
	;          SIF SOURCE:ARG:LOCAL
	;              LOCAL:1 ++
	;      NEXT
	;      SIF !LOCAL:1
	;          信赖度上昇値 = 0        ← ★ 这一轮没有任何 SOURCE ⇒ **信赖度归零**
	;      ```
	;    ⇒ 而"台词交心"是**言语**，没有对应的官方 `SOURCE` ——
	;      于是闸门触发、归零，**书面写了 +N 实际一点没加** ⚠️
	;
	;  ⇒ 所以这里**直加信赖度本体**（`CFLAG:角色:4`）——
	;     这是**言语层**的量，官方那套"靠 SOURCE 换算"的机制覆盖不到它 ✓
	;  ⚠️ 代价：丢掉了 `@TRUST_CALC` 里的性格修正（亲密度/心情/献身…）——
	;     但那正是"为什么它会被归零"的原因，鱼与熊掌不可兼得 ✓
	;  ⚠️ 身体接触 / 陪伴 / 帮忙 那些**有 SOURCE** 的，照旧走 `@TRUST_CALC` ✓
	CFLAG:(LLM_CID):4 = LIMIT(CFLAG:(LLM_CID):4 + LLM_D5, 0, 1000000)
	; ⚠️⚠️ **不要设 `LLM_TRST_ANY`** —— 那是给 `@TRUST_CALC` 打开的闸门。
	;    已经直加了，再走一遍 `TRUST_CALC` 会**白送**它的基线加成
	;    （`信赖度上昇値 += ABL:親密 / 5`，见 `TRACHECK_信頼度上昇処理.ERB:25`）⚠️
	;    实测：`tr=5` 被钳成 2、直加 2，可信赖却涨了 **5** —— 那多出的 3
	;    就是这条基线（当时親密 15 ÷ 5 = 3）✓
	;  ⇒ 只有**身体接触 / 陪伴 / 帮忙**（它们写了 `SOURCE`）才需要开那个闸门 ✓
	;    那几处自己会设标志。
	SIF LLM_MSG != ""
		LLM_MSG += "　"
	; ⚠️ **这里也不显示数值** —— 同理，等 ④e 结算完统一用**实际差值**显示 ✓
	;    （用户实测：「明细写 +2、实际涨 5」⇒ 显示的必须是落地的值）
ENDIF

; ① 好感度：单轮 ±3，单场累计 ±10
LLM_D = LIMIT(LLM_D1, -5, 3)
SIF REF_ACC_FAVOR + LLM_D > 10
	LLM_D = 10 - REF_ACC_FAVOR
SIF REF_ACC_FAVOR + LLM_D < -10
	LLM_D = -10 - REF_ACC_FAVOR
IF LLM_D != 0
	CFLAG:(LLM_CID):2 += LLM_D
	; 0 ~ 1000000 是游戏自己用的界限（TRACHECK_好感度上昇処理.ERB:415）
	CFLAG:(LLM_CID):2 = LIMIT(CFLAG:(LLM_CID):2, 0, 1000000)
	REF_ACC_FAVOR += LLM_D
	; ⚠️⚠️ 这里必须是 `+=`（累加），**不能写 `LLM_MSG = "好感度"`** ——
	;     那样会把前面（⓪b 陪伴 / 帮忙）已经拼好的提示**整段覆盖掉**，
	;     表现就是"陪她干活/帮忙"那行根本不显示（只剩数值）。
	;     实测踩过：帮忙后只看到「体力－250 … 工作量＋115」，看不到「你帮她门番…」。
	;     而它有时又"看起来正常"，是因为那一轮好感度恰好没变化、没走到这里。
	SIF LLM_MSG != ""
		LLM_MSG += "　"
	LLM_MSG += "好感度"
	IF LLM_D > 0
		LLM_MSG += @"＋%TOSTR(LLM_D)%"
	ELSE
		LLM_MSG += @"－%TOSTR(-LLM_D)%"
	ENDIF
ENDIF

; ② 情緒：单轮 ±40，单场累计 ±200
;    （官方一次会话就是这个量级；上限用游戏自己的 MAXBASE）
LLM_D = LIMIT(LLM_D2, -40, 40)
SIF REF_ACC_MOOD + LLM_D > 200
	LLM_D = 200 - REF_ACC_MOOD
SIF REF_ACC_MOOD + LLM_D < -200
	LLM_D = -200 - REF_ACC_MOOD
IF LLM_D != 0
	BASE:(LLM_CID):情緒 += LLM_D
	BASE:(LLM_CID):情緒 = LIMIT(BASE:(LLM_CID):情緒, 0, MAXBASE:(LLM_CID):情緒)
	REF_ACC_MOOD += LLM_D
	SIF LLM_MSG != ""
		LLM_MSG += "　"
	LLM_MSG += "情緒"
	IF LLM_D > 0
		LLM_MSG += @"＋%TOSTR(LLM_D)%"
	ELSE
		LLM_MSG += @"－%TOSTR(-LLM_D)%"
	ENDIF
ENDIF

; ③ 愤怒：单轮 ±60
;    （官方一次轻冒犯 +139~+231、强吻 +578；上限由 MAXBASE 兜底。
;      "聊到一半被激怒"另有本场累积判定，见 @LLM_REFUSE_REASON）
LLM_D = LIMIT(LLM_D3, -60, 60)
IF LLM_D != 0
	BASE:(LLM_CID):憤怒 += LLM_D
	BASE:(LLM_CID):憤怒 = LIMIT(BASE:(LLM_CID):憤怒, 0, MAXBASE:(LLM_CID):憤怒)
	SIF LLM_MSG != ""
		LLM_MSG += "　"
	LLM_MSG += "愤怒"
	IF LLM_D > 0
		LLM_MSG += @"＋%TOSTR(LLM_D)%"
	ELSE
		LLM_MSG += @"－%TOSTR(-LLM_D)%"
	ENDIF
ENDIF

; ④b 对话本身的时间与气力成本（每轮一次）
;
;  ── 数值怎么定的（对齐游戏自己的基准）──────────────────────────────
;  官方「一次会话」`COMF300 会話.ERB`：**时间 +10 分钟、双方气力各 −20**
;  （失败时更重：时间 +10、气力各 −100）。
;  官方日常指令的时间众数是 **5 分钟**（56 处；见 `TRACHECK_TIME`
;  对 `SELECTCOM < 200` 的统一 +5，以及 `COMF` 里各处 `TIME +=`）。
;
;  ⚠️ 但自由对话是**多轮**的：如果每轮都按"一次完整会话"（10 分钟 / 20 气力），
;     聊 10 轮就是 100 分钟 + 200 气力 —— 太重，玩家会不敢说话。
;
;  ⇒ 取 **3 分钟 / 5 气力**（每轮）。
;
;  ⚠️⚠️ **设计基准是"单轮"，不是"一场"。**
;     `LLM_ROUND >= 20` 那个 20 只是**防止无限聊的上限**，
;     **玩家随时可以输入空行退出**（见 `@LLM_CHAT_LOOP` 的输入处理）。
;     所以每轮的数值必须**自己就站得住** —— 不能按"聊满 20 轮"来配平，
;     因为玩家很可能只聊两三轮就走。
;     这里 3 分钟 / 5 气力的依据是**单轮就轻**：
;       · 官方日常指令一次 5 分钟（`TRACHECK_TIME` 对 `SELECTCOM < 200`），
;         我们比它还轻（3 分钟）；
;       · 官方一次完整会话是双方各 −20 气力，我们只取 1/4（−5）——
;         聊一轮几乎无感，多聊几轮才累积成可观的开销。
;
;  ⚠️ **不消耗体力** —— 官方会话也只扣气力（`COMF300` 里没有体力的 DOWNBASE）。
TIME += 3
BASE:MASTER:気力 = MAX(BASE:MASTER:気力 - 5, 0)
BASE:(LLM_CID):気力 = MAX(BASE:(LLM_CID):気力 - 5, 0)

; ④c ★ **她自己也在干活** —— 补上她那边的进度
;
;  ⚠️⚠️ 这是很容易漏掉的一条：游戏里角色**自己**干活就会推进工作量，
;     在 `@BASE自然変動(ARG)` 里（`BASE自然変動.ERB:104-106`）：
;         IF CFLAG:ARG:行動 == 5
;             BASE:ARG:工作量 = MAX(BASE:ARG:工作量 - Lapse * 10, 0)   ; 每分钟 10 点
;     而它由 `MOVEMENT_SUB.ERB:24` **每回合**为每个角色调用一次。
;     **自由对话不是游戏回合**，所以这个函数根本不会跑 ——
;     结果就是"只有玩家帮忙才有进度"，玩家会误以为自己必须一直帮，
;     最后把自己的体力耗光（实测就累晕在门口了）。
;
;  这里按**本轮实际推进的分钟数**补上那一份：
;    `TIME - LLM_T0` = 对话本身的 3 分钟 + 陪伴/帮忙额外推进的时间
;    （`LLM_T0` 在函数开头记下，所以这一处就能覆盖所有推进来源）
;  ⚠️ 不去直接 `CALL BASE自然変動` —— 那会连带触发情绪衰减、理性恢复、
;     发情判定、宴会酒气等一大堆**本回合之外的**副作用，在对话里跑不合适。
;     这里只补"她在干活"这一条，其余交给正常的回合流程。
LLM_DT = TIME - LLM_T0
LLM_SELF = 0
; 先记下**实际**推进量（受剩余量限制），再扣 —— 明细要显示这个数
IF CFLAG:(LLM_CID):行動 == 5 && BASE:(LLM_CID):工作量 > 0 && LLM_DT > 0
	LLM_SELF = MIN(LLM_DT * 10, BASE:(LLM_CID):工作量)
	BASE:(LLM_CID):工作量 = MAX(BASE:(LLM_CID):工作量 - LLM_DT * 10, 0)
ENDIF

; ⚠️ 把"她自己的那份进度"也追加进明细。
;    这一项算得比陪伴分支晚（它在 ④c 才出来），所以只能在这里补。
;    不显示的话，玩家会以为"她几乎没动、全靠我在帮" ——
;    实际上她按每分钟 10 点自己推进（`BASE自然変動.ERB:106`），
;    陪 15 分钟就有 150 点，比玩家的贡献还多。
SIF LLM_SELF > 0
	CALL LLM_GAIN_GET(LLM_GAIN, "她自己推进", LLM_SELF)

; ④e ★★ **官方的数值结算** —— 这一步之前一直漏了，是"感觉对她的数值没影响"的根因
;
;  官方「帮忙干活」的完整流程是**两步**：
;    ① `@COM304` 干活 → 写 `SOURCE:歓楽` / `SOURCE:受動`（好感度与情绪的"**源**"）
;                        写 `TFLAG:信頼度管理`（信赖度的**档位**）
;                        `DOWNBASE`（体力/气力，我们已单独结算过）
;    ② `@SOURCE_CHECK`（eraTW 的**指令统合函数**）统一结算：
;         `CALL FAVOR_CALC(TARGET)`  → `SOURCE:*` 换算成 **好感度 / 情緒 / 憤怒**
;         `CALL TRUST_CALC(TARGET)`  → `TFLAG:信頼度管理` 换算成 **信赖度**
;         （`SOURCE.ERB:1219` 与 `:1224-1225`；`TRUST_CALC` 末尾会把
;           `TFLAG:信頼度管理` 清 0，`SOURCE` 也由结算过程消费掉）
;
;  ⚠️⚠️ **自由对话不是指令，`@SOURCE_CHECK` 根本不会跑** ——
;     所以"只写 SOURCE 不结算"等于**什么都没发生**：她的好感度、信赖度
;     一动不动。这是本系统第三个同类 bug（前两个：`DOWNBASE` 没结算、
;     她自己干活没推进）—— 共同点都是"**写了累积量但没有结算入口**"。
;
;  ⚠️ 两个函数开头都有闸门 `SIF !TFLAG:102 / RETURN 0`。
;     `TFLAG:102` 是**指令类型**（1=日常 / 2=性行为 / 3=逆推，
;     见 `COUNTER_TYPE.ERB:4` 的注释），自由对话里得**手动设成 1**
;     （等同日常指令），否则它们会直接返回、白调。设完**恢复原值**。
;
;  ⚠️ 只在"本轮真的写过 SOURCE"时才调用 —— 否则普通闲聊也会走一遍，
;     而 `FAVOR_CALC` 开头有 `TFLAG:97 += (ABL:従順 + ABL:親密) / 2`
;     之类的基线计算，会让**每轮闲聊都白涨好感度**。
;  ⚠️ 两个标志分开判：
;     · `LLM_SRC_ANY`  —— 写过 `SOURCE`（好感度/情绪的源）→ 才调 `FAVOR_CALC`
;     · `LLM_TRST_ANY` —— 写过信赖档位 → 才调 `TRUST_CALC`
;     混在一起判的话，像"陪发呆"这种**只写信赖、不写 SOURCE**的情况
;     也会跑一遍 `FAVOR_CALC`，而它开头有基线计算
;     （`TFLAG:97 += (ABL:従順 + ABL:親密) / 2`），会白白涨好感度。
;  ⚠️⚠️ 这里必须是 `IF … ENDIF`，**绝不能用 `SIF`** ——
;     下面有 6 行，而 `SIF` 只绑紧接的一行，会导致
;     `TFLAG:102 = 1` 与两次结算**每轮无条件执行**（等于闲聊也白涨好感度）。
; ★★ **记下结算前的信赖度** —— 用来在结算后算「这一轮实际涨了多少」 ✓
;  ⚠️ 必须在这里（④e 之前）记，因为 `@TRUST_CALC` 会改 `CFLAG:4` ✓
LLM_T4B = CFLAG:(LLM_CID):4
IF LLM_SRC_ANY || LLM_TRST_ANY
	LLM_TF102 = TFLAG:102
	TFLAG:102 = 1
	; ⚠️⚠️ **必须先把 `TFLAG:99`（失败指令标志）清 0** —— 用户实测：
	;    "好像还是没有加信赖 莫名其妙的"（好感度涨了、信赖度一动不动）。
	;
	;  **根因**（`TRACHECK_信頼度上昇処理.ERB`，这是我第三次读它才发现的）：
	;    ```erb
	;    : 19  SIF TFLAG:信頼度管理 < 0
	;    : 20      TFLAG:99 ++              ← 一次"负信赖"就把它设上
	;    ...
	;    :243  SIF TFLAG:99 && 信赖度上昇値 > 0
	;    :244      信赖度上昇値 = 0         ← ★ 只要它残留，**正数信赖一律归零**
	;    ```
	;  ⚠️ **它是跨轮残留的** —— 只要你之前有过一次被拒/失败的指令，
	;     后面**所有**正数信赖都会被吞掉，**和有没有 SOURCE 无关** ⚠️
	;  ⇒ 而好感度走 `FAVOR_CALC`，**没有这道闸门** ⇒ 所以"好感涨、信赖不涨" ✓
	;
	;  ⇒ 自由对话不是指令，没人替我们清它 ⇒ **这里自己清** ✓
	LLM_TF99 = TFLAG:99
	TFLAG:99 = 0
	SIF LLM_SRC_ANY
		CALL FAVOR_CALC(LLM_CID)
	SIF LLM_TRST_ANY
		CALL TRUST_CALC(LLM_CID)
	; ⚠️ `TRUST_CALC` 末尾自己会把 `TFLAG:99` 清 0（`:282`）✓
	;    这里恢复成"进函数前的值"就没意义了（那正是要清掉的脏值），
	;    所以**不恢复** —— 让它是干净的 0 ✓
	TFLAG:102 = LLM_TF102
ENDIF

; ④d ★ 把**时间经过**也写进结算明细
;  —— 用户要的就是这个：`时间－3分钟` / `时间－30分钟` 这样，
;     让玩家一眼看出这一轮到底花掉了多少时间。
;  用 `@LLM_GAIN_COST`（消耗版：正数显示成「－N」）—— 时间流逝算消耗，
;  而且 `LLM_DT` 里已经含了"对话本身的 3 分钟 + 陪伴/帮忙额外推进的时间"，
;  所以显示的是**这一轮的总时间开销**。
;  ⚠️ 普通轮次（没陪伴/帮忙）时 `LLM_GAIN` 本来是空的，这里会把它建起来，
;     于是每轮都会有一行「（时间－3分钟）」—— 这正是想要的效果。
SIF LLM_DT > 0
	CALL LLM_GAIN_COST(LLM_GAIN, "时间", LLM_DT)

; ★ **顺带把玩家当前的体力 / 气力也列在同一行** —— 方便做体力管理。
;  ⚠️ 用户需求原话："能不能在「时间－3」那一行同时显示玩家的当前气力和当前体力，
;     方便玩家更好的进行体力管理。"
;  ⚠️ 这两项**无条件追加**（不像上面那些"0 就跳过"）：
;     体力管理的前提就是**随时可见**，只在变动时才显示等于没显示。
;  ⚠️ 用「当前/上限」的格式 —— 光给当前值判断不出还剩多少余量。
;  ⚠️ 放在**最后**：前面是"这一轮变动的增减"，这里是"变动之后的余额"，
;     视觉上分得开，不会和「体力－150」那种变化项混淆。
;  ⚠️ 值取自**结算之后**（④e 官方结算已经跑完），所以是真正的最新余额。
CALL LLM_GAIN_CUR(LLM_GAIN, "体力", BASE:MASTER:体力, MAXBASE:MASTER:体力)
CALL LLM_GAIN_CUR(LLM_GAIN, "气力", BASE:MASTER:気力, MAXBASE:MASTER:気力)

; ⑤ 欲情：只在"关系已深 + 这句是性骚扰"时给（见 ⓪ 的分级表）
;  ⚠️ 用 `PALAMLV:N`（加 N 档）而不是绝对数 —— 见函数头的说明。
;     欲情没有上限变量，也没有自然衰减（PALAM 不参与 BASE自然変動），
;     所以这里给 3 档是个不小的量：约等于官方一次"强刺激"的 1/3。
IF LLM_SEXY
	PALAM:(LLM_CID):欲情 += PALAMLV:3
	SIF LLM_MSG != ""
		LLM_MSG += "　"
	LLM_MSG += "欲情↑"
ENDIF

; 无论有没有变化都**始终**给出一行反馈。
; 为什么不再静默：全 0 时什么都不显示，会让人分不清
;   「模型给了 0,0,0」/「模型没给块」/「联动根本没在跑」——
;   三种情况在界面上一模一样。给一行字就能一眼确认。
; ★★ **每轮通报：她是谁 + 当前好感/信赖**（用户要求："看起来更直观"）——
;  ⚠️ 放在明细**之前**：先给"她是谁、现在什么关系"，再看这一轮的变化，
;     读起来才有参照（不然"+15 情绪"到底是从哪个基数上来的，看不出来）✓
;  ⚠️ 好感度 = `CFLAG:2`、信赖度 = `CFLAG:4`（`CSV\CFLAG.csv` 确认过：
;     `2,好感度` / `4,信頼度`）✓
;  ⚠️⚠️ **`CALLNAME:xxx` 不能直接写进 `%…%`**（见 `:2877` 的注释）——
;     必须先用 `=` 接住再插值，否则取不到值 ✓
; ★★ ④f **用「实际差值」显示信赖变化**（用户要「能看到数值」，而且要**准**）——
;  ⚠️ 为什么不在前面写：前面只知道「投入了多少」（`LLM_TT` / `LLM_D5`），
;     而 `@TRUST_CALC` 会按亲密度/心情/性格**再修正一次** ⇒ 落地值不一样 ⚠️
;     用户实测：「明细写 +2、实际涨 5」—— 就是这里对不上 ✓
;  ⇒ 所以**结算完再算差值**，显示的必然是**真正落地的那个数** ✓
LLM_T4D = CFLAG:(LLM_CID):4 - LLM_T4B
IF LLM_T4D != 0
	SIF LLM_MSG != ""
		LLM_MSG += "　"
	IF LLM_T4D > 0
		LLM_MSG += @"信赖度＋{LLM_T4D}"
	ELSE
		LLM_MSG += @"信赖度－{-LLM_T4D}"
	ENDIF
ENDIF
LLM_NM = %CALLNAME:(LLM_CID)%
PRINTFORML 【%LLM_NM%】好感 {CFLAG:(LLM_CID):2}　信赖 {CFLAG:(LLM_CID):4}
IF LLM_MSG != ""
	PRINTFORML %LLM_MSG%
ELSEIF LLM_GOT
	PRINTFORML （本轮数值无变化）
ELSE
	PRINTFORML （本次回复未包含结算块 · 数值未变动）
ENDIF
; 「陪伴 / 帮忙」的本次结算明细 —— 只在真的发生时才有内容
IF LLM_GAIN != ""
	; ★★ **互动模式：把高潮值 / 觉醒值计量表拼进提示行**（2026-09-21 用户要求）——
	;   ⚠️ 用 IF LLM_MODE == 1 包住 ⇒ 自由对话不受影响 ✓
	IF LLM_MODE == 1
		LLM_INT_MTR = ""
		CALL LLM_INT_METERS(LLM_CID, LLM_INT_MTR)
		SIF LLM_INT_MTR != ""
			LLM_GAIN += @"　%LLM_INT_MTR%"
	ENDIF
	PRINTFORML （%LLM_GAIN%）
ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  显示角色图（立绘 / 颜绘）
; ────────────────────────────────────────────────────────────────────────────
;  为什么不自己拼 <img>：本作已有现成的显示层，直接复用最稳 ——
;  资源名解析、差し替え適用、特效层、边框、缩放、多尺寸，它都处理好了。
;
;    @PRINT_FACE(CID, 表情, 服装, 差分, エフェクト, …)
;        颜绘（半身）。这是本作"对话 / 事件配图"的惯例做法。
;    @PRINT_FIGURE(CID, 表情, 服装, 差分, エフェクト, "立絵", …)
;        立绘（全身）。
;
;  ⚠️ 这两个接口**内部自己会检查**：
;       · 顔絵付きメッセージ（设置里的"对话或事件中的配图"）
;       · FLAG:画像表示（设置里的"显示立绘"）
;     玩家关掉任一项时它们会直接 RETURN、什么都不画。
;     所以这里**不要**再绕过它强行显示，也不需要在外面重复判断。
;
;  挑选规则：跟随玩家自己的"角色绘的类型"设置
;      `FLAG:立ち絵種類` 为真 = 颜绘，为假 = 立绘
;      （语义见 SHOP関連\OPTION.ERB:929 的 `\@ FLAG:立絵種類 ? [颜绘] # [立绘] \@`）
;  若玩家选的是立绘、但该角色没有立绘资源，则退回颜绘（不会什么都不显示）。
;
;  ⚠️⚠️ 这是**已经验证可用**的版本（你说"很完美"的那一版）—— 不要再去"优化"它。
;     我曾把它改成"自己按状态挑表情 + 用 GET_BASE_RESOURCE 校验资源是否存在"，
;     结果那个校验误判成"没有图"，整段立绘被跳过，表现是「立绘位置什么都没有」。
;     ⇒ 教训：**不要替游戏的显示层做它已经做好的判断。**
;
;  本函数**不依赖任何 .ERH 全局变量**（只用局部变量和游戏自己的状态量），
;  所以不会被"全局变量莫名失效"那类问题牵连。
; ────────────────────────────────────────────────────────────────────────────
@LLM_SHOW_FIGURE(LLM_CID)
#DIM LLM_CID
#LOCALSIZE 1
#DIM LLM_HAS_FIG

SIF LLM_CID < 1 || LLM_CID >= CHARANUM
	RETURN

; 玩家选择「颜绘」→ 直接用颜绘
IF FLAG:立ち絵種類
	CALL PRINT_FACE(LLM_CID)
	RETURN
ENDIF

; 玩家选择「立绘」→ 有立绘资源就画立绘，没有则退回颜绘
LLM_HAS_FIG = HAS_STANDING(LLM_CID)
IF LLM_HAS_FIG
	CALL PRINT_FIGURE(LLM_CID, "", "", "", "", "立絵")
ELSE
	CALL PRINT_FACE(LLM_CID)
ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  输出一条角色台词
; ────────────────────────────────────────────────────────────────────────────
; ────────────────────────────────────────────────────────────────────────────
;  她愿不愿意进行自由对话？
; ────────────────────────────────────────────────────────────────────────────
;  返回值（调用方读 RESULT）：1 = 拒绝，0 = 愿意
;  拒绝理由写进 REF_REASON，之后喂给模型，让拒绝的语气与处境对得上。
;
;  ⚠️ 所有判定都只用**已经验证过的写法**：
;     · 具名下标带括号 `CFLAG:(CID):名`、`BASE:(CID):名` —— 本项目多处使用
;     · **`MARK` 的下标不加括号**！本作既有写法是 `MARK:变量:元素`
;       （FORTUNE.ERB 的 `MARK:target_id:反発刻印`、
;         QoL_Com_Order.ERB 的 `MARK:mCID:不埒刻印`），
;       全项目没有一处写 `MARK:(变量):元素` —— 这点曾经怀疑是踩坑点。
;     · 多行条件一律 `IF … ENDIF`，绝不用 `SIF` 带多行（见避坑清单 5j）
;
;  参数：LLM_ANGER = 本场对话累积的"不快"（由 @LLM_CHAT_LOOP 维护并传入）
;
;  判定条件（阈值想调就改这里）—— 顺序即优先级，越靠前越强势：
;    · CFLAG:睡眠            —— 睡着了被吵醒
;    · CFLAG:ブチギレ         —— 暴怒（游戏里最强的愤怒态）
;    · MARK:反発刻印 >= 3     —— 对齐官方（COMF300 会話.ERB:31）
;                               ⚠️ 曾经写成"任意非 0"，误伤太大
;    · BASE:憤怒 >= 500      —— 500 是游戏自己的"愤怒"阈值（QOL_IMAGE.ERB:1494）
;    · LLM_ANGER >= 300      —— **这场对话里被惹毛了**：模型每轮给的愤怒增量累积
;                               约 5 轮明显冒犯触发；想让她更耐烦就调大
;    · 心情 == -1 且 情緒 < MAXBASE/10 且 好感 < REQUIRED_FAVOR_思慕
;                            —— 真的没心情（三个条件必须同时满足）
;                               ⚠️ 曾经只判 `情緒 < MAXBASE/3`，**几乎总成立**，
;                                  把正常对话全挡住了。详见下面那段注释。
;
;  ⚠️ 注意：**官方自己的「会話」指令只有前三条里的刻印那条**，
;     其余都是我们为自由对话加的。所以尺度宁可宽松 —— 少拒绝，
;     也别让玩家觉得"每个角色都不理我"。
; ────────────────────────────────────────────────────────────────────────────
@LLM_REFUSE_REASON(LLM_CID, LLM_ANGER, REF_REASON)
#DIM  LLM_CID
#DIM  LLM_ANGER
#DIMS REF REF_REASON
#DIM  LLM_ANGER_LIMIT
#LOCALSIZE 1

REF_REASON = ""

; 睡着了
IF CFLAG:(LLM_CID):睡眠
	REF_REASON = "你现在正睡得迷迷糊糊，刚被吵醒，很困也很不耐烦"
	RETURN 1
ENDIF
; 暴怒（游戏里最强的愤怒态）
IF CFLAG:(LLM_CID):ブチギレ
	REF_REASON = "你现在正在暴怒，气得不想跟任何人说话"
	RETURN 1
ENDIF
; 对玩家有反感刻印 —— **只在刻印 3 时才拒绝**
;  ⚠️ 对齐官方：`COMF300 会話.ERB:31` 判的是 `MARK:反発刻印 >= 3`。
;     写成"任意非 0 就拒绝"会把只有 1 级刻印的角色也一起挡掉，误伤太大。
IF MARK:LLM_CID:反発刻印 >= 3
	REF_REASON = "你心里对眼前这个人有根刺（反感），不想给他好脸色"
	RETURN 1
ENDIF
; 正在气头上
IF BASE:(LLM_CID):憤怒 >= 500
	REF_REASON = "你现在正在气头上，心里很烦躁"
	RETURN 1
ENDIF
; 这场对话里被惹毛了（累积阈值）
;  ⚠️ 2026-09 数值调研后从 6 提到 300：
;     愤怒单轮现在是 ±60，累积 300 ≈ "约 5 轮明显冒犯"，
;     量级对齐官方"被无视 → 愤怒 +347"（COMF300 会話.ERB:31-35）。
;     原来写 6 是配着 ±2/轮 定的，不改的话第一轮就会触发。
LLM_ANGER_LIMIT = 300
IF LLM_ANGER >= LLM_ANGER_LIMIT
	REF_REASON = "刚才的对话让你很不痛快，火气已经压不住了"
	RETURN 1
ENDIF
; 心情糟糕 + 情绪**极低** + 关系还浅
;  ⚠️ 这条曾经是 `情緒 < MAXBASE/3`（=500）—— 结果**几乎总是成立**：
;     游戏里角色的情绪长期低于这个数（官方自己的保底才 `MAX(情緒, 300)`，
;     见 `情事発覚.ERB:392`；而自然衰减每次行动就要掉 40~120）。
;     表现就是"每个角色都没精神理人"，把正常对话全挡在门外。
;
;     现在收紧成**三个条件同时满足**，才认为她真的没心情：
;       · 心情 = -1（糟糕）
;       · 情緒 < MAXBASE/10（**极低**，而不是 500 那种"普通偏低"）
;       · 好感度 < 思慕门槛（关系还浅 —— 关系深的人心情差也愿意理你）
;
;  另外注意：**官方自己的「会話」指令并没有这一条**（`COMF300` 只判
;  反感刻印与会话累积值）。这条是我们加的，所以尺度要自己拿捏好，
;  宁可少拒绝，也不要挡住正常对话。
IF TALENT:(LLM_CID):心情 == -1 && BASE:(LLM_CID):情緒 < MAXBASE:(LLM_CID):情緒 / 10 && CFLAG:(LLM_CID):2 < REQUIRED_FAVOR_思慕
	REF_REASON = "你心情很糟，又累又提不起劲，不太想搭理人"
	RETURN 1
ENDIF

RETURN 0


; ────────────────────────────────────────────────────────────────────────────
;  拒绝台词用的 system prompt
; ────────────────────────────────────────────────────────────────────────────
;  persona 部分与主 prompt 同源（都走 @LLM_PERSONA_SNAPSHOT），
;  所以拒绝时的语气仍是这个角色本人的。
;  两种情形：① 一开始就不想理 ② 聊到一半被惹毛，直接不聊了。
; ────────────────────────────────────────────────────────────────────────────
@LLM_BUILD_REFUSE_PROMPT(LLM_CID, REF_REASON, REF_PROMPT, LLM_PLAYER_SAY)
#DIM  LLM_CID
#DIMS REF_REASON
#DIMS REF REF_PROMPT
#DIMS LLM_PLAYER_SAY    ; 玩家刚说的话；开场就被拒绝时传空串
#LOCALSSIZE 4
#DIMS LLM_CHAR_NAME
#DIMS LLM_TONE

; 现取一次 persona，避免多用同一角色时残留上一次的内容
CALL LLM_PERSONA_SNAPSHOT(LLM_CID)
LLM_CHAR_NAME = %CALLNAME:(LLM_CID)%
; 语气描述与主 prompt 同源 —— 否则她拒绝时会突然变回中性的 AI 腔
CALL LLM_TONE_OF(LLM_CID, LLM_TONE)

REF_PROMPT = @"你正在扮演东方Project同人游戏《eraTW》中的角色。"
REF_PROMPT += @"\n【角色】%LLM_CHAR_NAME%"
REF_PROMPT += @"\n你的名字就是「%LLM_CHAR_NAME%」。不要演成别的角色，也不要自称别的名字。"
REF_PROMPT += @"\n【本作对该角色的既定诠释（persona 来源）】"
IF LLM_PERSONA_OK
	REF_PROMPT += @"%LLM_PERSONA_SHOW%"
ELSE
	REF_PROMPT += @"该角色在本作中没有专属剧本，请按其原作性格演绎"
ENDIF
REF_PROMPT += @"\n【说话方式】%LLM_TONE%"
REF_PROMPT += @"\n【你现在的状态】%REF_REASON%"
IF LLM_PLAYER_SAY != ""
	REF_PROMPT += @"\n【刚刚发生的事】你们本来在随便聊聊，玩家对你说：「%LLM_PLAYER_SAY%」"
	REF_PROMPT += @"\n【要求】"
	REF_PROMPT += @"\n1. 这句话让你彻底不想再聊下去了。只输出一到两句把他打发走的话，可以针对他刚说的内容。"
ELSE
	REF_PROMPT += @"\n【眼下发生的事】玩家走到你面前，想和你自由地聊几句。"
	REF_PROMPT += @"\n【要求】"
	REF_PROMPT += @"\n1. 你现在**不愿意**和他交谈。只输出一到两句拒绝的话。"
ENDIF
REF_PROMPT += @"\n2. 语气必须符合上面的【说话方式】与当前状态 —— 用口语短句、带语气词，"
REF_PROMPT += @"\n   不要写成中性的通用回答，也不要客服腔。"
REF_PROMPT += @"\n3. 只输出角色说出口的话：不要旁白、动作描写、括号说明、引号本身。"
REF_PROMPT += @"\n4. 不要长篇大论，也不要借机说教，一到两句就够。"
REF_PROMPT += @"\n5. 不要提到自己是 AI、模型或程序，不要输出解释或任何格式标记。"
REF_PROMPT += @"\n6. 不要输出任何结算用的数值块或分隔符（例如 ###DELTA###）。"
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  拒绝：让模型按 persona 说一句拒绝台词，然后结束
; ────────────────────────────────────────────────────────────────────────────
@LLM_REFUSE_TALK(LLM_CID, REF_REASON, LLM_PLAYER_SAY)
#DIM  LLM_CID
#DIMS REF_REASON
#DIMS LLM_PLAYER_SAY
#LOCALSIZE 4
#LOCALSSIZE 4
#DIMS LLM_SYS
#DIMS LLM_TMP
#DIMS LLM_OUT
#DIM  LLM_STATE
#DIM  LLM_REQ

; 第 4 参数传 0 = **不记入对话记忆**：拒绝不算"聊过"，
; 免得污染之后正式对话的上下文。
;
; ⚠️ 玩家累趴时**不再发请求** —— 判据与其它入口统一走 `@LLM_TOO_TIRED`。
;    但**台词和记忆都要留**（统一走 `@LLM_TOO_TIRED_TALK`），
;    她应该开口关心一句，而且这件事该被她记住。
; ★ **自由互动时绕过「玩家累趴」中断**（2026-09-20）——
;   ⚠️ 场景里玩家累不累和互动无关 ⇒ 不该被强制道别 ✗
;   ⚠️ 前面已清 `RESULT` ⇒ RESULT 保持 0 ⇒ `IF RESULT` 不命中 ✓
; ⚠️ **必须先清 RESULT** —— `SIF` 不成立时 CALL 不执行，
;   RESULT 会保留上一次的残留值 ⇒ `IF RESULT` 会误判 ⚠️
RESULT = 0
SIF LLM_MODE == 0
	CALL LLM_TOO_TIRED
IF RESULT
	CALL LLM_TOO_TIRED_TALK(LLM_CID, RESULT)
	RETURN
ENDIF
CALL LLM_BUILD_REFUSE_PROMPT(LLM_CID, REF_REASON, LLM_SYS, LLM_PLAYER_SAY)
IF LLM_PLAYER_SAY != ""
	CALLSHARP LLM_CHAT_SEND(LLM_CID, LLM_SYS, @"（玩家对你说：「%LLM_PLAYER_SAY%」）", 0, LLM_TMP)
ELSE
	CALLSHARP LLM_CHAT_SEND(LLM_CID, LLM_SYS, "（玩家走到你面前，想和你自由地聊几句。）", 0, LLM_TMP)
ENDIF
IF TOINT(LLM_TMP) <= 0
	; 请求发不出去时也得给个反馈，不能什么都不显示
	PRINTFORML 「……我现在不想说话。」
	RETURN
ENDIF
LLM_REQ = TOINT(LLM_TMP)
PRINTFORML 　.....少女思考中……
CALL LLM_POLL(LLM_REQ, LLM_STATE, LLM_OUT)
IF LLM_STATE == 1
	CALL LLM_SANITIZE_REPLY(LLM_OUT)
	SIF LLM_OUT != ""
		CALL LLM_PRINT_REPLY(LLM_CID, LLM_OUT)
ELSEIF LLM_STATE == 0
	CALLSHARP LLM_CHAT_CANCEL(LLM_REQ, LLM_TMP)
	PRINTFORML 「……我现在不想说话。」
ELSE
	PRINTFORML 「……我现在不想说话。」
ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  「帮忙干活」用的两个小工具
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ 为什么不直接 `CALL COM304`（官方「帮忙干活」指令）：
;     那是指令函数，由**指令系统**调用 —— 调用前系统会准备好一整套上下文
;     （`SELECTCOM` / `TARGET` / `TFLAG` / 各种 VARSET …）。
;     从自由对话里直接 CALL 它，实测会让**自由对话被中断**。
;     所以这里只把它的核心几步按需抄过来，路径完全可控。
;
;  两个函数各自对应官方的一小段：
;    `@LLM_WORK_SKILL` ← `COMF304 仕事を手伝う.ERB:214-234`（職種 → 对应技能）
;    `@LLM_WORK_COST`  ← `COMF304:36-131`（職種 → 扣玩家体力/气力），
;                        原表很长，这里按职种归并成几档，量级相当。
; ────────────────────────────────────────────────────────────────────────────
; ────────────────────────────────────────────────────────────────────────────
;  ★ 帮忙干活时，**玩家的技能经验**也要涨
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ 为什么要补这一块：官方的 `COMF304 仕事を手伝う` **会涨玩家的经验**
;     （`COMF304:337-388`），而我们照抄它实现 `@LLM_WORK_DO` 时**只抄了
;     工作量/消耗/好感度那几段，把经验这段漏了** ——
;     结果是"帮了半天活，技能一点没长"，和官方指令的收益对不上。
;
;  ⚠️ **只有「帮忙干活」需要补** —— 官方的「陪同自由行动」（`COMF368`）
;     本来就**不涨玩家经验**（它只跑 `"ソース"` 那一段），
;     所以陪着看书/钓鱼/运动不涨是**符合官方设计的**，别去乱加。
;
;  ⚠️⚠️ 官方是按 `TFLAG:193`（结果码）决定涨多少的：
;        `TFLAG:193 == 1`（大成功）→ 再加 1；`!RAND:4`（25%）→ 加 1。
;     而**我们的 `@LLM_WORK_DO` 现在也会掷骰了**（见那里的 ①b），
;     所以这里**忠实照抄官方的两段判定**，不再是"固定按成功处理"。
;
;  ⚠️ 返回值用 REF 参数带回（`REF_AMT` / `REF_LABEL`）——
;     因为**明细要显示它**（用户反馈："没有在自由对话这边看到数值反馈"）。
;     普通函数只能 `RETURN` 一个数，带不回"涨的是哪一项"。
; ────────────────────────────────────────────────────────────────────────────
@LLM_WORK_EXP(LLM_JOB, REF_AMT, REF_LABEL)
#DIM  LLM_JOB
#DIM  REF REF_AMT      ; 实际涨了几点（0 = 没涨）
#DIMS REF REF_LABEL    ; 涨的是哪一项（中文名，如「清扫经验」）
REF_AMT = 0
REF_LABEL = ""
SELECTCASE LLM_JOB
	; 清掃 / 宴会片づけ
	CASE 40, 50
		REF_LABEL = "清扫经验"
		; ⚠️ 每一段都是**两行**，必须 `IF … ENDIF`（`SIF` 只绑紧随的一行）
		IF TFLAG:193 == 1
			EXP:MASTER:清掃経験 ++
			REF_AMT += 1
		ENDIF
		SIF !RAND:4
			EXP:MASTER:清掃経験 ++
		SIF !RAND:4
			REF_AMT += 1
	; 会話 / 商売 / お酒
	CASE 41, 47, 52
		REF_LABEL = "会话经验"
		IF TFLAG:193 == 1
			EXP:MASTER:会話経験 ++
			REF_AMT += 1
		ENDIF
		SIF !RAND:4
			EXP:MASTER:会話経験 ++
		SIF !RAND:4
			REF_AMT += 1
	CASE 42
		REF_LABEL = "战斗经验"
		IF TFLAG:193 == 1
			EXP:MASTER:戦闘経験 ++
			REF_AMT += 1
		ENDIF
		SIF !RAND:4
			EXP:MASTER:戦闘経験 ++
		SIF !RAND:4
			REF_AMT += 1
	CASE 43
		REF_LABEL = "学习经验"
		IF TFLAG:193 == 1
			EXP:MASTER:学習経験 ++
			REF_AMT += 1
		ENDIF
		SIF !RAND:4
			EXP:MASTER:学習経験 ++
		SIF !RAND:4
			REF_AMT += 1
	; 以下四类官方是"**无条件 +1**"（更高），大成功再 +1
	CASE 44
		REF_LABEL = "料理经验"
		EXP:MASTER:料理経験 ++
		REF_AMT += 1
		IF TFLAG:193 == 1
			EXP:MASTER:料理経験 ++
			REF_AMT += 1
		ENDIF
	CASE 45
		REF_LABEL = "演奏经验"
		EXP:MASTER:演奏経験 ++
		REF_AMT += 1
		IF TFLAG:193 == 1
			EXP:MASTER:演奏経験 ++
			REF_AMT += 1
		ENDIF
	CASE 54
		REF_LABEL = "采集经验"
		EXP:MASTER:採集経験 ++
		REF_AMT += 1
		IF TFLAG:193 == 1
			EXP:MASTER:採集経験 ++
			REF_AMT += 1
		ENDIF
	CASE 55
		REF_LABEL = "钓鱼经验"
		EXP:MASTER:釣り経験 ++
		REF_AMT += 1
		IF TFLAG:193 == 1
			EXP:MASTER:釣り経験 ++
			REF_AMT += 1
		ENDIF
	; 調合 / 家事
	CASE 56, 53
		REF_LABEL = "调和经验"
		EXP:MASTER:調合経験 ++
		REF_AMT += 1
		IF TFLAG:193 == 1
			EXP:MASTER:調合経験 ++
			REF_AMT += 1
		ENDIF
ENDSELECT
; ⚠️ 上面的"两行 SIF"写法（一个判定拆成 `EXP ++` 和 `REF_AMT += 1`）
;    是为了**让随机数只掷一次**：写成 `SIF !RAND:4` 加两行的话，
;    第二次 `RAND:4` 会重新掷，可能"经验涨了但计数没加"。
;    —— 所以这里刻意保留成两个 `SIF !RAND:4`，但都只有一行。
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  ★ 生成「距下一级还差多少」的**进度条文本**（如「Lv2 ■■■■□□□□□□ 4/10」）
; ────────────────────────────────────────────────────────────────────────────
;  用户需求："某项技能距离下一级的进度能否也能用进度条表示，
;  这样可以直观地看到经验增加后距离技能升级还有多少进度。"
;
;  ⚠️ **升级公式不自己算，直接复用官方的 `@Qol_XpProgressToNextLevel`**
;     （`QoL_Misc.ERB:730`，`#FUNCTION`）—— 它正是**官方状态界面
;     画技能进度条时用的那个**（`@Qol_SkillProgressBar` → `@Qol_PrintBar`）。
;     它通过 `RESULT:0/1/2` 返回：
;         RESULT:0 = 本级已经积累了多少
;         RESULT:1 = 本级**升满**需要多少（= 两个等级门槛的差）
;         RESULT:2 = 到下一级为止的**总**需求
;     ⇒ 我们要的"进度"就是 `RESULT:0 / RESULT:1`。
;
;  ⚠️ 为什么不自己照抄 EXPLV 公式：那套公式**按技能分成两类、还有 Lv0/Lv1 的
;     特例**（见 `QoL_Misc.ERB:735-760`），自己抄一遍迟早和官方对不上。
;     复用官方函数 ⇒ **玩家在状态界面看到的进度，和这里看到的一定一致。**
;
;  ⚠️ 调用方式必须是 `CALLF`（官方的 `@Qol_PrintBar` 也是这么调的，
;     `QoL_Misc.ERB:722`）—— `#FUNCTION` 标记的函数**不能用 `CALL`**。
;
;  ⚠️ 这段的「職種 → 技能」映射和 `@LLM_WORK_EXP` 的「職種 → 经验」映射
;     **是配对的但不是同一张表**：那边要经验的**字段名**，这边要等级的**当前值**。
;     等级侧的对应关系照抄官方 `@Qol_SkillProgressBar`（`QoL_Misc.ERB:692-714`）。
; ────────────────────────────────────────────────────────────────────────────
@LLM_SKILL_BAR(LLM_JOB, REF_OUT)
#DIM  LLM_JOB
#DIMS REF REF_OUT
#LOCALSIZE 8
#LOCALSSIZE 4
#DIM LLM_SK          ; 该项技能当前等级
#DIM LLM_XP          ; 该项经验当前值
#DIM LLM_IN          ; 本级已积累（RESULT:0）
#DIM LLM_NEED        ; 本级所需（RESULT:1）
REF_OUT = ""
LLM_SK = -1
LLM_XP = 0
SELECTCASE LLM_JOB
	; 清掃 / 宴会片づけ
	CASE 40, 50
		LLM_SK = ABL:MASTER:清掃技能
		LLM_XP = EXP:MASTER:清掃経験
		CALLF Qol_XpProgressToNextLevel(GETNUM(EXP, "清掃経験"), LLM_SK, LLM_XP)
		LLM_IN = RESULT:0
		LLM_NEED = RESULT:1
	; 会話 / 商売 / お酒
	CASE 41, 47, 52
		LLM_SK = ABL:MASTER:話術技能
		LLM_XP = EXP:MASTER:会話経験
		CALLF Qol_XpProgressToNextLevel(GETNUM(EXP, "会話経験"), LLM_SK, LLM_XP)
		LLM_IN = RESULT:0
		LLM_NEED = RESULT:1
	CASE 42
		LLM_SK = ABL:MASTER:戦闘能力
		LLM_XP = EXP:MASTER:戦闘経験
		CALLF Qol_XpProgressToNextLevel(GETNUM(EXP, "戦闘経験"), LLM_SK, LLM_XP)
		LLM_IN = RESULT:0
		LLM_NEED = RESULT:1
	CASE 43
		LLM_SK = ABL:MASTER:教養
		LLM_XP = EXP:MASTER:学習経験
		CALLF Qol_XpProgressToNextLevel(GETNUM(EXP, "学習経験"), LLM_SK, LLM_XP)
		LLM_IN = RESULT:0
		LLM_NEED = RESULT:1
	CASE 44
		LLM_SK = ABL:MASTER:料理技能
		LLM_XP = EXP:MASTER:料理経験
		CALLF Qol_XpProgressToNextLevel(GETNUM(EXP, "料理経験"), LLM_SK, LLM_XP)
		LLM_IN = RESULT:0
		LLM_NEED = RESULT:1
	CASE 45
		LLM_SK = ABL:MASTER:音楽技能
		; ⚠️ 音楽技能一个等级对应**三个**经验（演奏 / 歌唱 / 舞踏），
		;    官方取三者**最大值**当进度（`QoL_Misc.ERB:704`）。
		LLM_XP = MAX(EXP:MASTER:演奏経験, MAX(EXP:MASTER:歌唱経験, EXP:MASTER:舞踏経験))
		CALLF Qol_XpProgressToNextLevel(GETNUM(EXP, "演奏経験"), LLM_SK, LLM_XP)
		LLM_IN = RESULT:0
		LLM_NEED = RESULT:1
	; 以下三项是 TALENT 而不是 ABL
	CASE 54
		LLM_SK = TALENT:MASTER:採集Lv
		LLM_XP = EXP:MASTER:採集経験
		CALLF Qol_XpProgressToNextLevel(GETNUM(EXP, "採集経験"), LLM_SK, LLM_XP)
		LLM_IN = RESULT:0
		LLM_NEED = RESULT:1
	CASE 55
		LLM_SK = TALENT:MASTER:釣りLv
		LLM_XP = EXP:MASTER:釣り経験
		CALLF Qol_XpProgressToNextLevel(GETNUM(EXP, "釣り経験"), LLM_SK, LLM_XP)
		LLM_IN = RESULT:0
		LLM_NEED = RESULT:1
	CASE 56, 53
		LLM_SK = TALENT:MASTER:調合Lv
		LLM_XP = EXP:MASTER:調合経験
		CALLF Qol_XpProgressToNextLevel(GETNUM(EXP, "調合経験"), LLM_SK, LLM_XP)
		LLM_IN = RESULT:0
		LLM_NEED = RESULT:1
ENDSELECT
; 没匹配到（理论上不会）→ 不显示，别让明细出现半截内容
SIF LLM_SK < 0
	RETURN
; 满级：官方状态界面在 Lv6 以上就不画这条了（`QoL_Misc.ERB:720`）
IF LLM_SK >= 6
	REF_OUT = "已满级"
	RETURN
ENDIF
; ⚠️ 除以 0 保护 —— `LLM_NEED` 是本级所需，正常必然 > 0，
;    但万一官方的公式在某个等级返回 0，这里不能崩。
SIF LLM_NEED <= 0
	RETURN
; ⚠️⚠️ **数值插值必须用 `{…}`，不是 `%…%`** ——
;    `%…%` 只能装字符串，装数值会报 Lv2「% %中的表达式结果不是字符串」
;    （本项目已经在进度百分比那处栽过一次，见待做清单 §8.3）。
;    而 `%LLM_BARSTR(…)%` 是**返回字符串的函数**，所以那边仍然用 `%…%`。
REF_OUT = @"Lv{LLM_SK} %LLM_BARSTR(LLM_IN * 100 / LLM_NEED, 10)% {LLM_IN}/{LLM_NEED}"
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  ★ 她手头那件事**实际**还剩几分钟（扣掉本场对话已经推进掉的时间）
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️⚠️ 为什么不直接用 `Activity_Duration`：
;     它只在**回合末**由 `@CHARA_MOVEMENT` → `@自由行動処理` 递减
;     （`MOVEMENT.ERB:118`，`Activity_Duration -= TIME_PROGRESS(TIME:1)`），
;     而**自由对话不是一个回合** —— 我们在对话里推进的 `TIME`
;     要等**退出对话后的那一回合**才会被一次性补扣。
;     ⇒ 直接读它，会得到"陪了 8 轮、她还剩 60 分钟"这种**永远不结束**的假象。
;     （这正是"陪着运动陪不到结束"的深层原因，比时间推进漏写更根本。）
;
;  ⚠️ 本场已推进 = `TIME + DAY*1440 − LLM_SESSION_T0`（用绝对值，跨天也对）。
;  ⚠️ 返回值已经钳到 >= 0 —— 调用方可以直接拿它当"还剩几分钟"用。
; ────────────────────────────────────────────────────────────────────────────
@LLM_ACT_REMAIN(LLM_CID)
#FUNCTION
#DIM LLM_CID
#LOCALSIZE 4
#DIM LLM_LEFT
; ⚠️ 兜底：`LLM_SESSION_T0` 是开场白时赋的；万一没赋过（= 0），
;    下面那个减法会得到一个巨大的"已推进量"，把剩余**恒算成 0** ——
;    那会让"陪伴"整个失效（建立条件也不成立）。这时退回原始值。
SIF LLM_SESSION_T0 <= 0
	RETURNF Activity_Duration:(LLM_CID)
LLM_LEFT = Activity_Duration:(LLM_CID)
LLM_LEFT -= MAX(TIME + DAY * 1440 - LLM_SESSION_T0, 0)
RETURNF MAX(LLM_LEFT, 0)


; ────────────────────────────────────────────────────────────────────────────
;  ★ 现在是不是"她平时该睡的时间"（= 该说"你很困"）
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️⚠️ **这个函数是为了修一个真 bug 才拆出来的**（用户实测："开场白冷不丁
;     来一句我很困，好像没跟着作息走"）：
;
;   原来的判据写在 `LLM_SCHED` 里，是
;       `CFLAG:就寝時間 > 0 && (TIME > 就寝時間 || TIME < 起床時間)`
;   —— **只考虑了"睡觉时段跨夜"这一种形态**。
;
;   而 `就寝時間` / `起床時間` 都是**当天分钟数**（0~1440），
;   所以"她什么时候在睡"有**两种形态**，必须分开判：
;
;     · **跨夜型**（`就寝 > 起床`，如 23:00 睡、7:00 起 = 1380/420）
;         ⇒ 睡觉时段 = `TIME > 就寝 || TIME < 起床`   ← `||` 对
;     · **同天内**（`就寝 < 起床`，如 1:00 睡、10:00 起 = 60/600）
;         ⇒ 睡觉时段 = `就寝 < TIME < 起床`           ← 要用 `&&`
;
;   ⚠️ 原代码对第二种也用了 `||`，于是变成 `TIME > 60 || TIME < 600` ——
;     **除了 1:00 那一分钟，整天都成立**！
;
;  实测影响面（量过 `CSV\Chara\*.csv` 全部 165 个有作息的角色）：
;     · 跨夜型 95 个 —— 原代码正确
;     · **同天内 70 个（42%）—— 旧判据覆盖 100% 的时间**
;       （萃香 / 魔理沙 / 露米娅 / 隐岐奈… 全都在内）
;     ⇒ 这 70 个角色**任何时间**都会被告知"你很困，只是还没走"。
;
;  ⚠️ `@LLM_SCHED` 那边直接用 `LLM_IS_SLEEPTIME(角色)`，两边只有一个判据。
;  ⚠️ 是 `#FUNCTION` —— 只能用表达式调用（`IF LLM_IS_SLEEPTIME(...)`），不能 `CALL`。
; ────────────────────────────────────────────────────────────────────────────
@LLM_IS_SLEEPTIME(LLM_CID)
#FUNCTION
#DIM LLM_CID
#LOCALSIZE 4
#DIM LLM_A       ; 就寝时间（当天分钟数）
#DIM LLM_B       ; 起床时间（当天分钟数）
#DIM LLM_R
LLM_A = CFLAG:(LLM_CID):就寝時間
LLM_B = CFLAG:(LLM_CID):起床時間
; ⚠️ 保护：字段为 0（调试重置等）时不能判 —— 否则 `TIME > 0` 恒真
SIF LLM_A <= 0 || LLM_B <= 0
	RETURNF 0
LLM_R = 0
IF LLM_A > LLM_B
	; ① 跨夜型：睡觉时段横跨午夜
	SIF TIME > LLM_A || TIME < LLM_B
		LLM_R = 1
ELSE
	; ② 同天内：睡觉时段在一天之内（凌晨睡、白天起）
	SIF TIME > LLM_A && TIME < LLM_B
		LLM_R = 1
ENDIF
RETURNF LLM_R


@LLM_WORK_SKILL(LLM_JOB)
#DIM LLM_JOB
SELECTCASE LLM_JOB
	CASE 40, 53
		RETURN ABL:MASTER:清掃技能
	CASE 41, 47, 52
		RETURN ABL:MASTER:話術技能
	CASE 42
		RETURN ABL:MASTER:戦闘能力
	CASE 43
		RETURN ABL:MASTER:教養
	CASE 44
		RETURN ABL:MASTER:料理技能
	CASE 45
		RETURN ABL:MASTER:音楽技能
	CASE 54
		RETURN TALENT:MASTER:採集Lv
	CASE 55
		RETURN TALENT:MASTER:釣りLv
	CASE 56
		RETURN TALENT:MASTER:調合Lv
ENDSELECT
RETURN 0


@LLM_WORK_COST(LLM_JOB, REF_T, REF_K)
#DIM  LLM_JOB
#DIM  REF REF_T
#DIM  REF REF_K
SELECTCASE LLM_JOB
	CASE 42                     ; 戦闘 —— 最累
		REF_T = 250
		REF_K = 50
	CASE 40, 44, 53             ; 清掃 / 料理 / 家事
		REF_T = 150
		REF_K = 120
	CASE 45, 46, 54, 55, 56     ; 音楽 / 遊び / 採集 / 釣り / 調合
		REF_T = 200
		REF_K = 100
	CASE 41, 43, 47, 52         ; 会話 / 教養 / 商売 / お酒 —— 费神不费体力
		REF_T = 50
		REF_K = 200
	CASEELSE
		REF_T = 100
		REF_K = 100
ENDSELECT
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  帮忙干活（可重复调用）
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ 抽成函数，是因为它要在**两个地方**用：
;    · **随口陪着**（`t=3`，15 分钟）→ `LLM_STEP = 9`
;    · **认真帮忙**（`t=4`，30 分钟）→ `LLM_STEP = 30`
;  份额的含义是"相对完整一份的倍率"（下面 `× LLM_STEP / 10`）：10 = 一份。
;  产出与消耗都按份额缩放，所以"一次帮 30 分钟"和"连着聊 10 轮"
;  的总量大致相当 —— 不会因为每轮全量结算而几轮就把体力清空。
;
;  返回值（`RESULT`）：本次实际完成的工作量；0 = 没帮上（活干完 / 職種不适用）。
;
;  数值照抄官方 `COMF304 仕事を手伝う.ERB` + `@JOB_EFFICIENCY`：
;    · 出力 `WorkP = 50 + 技能 × 75`（`:258` 的"成功"档；不掷骰，结果可预期）
;    · 完成量 `L_帮忙 = WorkP + RAND:80 + RAND:80 + 10`（`:394`）
;    · 清洁类减半（`:415-416`）
;    · 信赖度 `+= 5`、`SOURCE:歓楽 += 300` 等（`:135-184`）
; ────────────────────────────────────────────────────────────────────────────
@LLM_WORK_DO(LLM_CID, LLM_STEP, LLM_COSTSTEP)
#DIM LLM_CID
#DIM LLM_STEP
#DIM LLM_COSTSTEP       ; **消耗**的份额（与进度份额分开，见下面 ③ 的说明）
#LOCALSIZE 12
#DIM LLM_SK
#DIM LLM_WP
#DIM LLM_TG
#DIM LLM_CT
#DIM LLM_CK
#DIM LLM_SRC      ; 本次给多少"好感度源"（按官方基准，不乘工作量份额）
#DIM LLM_TG_BEFORE ; 扣减**前**的剩余工作量 —— 用来算"实际推进了多少"（见 ②）
#DIM LLM_RATE     ; 掷骰值（0~99）
#DIM LLM_RATE_LOW ; 大成功线
#DIM LLM_RATE_HIGH; 失败线

; 活已经干完了
SIF BASE:(LLM_CID):工作量 <= 0
	RETURN 0
; 这两种職種不适用「帮忙干活」（官方 @COM_ABLE304:449-450）
SIF GROUPMATCH(CFLAG:(LLM_CID):職種, 49, 51)
	RETURN 0

; ① 技能 → 出力 → 完成量
CALL LLM_WORK_SKILL(CFLAG:(LLM_CID):職種)
LLM_SK = RESULT
LLM_WP = 50 + LLM_SK * 75
LLM_TG = LLM_WP + RAND:80 + RAND:80 + 10
SIF GROUPMATCH(CFLAG:(LLM_CID):職種, 40, 50)
	LLM_TG /= 2

; ①b ★ **掷骰判定：失败 / 成功 / 大成功**（照抄官方 `COMF304:288-334`）
;
;  ⚠️ 为什么要有这一步：官方帮忙是**有成败**的，而我们原来是"必定成功"，
;     既丢了数值差异，也让对话少了一大块素材 ——
;     **大成功该得意、失败该懊恼**，这些反应现在才能演出来。
;
;  ⚠️ 官方原式是 `LOCAL:1 = 90 + GET_SUCCESS_RATE() / 5`，
;     但 `@GET_SUCCESS_RATE` 在本作里**搜不到定义**（可能是 mod 删了/改名了），
;     所以这里用**固定档位**代替：大成功 9%、失败 10%（与官方量级一致）。
;     等哪天找到那个函数，把 `LLM_RATE` 换掉即可。
;
;  结果码写进 `TFLAG:193`（官方用的就是这个位置）：
;       1 = 大成功   0 = 成功   -1 = 失败
LLM_RATE = RAND:100
	LLM_RATE_LOW = 10 + LLM_SK * 2    ; ★ 官方 `LOCAL:2`（2026-09-19 修）
	LLM_RATE_HIGH = 75 + LLM_SK * 5   ; ★ 官方 `LOCAL:1`（2026-09-19 修）
IF LLM_RATE <= LLM_RATE_LOW
	; ── 大成功：额外推进 + 信赖更高 ──
	TFLAG:193 = 1
	LLM_TG = LLM_TG * 2              ; ★ 官方 `WorkP * 2`（2026-09-19 修，原为 1.5）
	TFLAG:信頼度管理 += 3
ELSEIF LLM_RATE >= LLM_RATE_HIGH
	; ── 失败：几乎没推进（官方直接 `WorkP = 0`，只剩随机量）──
	TFLAG:193 = -1
	LLM_TG = 0                       ; ★ 官方 `WorkP = 0`（2026-09-19 修）
	TFLAG:信頼度管理 -= 1
ELSE
	; ── 成功 ──
	;  ⚠️ 成功**也要有回报**（用户要求"温柔一些"）：
	;     早期只给大成功加信赖，结果"帮她干完活"和"没帮"几乎没差别，
	;     玩家白忙一场。现在三档都有份，只是**量递减**：
	;         大成功 +3 ／ 成功 +1 ／ 失败 −1
	TFLAG:193 = 0
	TFLAG:信頼度管理 += 1
ENDIF

; ② 按份额缩放（至少 1，免得"帮了却等于没帮"）
LLM_TG = MAX(LLM_TG * LLM_STEP / 10, 1)
; ⚠️⚠️ **返回的必须是"实际推进了多少"，不是"想推进多少"** ——
;     `MAX(..., 0)` 会把扣减**钳位**：剩余只有 100 却要扣 1500 时，
;     实际只减了 100，而 `LLM_TG` 仍然是 1500。
;     直接返回它就会造成实测到的那类怪象：
;       · 明细显示「工作量＋1500」，可实际只减了 100
;       · 玩家在对话里看到的进度和真实值对不上，**退出对话再进来又"一致"了**
;         （因为重进时是从真实字段重算的）
;     ⇒ 用**前后差值**当结果，两边就永远一致。
LLM_TG_BEFORE = BASE:(LLM_CID):工作量
BASE:(LLM_CID):工作量 = MAX(BASE:(LLM_CID):工作量 - LLM_TG, 0)
LLM_TG = LLM_TG_BEFORE - BASE:(LLM_CID):工作量

; ②b ★ **玩家也练到了** —— 照抄官方 `COMF304` 的经验成长
;  ⚠️ 这一块原来漏了（只抄了工作量/消耗/好感度），结果是
;     "帮了半天活，技能一点没长"，和官方指令的收益对不上。
;  ⚠️ 只在**真的推进了工作量**时才给（`LLM_TG > 0`），
;     免得"活早干完了还在这儿点"也能刷经验。
;  ⚠️ 官方的「陪同自由行动」没有这一块 —— 陪着看书/钓鱼不涨是**对的**，
;     别顺手也加（那是官方设计，不是遗漏）。
;
;  ★ **涨了多少要发布出来**（`LLM_LAST_EXP` / `LLM_LAST_EXP_NAME`），
;    否则玩家在对话里看不到自己练到了什么（用户反馈过这一点）。
;  ⚠️ 每轮先清零 —— 上一轮的值不能残留（会显示成"这轮也涨了"）。
LLM_LAST_EXP = 0
LLM_LAST_EXP_NAME = ""
LLM_LAST_EXP_PROG = ""
IF LLM_TG > 0
	CALL LLM_WORK_EXP(CFLAG:(LLM_CID):職種, LLM_LAST_EXP, LLM_LAST_EXP_NAME)
	; ★ 距下一级的进度条 —— **必须在经验涨过之后再取**，
	;   否则显示的是"涨之前"的进度，等于没反映这次收益。
	CALL LLM_SKILL_BAR(CFLAG:(LLM_CID):職種, LLM_LAST_EXP_PROG)
ENDIF

; ③ 扣玩家体力 / 气力
;  ⚠️⚠️ **消耗用独立的份额（`LLM_COSTSTEP`），不跟着进度份额放大。**
;     理由：这是「**陪伴**」而不是「**替她干**」—— 活主要是她自己干的，
;     玩家只是陪着、搭把手。
;     早期版本让两者共用一个份额，结果是"闲聊 3 分钟掉 75 体力"：
;         份额 3 时体力 = 250 × 3/10 = 75/轮
;         而她的活总共 3600、每轮才推进 33 —— 全帮完要 8000+ 体力，
;     等于"陪人聊天比扛大包还累"。这显然是错的。
;     现在：进度按份额（推得快、看得见进展），消耗另算。
;  ⚠️ `LLM_COSTSTEP = 0` 表示「**这里不扣，调用方自己扣**」——
;     陪伴模式下的「闲聊着陪着」就是这种：它用一套**固定值**
;     （15 分钟 / 体力 −150 / 气力 −30），比按職種缩放更好预期。
SIF LLM_COSTSTEP > 0
	CALL LLM_WORK_COST(CFLAG:(LLM_CID):職種, LLM_CT, LLM_CK)
SIF LLM_COSTSTEP > 0
	DOWNBASE:MASTER:体力 += MAX(LLM_CT * LLM_COSTSTEP / 10, 1)
SIF LLM_COSTSTEP > 0
	DOWNBASE:MASTER:気力 += MAX(LLM_CK * LLM_COSTSTEP / 10, 1)
;  ⚠️⚠️ **必须立刻结算，否则等于没扣！**
;     `DOWNBASE` 只是"**累积待扣**"的暂存量，真正的减法发生在
;     `@SOURCE_DOWNBASE` 里（`SOURCE_EXTRA.ERB:580-581`）：
;         BASE:体力 = LIMIT(BASE:体力 - DOWNBASE:体力, 0, MAXBASE:体力)
;     而它**只在回合结束时**由 `@SOURCE_CHECK` 调用（`SOURCE.ERB:532`）。
;     自由对话不是一个回合 —— 不在这里主动结算的话，玩家在对话里看到的
;     「体力－75」只是提示，实际数值**一点没少**（要等退出对话、执行下一条
;     指令才会补扣）。
;  ⚠️ `@SOURCE_DOWNBASE` **不清零** `DOWNBASE`（清零由 `@SOURCE_CHECK` 负责），
;     所以这里必须手动清零，否则下一轮会把同一笔消耗**再扣一次**。
CALL SOURCE_DOWNBASE(MASTER)
DOWNBASE:MASTER:体力 = 0
DOWNBASE:MASTER:気力 = 0

; ④ 好感度 / 情绪的"源"（照抄 COMF304:135-184 的关键几项）
;
;  ⚠️⚠️ **这里刻意不乘 `LLM_STEP`（工作量份额）！**
;     `SOURCE:*` 描述的是"**这次相处本身的质量**"，不是"干完了多少活"。
;     早期把它跟份额绑在一起，而认真档的份额是 30（= 3 倍），于是：
;         `SOURCE:歓楽 += 300 × 30/10 = 900`
;     经 `@FAVOR_CALC` 换算后**一次帮忙就 +40~50 好感度** ——
;     远超官方基准（一次帮忙 300 源），玩家一看就知道不对劲。
;     **工作量推进得快**是使用者要的，但好感度不该跟着翻 3 倍。
;
;  现在的规则：
;    · 官方基准（`COMF304:138` 的 `SOURCE:歓楽 = 300`）—— 随口陪着就按这个给
;    · 认真帮忙（`LLM_COSTSTEP > 0`）—— 只给 **1.5 倍**，作为"更投入"的奖励
;    · `SOURCE:歓楽` 另外那两项（按 親密 / 従順 分档）与 `SOURCE:受動`
;      也一律用**基准值**，不乘份额
LLM_SRC = 300
SIF LLM_COSTSTEP > 0
	LLM_SRC = 450                     ; 认真帮忙 1.5 倍

; ★ 再按**掷骰结果**微调（用户要求：成功也该有好感，但比大成功少）
;  ⚠️ 这一层和上面的"投入程度"是**两个独立维度**：
;     投入程度决定**基数**（随口 300 / 认真 450），结果决定**浮动**（+150 / 减半）。
;  ⇒ 六种组合：
;       随口成功 300 ／ 随口大成功 450 ／ 随口失败 150
;       认真成功 450 ／ 认真大成功 600 ／ 认真失败 225
SIF TFLAG:193 == 1
	LLM_SRC += 150                    ; 大成功：更多
SIF TFLAG:193 == -1
	LLM_SRC /= 2                      ; 失败：减半（不归零 —— 毕竟花了时间）

TFLAG:情緒上昇抑制 = 1
SOURCE:(LLM_CID):歓楽 += LLM_SRC
SOURCE:(LLM_CID):歓楽 += 70 + ABL:(LLM_CID):親密 * 50
SOURCE:(LLM_CID):受動 += 230 + 80 * ABL:(LLM_CID):従順

RETURN LLM_TG


; ────────────────────────────────────────────────────────────────────────────
;  往「本次结算」明细串里追加一项
; ────────────────────────────────────────────────────────────────────────────
;  分成两个函数，是因为**符号方向相反**：
;    · 消耗类（体力 / 气力）—— `DOWNBASE` **正数 = 消耗**，所以显示成「－N」
;      （这与官方 `SOURCE.ERB:1044-1066` 的显示规则一致：
;        `体力-{DOWNBASE}` / 负数才显示成 `体力+`）
;    · 获得类（好感度 / 工作量）—— 正数 = 得到，显示成「＋N」
;  0 值一律跳过，不显示没变化的项。
; ────────────────────────────────────────────────────────────────────────────
@LLM_GAIN_COST(REF_TEXT, LLM_LABEL, LLM_VAL)
#DIMS REF REF_TEXT
#DIMS LLM_LABEL
#DIM  LLM_VAL
SIF LLM_VAL == 0
	RETURN
SIF REF_TEXT != ""
	REF_TEXT += "　"
REF_TEXT += @"%LLM_LABEL%"
IF LLM_VAL > 0
	REF_TEXT += @"－%TOSTR(LLM_VAL)%"
ELSE
	REF_TEXT += @"＋%TOSTR(-LLM_VAL)%"
ENDIF
RETURN


@LLM_GAIN_GET(REF_TEXT, LLM_LABEL, LLM_VAL)
#DIMS REF REF_TEXT
#DIMS LLM_LABEL
#DIM  LLM_VAL
SIF LLM_VAL == 0
	RETURN
SIF REF_TEXT != ""
	REF_TEXT += "　"
REF_TEXT += @"%LLM_LABEL%"
IF LLM_VAL > 0
	REF_TEXT += @"＋%TOSTR(LLM_VAL)%"
ELSE
	REF_TEXT += @"－%TOSTR(-LLM_VAL)%"
ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  往明细里追加一项「**当前值**」（如「体力 350/1000」）
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ 和上面两个的区别：
;    · `@LLM_GAIN_COST` / `@LLM_GAIN_GET` 显示的是**变化量**（带 ＋/－）
;    · 这一个显示的是**当前值**（并且带上限），用来**做体力管理**
;  用户的需求："在「时间－3」那一行同时显示当前体力和当前气力" ——
;  聊一轮就掉一截体力，看不到剩余量就没法判断还能陪多久。
;
;  ⚠️ 显示成 `当前/上限` 而不是只显示当前值：
;     光看「体力 350」判断不出还剩多少余量（上限因人而异，2000 和 1000 差一倍）；
;     写成「体力 350/2000」一眼就知道还剩约 18%。
;  ⚠️ 这一项**不参与"是否为空"的判断** —— 它总是要显示的，
;     所以调用方要无条件追加（见 ④d）。
; ────────────────────────────────────────────────────────────────────────────
; ────────────────────────────────────────────────────────────────────────────
;  生成一段「进度条」文本（供明细嵌入）
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ 为什么自己写、不复用官方的：
;    · `@PRINT_COLORBAR`（`PANIMATION.ERB:102`）、`@COLOR_BAR`
;      （`魔改内容\PRINT系\UI_Components_&_Tables.ERB:1190`）都是**直接 PRINT**，
;      **不返回字符串** —— 而我们的明细是一整串先在变量里拼好、最后一次性打印的，
;      中间插不进"打印"动作。写 `CALL` 进去会把条打在**别的行**上。
;    · `@HTML_COLORBAR` 虽然是 `#FUNCTIONS`，但它返回 **HTML**
;      （`<font color=…>`），给 `HTML_PRINT` 用的；
;      我们走 `PRINTFORML` 纯文本，HTML 标签会**原样显示出来**。
;
;  ⚠️ 字符选的是 `■`（实心）/ `□`（空心）——
;     这两个在**官方自己的界面里就在用**（`PRINT_STATE2.ERB:131`
;     `PRINTL 自宅位置：■■■■■`、`PRINT_STATE.ERB:13` `PRINT ■`），
;     所以字体一定支持，不会出现豆腐块。
;     （官方状态栏那条 `▅`（U+2585）也行，但方块更"进度条"。）
;
;  ⚠️ **必须是 `#FUNCTIONS`**（返回字符串），调用方才能写成
;     `@"…%LLM_BARSTR(百分比, 10)%…"` 嵌进明细串里。
; ────────────────────────────────────────────────────────────────────────────
@LLM_BARSTR(LLM_PCT, LLM_LEN)
#FUNCTIONS
#DIM  LLM_PCT        ; 百分比 0~100
#DIM  LLM_LEN        ; 条的字符数
#LOCALSIZE 4
#LOCALSSIZE 4
#DIMS LLM_FULL
#DIMS LLM_EMPTY
#DIMS LLM_A
#DIMS LLM_B
#DIM  LLM_FILL
SIF LLM_LEN <= 0
	RETURNF ""
; ⚠️ 上限 10：素材串只备了 10 个字符，超了 SUBSTRING 会取不到
SIF LLM_LEN > 10
	LLM_LEN = 10
LLM_FULL = "■■■■■■■■■■"
LLM_EMPTY = "□□□□□□□□□□"
; ⚠️ LIMIT 两端都要钳：百分比可能超 100（上限变动时），也可能是负的
LLM_FILL = LIMIT(LLM_PCT * LLM_LEN / 100, 0, LLM_LEN)
LLM_A = %SUBSTRING(LLM_FULL, 0, LLM_FILL)%
LLM_B = %SUBSTRING(LLM_EMPTY, 0, LLM_LEN - LLM_FILL)%
; ⚠️ 拼接**必须用 `@"…%变量%…"`** ——
;    写 `RETURNF LLM_A + LLM_B` 会拼进字面的 " + "（见避坑清单第 4 条）
RETURNF @"%LLM_A%%LLM_B%"


@LLM_GAIN_CUR(REF_TEXT, LLM_LABEL, LLM_VAL, LLM_MAX)
#DIMS REF REF_TEXT
#DIMS LLM_LABEL
#DIM  LLM_VAL
#DIM  LLM_MAX
SIF REF_TEXT != ""
	REF_TEXT += "　"
REF_TEXT += @"%LLM_LABEL%"
; ⚠️ 必须 `IF … ENDIF`：这里的分支有**两行**，
;    写成 `SIF` 的话 `RETURN` 会无条件执行，兜底那行就成了死代码。
IF LLM_MAX > 0
	; ★ 用**进度条**而不是「350/2000」：
	;   条本身就把"还剩几成"表达清楚了，比一对数字更快看懂；
	;   后面再跟一个**绝对值**，因为"够不够"要拿它和阈值比
	;   （婉拒线是 800，那是绝对数，光看条判断不出来）。
	;   ⇒ `■■□□□□□□□□ 350`
	REF_TEXT += @"%LLM_BARSTR(LLM_VAL * 100 / LLM_MAX, 10)% %TOSTR(LLM_VAL)%"
ELSE
	REF_TEXT += @"%TOSTR(LLM_VAL)%"
ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  把「**技能经验 ＋ 距下一级的进度条**」作为**一项**追加进明细
; ────────────────────────────────────────────────────────────────────────────
;  形如：`战斗经验＋1 Lv2 ■■□□□□□□ 4/10`
;
;  ⚠️ 为什么合成一项、而不是拆成两条：
;     拆开会变成「战斗经验＋1　战斗经验 Lv2 ■■…」—— 同一个技能名出现两遍。
;  ⚠️ 三项内容**各自可能缺席**，所以逐段判断：
;     · 名字没有 ⇒ 这一轮没帮忙（或職種没映射）→ 整项不显示
;     · 没涨经验（多数職種 25% 才涨）⇒ 省掉「＋1」，但**进度条照常显示**
;       —— 用户要的是"看到的进度"，不是"只在涨的那一次才看到"
;     · 已满级 / 没等级概念 ⇒ 只有名字
;  ⚠️ 数据来自 `@LLM_WORK_DO` 的 ②b（它负责在经验涨过之后取进度）。
; ────────────────────────────────────────────────────────────────────────────
@LLM_GAIN_EXP(REF_TEXT)
#DIMS REF REF_TEXT
SIF LLM_LAST_EXP_NAME == ""
	RETURN
SIF REF_TEXT != ""
	REF_TEXT += "　"
REF_TEXT += @"%LLM_LAST_EXP_NAME%"
SIF LLM_LAST_EXP > 0
	REF_TEXT += @"＋%TOSTR(LLM_LAST_EXP)%"
SIF LLM_LAST_EXP_PROG != ""
	REF_TEXT += @" %LLM_LAST_EXP_PROG%"
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  ★★ 「陪伴状态发生变化」的**唯一登记入口**
; ────────────────────────────────────────────────────────────────────────────
;  为什么要有它（用户建议模块化，这是落实）：
;    "某件事结束了"这件事，之前是**散在 5 个地方手写**的 ——
;    每处都要自己拼消息、自己清模式、自己写 `LLM_JUST_ENDED`。
;    结果 §28 的审计一次就揪出"漏了 3 处"，而且 §29 又发现
;    "清零之后 `LLM_ACT` 会整行消失、模型以为还没结束"。
;    ⇒ **把它变成一个入口**：以后加新的"结束"场景时，
;      **只要调它就不会漏**；审计也只要 grep `CALL LLM_MARK_END` 一处。
;
;  ⚠️⚠️ 两条铁律（都是踩出来的）：
;    1. **所有"结束"都必须经过这里** —— 否则 `LLM_JUST_ENDED` 不会写，
;       下一轮 prompt 里她"刚做完"这件事会**凭空消失**，
;       模型只能从对话历史里编 ⇒ 回一句「还没呢」（§29）。
;    2. **"被拒绝"不是"结束"** —— 关系不够 / 太累婉拒时，那件事**还在继续**，
;       她下一轮仍然"正在运动"。这种要 `LLM_WHAT` 传空串，
;       只显示一行提示、**不登记结束**。
;
;  参数：
;    REF_MSG   —— 要追加到的明细串（调用方传 `LLM_MSG`）
;    LLM_WHAT  —— 那件事的名字（如「一起做运动」「工作」）；
;                 **空串 = 这不是"结束"，不登记**（见铁律 2）
;    LLM_TEXT  —— 显示的原文；**空串 = 用默认格式「X结束了」**
;
;  ⚠️ 刻意**不碰 `REF_TOGETHER`**：它是 `@LLM_APPLY_DELTA` 的引用参数，
;     把引用参数再传给另一个函数的引用参数**不可靠**（本项目踩过这个坑）。
;     调用方自己清（就一行，而且清得明白）。
; ────────────────────────────────────────────────────────────────────────────
@LLM_MARK_END(REF_MSG, LLM_WHAT, LLM_TEXT)
#DIMS REF REF_MSG
#DIMS LLM_WHAT
#DIMS LLM_TEXT
SIF REF_MSG != ""
	REF_MSG += "　"
; ⚠️ 必须 `IF … ENDIF`（分支里有两行），`SIF` 只绑紧随的一行
IF LLM_TEXT != ""
	REF_MSG += @"（%LLM_TEXT%）"
ELSE
	REF_MSG += @"（%LLM_WHAT%结束了）"
ENDIF
; ★ **只有"真的结束了"才登记** —— 下一轮 prompt 会把这件事再说一遍
	IF LLM_WHAT != ""
		LLM_JUST_ENDED = %LLM_WHAT%
		; ★ 持续 3 轮（2026-09-18）—— 见 LLM_KOJO.ERH 里那个变量的说明 ✓
		LLM_ENDED_CNT = 3
	ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  「陪伴」专用 system prompt
; ────────────────────────────────────────────────────────────────────────────
;  为什么单独写一个、而不复用主 prompt：
;  主 prompt 里**强制要求**输出 `###DELTA###` 数值块，而这次请求只是要她
;  针对"你陪了她"这件事**补一句反应**，不该再算一次数值（否则同一轮结算两遍）。
;  所以这里用一套独立的、不含数值块要求的 prompt。
; ────────────────────────────────────────────────────────────────────────────
@LLM_BUILD_TOGETHER_PROMPT(LLM_CID, REF_PROMPT, LLM_WHAT)
#DIM  LLM_CID
#DIMS REF REF_PROMPT
#DIMS LLM_WHAT        ; 玩家陪她做了什么（如「吃饭」）
#LOCALSIZE 4
#LOCALSSIZE 4
#DIMS LLM_CHAR_NAME
#DIMS LLM_TONE
#DIM  LLM_ALEFT      ; 她那件事实际还剩几分钟（`@LLM_ACT_REMAIN` 的返回值）
#DIM  LLM_AEND       ; 大致结束时刻（当天分钟数 0~1439）

CALL LLM_PERSONA_SNAPSHOT(LLM_CID)
LLM_CHAR_NAME = %CALLNAME:(LLM_CID)%
CALL LLM_TONE_OF(LLM_CID, LLM_TONE)

REF_PROMPT = @"你正在扮演东方Project同人游戏《eraTW》中的角色。"
REF_PROMPT += @"\n【角色】%LLM_CHAR_NAME%"
REF_PROMPT += @"\n你的名字就是「%LLM_CHAR_NAME%」。不要演成别的角色。"
REF_PROMPT += @"\n【本作对该角色的既定诠释（persona 来源）】"
IF LLM_PERSONA_OK
	REF_PROMPT += @"%LLM_PERSONA_SHOW%"
ELSE
	REF_PROMPT += @"该角色在本作中没有专属剧本，请按其原作性格演绎"
ENDIF
REF_PROMPT += @"\n【说话方式】%LLM_TONE%"
REF_PROMPT += @"\n【刚刚发生的事】玩家没有多说什么，而是**安静地陪着你一起%LLM_WHAT%**。"
; ★ **告诉她"这件事还剩多久、大概几点结束"** ——
;   ⚠️ 不带这个的话，她会说「那咱们接着练吧」这种和实际剩余时间无关的话，
;      而玩家那边可能只差几分钟就要收工了。
;   ⚠️ 剩余时间必须走 `@LLM_ACT_REMAIN`（**有效剩余**）——
;      `Activity_Duration` 在自由对话中**不会减少**（递减在回合末的
;      `@CHARA_MOVEMENT` → `@自由行動処理`），直接读会偏大（见 §28）。
LLM_ALEFT = LLM_ACT_REMAIN(LLM_CID)
IF LLM_ALEFT > 0
	LLM_AEND = TIME + LLM_ALEFT
	; ⚠️ 跨天：`時刻表示` 只认 0~1439
	SIF LLM_AEND >= 1440
		LLM_AEND -= 1440
	REF_PROMPT += @"\n【你手头这件事】大概还要{LLM_ALEFT}分钟（大约%時刻表示(LLM_AEND)%结束）。"
ELSE
	REF_PROMPT += @"\n【你手头这件事】其实已经差不多到点了，随时可以收尾。"
ENDIF
REF_PROMPT += @"\n【要求】"
REF_PROMPT += @"\n1. 用**一到两句**说说你此刻的反应 —— 可以是随口的感想、别扭的抱怨、"
REF_PROMPT += @"\n   或者难得的放松。别写成感谢致辞，也别煽情。"
REF_PROMPT += @"\n2. **接着说下去，不要重复你刚才已经说过的话。**"
REF_PROMPT += @"\n3. 语气严格照【说话方式】：口语短句、带语气词，不要中性回答或客服腔。"
REF_PROMPT += @"\n4. 只输出你说出口的话：不要旁白、动作描写、括号说明、引号本身。"
REF_PROMPT += @"\n5. 不要提到自己是 AI、模型或程序。"
REF_PROMPT += @"\n6. **不要输出任何数值块或 ###DELTA### 分隔符。**"
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  「陪伴」之后补一句她的话
; ────────────────────────────────────────────────────────────────────────────
;  为什么值得多花一次请求：数值提示（「陪她吃饭，过了 30 分钟」）是系统口吻，
;  干巴巴的；而**她本人对"有人陪"这件事的反应**才是玩家真正想看的。
;  只在真的发生了陪伴时才调用（一场对话最多几次），不会明显拖慢节奏。
; ────────────────────────────────────────────────────────────────────────────
@LLM_TOGETHER_TALK(LLM_CID, LLM_WHAT)
#DIM  LLM_CID
#DIMS LLM_WHAT
; 数值局部：STATE / REQ / D1~D4 / **D5** 共 7 个（外加 LLM_CID 参数）—— 提到 12 留余量
#LOCALSIZE 12
; 字符串局部：SYS / TMP / OUT / **MEMO_NEW** 共 4 个（外加 LLM_WHAT 参数）——
; 之前正好卡在 4，加一个就溢出。提到 8。
#LOCALSSIZE 8
#DIMS LLM_SYS
#DIMS LLM_TMP
#DIMS LLM_OUT
#DIM  LLM_STATE
#DIM  LLM_REQ
#DIM  LLM_MEMO_W_NEW ; ★ 这里只是'抠掉不存'，但 `@LLM_PARSE_MEMO` 要求传这个出参
#DIM  LLM_D1
#DIM  LLM_D2
#DIM  LLM_D3
#DIM  LLM_D4
#DIM  LLM_D5
#DIM  LLM_D6
#DIMS LLM_MEMO_NEW   ; 只为把 ###MEMO### 从输出里抠掉（**不存储** —— 见调用处的说明）

; ⚠️ 玩家累趴时**不再发请求** —— 判据与其它入口统一走 `@LLM_TOO_TIRED`。
;    这一句本来就只是"锦上添花"（陪伴的数值效果已经生效），
;    所以安静跳过即可，不用打印任何东西。
; ★ **自由互动时绕过「玩家累趴」中断**（2026-09-20）——
;   ⚠️ 场景里玩家累不累和互动无关 ⇒ 不该被强制道别 ✗
;   ⚠️ 前面已清 `RESULT` ⇒ RESULT 保持 0 ⇒ `IF RESULT` 不命中 ✓
; ⚠️ **必须先清 RESULT** —— `SIF` 不成立时 CALL 不执行，
;   RESULT 会保留上一次的残留值 ⇒ `IF RESULT` 会误判 ⚠️
RESULT = 0
SIF LLM_MODE == 0
	CALL LLM_TOO_TIRED
IF RESULT
	; 玩家累趴了 → 这一句"锦上添花"的话就没必要发了，
	; 但**她的关心和记忆仍然要留**（统一走 @LLM_TOO_TIRED_TALK）。
	CALL LLM_TOO_TIRED_TALK(LLM_CID, RESULT)
	RETURN
ENDIF
CALL LLM_BUILD_TOGETHER_PROMPT(LLM_CID, LLM_SYS, LLM_WHAT)
; 第 4 参数传 1 = **记入对话记忆**：这是真实发生过的交流，该留在上下文里
; （与"拒绝"相反 —— 拒绝不算聊过，所以那边传 0）。
CALLSHARP LLM_CHAT_SEND(LLM_CID, LLM_SYS, "（玩家安静地陪着你，什么也没多说。）", 1, LLM_TMP)
IF TOINT(LLM_TMP) <= 0
	; 发不出去就安静跳过 —— 陪伴效果和数值提示都已经生效了，
	; 这一句只是锦上添花，不该因为接口问题打断对话。
	RETURN
ENDIF
LLM_REQ = TOINT(LLM_TMP)
PRINTFORML 　.....少女思考中……
CALL LLM_POLL(LLM_REQ, LLM_STATE, LLM_OUT)
CLEARLINE 1
IF LLM_STATE == 1
	; ⚠️ 先解析再清洗：万一模型还是带了 ###DELTA### 块，这里把它**抠掉**，
	;    但**不应用**其中的数值 —— 本轮数值已经在 @LLM_APPLY_DELTA 里结算过了，
	;    这里再用一次就成了同一轮算两遍。
	CALL LLM_PARSE_DELTA(LLM_OUT, LLM_D1, LLM_D2, LLM_D3, LLM_D4, LLM_D5, LLM_D6)
	; ⚠️ 这里**只抠掉、不存储** —— 这是"陪伴后补的一句"，
	;    同一轮的 ###MEMO### 已经在主循环里处理过了，再存会重复。
	CALL LLM_PARSE_MEMO(LLM_OUT, LLM_MEMO_NEW, LLM_MEMO_W_NEW)
	CALL LLM_SANITIZE_REPLY(LLM_OUT)
	IF LLM_OUT != ""
		CALL LLM_SHOW_FIGURE(LLM_CID)
		CALL LLM_PRINT_REPLY(LLM_CID, LLM_OUT)
	ENDIF
ENDIF
RETURN






@LLM_PRINT_REPLY(LLM_CID, REF_TEXT)
#DIM  LLM_CID
#DIMS REF_TEXT
#LOCALSIZE 1

CALL SET_KOJO_COLOR(LLM_CID)
SIF !FLAG:口上色
	RESETCOLOR
PRINTFORML 「%REF_TEXT%」
RESETCOLOR
; ★★ **记下「这一轮她说了什么」+ 日期**（2026-09-19 加）——
;   ⚠️ `LLM_PREV` **原来从来没被写过**（全项目只有读、没有写）⇒
;     【你们上一次交谈的片段】一直是空 ⚠️
;   ⚠️ 覆盖式写 ⇒ 对话结束时留下的正好是**最后一轮** ✓
;   ⚠️ **日期只给 LLM 看**，不进 [6] 界面（用户要求）✓
IF REF_TEXT != ""
	; ★ **自由互动不写持久数据**（2026-09-21 用户要求）✓
	; ★ 睡着 / 醉倒时的话不进记录（2026-09-21 用户要求）✓
	IF LLM_MODE == 0 && !CFLAG:(LLM_CID):睡眠 && !TCVAR:(LLM_CID):烂醉
	LLM_PREV:(LLM_CID):0 = @"{DAY * 1440 + TIME}|%REF_TEXT%"
	ENDIF
	; ★★ **两个攒记录块**（2026-09-20）——
	;   ① `LLM_DATERAW`：**约会期间**的完整台词（总结约会用）
	;   ② `LLM_CHATRAW`：**本场对话**的完整台词（开场预取总结用）
	;   ⚠️ 都要限长 4000 字节（超了砍掉最早的，免得存档膨胀）⚠️
	;   ⚠️ 两个都用 IF/ENDIF 包住 —— `SIF` 只绑一行，多行会被自查报「绑了多行」✓
	IF IS_DATING_WITH_PLAYER(LLM_CID)
		LLM_DATERAW:(LLM_CID):0 += @"\n%REF_TEXT%"
		; ⚠️ 限长 4000 字节（约 2000 汉字）
		IF STRLENS(LLM_DATERAW:(LLM_CID):0) > 4000
			LLM_DATERAW:(LLM_CID):0 '= SUBSTRING(LLM_DATERAW:(LLM_CID):0, 1000, STRLENS(LLM_DATERAW:(LLM_CID):0) - 1000)
		ENDIF
	ENDIF
	; ★ **自由互动不写持久数据**（2026-09-21 用户要求）✓
; ★ 睡着 / 醉倒时的话不进记录（2026-09-21 用户要求）✓
IF LLM_MODE == 0 && !CFLAG:(LLM_CID):睡眠 && !TCVAR:(LLM_CID):烂醉
	LLM_CHATRAW:(LLM_CID):0 += @"\n%REF_TEXT%"
ENDIF
	IF STRLENS(LLM_CHATRAW:(LLM_CID):0) > 4000
		LLM_CHATRAW:(LLM_CID):0 '= SUBSTRING(LLM_CHATRAW:(LLM_CID):0, 1000, STRLENS(LLM_CHATRAW:(LLM_CID):0) - 1000)
ENDIF
	ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  接口配置有问题时给提示
; ────────────────────────────────────────────────────────────────────────────

; ────────────────────────────────────────────────────────────────────────────
;  ★ 约会路上的提示（2026-09-18 用户要求）
; ────────────────────────────────────────────────────────────────────────────
;  用户原话：「能不能把**约会道中**还有 **XX 分钟到约会地点**写在每轮的
;            对话之下作为提示」✓
;
;  ⚠️ 数据是 `TFLAG:约会道中 约会道中`，**两种格式**（`EVENTCOMEND2.ERB:62-72`）：
;       · `> 1000` ⇒ 还没动身（初值 = 所要時間 + 1000）⇒ 剩余 = 值 - 1000
;       · `1 ~ 1000` ⇒ **正在路上** ⇒ 剩余 = 值（分钟）
;       · `= 0`   ⇒ 不在路上（或已到达）⇒ 不显示 ✓
;  ⚠️ 它是**全局**的（约会只有一个对象）⇒ 不按角色 ✓
;  ⚠️ 做成独立函数、在台词之后调用 —— 那样**不用碰主循环** ✓
; ────────────────────────────────────────────────────────────────────────────
;  ★ 约会路上**实际**还剩几分钟（扣掉本场对话已推进的时间）
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️⚠️ 为什么不能直接读 `TFLAG:约会道中`：
;     它的递减在 `@TURN_RESET`（`EVENTCOMEND2.ERB:61-64`）—— 那是**回合末事件**，
;     而**自由对话整个在一回合之内** ⇒ 对话中它**完全不变** ⇒
;     提示会每轮显示同一个数字（和 `Activity_Duration` 同一个坑）⚠️
;  ⚠️ 本场已推进 = `TIME + DAY*1440 − LLM_SESSION_T0`（绝对值，跨天也对）✓
;  ⚠️ 返回**剩余分钟**，已经钳到 >= 0；0 表示"不在路上 / 已到" ✓
@LLM_DATE_LEFT
#FUNCTION
#LOCALSIZE 2
#DIM LLM_LEFT
SIF TFLAG:约会道中 <= 0
	RETURNF 0
LLM_LEFT = TFLAG:约会道中
; ⚠️ `> 1000` = 还没动身（初值 = 所要時間 + 1000）⇒ 先减掉那 1000 ✓
SIF LLM_LEFT > 1000
	LLM_LEFT -= 1000
; ★ 扣掉本场对话已经推进掉的时间（否则数字永远不变）✓
SIF LLM_SESSION_T0 > 0
	LLM_LEFT -= MAX(TIME + DAY * 1440 - LLM_SESSION_T0, 0)
RETURNF MAX(LLM_LEFT, 0)


@LLM_SHOW_DATEHINT
#LOCALSIZE 2
#DIM LLM_DLEFT
LLM_DLEFT = LLM_DATE_LEFT()
SIF LLM_DLEFT <= 0
	RETURN
; ⚠️ 用和台词不同的颜色（灰蓝），一眼能看出那是**提示**不是她的话 ✓
SETCOLOR C_AQUA
PRINTFORML 　（约会路上 —— 大约还有 {LLM_DLEFT} 分钟到%CALLNAME:MASTER%要去的地方）
RESETCOLOR


; ★★ 把「约会路上还剩几分钟」注入 prompt（2026-09-18 用户要求）——
;   用户原话：「让 llm 也知道这个时间可以吗，就像工作进度一样」✓
;  ⚠️ 数据是 `TFLAG:约会道中`，两种格式（`EVENTCOMEND2.ERB:62-72`）：
;      `> 1000` ⇒ 还没动身 ⇒ 剩余 = 值 - 1000；`1~1000` ⇒ 剩余 = 值 ✓
@LLM_DATE_INTO(REF_PROMPT)
#DIMS REF REF_PROMPT
#LOCALSIZE 2
#DIM LLM_DLEFT
LLM_DLEFT = LLM_DATE_LEFT()
SIF LLM_DLEFT <= 0
	RETURN
REF_PROMPT += @"\n【你正在去约会的路上】大约还有 {LLM_DLEFT} 分钟就到地方了。"
REF_PROMPT += @"\n（⚠️ 你们**正在往那边走** —— 别催他，也别当成已经到了；边走边聊就好 ✓）"
RETURN

@LLM_SHOW_API_HINT
#LOCALSIZE 1
PRINTFORML 　　→ 请检查 plugins\LLMBridge\apis.txt
PRINTFORML 　　　最少需要 model 和 url 两行；密钥填在 key 行。
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  自检：确认本文件的函数是否**真的被引擎注册**了
; ────────────────────────────────────────────────────────────────────────────
;  为什么需要它：如果某个函数因为 Lv1 错误（例如 # 行没紧跟在 @ 声明后面）
;  而没被注册，外面 `CALL` 它时**不会有任何输出、也不一定有明显报错**，
;  表现就是"点了没反应"。用 EXISTFUNCTION 直接问引擎，结论是确定的。
; ────────────────────────────────────────────────────────────────────────────
@LLM_SELFTEST
#LOCALSIZE 4
#LOCALSSIZE 4
#DIMS LLM_TMP
; ⚠️ **本函数自己的出参变量** —— 不能借用 `@LLM_CHAT_LOOP` 的局部
;    （自查第 4 项「跨函数变量」会抓）⚠️
#DIMS LLM_MEMO_NEW
#DIM  LLM_MEMO_W_NEW

PRINTL 【LLM 自检】
; ══ ★★ **持久化自检**（用户报："重启游戏后角色会忘记之前交代的称呼"）════════
;  用途：**确定性地判断 `CHARADATA SAVEDATA` 有没有真的生效**。
;  ⚠️ **方案 B（2026-09-16）之后，这里检查的对象改成 `LLM_MEMO`** ——
;     称呼 / 身份 / 约定现在都写成 `###MEMO### [3]`，落在长期记忆里，
;     不再有 `LLM_ADDRESS` / `LLM_CALLME` / `LLM_CALLHER` 三个专用槽 ✓
;  用法：
;    ① 在对话里交代一次称呼或身份（模型会写一条 `[5]` 记忆）
;    ② **在游戏里存档**
;    ③ 关掉游戏、重启 → **读那个存档**（⚠️ 不是开新游戏！）
;    ④ 跑这个自检
;  ⇒ 那条记忆还在 ⇒ **持久化正常** ✓
;    变成空 ⇒ **SAVEDATA 没生效**（那就是 `.ERH` 加载或声明的问题，发我）
;  ⚠️ `SAVEDATA` 的语义是"**随游戏存档保存**" ——
;     **开新游戏、或者不读档，值本来就是空的**（那是正常的，不是 bug）。
SIF LLM_MEMO_CNT:(TARGET):0 > 0
	PRINTFORML 　持久记忆（LLM_MEMO）… {LLM_MEMO_CNT:(TARGET):0} 条
SIF LLM_MEMO_CNT:(TARGET):0 == 0
	PRINTFORML 　持久记忆（LLM_MEMO）… 【空】
SIF LLM_PREV:(TARGET):0 != ""
	PRINTFORML 　上一场对话（LLM_PREV）… 有
SIF LLM_PREV:(TARGET):0 == ""

; ★ **位置诊断**（2026-09-20）—— 排查「小地图里不知道自己在哪」用
;   ⚠️ 每次点 [3] 打印插件调试信息 都会显示，**只读不改** ✓
PRINTFORML 　位置诊断…
PRINTFORML 　　CFLAG:現在位置 = {CFLAG:(TARGET):現在位置}
PRINTFORML 　　地图ID = {GET_MAPID(CFLAG:(TARGET):現在位置)}
PRINTFORML 　　地图名(GET_MAPNAME) = %GET_MAPNAME(GET_MAPID(CFLAG:(TARGET):現在位置))%
PRINTFORML 　　地点名(GET_PLACENAME) = %GET_PLACENAME(CFLAG:(TARGET):現在位置, 0)%
PRINTFORML 　　名字(NAME_FROM_PLACE) = %NAME_FROM_PLACE(CFLAG:(TARGET):現在位置)%
PRINTFORML 　　季节地图名(GET_MAPNAME,1) = %GET_MAPNAME(GET_MAPID(CFLAG:(TARGET):現在位置), 1)%
PRINTFORML 　工作状态诊断…
PRINTFORML 　　CHARA_HOLIDAY(0) = {CHARA_HOLIDAY((TARGET), 0)}   ← 1=不在上班
PRINTFORML 　　CHARA_HOLIDAY(1) = {CHARA_HOLIDAY((TARGET), 1)}   ← 1=今天没班
PRINTFORML 　　BASE:工作量 = {BASE:(TARGET):工作量}
PRINTFORML 　　工作開始 = {TCVAR:(TARGET):工作開始}   工作結束 = {TCVAR:(TARGET):工作結束}
PRINTFORML 　　CFLAG:職場 = {CFLAG:(TARGET):職場}   CSTR:職場 = %CSTR:(TARGET):職場%
PRINTFORML 　　行動(5=工作) = {CFLAG:(TARGET):行動}   AT_HOME = {AT_HOME((TARGET))}
PRINTFORML 　【自由互动诊断】
PRINTFORML 　　最近一次 ###BODY### 解析 = 「%LLM_BODY_LAST%」   ← 空 = 模型没写
PRINTFORML 　　LLM_MODE = {LLM_MODE}   ← 1 = 自由互动模式
PRINTFORML 　　TARGET = {TARGET}  名字 = %CALLNAME:(TARGET)%
PRINTFORML 　　CFLAG:睡眠 = {CFLAG:(TARGET):睡眠}   ← 1 = 睡着（睡姦层的判据）
PRINTFORML 　　TCVAR:烂醉 = {TCVAR:(TARGET):烂醉}   ← 醉姦层的判据
PRINTFORML 　　CFLAG:诶嘿嘿 = {CFLAG:(TARGET):诶嘿嘿}   ← 第三层的判据
PRINTFORML 　　LLM_HALFAWAKE = {LLM_HALFAWAKE}   AWAKE = {LLM_AWAKE:(TARGET):0}   BOOST = {LLM_AWAKE_BOOST}
PRINTFORML 　　REL_LEVEL = {LLM_REL_LEVEL(TARGET)}   好感 = {CFLAG:(TARGET):好感度}  信赖 = {CFLAG:(TARGET):信赖度}
PRINTFORML 　　絶頂余韻 B={BASE:(TARGET):Ｂ絶頂余韻} V={BASE:(TARGET):Ｖ絶頂余韻} C={BASE:(TARGET):Ｃ絶頂余韻} A={BASE:(TARGET):Ａ絶頂余韻} M={BASE:(TARGET):Ｍ絶頂余韻}

	PRINTFORML 　上一场对话（LLM_PREV）… 【空】

; ══ ★★★★ **解析器往返自测**（2026-09-16 加，**这一段是确定性的**）════════
;  为什么需要：排查"模型写了 ###MEMO### 却不进库"时，一直卡在"等模型输出"
;    —— 而模型**不是每轮都写** ⇒ 永远不知道是它没写、还是解析器坏了 ⚠️
;  ⇒ 这里**造一份和模型真实输出同格式的文本**，过一遍解析器，直接判定 ✓
;  ⚠️ 格式照抄实测样本（`debug.log` 里 id=5 的原文）：
;     「台词 ###DELTA### 1,20,0,0,0,0 ###MEMO### [3] 他自报身份：红魔馆新来的佣人」
;  ⚠️ 用 `@"…"` 写这个测试串，**里面不能有裸 ASCII 双引号**（本文件铁律）✓
PRINTL
PRINTL 　── 解析器自测（不依赖模型）──
LLM_TMP = @"\n台词在这里 ###DELTA### 1,20,0,0,0,0 ###MEMO### [3] 他自报身份：红魔馆新来的佣人"
