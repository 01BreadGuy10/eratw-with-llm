; ============================================================================
;  LLM_CONVERSATION.ERB —— 自由对话的对话引擎
; ============================================================================
;  职责：
;    · 组装 persona + 局面状态（system prompt）
;    · 用 LLM_CHAT_SEND / LLM_CHAT_POLL 配合 AWAIT 做**非阻塞**等待
;    · 清洗模型输出并打印
;
;  依赖：plugins\LLMBridge.dll
;
;  ⚠️ 本文件是**新增文件**，不修改任何现有 ERB / CSV；删除即恢复原状。
;
;  ⚠️ 实现约定（踩过的坑，勿改）：
;    ★★ **状态矛盾一律由程序判定，不要丢给模型选**（2026-09-19 用户确认）——
;       用户原话：「这样分别注入让程序判定注入内容比 llm 靠谱」✓
;       · ❌ 反例：先注入「你今天要从6点上到12点」，再补一句
;         「如果和【你现在正在做的事】对不上，以它为准」——
;         那是**把判断权交给模型** ⇒ 它**先信肯定句** ⇒ 下班了还以为在岗 ⚠️
;       · ✅ 正例：程序先判「在岗 / 已下班」，**只注入一致的那一份**
;         （已下班就整段用过去式：「你今天上过班：6时到12时」）✓
;       ⇒ 新加状态注入时，**先问「这份信息会不会和别处打架」** ✓
;    1. 字符串变量拷内容必须用 FORM 语法：`A = %B%`；裸写 `A = B` 得到字面量。
;    2. 本作 `STRING VARIABLE ASSIGNMENT ... :NO`，所以 `'=` 不能用于普通字符串变量。
;    3. `%...%` 求值要求结果是字符串，别放 #DIM 整数变量。
;    4. CALLSHARP 只能回填**最后一个参数**，故 POLL 用 (id, 状态, 文本) 的顺序。
;    5. 数值变量用 #DIM，字符串变量用 #DIMS —— 用错会在比较时报
;       「无法对字符串型和数值型使用二相运算符」。
;    6. **跨函数共享的变量必须放在 .ERH 头文件里**（见 LLM_KOJO.ERH）。
;       直接写在 .ERB 文件级会报 Lv1「#行只能在函数声明后立刻使用」。
; ============================================================================


; ────────────────────────────────────────────────────────────────────────────
;  对话主循环
; ────────────────────────────────────────────────────────────────────────────
@LLM_CHAT_LOOP(LLM_CID)
#DIM  LLM_CID
; 数值局部现有 10 个（STATE/REQ/ROUND/D1~D4/ACC_FAVOR/ACC_MOOD/GOT_DELTA）
; 字符串局部现有 8 个（SYS/INPUT/OUT/TMP/APINAME/TOGETHER/TG_BEFORE/REASON）
; —— 都曾正好卡在边界，各留一点余量，免得以后加东西时溢出
#LOCALSIZE 16
#LOCALSSIZE 12
#DIMS LLM_SYS        ; system prompt
#DIMS LLM_INPUT      ; 玩家输入
#DIMS LLM_OPEN_MSG   ; ★ 开场白那条消息（带断点+时间间隔，2026-09-20）
#DIMS LLM_SCENE_TXT    ; ★ 自由互动的动作/场景描写（加粗白色旁白）
#DIMS LLM_BODY_TAG     ; ★ 睡姦/醉姦：从回复里解析出的 ###BODY### 内容
#DIMS LLM_GAP_TXT    ; ★ 距上次交谈的人话说法（分钟→小时→天）
#DIMS LLM_OUT        ; 模型回复
#DIMS LLM_TMP
#DIM  LLM_STATE      ; 轮询状态：0=等待 1=成功 -1=失败（数值！）
#DIMS LLM_APINAME    ; 当前接口名（显示用）
#DIM  LLM_REQ        ; 请求 id
#DIM  LLM_ROUND      ; 本轮已对话次数
#DIM  LLM_D1         ; 本轮结算：好感度增减（@LLM_PARSE_DELTA 回填）
#DIM  LLM_D2         ; 本轮结算：情緒增减
#DIM  LLM_D3         ; 本轮结算：愤怒增减
#DIM  LLM_D4         ; 本轮结算：**言论性质** 0=普通 1=亲昵调情 2=性骚扰/越界
#DIM  LLM_D5         ; ★ 本轮结算：**信赖度**档位（0~2）
#DIM  LLM_D6         ; ★ 本轮结算：**行为代码**（1牵手…7脱衣服；0=无）
#DIMS LLM_TOGETHER   ; 「陪伴」模式：空 = 没在陪；非空 = 正陪她做的事（跨轮保持）
#DIM  LLM_ISD         ; ★ 本轮她是否在约会中（2026-09-19）
; ★★ **对话模式**（2026-09-20）—— 0 = 自由对话，1 = 自由互动 ✓
;   ⚠️ **不存盘**：退出互动后由入口显式设回 0（免得模式残留）⚠️
#DIMS LLM_TG_BEFORE  ; 调用 @LLM_APPLY_DELTA **之前**的模式值，用来判断"刚建立"
#DIM  LLM_ACC_FAVOR  ; 本场已累计给过的好感度（单场 ±10 上限）
#DIM  LLM_ACC_MOOD   ; 本场已累计给过的情緒（单场 ±200 上限）
#DIMS LLM_REASON     ; 拒绝理由（她不愿交谈时用来喂给模型）
#DIM  LLM_GOT_DELTA  ; 模型这次是否给出了结算块（@LLM_PARSE_DELTA 的返回值）
#DIMS LLM_MEMO_NEW   ; ★ 模型这次给的记忆
#DIM  LLM_MEMO_W_NEW ; ★ 那条记忆的重要度
#DIMS LLM_NOTE_NEW   ; ★ 通用：抠出来的标记内容
; ⚠️⚠️ **"他自报的身份"判定状态**（2026-09-16 用户定：ERB 直接判定，不问模型）——
;    ⚠️⚠️ **不要用 `#DIM CONST` 数组装字符串**！我第一版写成
;       `#DIM CONST LLM_ID_LIST, 30 = 佣人, 女仆, …` ⇒ 游戏报
;       `Lv2: 无法解析的标识符「佣人」` + `Emuera停止运行` ⚠️
;       项目里的 `#DIM CONST` 数组**全是数值**
;       （如 `#DIM CONST SLOT_LEFT, 20 = 7,2,4,5,3,…`）✓
;    ⇒ 改用**直接连写判定**（和 `@LLM_IS_BYE` 一个写法：一串 `SIF` + 命中标志）——
;      不用数组、不用下标、不会踩这个坑 ✓
;    ⚠️ 词表**刻意保守**：宁可漏判，也不要误判（误判会写进一条错的身份记忆）✓
#DIM  LLM_IDHIT      ; 0/1：这一轮有没有识别出身份
#DIMS LLM_IDW        ; 命中的那个身份词
#DIM  LLM_IDDUP      ; ★ 这条身份记忆是不是**已经存在**（有 ⇒ 不存也不提示）
#DIM  LLM_MI         ; ★ 下标中转（CHARADATA 变量不能写三层下标）
; ⚠️ 2026-09-16 方案 B：身份改为 **ERB 直接判定**（见 `LLM_IDHIT` / `LLM_IDW`），
;    不再走 `###ADDR###` 解析 ⇒ 原来的 `LLM_ADDR_NEW` 已删除 ✓
#DIM  LLM_TRY        ; ★ 请求重试计数（最多 3 次）
; 说明：跨对话的"不快"存在 TCVAR:(角色):336（见 LLM_KOJO.ERH 的说明），
;       所以**不再需要** LLM_ANGER_ACC 这个局部变量。
; 说明：等待/超时逻辑都在 @LLM_POLL 里，这里不再需要 LLM_WAIT

; ⚠️ 参数名**不能**叫 CHARA：CHARA 是 Emuera 内置变量名，被拿来当形参有风险。
;    同理 ARG / ARGS / RESULT / RESULTS / TARGET / LOCAL / LOCALS / TIME 等都不能用。
;
; ⚠️⚠️ 这里曾经把上面那段说明放在 `@LLM_CHAT_LOOP` 与 `#DIM` 之间 —— 那就等于
;     「#行不是紧跟在函数声明后面」，会报
;        Lv1「#行只能在函数声明后立刻使用」
;     而 **Lv1 会让这个函数整个不被注册**：外面 CALL 它时不会有任何输出，
;     表现为"点开始对话后直接卡住/什么都不打印"。
;     ⇒ 任何注释都必须放在**全部 #DIM/#LOCALSIZE 之后**。

TARGET = LLM_CID

; ── 本场计数器先清零 ──
LLM_ROUND = 0
LLM_ACC_FAVOR = 0    ; 本场好感度累计（单场 ±10 上限从这里算）
LLM_ACC_MOOD = 0     ; 本场情緒累计（单场 ±200 上限从这里算）
; 陪伴模式：空 = 不在陪伴中；非空 = 正陪她做的这件事（如「吃饭」）。
; 一旦建立就跨轮次保持，退出对话时随本函数的局部变量一起消失。
LLM_TOGETHER = ""

; ── ★★ 约会状态跟踪 / 结束时的总结（2026-09-19）────────────────────
;  用户要求：「约会开始时的消息记录无限记忆直到约会结束，结束时输出
;            约会总结，进入持久记忆」✓
;  ⚠️ **触发点是「约会结束」而不是「对话结束」** ——
;     约会期间可能换好几张地图、聊好几场对话，那些都**不该**总结 ⚠️
;  ⚠️ 约会可能在**对话之外**结束（游戏机制：她回家 / 时间到 / 事件）⇒
;     所以这里在**每场对话开场**都检查一次，靠 `LLM_WAS_DATING` 找变化 ✓
LLM_ISD = IS_DATING_WITH_PLAYER(LLM_CID)
; ★ 上次在约会、这次不是 ⇒ 约会已经结束了（可能是在对话外结束的）
IF LLM_WAS_DATING:(LLM_CID):0 && !LLM_ISD
	CALL LLM_DATE_SUMMARY(LLM_CID)
ENDIF
; 场次：约会期间每开一场对话 +1（注入用，让她知道这是第几场）
IF LLM_ISD
	LLM_DATE_SESSION ++
ELSE
	LLM_DATE_SESSION = 0
ENDIF
LLM_WAS_DATING:(LLM_CID):0 = LLM_ISD
	; ★ **新一场开始 ⇒ 清空本场记录**（2026-09-20）✓
	LLM_CHATRAW:(LLM_CID):0 = ""

; ── 跨对话的"不快"：按关系滤镜消解一次 ────────────────────────────────
;  这个值存在 TCVAR，**关掉对话也不会忘**（"真实记录"）。
;  但每次重新搭话时，按关系消解一次 —— 照抄官方「陥落素質」的系数
;  （`SOURCE_EXTRA.ERB:107-140`：恋慕 ×0.2、愛欲 ×0.3、思慕 ×0.5）。
;
;  ⇒ 效果是"关系越深越容易消气"：恋人之间几天就翻篇，
;     陌生人则会把上次的不愉快带进下一次对话。
;
;  ⚠️ 刻意**不用 `MARK:反発刻印`** —— 那个几乎不可逆，代价太大。
IF TALENT:(LLM_CID):恋慕
	TCVAR:(LLM_CID):336 = TCVAR:(LLM_CID):336 * 2 / 10
ELSEIF TALENT:(LLM_CID):愛欲
	TCVAR:(LLM_CID):336 = TCVAR:(LLM_CID):336 * 3 / 10
ELSEIF TALENT:(LLM_CID):思慕
	TCVAR:(LLM_CID):336 = TCVAR:(LLM_CID):336 * 5 / 10
ENDIF
; 再缓慢自然消退（每次进对话 -50），免得永久背着一笔旧账
TCVAR:(LLM_CID):336 = MAX(TCVAR:(LLM_CID):336 - 50, 0)

; ────────────────────────────────────────────────────────────────────────────
;  先看玩家还聊不聊得动
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ 判定统一走 `@LLM_TOO_TIRED` —— **所有 LLM 交互入口共用同一个判据**
;     （开场白 / 主循环 / 拒绝台词 / 陪伴后追加台词…），
;     避免"这里拦了那里没拦"。以后加新互动也照这个来。
;
;  官方依据：
;    · 气力 —— `@COM_ABLE300` 的 `SIF BASE:MASTER:気力 <= 0 / RETURN 0`
;      （气力 0 不能发起会话）
;    · 体力 —— `EVENTCOMEND.ERB:91-94` 的 `体力 <= 0` →「体力不支晕过去了…」
;      ⚠️ 但那个判定在**回合末**才触发！对话中不刹车的话，
;         你能一边掉体力一边聊，直到退出对话才突然晕过去。
;
;  ⚠️ 这里不是"她拒绝"，是"你太累了"，所以不走 @LLM_REFUSE_TALK
;     （那句拒绝台词是角色视角的，用在这里会变成她在嫌弃你）。
; ★ **自由互动时绕过这个中断**（2026-09-20 用户要求）——
;   ⚠️ 睡姦/醉姦的前提就是她没意识 ⇒「睡着就拒绝」会让功能不可用 ✗
;   ⚠️ 前面已清 `RESULT` ⇒ 这里不调用时 RESULT 保持 0 ⇒ 下游分支不命中 ✓
; ⚠️ **必须先清 RESULT** —— `SIF` 不成立时 CALL 不执行，
;   RESULT 会保留上一次的残留值 ⇒ `IF RESULT` 会误判 ⚠️
RESULT = 0
SIF LLM_MODE == 0
	CALL LLM_TOO_TIRED
IF RESULT == 1
	PRINTFORML 　你连站都快站不稳了，实在没力气聊天。先去休息吧。
	RETURN 1
ELSEIF RESULT == 2
	PRINTFORML 　你已经累得说不出话了。先去休息一下再来吧。
	RETURN 1
ENDIF

; ────────────────────────────────────────────────────────────────────────────
;  先问她愿不愿意交谈
; ────────────────────────────────────────────────────────────────────────────
;  生气 / 睡着 / 对你有反感时，她会**拒绝**这次自由对话：
;  进来后只说一句拒绝台词就走，不进入下面的对话循环。
;  另外**聊到一半被激怒**也会中途拒绝（见循环内的判定）。
;  判定完全在本地（@LLM_REFUSE_REASON），行为可预测、不看模型脸色；
;  台词则走 persona 由模型生成（@LLM_REFUSE_TALK）。
;
;  ⚠️ 调用前必须先清 RESULT：CALL 一个没注册的函数不会执行、也不报错，
;     而 RESULT 会保留**上一次调用的残留值**，会被误判成"她拒绝交谈"。
RESULT = 0
; ★ **自由互动时绕过这个中断**（2026-09-20 用户要求）——
;   ⚠️ 睡姦/醉姦的前提就是她没意识 ⇒「睡着就拒绝」会让功能不可用 ✗
;   ⚠️ 前面已清 `RESULT` ⇒ 不调用时 RESULT 保持 0 ⇒ 下游分支不命中 ✓
SIF LLM_MODE == 0
	CALL LLM_REFUSE_REASON(LLM_CID, TCVAR:(LLM_CID):336, LLM_REASON)
IF RESULT
	CALL LLM_REFUSE_TALK(LLM_CID, LLM_REASON, "")
	; 返回 1 告诉菜单："她是拒绝的，请直接退出界面，
	; 把拒绝台词留在画面上"（留在菜单里会被 RELINE 清屏冲掉）
	RETURN 1
ENDIF

; 显示当前接口，让玩家知道在用哪个
CALLSHARP LLM_API_ACTIVE_NAME(LLM_APINAME)
SIF LLM_APINAME == ""
	LLM_APINAME = 未配置

; 取一次 persona（写入文件级变量，后续每轮复用）
; ★★ 开场清零（本场专用；这些是**跨轮**变量，不清会带到下一场）——
LLM_PENDING_EXIT = 0
LLM_FEEL = 0
LLM_TOUCH_NOTE = 0
LLM_STRIPPED = 0
; ⚠️⚠️ **本场已经挽留过几次** —— 必须在这里清零，否则**只清一次就永久卡死**：
;    `LLM_BYE_KEPT` 是**文件级变量**（不带 SAVEDATA，跨对话留着），
;    而它**全项目只有一处写 1**（`@LLM_BYE_CHECK` 里挽留成功时）。
;    ⇒ 不清零的话，**第一次挽留之后它永远是 1** ⇒
;      `SIF LLM_BYE_KEPT >= 1 / RETURN` 之后每次都提前返回 ⇒
;      `LLM_BYE_MODE` 恒为 0 ⇒ **「玩家说再见就结束对话」整个功能失效** ⚠️
;    （2026-09-16 排查「说了再见还继续聊」时发现的，和下面的调用缺失是**两个独立缺口**）
LLM_BYE_KEPT = 0
; ⚠️ 道别结束标记也开场清零（会话级，用完即清）✓
LLM_BYE_ENDED = 0
; ★★ **上一次见面距今** —— ⚠️ 必须在更新 `LLM_LASTMEET` 之前算差值，否则永远是 0 ✓
;     用绝对分钟数（`TIME + DAY*1440`），跨天时 `TIME` 会回绕 ✓
LLM_GAP = TIME + DAY * 1440 - LLM_LASTMEET:(TARGET):0
SIF LLM_GAP <= 0
	LLM_GAP = 0
LLM_LASTMEET:(TARGET):0 = TIME + DAY * 1440
; ★★ **本场对话的起点**（绝对分钟数）——
;  ⚠️ 只读不写的缺口：`@LLM_ACT_REMAIN` 要靠它算「她手头那件事实际还剩多久」
;     （本场推进 = 现在 − 起点），没赋值就永远是 0，那个估算就不准 ⚠️
;     （2026-09-16 审计发现的缺口，修复）
LLM_SESSION_T0 = TIME + DAY * 1440

CALL LLM_PERSONA_SNAPSHOT(TARGET)

; ────────────────────────────────────────────────────────────────────────────
;  开场白：一进对话就让角色先说一句
;  目的：让玩家一眼看出"链路通不通"，不用先自己想话题。
;  说明：★ **这一轮要记入历史**（第4参数传 1，2026-09-19 改）——
;        ⚠️ 原来传 0（不记）是为了避免把"请开始对话"这种指令留在上下文里，
;        但副作用是**她开场说了什么自己就不记得了** ⚠️（用户实测）
;        ⇒ 改成：玩家侧文案写自然（"（玩家走到你面前。）"），然后记进历史 ✓
; ────────────────────────────────────────────────────────────────────────────
; ⚠️⚠️ **第 4 个参数 `LLM_OPENING` 必须传！**（2026-09-16 修）——
;    它原来是省略的 ⇒ 恒为 0 ⇒ 下面这些**全部失效**：
;      · 【本场的开头任务】+ `###ATTITUDE###` 要求（态度生成不出来）⚠️
;      · `LLM_MEMO_OK`（记忆注入的冷却逻辑）
;    ⇒ 开场白这轮传 **1**，主循环那轮传 **0** ✓
; ★★ **开场白的断点标记**（2026-09-20 用户批准）——
;   ⚠️ 对话历史是**跨对话累积**的（`hist=30`）⇒ 上次内容一直留着 ⇒
;     她容易「顺着上次说」，而不是「看现在在哪、在做什么」⚠️
;   ⚠️ 但**不能清历史**（会丢连贯性；而且接口只能整段清）⇒
;   ⇒ 折中：在**每场对话的开场消息**里插一个**明确分隔 + 时间间隔** ✓
;     那条消息会进历史 ⇒ 每场之间都有断点 ⇒ 模型认得「这是新的一场」✓
;   依据：`LLM_GAP`（距上次见面的分钟数，`:214` 早已算好，跨天也对）✓
	LLM_OPEN_MSG = "（玩家走到你面前。）"
	IF LLM_GAP > 0
		; 换算成人话（分钟 → 小时/天），别把 4320 这种数字丢给她 ⚠️
		LLM_GAP_TXT = @"{LLM_GAP} 分钟前"
		SIF LLM_GAP >= 60
			LLM_GAP_TXT = @"{LLM_GAP / 60} 小时前"
		SIF LLM_GAP >= 1440
			LLM_GAP_TXT = @"{LLM_GAP / 1440} 天前"
		LLM_OPEN_MSG = @"（——新的一场对话—— 距上次交谈：%LLM_GAP_TXT%）"
	ENDIF
	SIF LLM_GAP <= 0
		LLM_OPEN_MSG = "（——新的一场对话—— 你们刚还在说话）"
; ★★ **开场前先拿「本次态度 + 上一场总结」**（2026-09-20 用户要求）——
;   ⚠️ 原来态度是**开场白这一轮自己产出**的 ⇒ 开场白**用不上**本次态度 ⚠️
;   ⇒ 这里先发一次独立请求把它们拿回来、存进变量，
;     再组装 prompt ⇒ 开场白就能同时用上「本次态度」和「上次总结」✓
;   ⚠️ 失败会静默跳过（`@LLM_PRESESSION` 内部处理）⇒ 不阻塞开场 ✓
CALL LLM_PRESESSION(TARGET)
CALL LLM_BUILD_SYSTEM_PROMPT(TARGET, LLM_SYS, LLM_TOGETHER, 1)
CALLSHARP LLM_CHAT_SEND(TARGET, LLM_SYS, LLM_OPEN_MSG, 1, LLM_TMP)
IF TOINT(LLM_TMP) > 0
	LLM_REQ = TOINT(LLM_TMP)
	; ★★ **20 秒超时 ⇒ 自动重试，最多 3 次**（显示「少女重连中（X/3）」）——
	;  ⚠️ 超时**也重试**：实测服务端卡住时"等"没有意义，隔一会儿重发基本都能成 ✓
	;  ⚠️ 重试前必须 `LLM_CHAT_CANCEL` 取消挂起的那次 ——
	;     否则它还在服务端跑，几次重试会**叠成一堆并发请求** ⚠️
	LLM_TRY = 0
	WHILE 1
		LLM_TRY ++
		IF LLM_TRY == 1
			PRINTFORML 　.....少女思考中……
		ELSE
			CLEARLINE 1
			PRINTFORML 　.....少女重连中（{LLM_TRY}/3）……
		ENDIF
		CALL LLM_POLL(LLM_REQ, LLM_STATE, LLM_OUT)
		SIF LLM_STATE == 1
			BREAK
		SIF LLM_TRY >= 3
			BREAK
		CALLSHARP LLM_CHAT_CANCEL(LLM_REQ, LLM_TMP)
		CALLSHARP LLM_CHAT_SEND(TARGET, LLM_SYS, LLM_OPEN_MSG, 1, LLM_TMP)
		LLM_REQ = TOINT(LLM_TMP)
		SIF LLM_REQ <= 0
			BREAK
	WEND
	IF LLM_STATE == 1
		; ⚠️ 顺序要紧：**先**解析结算块（此时换行还完好），**再**清洗台词。
		;    反过来做的话，SANITIZE 会把换行换成全角空格，数值段就拆不干净了。
		; ══ ★★ **标记行解析**（记忆 / 约定 / 脱衣部位）══
		;  ⚠️ 必须在 `SANITIZE_REPLY` **之前** —— 清洗会把换行换成全角空格，之后就拆不出行了 ✓
		CALL LLM_PARSE_MEMO(LLM_OUT, LLM_MEMO_NEW, LLM_MEMO_W_NEW)
		IF LLM_MEMO_NEW != ""
			; ★★ **只在「真的新存了一条 · 且是免骰类」时给玩家一行提示** ⚠️
			;  用户定：「就不能和其他的那些提示一样只输出一次文本吗，比如亲密接触那些」✓
			;  ⚠️ 两个条件缺一不可：
			;     ① `@LLM_MEMO_EXISTS` = 之前没有这条（否则每次对话都刷一遍）
			;     ② `@LLM_MEMO_GATE`   = 属于免骰类（身份 / 称呼）⇒ 一定存得下 ✓
			;        「共同经历」那种还要掷存储骰 ⇒ 保持静默（她可能真没记住）✓
			; ── 提示（只在真的新存 + 免骰类时）──
			CALL LLM_MEMO_EXISTS(TARGET, LLM_MEMO_NEW)
			IF RESULT == 0
				IF LLM_MEMO_GATE(LLM_MEMO_NEW)
					SETCOLOR C_AQUA
					PRINTFORML 　（她记住了你说的事。）
					RESETCOLOR
				ENDIF
			ENDIF
			CALL LLM_MEMO_ADD(TARGET, LLM_MEMO_NEW, LLM_MEMO_W_NEW)
		ENDIF
		; ⚠️⚠️ 上面这个 `IF` **必须在这里闭合** —— 原来写成 `SIF` 时它只绑紧随的一行，
		;    等于**根本没管住**，而且会一路吃到下面的 `###PROMISE###` / `###STRIP###` ⚠️
		; ⚠️ `###ADDR###` / `###CALL###` / `###CALLHER###` 的解析**已删除**
		;    （2026-09-16 方案 B）—— 那三种事统一写成 `###MEMO### [3]` ✓
		; ★★ **对玩家的态度**（只在**开场白**那一轮生成）——
;  ⚠️ 它综合了"数值 + 长期记忆 + 上一场缓存"，所以**每场开头重算一次** ✓
; ⚠️⚠️ **刻意"不清空"**（2026-09-16 改）——
;    原来这里先清空、再"只在模型写了才写回" ⇒
;    **模型漏写那一场，态度就变成空的** ⚠️
;    （用户实测：「偶尔会出现态度为空」；log 里能看到多数 reply 末尾有
;      `###ATTITUDE###`，少数只有 `###DELTA###` —— 那是**模型侧**的服从率问题）✓
;  ⇒ 改成 **"没写就沿用上一次的"**：
;     · 彻底消除"偶尔为空" ✓
;     · 而且符合"渐变"的设计（态度本来就该连续）✓
;     · 代价：很久没聊时也会沿用旧态度 —— 但那比"突然变空白"好得多 ✓
;  ⚠️ 那条"清空"是**为了排除早期脏数据**（`[6]` 里显示 `" "` 那次）——
;     现在脏数据已由 `@LLM_CLEAN_VALUE` + 长度阈值挡住，不需要再清空了 ✓
CALL LLM_PARSE_NOTE(LLM_OUT, "###ATTITUDE###", LLM_NOTE_NEW)
; ⚠️⚠️ **必须判"有没有实际内容"，不能只判"是不是空串"**（2026-09-16 用户实测）——
;    模型偶尔写 `###ATTITUDE###""`（空内容带引号）⇒ 返回的是 **`""`（2 字符）**，
;    `!= ""` **判不出来** ⇒ 把 `""` 写进槽 ⇒ `[6]` 里显示成 `" "` ⚠️
;  ⚠️ `STRLENS` 数的是**字节**（中文 1 字 = 2）⇒ **≥ 4 字节（2 个汉字）才算有效** ✓
IF STRLENS(LLM_NOTE_NEW) >= 4
	; ★ **自由互动不写持久数据**（2026-09-21 用户要求）✓
	SIF LLM_MODE == 0
	LLM_ATTITUDE:(TARGET):0 '= @"%LLM_NOTE_NEW%"
ENDIF
CALL LLM_PARSE_NOTE(LLM_OUT, "###PROMISE###", LLM_NOTE_NEW)
		IF LLM_NOTE_NEW != ""
			; ★ **自由互动不写持久数据**（2026-09-21 用户要求）✓
			SIF LLM_MODE == 0
			LLM_PROMISE:(TARGET):0 = %LLM_NOTE_NEW%
		ENDIF
		; ★ 脱衣部位（玩家说脱哪件，模型就报哪件）
		CALL LLM_PARSE_NOTE(LLM_OUT, "###STRIP###", LLM_NOTE_NEW)
		IF LLM_NOTE_NEW != ""
			LLM_STRIP_WANT = %LLM_NOTE_NEW%
		ENDIF
		; ⚠️⚠️ **`@LLM_PARSE_DELTA` 必须最后跑**（2026-09-16 修）——
		;    它会把 `LLM_OUT` 截成「`###DELTA###` 之前的那半」（那是它抠数值块的方式），
		;    所以**所有标记解析都得排在它前面**，否则 `###MEMO###` / `###PROMISE###` /
		;    `###STRIP###` 会被这一刀切掉 ⇒ **模型写了也存不下** ⚠️
				CALL LLM_PARSE_DELTA(LLM_OUT, LLM_D1, LLM_D2, LLM_D3, LLM_D4, LLM_D5, LLM_D6)
		LLM_GOT_DELTA = RESULT
		CALL LLM_SANITIZE_REPLY(LLM_OUT)
		; ⚠️ 必须 IF/ENDIF：`SIF` 只绑紧随的一行
		IF LLM_OUT != ""
			CALL LLM_SHOW_FIGURE(TARGET)
			CALL LLM_PRINT_REPLY(TARGET, LLM_OUT)
			; ★ 约会路上时，在台词之下补一行提示（2026-09-18 用户要求）✓
			CALL LLM_SHOW_DATEHINT
			; 记下调用前的模式值 —— 用来判断这一轮是不是**刚建立**陪伴模式
			LLM_TG_BEFORE = %LLM_TOGETHER%
			; 数值提示跟在台词之后打印（@LLM_APPLY_DELTA 内部打印）
			CALL LLM_APPLY_DELTA(TARGET, LLM_D1, LLM_D2, LLM_D3, LLM_D4, LLM_D5, LLM_D6, LLM_ACC_FAVOR, LLM_ACC_MOOD, LLM_GOT_DELTA, LLM_TOGETHER)
			TCVAR:(TARGET):336 = MAX(TCVAR:(TARGET):336 + LLM_D3, 0)

			; ★ 只在**刚建立**陪伴模式时追加一句（否则模式跨轮保持，会每轮都多发一次请求）
			SIF LLM_TOGETHER != "" && LLM_TG_BEFORE == ""
				CALL LLM_TOGETHER_TALK(TARGET, LLM_TOGETHER)
		ENDIF
	ELSEIF LLM_STATE == 0
		CALLSHARP LLM_CHAT_CANCEL(LLM_REQ, LLM_TMP)
		PRINTFORML 　[超时] 开场白没有回复（链路可能有问题，见下方提示）
		CALL LLM_SHOW_API_HINT
	ELSE
		PRINTFORML 　[开场失败] %LLM_OUT%
		CALL LLM_SHOW_API_HINT
	ENDIF
ELSE
	PRINTFORML 　[无法发起请求]
	CALL LLM_SHOW_API_HINT
ENDIF
PRINTL

WHILE 1
	SIF LLM_ROUND >= 20
		BREAK

	; ── 取玩家输入 ──
	CLEARTEXTBOX
	DRAWLINE
	PRINTFORML 【自由对话】与 %CALLNAME:TARGET% 交谈
	PRINTFORML 　接口：%LLM_APINAME%
	PRINTFORML 　persona：%LLM_PERSONA_SHOW%
	PRINTFORML 　直接输入要说的话后回车；输入空内容即结束
	DRAWLINE
	INPUTS
	LLM_INPUT = %RESULTS%
	; ⚠️⚠️ **这里原本有一个 `IF LLM_PENDING_EXIT / RETURN 1` 块，已删除**（2026-09-16）——
	;    它想实现"她道别后，玩家再按一次回车就退出"，但那**违反本项目的前提**：
	;    **整个插件会话都在一个回合里**，主循环的 `INPUTS` 只是回合内的模拟 ⇒
	;    留到"下一轮"处理，屏幕早就被重新打印的输入区覆盖了 ⇒
	;    实测症状：【对话结束】**出现在下一次自由对话的输入画面上** ⚠️
	;    ⇒ 现在改为在**设标记的同一轮**直接收尾退出（见上面 `@LLM_CHAT_LOOP` 开场段）✓
	;  ⚠️ `LLM_PENDING_EXIT` 变量本身保留（开场清零 + 语义说明），
	;     但**不再有"跨轮延迟退出"这条路径** —— 不要再把它加回来 ✓
	SIF LLM_INPUT == ""
		BREAK

	; ── 聊到一半被激怒了就不再继续 ──
	;  判定点是"玩家刚说完、还没发给模型"这一刻：上一轮的影响
	;  （模型给的愤怒增量、以及游戏自己触发的暴怒）都已经落到状态里了。
	;  命中就直接让她把话说完（拒绝台词会针对玩家刚说的内容），然后退出。
	;  （同样先清 RESULT，理由见进入时那段注释）
	RESULT = 0
	; ★ **自由互动时绕过这个中断**（2026-09-20 用户要求）——
	;   ⚠️ 睡姦/醉姦的前提就是她没意识 ⇒「睡着就拒绝」会让功能不可用 ✗
	;   ⚠️ 前面已清 `RESULT` ⇒ 不调用时 RESULT 保持 0 ⇒ 下游分支不命中 ✓
	SIF LLM_MODE == 0
		CALL LLM_REFUSE_REASON(TARGET, TCVAR:(TARGET):336, LLM_REASON)
	IF RESULT
		CALL LLM_REFUSE_TALK(TARGET, LLM_REASON, LLM_INPUT)
		; 返回 1 → 菜单直接退出，把她的台词留在画面上
		; ⚠️ 同样要先收尾（`RETURN 1` 会跳过函数末尾那段）✓
		CALL LLM_RESTORE_CLOTHES(TARGET)
		RETURN 1
	ENDIF

	; ★★ **玩家在道别吗？她接受还是挽留？** ——
	;  ⚠️⚠️ **这一句漏了整整两天**：`@LLM_BYE_CHECK` 一直**只有定义、没有任何调用点**
	;     （查过全部 24 个备份，`调用=0` 从截断事故延续至今）⇒
	;     `LLM_BYE_MODE` 恒为 0 ⇒ ①她从不挽留、②`LLM_PENDING_EXIT` 永远设不上、
	;     ③「玩家说再见 ⇒ 下一轮退出对话」**整块功能从来没生效过** ⚠️
	;     （2026-09-16 排查「说了再见还继续聊天」时发现）
	;  ⚠️⚠️ **必须放在 `@LLM_DECIDE_ACTION` 之前** ——
	;     链是：`BYE_CHECK` 定 `LLM_BYE_MODE` ⇒ `@LLM_DECIDE_ACTION` 读它决定
	;     `LLM_ACTION`（2 挽留 / 3 送别）⇒ `@LLM_ACTION_HINT` 拼进 prompt。
	;     `@LLM_DECIDE_ACTION` 是在 `@LLM_BUILD_SYSTEM_PROMPT` 里调的（下一句）✓
	;  ⚠️ 用**玩家输入**判关键词（`@LLM_IS_BYE`）：她的回复还没产生，
	;     而"接受还是挽留"必须在她开口**之前**定好 —— 这就是"先判、再让她说" ✓
	;  ⚠️⚠️ **先手动清 0** —— `LLM_BYE_MODE` 也是跨轮的文件级变量，
	;     而它只在 `@LLM_BYE_CHECK` **内部**被赋值 ⇒ 不清的话**会粘住上一轮的值**：
	;     挽留过一次（=2）之后，下一轮即使玩家没在道别，
	;     `@LLM_DECIDE_ACTION` 也会继续判成"挽留" ⇒ **她每轮都在挽留** ⚠️
	LLM_BYE_MODE = 0
	; ★ **自由互动时绕过这个中断**（2026-09-20 用户要求）——
	;   ⚠️ 睡姦/醉姦的前提就是她没意识 ⇒「睡着就拒绝」会让功能不可用 ✗
	;   ⚠️ 前面已清 `RESULT` ⇒ 不调用时 RESULT 保持 0 ⇒ 下游分支不命中 ✓
	; ⚠️ **必须先清 RESULT** —— `SIF` 不成立时 CALL 不执行，
	;   RESULT 会保留上一次的残留值 ⇒ `IF RESULT` 会误判 ⚠️
	RESULT = 0
	SIF LLM_MODE == 0
		CALL LLM_BYE_CHECK(TARGET, LLM_INPUT)

	; ══ ★★★★ **"他自报的身份" —— ERB 直接判定并写入**（2026-09-16 用户定）══
	;  用户的原话：「**为什么要通过 llm 记忆呢？不能直接判定然后写入，
	;                之后 llm 输出对应风味对话吗**」
	;  ⇒ 对。**身份这类事实根本不需要她判断**（他说了就是事实、与关系无关），
	;    却绕一圈让模型"决定要不要写 + 输出标记 + 我们解析" ——
	;    那是 **"她先说、系统后判"**，正是 §17/§18 花两轮修掉的病根 ⚠️
	;  ⇒ 改成 **"先判、再让她说"**：这里直接判定并写进记忆，
	;    她只负责**顺着这句话自然回应**（prompt 里已改成这么说）✓
	;  ⚠️ 顺带解决了老问题：模型不输出标记 ⇒ 永远记不住。
	;     现在**不依赖模型**，必定写入 ✓
	;
	;  ⚠️ 判据（刻意保守，宁可漏判也不要误判）：
	;     · 必须含「我是」
	;     · 「我是」后面 12 字以内**要命中一个身份词**（下面的词表）
	;       —— 光看「我是」会把「我是认真的」也当成身份 ⚠️
	;     · 含「叫我」⇒ **不在这里处理**（那是"称呼"，属另一类）✓
	;  ⚠️⚠️ **不能用"精确等于"来判**！第一版我写成
	;     `SUBSTRING(输入, 「我是」之后, 12)` 再 `== "佣人"` ——
	;     但「我是**红魔馆新来的**佣人」里身份词在 6 个字之后 ⇒ 永远不相等 ⚠️
	;     ⇒ 正确做法：**取「我是」之后的一段，然后在里面找身份词** ✓
	;  ⚠️ 词表**连写判定**（照 `@LLM_IS_BYE` 的写法）——
	;     不用数组：`#DIM CONST` 装不了字符串（会直接让游戏起不来）⚠️
; ── ⚠️⚠️ **直接在整句输入里找身份词**（2026-09-16 重写）─────────────────
;  背景（诊断实测）：玩家说「是的 我现在是红魔馆的佣人了」，而
;    `STRFIND(输入, "我是")` = **-1**  ⇒ 旧写法（先找「我是」再取后面）**永远走不到** ⚠️
;  ⚠️ 但**单字「我」= 5、「是」= 0 都能找到** —— 所以既不是编码问题、
;     也不是 STRFIND 不支持多字，而是**那个模式在口语里根本不出现**：
;     「现在是」「算是个」「我是个」… 谁也不会说「我是」两个字连在一起 ✓
;  ⇒ 正确做法：**不依赖任何句式，直接在整句里找身份词** ✓
;     好处：① 覆盖所有说法  ② 词表本身够窄 ⇒ 不会误判
;  ⚠️ 唯一要排掉的是「**叫我**」—— 那是**称呼**（归 `###MEMO###` 另一类），不是身份 ✓
;  ⚠️ 词表**刻意保守**（宁可漏判，不要误判）—— 误判会写进一条错的身份记忆 ✓
;  ⚠️ 连写判定（照 `@LLM_IS_BYE`）—— `#DIM CONST` **装不了字符串**（会让游戏起不来）⚠️
;  ⚠️⚠️ **每个词只写 `SIF` + 一行**（只设 `LLM_IDW`）——
;     写成 "`SIF` + 两行" 的话第二行会**无条件执行** ⇒ 每轮都误判成"识别出身份" ⚠️
;     （自查脚本抓到过；末尾再统一判一次 `LLM_IDW` 是不是空 ✓）
LLM_TMP = %LLM_INPUT%
LLM_IDW '= ""
; ⚠️ 有「叫我」⇒ 这一轮是**起称呼**，不是报身份 ⇒ 整块跳过 ✓
SIF STRFIND(LLM_TMP, "叫我") >= 0
	LLM_TMP = ""
SIF STRFIND(LLM_TMP, "佣人") >= 0
	LLM_IDW '= "佣人"
SIF STRFIND(LLM_TMP, "女仆") >= 0
	LLM_IDW '= "女仆"
SIF STRFIND(LLM_TMP, "仆人") >= 0
	LLM_IDW '= "仆人"
SIF STRFIND(LLM_TMP, "主人") >= 0
	LLM_IDW '= "主人"
SIF STRFIND(LLM_TMP, "客人") >= 0
	LLM_IDW '= "客人"
SIF STRFIND(LLM_TMP, "常客") >= 0
	LLM_IDW '= "常客"
SIF STRFIND(LLM_TMP, "朋友") >= 0
	LLM_IDW '= "朋友"
SIF STRFIND(LLM_TMP, "恋人") >= 0
	LLM_IDW '= "恋人"
SIF STRFIND(LLM_TMP, "弟子") >= 0
	LLM_IDW '= "弟子"
SIF STRFIND(LLM_TMP, "学生") >= 0
	LLM_IDW '= "学生"
SIF STRFIND(LLM_TMP, "助手") >= 0
	LLM_IDW '= "助手"
SIF STRFIND(LLM_TMP, "记者") >= 0
	LLM_IDW '= "记者"
SIF STRFIND(LLM_TMP, "商人") >= 0
	LLM_IDW '= "商人"
SIF STRFIND(LLM_TMP, "医生") >= 0
	LLM_IDW '= "医生"
SIF STRFIND(LLM_TMP, "巫女") >= 0
	LLM_IDW '= "巫女"
SIF STRFIND(LLM_TMP, "妖怪") >= 0
	LLM_IDW '= "妖怪"
SIF STRFIND(LLM_TMP, "人类") >= 0
	LLM_IDW '= "人类"
SIF STRFIND(LLM_TMP, "外来人") >= 0
	LLM_IDW '= "外来人"
SIF STRFIND(LLM_TMP, "旅行者") >= 0
	LLM_IDW '= "旅行者"
; ★ 统一判一次（`LLM_IDW` 非空 = 命中了某个词）✓
LLM_IDHIT = 0
SIF LLM_IDW != ""
	LLM_IDHIT = 1
IF LLM_IDHIT
	; ⚠️⚠️ **不在这里存**（2026-09-16 用户定案）——
