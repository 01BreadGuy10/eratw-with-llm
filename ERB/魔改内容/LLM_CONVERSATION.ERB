	; ── 发起请求（立即返回 id）──
	CALLSHARP LLM_CHAT_SEND(TARGET, LLM_SYS, LLM_INPUT, LLM_TMP)
	IF TOINT(LLM_TMP) <= 0
		PRINTFORML 　[发起失败]
		CALL LLM_SHOW_API_HINT
		BREAK
	ENDIF
	LLM_REQ = TOINT(LLM_TMP)

	; ── 非阻塞等待：AWAIT 让出，轮询结果 ──
	;  ★★ **20 秒超时 ⇒ 自动重试，最多 3 次**（同开场白那处）✓
	LLM_TRY = 0
	WHILE 1
		LLM_TRY ++
		IF LLM_TRY == 1
			PRINTFORML 　.....少女思考中……
		ELSE
			CLEARLINE 1
			PRINTFORML 　.....少女重连中（{LLM_TRY}/3）……
		ENDIF
		CALL LLM_POLL(LLM_REQ, LLM_STATE, LLM_OUT)
		SIF LLM_STATE == 1
			BREAK
		SIF LLM_TRY >= 3
			BREAK
		CALLSHARP LLM_CHAT_CANCEL(LLM_REQ, LLM_TMP)
		CALLSHARP LLM_CHAT_SEND(TARGET, LLM_SYS, LLM_INPUT, LLM_TMP)
		LLM_REQ = TOINT(LLM_TMP)
		SIF LLM_REQ <= 0
			BREAK
	WEND

	; 清掉"少女思考中"那行
	CLEARLINE 1

	IF LLM_STATE == 0
		; 超时：放弃跟踪，但不影响后续
		CALLSHARP LLM_CHAT_CANCEL(LLM_REQ, LLM_TMP)
		PRINTFORML 　[超时] 等太久没回复，已放弃这次请求
		CONTINUE
	ENDIF

	IF LLM_STATE != 1
		PRINTFORML 　[出错] %LLM_OUT%
		CALL LLM_SHOW_API_HINT
		BREAK
	ENDIF

	; ── 解析结算块 → 清洗 → 输出 → 应用数值 ──
	; ⚠️ 顺序要紧：**先**解析结算块（此时换行还完好），**再**清洗台词。
	;    反过来做的话，SANITIZE 会把换行换成全角空格，数值段就拆不干净了。
	; ══ ★★ **标记行解析**（记忆 / 身份 / 约定 / 两个方向的称呼 / 脱衣部位）══
