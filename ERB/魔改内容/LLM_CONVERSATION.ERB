	;   "你可以喜欢这个角色的屁股，所以一直对她用一些屁股相关的东西；
	;    也可以喜欢另一个角色的胸。**这并不是跨角色的东西**。"
	;  ⇒ 所以这是**按角色**累积的观察（`LLM_PREF`，`CHARADATA`）✓
	;  ⚠️ 措辞是"**他好像特别中意**"—— 她是从经验里**察觉**的，不是被告知的 ✓
	LLM_PMAX = 0
	LLM_PTOP = 0
	FOR LOCAL, 1, 8
		SIF LLM_PREF:(LLM_CID):LOCAL <= LLM_PMAX
			CONTINUE
		LLM_PMAX = LLM_PREF:(LLM_CID):LOCAL
		LLM_PTOP = LOCAL
	NEXT
	; ⚠️ **至少 3 次**才算"偏好"（一两次说明不了什么）✓
	IF LLM_PMAX >= 3 && LLM_PTOP >= 1
		CALL LLM_AGREE_NAME(LLM_PTOP, LLM_NOTE_TXT)
		IF LLM_NOTE_TXT != ""
			REF_PROMPT += @"\n【他好像特别中意】%LLM_NOTE_TXT%"
			REF_PROMPT += @"\n（⚠️ 这是你**从相处里察觉**的 —— 他每次都往那儿去。"
			REF_PROMPT += @"\n  知道归知道，但**别点破**，也别一副看穿了他的样子。）"
		ENDIF
	ENDIF
	; ★★ 「最爱的行为」（**本存档专属**，每个档不同）——
	;  ⚠️ 明确标注"这是这个存档里的偏好"，免得模型当成角色设定 ✓
	IF LLM_FAV:(LLM_CID):0 >= 1 && LLM_FAV:(LLM_CID):0 <= 7
		CALL LLM_AGREE_NAME(LLM_FAV:(LLM_CID):0, LLM_NOTE_TXT)
		REF_PROMPT += @"\n【你特别吃这一套】%LLM_NOTE_TXT%"
		REF_PROMPT += @"\n（⚠️ 被这么对待的时候，你**比别的都更有感觉** ——"
		REF_PROMPT += @"\n  但**别直接说破**，用你平时的反应方式自然流露就好。"
		REF_PROMPT += @"\n  这是**你自己也说不清为什么**的偏好，不是设定。）"
	ENDIF
	; ★★ **按行为细化记的"合意"**（用户要求："这些合意可以偶尔被 llm 提起"）
	CALL LLM_AGREE_SHOW(LLM_CID, LLM_AGREE_TXT)
	IF LLM_AGREE_TXT != ""
	REF_PROMPT += @"\n【你们之间的**亲密关系**】%LLM_AGREE_TXT%"
	REF_PROMPT += @"\n（⚠️⚠️ 这些是**已经发生过**的亲密行为 —— **不是「试过」、是事实** ✓"
	REF_PROMPT += @"\n   · 有过这些，你们就**不是「刚认识」或「点头之交」**了 ——"
	REF_PROMPT += @"\n     你的态度、距离感、说话方式都该体现出这层关系 ✓"
	REF_PROMPT += @"\n   · 但**绝大多数轮次不用提**；聊到相关话题时才顺带一句，别罗列。）"
		ENDIF

	; ══ ★★ **欲求不满高时，她会主动开口请求**（用户要求）════════════════════
	;  用户："如果其欲求不满度较高甚至会主动请求玩家做某事。"
	;  ⚠️ 触发条件**两个都要**：
	;     ① 欲求不满 >= 500（官方 `PRINT_STATE.ERB:61-82` 的「欲求不满❤」档）
	;     ② 她**确实接受过**某个行为（`LLM_AGREE_TXT` 非空）——
	;        没试过的事她不会主动要（那是"推倒"，走 `@LLM_TRY_PUSH`）
	;  ⚠️ 分两层，别和逆推撞车：
	;     · **500~799**：**开口请求**（"……今天、可以吗"）—— 台词层，不动作
	;     · **>= 800**：`@LLM_TRY_PUSH` 直接**动手**（她主动推倒你）✓
	IF CFLAG:(LLM_CID):积攒度 >= 500 && LLM_AGREE_TXT != "" && CFLAG:(LLM_CID):积攒度 < 800
		REF_PROMPT += @"\n【你现在有点忍不住了】"
		REF_PROMPT += @"\n（身体里那股劲儿一直没散去。你们之间**试过**的是：%LLM_AGREE_TXT% ——"
		REF_PROMPT += @"\n  ⚠️⚠️ 你可以**主动提出来**，而且**要具体到「做什么」**，两个方向都行："
		REF_PROMPT += @"\n     · **邀请他**：「……可以摸一下吗」「抱抱我」「想让你亲我」"
		REF_PROMPT += @"\n     · **你想做**：「我想摸摸你」「让我亲一下好不好」"
		REF_PROMPT += @"\n  ⚠️ **就在上面「你们试过」的那几项里挑** ——"
		REF_PROMPT += @"\n     没试过的**别提**（那是要跨出一步，得等他先开口）。"
		REF_PROMPT += @"\n  ⚠️ **要按你的性格说**："
		SELECTCASE CFLAG:(LLM_CID):性格傾向
			CASE 1
				REF_PROMPT += @"\n     · 弱势系：小声、绕圈子、说一半就脸红（「那个……如果可以的话……」）"
			CASE 2
				REF_PROMPT += @"\n     · 强势系：直说，甚至带点命令口气（「过来，让我摸摸」）—— 但心里是想要的"
			CASE 4
				REF_PROMPT += @"\n     · 认真系：先找理由（「……偶尔一次也没什么吧」「书上说这样有益健康」）"
			CASEELSE
				REF_PROMPT += @"\n     · 坦率系：直接说出来，不绕弯（「我想摸你」）"
		ENDSELECT
		REF_PROMPT += @"\n  ⚠️ **这是「提议」，不是「动手」** —— 说出口就够，"
		REF_PROMPT += @"\n     他答不答应由他决定；被拒绝会失望，但**不要硬来**。"
		REF_PROMPT += @"\n  ⚠️ 也别每轮都提 —— 提一次，他没接就算了。）"
	ENDIF
	REF_PROMPT += @"\n（⚠️ 这些是**已经发生的事实**，不是猜测 —— 你可以自然地提起、"
	REF_PROMPT += @"\n  当作你俩之间的默契；但**别刻意炫耀、也别每轮都提**。）"
; ── ★ 她想，但地方不对（"憋着"）──
;  标记由 `@LLM_TRY_PUSH` 设置（`TCVAR:角色:338`）。
;  ⚠️ 这一段是**行为指导**，不是让她把欲望说出来 ——
;     分寸感全靠这里：**要给暗示，但要矜持**。写露骨了就毁了。
;  ⚠️ 多行必须用 `IF … ENDIF`（`SIF` 只绑紧随的一行）
	; （这一档的行动指令已合并到下面的【这一轮你打算怎么做】—— ACTION==6）
; ── ★★ 欲求不满度 —— 结合关系决定她怎么表现（用户要求）──
;  ⚠️ 只在**没有"憋着"**时注入：`TCVAR:338`（见上面的 `LLM_LUST`）说的是
;    "想要但**地方不对**"，已经是很强的表达；两条同时出现会说两遍"你很想要"。
; ── ★★ 欲求不满度：**拆成事实层 + 行动层**（本次设计的范例）──
;  事实层（下面）：**无论她这轮打算做什么**，她都该知道自己什么状态 —— 但只给数字，
;                  **不带任何行动指令**，所以不会和别的模块抢戏。
;  行动层（ACTION == 7）：只有"想撩"是本轮主基调时，才告诉她怎么表现。
SIF CFLAG:(LLM_CID):积攒度 >= 200
	REF_PROMPT += @"\n【你现在的身体状态】欲求 {CFLAG:(LLM_CID):积攒度 / 10}％。"
	; （这一档的行动指令已合并到下面的【这一轮你打算怎么做】—— ACTION==7）
; 该角色的爱好 —— 只在有内容时注入；并说明它会带来额外的好感度
IF LLM_LIKES != ""
	REF_PROMPT += @"\n【这个角色喜欢的东西】%LLM_LIKES%"
	REF_PROMPT += @"\n（⚠️ 你可以**自然地**聊到这些（她也会主动提），"
	REF_PROMPT += @"\n  **但别硬塞、也别一次全抖出来** —— 隔几轮偶尔带到一次就好。）"
ENDIF
; ── 持久记忆：她**真的记得**的事（跨对话保留）──
;
;  ⚠️⚠️ **注入频率被刻意压低了**（用户反馈："一直重复提着这种死板的记忆，
;     有些没有活人感"）。两道措施：
;    ① **措辞**上明确"这是背景不是话题""一整场不提才是常态"，
;       并**点名禁止用「上次你……」开头** —— 那是把回忆当谈资，
;       模型一被提示"你记得这件事"，就会拿它当话头，听起来很刻意。
;    ② **机制**上加冷却：不是每轮都摊在她面前，隔一段时间才想起来一次。
;       曝光少了，她自然就不会每轮都提。
;
;  ⚠️ 冷却记在 `TCVAR:角色:340`（**确认过是空号**，见 `LLM_KOJO.ERH` 的编号表）。
;  ⚠️ **开场白那一轮无视冷却** —— 新一场对话开口时提起旧事最自然，
;     而且玩家刚进来就问"你还记得吗"却被冷却挡住会很怪。

; ★★ **对玩家的态度**（2026-09-16 新增）—— 让整场对话的**基调一致** ✓
;  ⚠️ 它是**上一轮开场白时她自己写的**（综合了数值 / 记忆 / 上一场缓存）✓
;  ⚠️ 提示她"这是你自己定的调子，别自相矛盾" ✓
; ⚠️ 同样判"有没有实际内容"（≥4 字节），把 `""` 那种垃圾挡在注入之外 ✓
IF STRLENS(LLM_ATTITUDE:(LLM_CID):0) >= 4
	REF_PROMPT += @"\n【你对他的态度】%LLM_ATTITUDE:(LLM_CID):0%"
	REF_PROMPT += @"\n（⚠️ 这是**你自己**给这段关系定的调子 —— 整场都照这个来，"
	REF_PROMPT += @"\n  别一会儿亲热一会儿冷淡。除非**发生了什么事**改变你的看法，"
	REF_PROMPT += @"\n  否则没必要临时改口 ✓）"
ENDIF
; ⚠️⚠️ **【他告诉过你他的身份】这块已删除**（2026-09-16 方案 B）——
;    它读的是 `LLM_ADDRESS` 槽，而那个槽**已经不再被写入** ⇒ 永远为空 ⇒ 死块 ⚠️
;    现在"他自报的身份"是一条 `###MEMO### [3]` 记忆，
;    由上面【你还记得关于他的事】那段统一注入 ✓
;
;  ⚠️ **这段里有一条必须保留下来的要点**（原来写在注入的括号里）：
;     **身份只是"别前后矛盾"用的，不是"你该怎么称呼他"的规则** ——
;     用户明确要求过：关系深了以后她**照样可以叫名字、叫朋友、用自己习惯的叫法**，
;     否则恋人档会一直"佣人先生"，非常怪 ⚠️
;  ⇒ 这条已经写进 `###MEMO###` 段的示例措辞里（搜「他自报身份」）✓
; ── 上一轮"帮忙干活"的成败（供她演出不同反应）──
;  ⚠️ 这是**上一轮**的结果（存 LLM_LAST_RESULT），不是这一轮 ——
;     因为 prompt 是在行动结算**之前**组装好的。
;  ⚠️⚠️ `LLM_LAST_RESULT` 的**哨兵值 9 = "这场对话里还没帮过活"**，
;     在 `@LLM_CHAT_LOOP` 开场白时初始化。
;     不加哨兵的话，默认 0 会和"成功"撞车 —— 她会在**你还没帮任何忙**的时候
;     就说「刚才那活干得挺顺」。
IF LLM_LAST_RESULT == 1
	REF_PROMPT += @"\n【你刚帮他干的活】做得**非常漂亮** —— 连你自己都有点得意。"
	REF_PROMPT += @"\n（可以自然地表露出来：得意、邀功、或者嘴硬地说「这不算什么」。不要生硬地报「大成功」。）"
ELSEIF LLM_LAST_RESULT == -1
	REF_PROMPT += @"\n【你刚帮他干的活】**搞砸了** —— 手忙脚乱，还给他添了麻烦。"
	REF_PROMPT += @"\n（可以自然地表露出来：懊恼、找借口、嘴硬、或者不好意思。不要生硬地报「失败」。）"
ELSEIF LLM_LAST_RESULT == 0
	REF_PROMPT += @"\n【你刚帮他干的活】顺顺利利地做完了。"
	REF_PROMPT += @"\n（不用特意提，正常聊就行。）"
ENDIF
REF_PROMPT += @"\n【现在所在的地方】%LLM_PLACE%"
REF_PROMPT += @"\n【现在几点】%LLM_NOW%"
REF_PROMPT += @"\n（⚠️ 这是**确切时间**，你对时间的一切说法都必须和它一致 —— "
	REF_PROMPT += @"\n  说不准就干脆别提时间 —— 别硬凑一句氛围。"
	REF_PROMPT += @"\n  日期同理 —— 那行开头就是**年月日**，别把季节/月份说错。"
REF_PROMPT += @"\n  如果不确定，就干脆别提时间。）"
REF_PROMPT += @"\n【外面的天气】%LLM_WEATHER%"
REF_PROMPT += @"\n（⚠️ 这是**当前真实天气**，你对天气的一切说法都必须和它一致 ——"
	REF_PROMPT += @"\n  说出来的话要和它**一致**，别硬凑一句氛围。"
	REF_PROMPT += @"\n  天气是室外的信息：你在屋里时，只能说**推测**（听声、看外面），"
REF_PROMPT += @"\n  但别说得像亲眼看着一样。不确定就干脆别提。）"
; 同房间还有谁 —— 只在真的有人时才注入这一行
SIF LLM_OTHERS != ""
	REF_PROMPT += @"\n【同一个房间里还有】%LLM_OTHERS%"
; ★★ 约会路上 —— 和工作进度（`LLM_ACT` 的「还剩 X％」）同类信息（2026-09-18 用户要求）
;  ⚠️ 展开成独立函数 ⇒ 这里只有一行，**不破坏上面的 `SIF` 结构** ✓
; ★★★ **【你现在正在做的事】的注入**（2026-09-19 恢复）——
;   ⚠️⚠️ 这两行**曾被「约会提示」的插入覆盖掉**（备份比对确认）⇒
;      从那天起 `LLM_ACT` **从未进过 prompt** ⇒
;      她看不到「在做什么」和**工作量百分比** ⇒ 问进度只能拿排班表回答
;      （实测症状：「还剩三个多钟头」而不是「还剩一半多」）⚠️
;    ⇒ 恢复它，并**放在约会提示之前**（顺序无关，但别再来一次）✓
; 她手头正在做的事 —— 只在有内容时注入（空闲时不加这一行）
SIF LLM_ACT != ""
	REF_PROMPT += @"\n【你现在正在做的事】%LLM_ACT%"
CALL LLM_DATE_INTO(REF_PROMPT)
; 日程感 —— 只在"快没时间了"时注入
SIF LLM_SCHED != ""
	REF_PROMPT += @"\n【时间上的事】%LLM_SCHED%"
; ★★ 这一轮她**打算收尾去睡** —— 让她把道别说出口（系统会在结算后结束对话）
;  ⚠️ 判定是**组装 prompt 之前**做的（`@LLM_SLEEP_CHECK`），
;     结算时复用同一个值 ⇒ 她说的话和系统的动作必然一致（§18 的"先判、再让她说"）。
	; （这一档的行动指令已合并到下面的【这一轮你打算怎么做】—— ACTION==5）

; ── ★★ 玩家在道别 —— 她**送别**还是**挽留** ──
;  ⚠️ 判定是组装 prompt **之前**做的（`@LLM_BYE_CHECK`，用玩家输入的关键词），
;     结算时复用同一个值 ⇒ 她的话和系统的收尾动作必然一致。
;  ⚠️ 三个变量都是那一刻定好的：`LLM_BYE_MODE`（接受/挽留）、`LLM_NEXT_TXT`（她接下来要做什么）。
	; ★★★★ **行动提示（合成一句）** —— 全项目**唯一**的行动指令
	;  ⚠️ 判定已经在 `@LLM_DECIDE_ACTION` 做完，这里只把**结论 + 相关数值**
	;    拼成一句话（用户的设计：判定归判定、对话归组合）。
	CALL LLM_ACTION_HINT(LLM_CID, LLM_ACT_TXT)
	SIF LLM_ACT_TXT != ""
		REF_PROMPT += @"\n【这一轮你打算怎么做】%LLM_ACT_TXT%"

; ★★ **上一轮的身体接触没被受理** —— 让她对此有反应（用户要求）
;  ⚠️ 只给"**事实原因**"，**怎么说交给人设和关系** —— 这是用户明确的要求
;     （"这个肯定是要跟人设来的"）。
;  ⚠️ 时序：结算是她**说完之后**才跑的，所以这条只在**下一轮**才生效
;     （和 `LLM_JUST_ENDED` 同一套做法：记一轮、下一轮消费）。
;  ⚠️ 用完就清 —— 否则她会一直念叨这件事。
; ★★ **上一轮的"实际收益"偏高/偏低 → 微调这一轮的语气** ──
;  用户要求："可以根据浮动微调一下角色的 LLM 回复" ✓
;  ⚠️ 时序：浮动在她说完**之后**才算出来 ⇒ 这里消费的是**上一轮**的结果 ✓
;     （和 `LLM_TOUCH_NOTE` 同一套：记一轮、下一轮用）
;  ⚠️ 措辞要**含糊** —— 不要让她报数字，只说"感觉" ✓
IF LLM_FEEL != 0
	IF LLM_FEEL >= 2
		; ★★ **这是"最爱"级别**（用户要求："llm 会根据这段文本生成符合「最爱」的对应文本"）
		;  ⚠️ 她**自己也不知道为什么** —— 所以表现成"身体比脑子先反应"，
		;     而不是"我知道我喜欢这个" ✓
		REF_PROMPT += @"\n【你刚才被碰到的地方】是**你特别吃的那一处** ——"
		REF_PROMPT += @"\n  ⚠️ 反应比平时明显得多：声音会漏出来 / 身体先软一下 /"
		REF_PROMPT += @"\n     话说到一半断掉 —— 但**用你自己的方式表现**（性格照旧）。"
		REF_PROMPT += @"\n  ⚠️⚠️ **别解释、别说破、别承认** —— 你自己也说不清为什么。"
		REF_PROMPT += @"\n     最多是嘴上硬撑着、身体已经出卖了你。"
	ELSEIF LLM_FEEL > 0
		REF_PROMPT += @"\n【你刚才那一下的感觉】比你以为的还要受用 ——"
		REF_PROMPT += @"\n  心里那点涟漪比预想的大。这一轮可以**自然地带一点出来**"
		REF_PROMPT += @"\n  （语气软一点、或者主动多亲近半分），但**别说破**。"
	ELSE
		REF_PROMPT += @"\n【你刚才那一下的感觉】没什么特别的感觉 ——"
		REF_PROMPT += @"\n  甚至有点心不在焉。这一轮可以**稍微淡一点**"
		REF_PROMPT += @"\n  （敷衍半分、或者把话题带开），但**别冷场、别提原因**。"
	ENDIF
	; ⚠️ 用完就清 —— 否则这份"感觉"会一直挂在她身上 ✓
	LLM_FEEL = 0
ENDIF
IF LLM_TOUCH_NOTE != 0
	REF_PROMPT += @"\n【刚刚发生的事】他刚才碰到了你，但"
	SELECTCASE LLM_TOUCH_NOTE
		CASE 1
			REF_PROMPT += @"距离上一次还**不到一小时**。"
