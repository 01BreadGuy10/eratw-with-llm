SIF !EXISTFUNCTION(@"ADD_CHECK_CLOTHES")
	RETURN
LLM_CW = %ADD_CHECK_CLOTHES(LLM_CID, "TOP")%
SIF LLM_CW != ""
	REF_OUT = @"上身：%LLM_CW%"
LLM_CW = %ADD_CHECK_CLOTHES(LLM_CID, "BOTTOM")%
IF LLM_CW != ""
	SIF REF_OUT != ""
		REF_OUT += "　"
	REF_OUT += @"下身：%LLM_CW%"
ENDIF
LLM_CW = %ADD_CHECK_CLOTHES(LLM_CID, "BRA")%
