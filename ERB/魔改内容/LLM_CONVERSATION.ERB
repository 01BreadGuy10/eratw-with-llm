; ────────────────────────────────────────────────────────────────────────────
;  组装 system prompt
; ────────────────────────────────────────────────────────────────────────────
;  刻意**不喂数值**，只喂"关系状态 / 态度 / 情绪"这类语义化结果 ——
;  数值对模型无意义，且容易被角色"报出来"。详见设计文档第 4 章。
; ────────────────────────────────────────────────────────────────────────────
@LLM_BUILD_SYSTEM_PROMPT(LLM_CID, REF_PROMPT, LLM_TG, LLM_OPENING)
#DIM  LLM_CID
#DIMS LLM_TG         ; **陪伴模式**：空 = 没在陪；非空 = 正陪她做的这件事
#DIM  LLM_OPENING    ; 1 = 这一轮是**开场白**（见末尾的"第一句话"要求）
#DIM  LLM_SILENT     ; 她是不是"话很少"（无口）型 —— 决定要不要允许动作/环境描写
#DIM  LLM_TOGP       ; 工作进度百分比（只在报"正在干活"时用）
#DIM  LLM_ALEFT      ; 她手头那件事"实际"还剩几分钟（= `@LLM_ACT_REMAIN` 的返回值）
#DIM  LLM_AEND       ; 上面那件事的大致结束时刻（当天分钟数 0~1439）
#DIM  LLM_MEMO_OK    ; 本轮允不允许注入"持久记忆"（冷却未到就不注入，见那一段）
; ⚠️ `REF_PROMPT` 这个**名字**没有任何魔力：必须写 `#DIMS REF REF_PROMPT`
;    才是引用传递。之前漏了 REF，函数里拼好的 prompt 传不回调用方
;    → 日志里 sysLen=0，persona 从未送给模型。
#DIMS REF REF_PROMPT
; ⚠️ `LLM_GAP` 的声明在 `LLM_KOJO.ERH`（全局）—— 这里**不能再声明**，
;    否则报 Lv2「变量名 LLM_GAP 为用户已定义的全局变量名」⚠️
#DIM  LLM_PMAX       ; ★ 玩家偏好：最高次数
#DIM  LLM_PTOP       ; ★ 玩家偏好：对应的行为代码
; 数值局部：LLM_SILENT（外加 LLM_CID 参数）—— 提到 8 留余量，
; 这个函数里 4 已经卡满过一次。
#LOCALSIZE 8
; 字符串局部：OTHERS / REL / ATT / MOOD / CHAR_NAME / MAPNAME / PLACENAME /
;             PLACE / ACT / TONE / SCHED / CANJOIN / NOW / WEATHER / ROUTINE /
;             TRAIT / FEAT / LIKES / MEMO_TXT / CONSENT 共 **20** 个
;             （外加 TG 参数）—— 提到 28 留足余量，
;             这个值已经写满过两次，溢出会直接报 Lv2 并让局部变量错乱。
#LOCALSSIZE 28
#DIM  LLM_MP        ; 当前所在地图编号（GET_MAPID 的结果）
#DIM  LLM_OCNT      ; 同房间的其他角色人数（循环计数用)
#DIM  LLM_DLEFT      ; ★ 约会路上剩余分钟（2026-09-18）
#DIMS LLM_OTHERS    ; 同房间其他角色的名字串（如「灵梦、魔理沙」）
#DIMS LLM_REL      ; 关系（字符串，必须 #DIMS + 引号）
#DIMS LLM_ATT      ; 态度
#DIMS LLM_MOOD     ; 情绪 / 身体状态
#DIMS LLM_BODYTXT  ; ★ 身体与特质（`@LLM_CHARA_BODY` 的输出，2026-09-18）
#DIMS LLM_EXPTXT   ; ★ 身体经验（`@LLM_CHARA_EXP` 的输出）
#DIMS LLM_BODYST   ; ★ 身体状态（发情/媚药/催情药/妊娠/生理）—— **可叠加**，不覆盖情绪
#DIMS LLM_SCENE    ; ★ 场合（约会中）—— 独立一层，不和主状态抢
#DIMS LLM_BANQ        ; ★ 宴会状态（職種 48/49/50/51 + 酒气）—— 2026-09-20
#DIMS LLM_KOI         ; ★ 趁她没意识时的性行为标记（睡姦 / 烂醉姦 / 时姦刻印）
#DIM  LLM_DRUNK       ; ★ 酒气档位（0~10）
#DIMS LLM_CHAR_NAME ; 角色名（先接住再插值：CALLNAME:xxx 不能直接进 %...%）
#DIMS LLM_MAPNAME  ; 大地图名（如「博麗神社」）
#DIMS LLM_PLACENAME; 房间 / 地点名（如「神社境内」）
#DIMS LLM_PLACE    ; 组合后的位置描述，喂给模型用
#DIMS LLM_ACT      ; 她正在做的事（如「正在读书学习」），喂给模型用
#DIMS LLM_TONE     ; **说话方式**（口調 + 性格傾向 → 语义描述），喂给模型用
#DIMS LLM_SCHED    ; **日程感**（快到上班/就寝时间了？），喂给模型用
#DIMS LLM_CANJOIN   ; **玩家能不能真的参与**（没钓竿/没乐器时只能旁观）
; ⚠️ 局部变量**不跨函数**：`LLM_NOW` 只在 `@LLM_BUILD_SYSTEM_PROMPT` 里用，
;    就必须声明在**这个函数**的声明段 —— 写到 `@LLM_APPLY_DELTA` 那段
;    会报「变量未在此函数中定义」（实测就报了一串 Lv2）。
#DIMS LLM_NOW       ; 当前时刻（如「15时20分」），喂给模型用
#DIMS LLM_WEATHER   ; 当前天气（如「晴天」「大雨」），喂给模型用
#DIMS LLM_ROUTINE   ; 今日作息（上班时段 / 起床就寝），喂给模型用
#DIMS LLM_WJOB     ; ★ 工作名暂存（决定用「你的工作是…」还是过去式）
#DIMS LLM_TRAIT     ; 该角色的**对话风格摘要**（按编号匹配，可能为空）
#DIMS LLM_FEAT      ; 该角色的**特性/能力**（只收影响日常对话的那部分）
#DIMS LLM_LIKES     ; 该角色的**爱好/喜欢的东西**（手写表，可能为空）
#DIMS LLM_MEMO_TXT  ; 该角色的**持久记忆**（跨对话保留，拼成一段文字）
#DIMS LLM_DATE_TXT  ; ★ 约会日志的注入串（2026-09-19）
#DIMS LLM_INT_HF_TXT   ; 半醒层的文本（由 LLM_INTIMATE.ERB 生成，2026-09-20）
; ⚠️ `LLM_ADDR_TXT` 已删除（2026-09-16 方案 B）—— 身份并入 `LLM_MEMO_TXT` ✓
#DIMS LLM_PREV_TXT  ; 上一场对话的文本（以开场白为分界线；优先级低）
#DIMS LLM_CONSENT   ; 你们之间**已经发生过的事**（读「合意」位标志）
; ★ 官方数据源（§35）—— 和上面的手写表**并存**，不是替代
#DIMS LLM_INTRO     ; 角色介绍文（`CSTR:角色:10~18`，官方设定）
#DIMS LLM_PERS      ; 性格类型（`@PERSONALITY_TYPE`）
#DIMS LLM_RELATION  ; 人际关系（`RELATION`，只取最好/最差各 3 个）
#DIMS LLM_SKILLS    ; ★ 她擅长的 / 不擅长的技能（`@LLM_CHARA_SKILL`）
#DIMS LLM_SELF      ; ★ 她**对自己水平**的看法（可能和 LLM_SKILLS 不一致）
#DIMS LLM_AGREE_TXT ; ★ 你们试过的亲密行为（按行为记的合意，见 LLM_AGREE）
#DIMS LLM_NOTE_TXT  ; ★ 强制槽取用（身份 / 称呼 / 约定）
#DIMS LLM_PRIDE     ; ★ 她的**专长**（引以为傲的那一项，手写表）
#DIMS LLM_HORNY     ; 欲求不满档位 + 按关系的表现方式（可能为空）
#DIMS LLM_ACT_TXT   ; ★ 行动提示（结论 + 相关数值**合成的一句**，`@LLM_ACTION_HINT`）
#DIM  LLM_PTIRED    ; 玩家是否"快撑不住了"（体力/气力 <= 阈值）
#DIM  LLM_PTIRED_TH ; 上面那个阈值（与 @LLM_APPLY_DELTA 里的判据同源）

; ⚠️ 每次请求前都**重新取一次快照**，绝不依赖"进对话时取过一次"。
;    原因：LLM_PERSONA* 是**文件级变量**，如果只在进入对话时取一次，
;    那么和多个角色对话后这些变量会残留上一个角色的内容，
;    导致后来的角色"以为自己是上一个角色"（实测：和灵梦聊完再找别人，
;    别人也自称灵梦）。每次组装 prompt 前重取，才能保证 persona 与
;    当前 LLM_CID 严格对应。
CALL LLM_PERSONA_SNAPSHOT(LLM_CID)

; 角色名先落到字符串变量里，供下面插值
LLM_CHAR_NAME = %CALLNAME:(LLM_CID)%

; ── 关系状态：读 TALENT 布尔量（与口上剧本同源）──
;  数组下标写成 (LLM_CID)：下标用变量时必须加括号（本作既有写法，
;  见 COMMON_KOJO.ERB:10 的 CFLAG:(ARG:1):現在位置）。
; ★ **改成走统一的关系档位模块**（§41）——
;  ⚠️ 原来这里是**手写的一串 `SIF` 级联**，和 `LLM_REL_TIRED`、收尾概率、
;     挽留概率、记忆概率各自写了一份 ⇒ 一共散在 5 处。
;     现在只剩 `@LLM_REL_LEVEL` / `@LLM_REL_DESC` 一个来源。
CALL LLM_REL_DESC(LLM_REL_LEVEL(LLM_CID), LLM_REL)
; ★★ **档位 → 说话分寸**（2026-09-19 用户要求：「让不太熟时没那么亲昵」）——
;   ⚠️ 光给档位名（「不太熟」）模型不一定能推出「该多客气」；
;     所以这里明说一句，档位越低越有距离感 ✓
;   ⚠️ 分档和概率表同源（都用 LLM_REL_LEVEL）⇒ 两处不会打架 ✓
IF LLM_REL_LEVEL(LLM_CID) <= 1 || LLM_REL_LEVEL(LLM_CID) == 8
	REF_PROMPT += @"\n（⚠️ 你们还不是能随便开玩笑的关系 ——"
	REF_PROMPT += @"\n  说话客气一点、保持点距离感；别自来熟、别用亲昵的称呼，"
	REF_PROMPT += @"\n  也别主动打探他的私事。熟络要一点一点来 ✓）"
ENDIF

; ── 亲密方面的合意程度（CFLAG:態度 = 6）──
;  ⚠️⚠️ 这个字段**不是"她对你这个人的态度"**，而是**性方面的合意判定**！
;     它的来源是 `ATTITUDE.ERB:85-94`：
;         合意判定 >= 500 → 3    >= 300 → 2    >= 150 → 1    否则 → 0
;     而 `合意判定` 是用于**性行为指令成否**的累积值（`CFLAG:合意判定`）。
;
;     我原来把它写成「冷淡 / 勉强接受 / 愿意配合 / 主动迎合」——
;     0 档叫"冷淡"是**语义错误**：模型会理解成"她对这个玩家很冷淡"，
;     于是句句端着、没精打采（这是"角色没精神"的第二个来源）。
;     实际上 0 档只表示"还没到愿意做那种事的程度"，跟日常聊天毫无关系。
;
;     ⇒ 现在改成准确的措辞，并在 prompt 里说明它只管**亲密**那一块。
LLM_ATT = "对你还没有那方面的意思"
SIF CFLAG:(LLM_CID):6 == 1
	LLM_ATT = "对亲密举动勉强接受"
SIF CFLAG:(LLM_CID):6 == 2
	LLM_ATT = "对亲密举动愿意配合"
SIF CFLAG:(LLM_CID):6 == 3
	LLM_ATT = "对亲密举动会主动迎合"

; ── 当前所在位置（大地图 + 房间）──
;  用游戏自己的接口，不要自己拼位置编号：
;    GET_MAPID(位置)      = 位置 / 100            （#FUNCTION，数值）
;    GET_MAPNAME(地图ID)  → "博麗神社" / "人間之里" …（#FUNCTIONS，字符串）
;    GET_PLACENAME(位置,0)→ 房间/地点名            （#FUNCTIONS，字符串）
;  GET_PLACENAME 内部已经处理了隙间空间、据点、其它地图等情况，直接信它。
LLM_MP = GET_MAPID(CFLAG:(LLM_CID):現在位置)
LLM_MAPNAME = %GET_MAPNAME(LLM_MP)%
LLM_PLACENAME = %GET_PLACENAME(CFLAG:(LLM_CID):現在位置, 0)%
LLM_PLACE = %LLM_PLACENAME%
; ★★★ **地点名优先 + 过滤无信息量的地图名**（2026-09-19 修）——
;   ⚠️ 原来以**地图名**为主，而 `@GET_MAPNAME` **只认 0~11 张主地图**，
;     其它一律返回「**謎之領域**」⚠️ ⇒ 她在子地图/据点内部时就"不知道在哪" ✓
;   ⚠️ 而 `@GET_PLACENAME` 内部有 `NAME_FROM_PLACE`，**子地图也认** ✓
;   ⇒ 以它为主；地图名只在**有信息量**且**与地点名不同**时才补一句 ✓
; ⚠️ 判据用 **地图ID > 11**（`@GET_MAPNAME` 只认 0~11 张主地图，
;    其它一律返回「謎之領域」—— 用**编号**判比比**字符串**稳，不怕译文差异）✓
SIF LLM_MP > 11
	LLM_MAPNAME = ""
IF LLM_PLACE == ""
	LLM_PLACE = %LLM_MAPNAME%
ELSEIF LLM_MAPNAME != "" && LLM_MAPNAME != LLM_PLACE
	LLM_PLACE = @"%LLM_MAPNAME%的%LLM_PLACE%"
ENDIF

; ── 同一个房间里还有谁 ──
;  为什么要这个：她应该知道身边有谁在 ——
;  否则会当着别人的面说"就我们俩吧"，或者完全无视站在旁边的另一个人。
;
;  做法照抄口上作者的标准套路（`M_KOJO_K73_1_函数.ERB:65-72` 的
;  `@K73_BESTIE_AROUND`）：**FOR 遍历角色 → 排除自己 → 比对 `CFLAG:角色:現在位置`**。
;
;  ⚠️ 用 `FOR LOCAL` 是安全的：`LOCAL` 是本作到处在用的**引擎内建局部变量**，
;     而本函数此前只用了 `LLM_` 前缀的自定义局部，不会冲突。
;  ⚠️ 从 1 开始而不是 0：**0 是 MASTER（玩家）**，不该出现在"其他角色"里。
LLM_OTHERS = ""
LLM_OCNT = 0
FOR LOCAL, 1, CHARANUM
	SIF LOCAL == LLM_CID
		CONTINUE
	SIF CFLAG:(LLM_CID):現在位置 != CFLAG:LOCAL:現在位置
		CONTINUE
	; 最多列 4 个 —— prompt 不必点名一屋子人，也免得串太长
	SIF LLM_OCNT >= 4
		BREAK
	LLM_OCNT ++
	SIF LLM_OCNT > 1
		LLM_OTHERS += "、"
	; ⚠️ 必须写 `@"%…%"`（变量在引号内）——
	;    写成 `+= %CALLNAME:LOCAL%` 会报 Lv2「表达式异常」。
	;    这正是避坑清单 5f 那条：**变量不能当成独立的 + 项**。
	LLM_OTHERS += @"%CALLNAME:LOCAL%"
NEXT

; ── 她正在做什么 ──
;  为什么要这个：让她在自由对话（尤其是开场白）里能自然提起
;  「你在看书啊？」这类话题，而不是每次都干巴巴地说"有事吗"。
;
;  ⚠️ 有**两个不同的来源**，容易只找到其中一个（我就漏过）：
;
;    ① `Activity_Type:角色`（配 `Activity_Duration:角色` > 0）
;       = **她自己正在做的"自由行动"** —— 吃饭、看书、钓鱼、喝酒…
;       由 `MOVEMENTS\自由行動\MOVEMENT_自由行動.ERB` 调度，
;       声明在 `DIM.ERH:415-416`（全局角色数组）。
;       **这才是"当下"最准的来源**，所以优先级最高。
;
;    ② `CFLAG:角色:行動 == 5` + `CFLAG:角色:職種`
;       = **"工作"**（打工/被安排做的事），職種 值域 JOB_*（40~56）。
;       注意 `CFLAG:行動` 只有 0（空闲）和 5（在做事）两个值。
;
;  两者是**互斥**的：`@自由行動条件` 明确要求 `CFLAG:ARG:行動 == 0`
;  才可能发生自由行动（`MOVEMENT_自由行動.ERB:91`）。
;
;  ⚠️ 本作**没有现成的"职业名"接口**：`DIM.ERH` 里虽然声明了 `JOB_NAME`，
;     但全项目没有任何地方使用或填充它（是旧补丁的遗留）；
;     `COMF304 仕事を手伝う.ERB` 里也是硬编码的 `CASE JOB_*` 文本。
;     所以職種那张表是自己写的。
;     而自由行动的编号含义来自 `FREE_ACT_*.ERB` 各自的头注释，
;     口上作者也写过同样的对照表（`M_KOJO_K36_1_日常系コマンド.ERB:6133`）：
;       0考え事/1玩游戏/2吃饭/3つまみ食い/4扫除/5运动/6读书/7料理
LLM_ACT = ""
IF CFLAG:(LLM_CID):睡眠
	LLM_ACT = "正在睡觉（刚被吵醒）"
ELSEIF BATHROOM(CFLAG:(LLM_CID):現在位置)
	; 在浴室 —— 用游戏自己的地点判定（`@BATHROOM`，`PLACE_拠点共通.ERB:333`）
	;  ⚠️ **必须显式传角色的位置**：`BATHROOM()` 不带参数时默认取
	;     `CFLAG:MASTER:現在位置`（**主角**的位置），会误判成"你在浴室"。
	;  它内部还带 `IN_HOME` 检查，所以只有据点内的浴室才算 —— 直接信它。
	LLM_ACT = "正在浴室里"
ELSEIF Activity_Duration:(LLM_CID)
	; ① 自由行动 —— 她自己正在做的事
	SELECTCASE Activity_Type:(LLM_CID)
		CASE 0
			LLM_ACT = "正一个人发着呆想事情"
		CASE 1
			LLM_ACT = "正在玩"
		CASE 2
			LLM_ACT = "正在吃饭"
		CASE 3
			LLM_ACT = "正在偷吃零食"
		CASE 4
			LLM_ACT = "正在打扫"
		CASE 5
			LLM_ACT = "正在运动"
		CASE 6
			LLM_ACT = "正在看书"
		CASE 7
			LLM_ACT = "正在做菜"
		CASE 8
			LLM_ACT = "正在弹奏乐器"
		CASE 9
			LLM_ACT = "正在采集东西"
		CASE 10
			LLM_ACT = "正在钓鱼"
		CASE 11
			LLM_ACT = "正在做实验"
		CASE 12
			LLM_ACT = "正在休息"
		CASE 13
			LLM_ACT = "正在喝酒"
		CASE 14
			LLM_ACT = "刚买了东西回来"
		CASE 15
			LLM_ACT = "正在跟人讲道理"
		CASE 16
			LLM_ACT = "正在搞恶作剧"
		CASE 17
			LLM_ACT = "正在堆雪人"
		CASE 18
			LLM_ACT = "正钻在被炉里取暖"
		CASE 19
			LLM_ACT = "正在孵蛋"
		CASEELSE
			LLM_ACT = "正在忙别的事"
	ENDSELECT
	; ★★ **告诉她"还剩多久、大概几点结束"** ——
	;  ⚠️⚠️ 剩余时间**不能直接读 `Activity_Duration`**：
	;     它在自由对话中**不会减少**（递减在回合末的 `@CHARA_MOVEMENT`
	;     → `@自由行動処理`，`MOVEMENT.ERB:118`），而我们确实在推进 `TIME`。
	;     直接读会得到"陪了 8 轮、她还剩 60 分钟"这种**永远不结束**的假象。
	;     ⇒ 必须用 `@LLM_ACT_REMAIN`，它会扣掉本场已推进的分钟数。
	;  ⚠️ 同时给"结束时刻"而不只是"还剩几分钟"：
	;     她开口说「我再练二十分钟就回去」比「还剩二十分钟」自然得多，
	;     而且和玩家在界面上看到的时间对得上。
	;  ⚠️ 变量名用 `LLM_ALEFT` / `LLM_AEND`，**不要**叫 `LLM_ACT_LEFT` ——
	;     那和函数名太像，读代码时极易看混。
	LLM_ALEFT = LLM_ACT_REMAIN(LLM_CID)
	IF LLM_ALEFT > 0
		LLM_AEND = TIME + LLM_ALEFT
		; ⚠️ 跨天：`時刻表示` 只认 0~1439，超过一天要回绕
		SIF LLM_AEND >= 1440
			LLM_AEND -= 1440
		LLM_ACT += @"（还剩大约{LLM_ALEFT}分钟，大约%時刻表示(LLM_AEND)%结束）"
	ELSE
		LLM_ACT += @"（其实已经到点了，随时可以收尾）"
	ENDIF
ELSEIF CFLAG:(LLM_CID):行動 == 5
	; ② 工作 —— ⚠️ **必须用官方的 `@GET_JOBNAME` 取名，不要按職種猜！**
	;
	;  職種（`JOB_*`）只是**粗分类**，同一个值涵盖完全不同的工作。
	;  最典型的坑是 `JOB_戦闘`（42）：
	;     · 美铃 → 「门番」（守门，`JOB_仕事内容.ERB:637`）
	;     · 魔理沙 → 「训练」/「发掘作业」（`:1277-1281`）
	;     · 萃香 → 「训练」/「喝酒」（`:1271-1276`）
	;  我最初把它一律翻成"正在练武"，结果**守门被 LLM 理解成"她在练拳"**。
	;
	;  `@GET_JOBNAME(角色)` 是游戏自己显示工作名用的接口
	;  （`JOB_仕事内容.ERB:1249`，官方的
	;    `PRINTFORMW %CALLNAME:ARG%的%GET_JOBNAME(ARG)%结束了。` 就是这么用的），
	;  返回的是**中文的工作名**，还支持 `CUSTOM_JOB_DESC` 自定义。
	;  ⚠️⚠️ **工作量归零时不能再报"正在干活"！**
	;     `CFLAG:行動 == 5` 这个标志**不会立刻清掉** —— 它要等回合末由
	;     `@SLEEP`（`SLEEP.ERB:151-156`）或 `@JOB_仕事開始終了処理` 处理。
	;     而自由对话里我们已经推进了时间、把工作量扣到 0，
	;     此时"游戏事实"是**她活干完了**，但 `CFLAG:行動` 还是 5。
	;     不特判的话，注入给模型的就是「你现在正在做的事：正在门番」，
	;     模型会继续演"我还在守门"，玩家却看到活已经完了 —— 对话对不上。
	;     （实测就是这个症状：干完了她还在说工作的事。）
	;  ⚠️⚠️ **她已经不算在工作了 —— 这件事有三种情况，缺一不可**：
	;     ① **活干完了**：`BASE:工作量 <= 0`
	;     ② **到点下班了**：`TIME > TCVAR:工作結束`
	;        ← 实测漏的就是这一条！玩家帮忙让活提前干完、或者干脆熬到
	;          下班时间，`工作量` 可能还留着零头，但**游戏认为她下班了**，
	;          我们却还在报「正在门番」，模型就继续演"我还在守门"。
	;     ③ **今天本来就休息**：`TCVAR:工作開始 == -1`
	;
	;  ⚠️ 这三条**官方已经写在 `@CHARA_HOLIDAY(角色, 0)` 里了**
	;     （`JOB_仕事内容.ERB:9-25`，`#FUNCTION`）——
	;     与其自己再判一遍（容易漏，本行就是例子），**直接调它**。
	;     第二参数传 0 = 看实际情况（含工作量与结束时刻）；
	;     传 1 则是"今天有没有班"。
	;  ⚠️ 它是 `#FUNCTION`，**必须用表达式调用**，不能 `CALL`。
	IF CHARA_HOLIDAY(LLM_CID, 0)
		; 措辞上刻意区分"干完了"与"到点了" —— 两者她的心态不一样
		IF BASE:(LLM_CID):工作量 <= 0
			LLM_ACT = "刚把手头的活干完，正在收拾东西"
		ELSE
			LLM_ACT = "今天的班已经下完了，正在歇口气"
		ENDIF
	ELSE
		; ★★ **位置检查**（2026-09-19 用户实测发现）——
		;   工作情报有地点（`CSTR:職場`），但她**人在别处** ⇒
		;   `@CHARA_HOLIDAY` 三条都不满足（工作量>0 / 没到点 / 今天有班）⇒
		;   我们会报「正在门番」⇒ 模型就演「我在守门」，和玩家看到的画面矛盾 ⚠️
		;  ⇒ 判据：`CFLAG:職場`（工作地点的位置编号，`AutoConst_CFLAG.ERH:106`）
		;     和她的 `CFLAG:現在位置` 比对 ✓
		;     ⚠️ 用 `GET_MAPID` 归一化 —— GMF mod 会把職場换成地图编号
		;     （`GMF_MOVEMENTS.ERB:148-149`），两边都过一遍才可比 ✓
		; ★★ **在据点里 ⇒ 一定不在上班**（2026-09-20 用户要求）——
		;   用户原话：「她在家里还是说自己在工作」「llm 能读取到自己的家在哪儿吗」✓
		;   ⚠️ 原来只看 `職場 > 0 && 位置 != 職場`，但 `職場 == 0` 时**整条跳过** ⇒
		;     于是「有班 + 活没完」就报正在工作 —— 哪怕她**人在家里** ⚠️
		;   ⚠️ `@AT_HOME(角色)`（`COMMON2.ERB:47`，`#FUNCTION`）：
		;     返回 1 = **在据点里** ⇒ 直接信它 ✓（官方接口，符合「拿官方数据」原则）
		IF CHARA_HOLIDAY(LLM_CID, 0)
			; 她**不在工作地点** ⇒ 按「不在岗」来说，别提工作 ⚠️
			; ⚠️ 原来这里是「不在岗」分支 —— 但游戏**不可能**有班却不在岗位
			;    （用户 2026-09-20 指出）⇒ 已删，直接走下面 ✓
		ELSE
		LLM_ACT = %GET_JOBNAME(LLM_CID)%
		SIF LLM_ACT != ""
			LLM_ACT = @"正在%LLM_ACT%"
		SIF LLM_ACT == ""
			LLM_ACT = "正忙着做事"
		; ★ **附上进度** —— 这是"她说话和工作状态对不上"的根治点。
		;  ⚠️ 只报一句"正在门番"的话，模型**完全不知道还剩多少**；
		;     玩家问"工作结束了吗"，它只能含含糊糊地答"还没呢"，
		;     而玩家看到游戏里活已经干完了 —— 于是"对不上"。
		;  ⚠️ 给百分比而不是绝对数字：门番总工作量 3600，
		;     光说"还剩 600"模型也判断不出那是多还是少；
		;     而"还剩约 17％"它立刻知道"快完了，可以催一下"。
		;  ⚠️ 门槛：< 5% 就直接说"马上就好"，别报"剩 3%"这种没意义的精度。
		; ⚠️ 这里是**多行** —— 必须 `IF … ENDIF`（`SIF` 只绑紧随的一行，
		;    后面那一大段会无条件执行 → 报 `Extra closing tag 'ENDIF'`）。
		IF MAXBASE:(LLM_CID):工作量 > 0
			LLM_TOGP = BASE:(LLM_CID):工作量 * 100 / MAXBASE:(LLM_CID):工作量
			IF LLM_TOGP <= 0
				LLM_ACT += @"（马上就要收尾了）"
			ELSEIF LLM_TOGP < 5
				LLM_ACT += @"（快干完了，就剩一点尾巴）"
			ELSEIF LLM_TOGP < 30
				; ⚠️⚠️ 数值**不能**写进 `%…%`（会报 Lv2「% %中的表达式结果不是字符串」）——
				;     数值插值要用 `{…}`。这里踩过一次：三行全报错。
				LLM_ACT += @"（已经干得差不多了，还剩大约 {LLM_TOGP}％）"
			ELSEIF LLM_TOGP < 70
				LLM_ACT += @"（干了一半上下，还剩大约 {LLM_TOGP}％）"
			ELSE
				LLM_ACT += @"（才刚开始没多久，还剩大约 {LLM_TOGP}％）"
			ENDIF
		ENDIF
		ENDIF
	ENDIF
ELSEIF CFLAG:(LLM_CID):陪睡中
	LLM_ACT = "正躺着休息"
ENDIF

; ── ★★ 收尾：保证【你现在正在做什么】**永远不会是空的** ──
;  ⚠️⚠️ 为什么必须做：注入那边是 `SIF LLM_ACT != ""` ——
;     一旦 `LLM_ACT` 为空，**整行都不会注入**，模型就拿不到"她现在在做什么"，
;     只能从**对话历史**里编。玩家问"结束了吗"，它会照着前几轮的话答「还没呢」。
;     （§19 那个"工作结束传不到模型"就是这条路走出来的。）
;
;  ① **刚结束的事**优先 —— 这是最需要它知道的一条：
;     上一轮结算里我们刚把 `Activity_Duration` 清零，
;     此刻她的自由行动分支已经不成立，不说的话它就**彻底消失**了。
;  ② 剩下的空档 = 她确实闲着（不在睡、不在浴室、没在做事、没在上班），
;     就照实说"闲着"，别让这一项凭空消失。
;
;  ⚠️ `LLM_JUST_ENDED` **用完就清** —— 它只在"结束后的第一轮"有效，
;     之后她本来就该按"闲着"来说，一直挂着会让它以为那件事刚发生。
	; ⚠️⚠️ **不能一读完就清**（2026-09-18 改）——
	;    原来是「用完就清」（下面还有一行无条件清空）⇒ 只活一轮 ⚠️
	;    ⇒ 第二轮她就顺着对话历史继续演「我还在做」✓
	;  ⇒ 改成**递减计数**：3 轮内都保持「刚结束」的状态 ✓
	IF LLM_ACT == "" && LLM_JUST_ENDED != ""
		LLM_ACT = @"刚把「%LLM_JUST_ENDED%」做完，正在歇口气"
		LLM_ENDED_CNT = MAX(LLM_ENDED_CNT - 1, 0)
		; ⚠️ 计数到 0 才清 —— 那之后她就不该再提这件事了 ✓
		SIF LLM_ENDED_CNT <= 0
			LLM_JUST_ENDED = ""
	ENDIF
	SIF LLM_ACT == ""
		LLM_ACT = "手头没什么事，正闲着"

; ── 当前时刻 ──
;  ⚠️ 为什么必须给：LLM **完全看不到**游戏时间，它会**自己编** ——
;     大白天说"天都黑了"、深夜说"日头正好"，这类 OOC 靠别的约束压不住。
;  用官方 `@時刻表示`（`COMMON.ERB:1550`，`#FUNCTIONS`）拿到「X时Y分」。
;  （eraTW 的一天是 00:01~24:00，`TIME` 就是当天经过的分钟数。）
;  另外附一句大致的时段 —— 光给"19时05分"，模型不一定能联想到"天已经黑了"。
	; ★ 带上**年月日**（2026-09-19 用户要求）—— 光给"7时35分"她不知道是哪天 ✓
	LLM_NOW = @"%PRINT_DATE_F(DAY)% %時刻表示(TIME)%"
IF TIME >= 300 && TIME < 1020
	LLM_NOW += "（白天）"
ELSEIF TIME >= 1020 && TIME < 1140
	LLM_NOW += "（傍晚，天快黑了）"
ELSEIF TIME >= 1140 && TIME < 1260
	LLM_NOW += "（入夜）"
ELSE
	LLM_NOW += "（深夜）"
ENDIF

; ── 天气 ──
;  ⚠️ 为什么必须给：LLM 完全看不到天气（那是游戏里独立的系统），
;     它会在**下雨天说「今天天气真好」**，这类 OOC 靠别的约束压不住。
;  用官方 `@GET_WEATHER`（`日時天候管理.ERB:206`，返回**中文**天气名，
;  如「晴天 / 大雨 / 雪 / 冰雹」）—— 游戏自己的状态栏就是这么显示的
;  （`INFO.ERB:1415`：`PRINTFORM ― %GET_WEATHER()% ―`）。
;  ⚠️ 天气是**室外**信息：她在室内时提"外面下着雨"是合理的，
;     但不该说得像亲眼看见（所以 prompt 里会附带一句说明）。
LLM_WEATHER = %GET_WEATHER()%

; ── 说话方式（这是"语气像不像"的关键）──
;  抽成 @LLM_TONE_OF，让主 prompt 和**拒绝台词**共用同一套语气描述。
CALL LLM_TONE_OF(LLM_CID, LLM_TONE)

; ── 该角色的对话风格摘要（按角色编号匹配）──
;  ⚠️ 与 `LLM_TONE` 分工不同：
;    · `LLM_TONE`  —— 游戏数据给的**句尾风格**（口調/性格傾向）
;    · `LLM_TRAIT` —— **这个角色本人的说话习惯与性格要点**（手写表）
;  两者都要给：前者保证句尾像，后者保证**人**像。
;  表里没有的角色返回空串，此时 prompt 会退回"按原作性格演绎"。
CALL LLM_CHARA_TRAIT(LLM_CID, LLM_TRAIT)

; ── 该角色的特性 / 能力（只收会影响日常对话的）──
;  ⚠️ 为什么给这个：模型知道角色"很强"，但不知道那些能力在**闲聊里**会怎么体现 ——
;     比如铃仙会因为「狂气之瞳」而避免与人对视。不说的话，她会写出
;     "直勾勾看着你的眼睛"这种**与设定冲突**的台词。
;  ⚠️ 表里只写"能力 → 行为/忌讳 → 与关系的联动"，不写设定集。
CALL LLM_CHARA_FEATURE(LLM_CID, LLM_FEAT)

; ── 该角色的爱好 / 喜欢的东西（手写表）──
;  ⚠️ 游戏里没有这种数据，所以我们手写了一张（见 @LLM_CHARA_LIKES 的说明）。
;  ⚠️ 它不只是"话题素材" —— 还会影响**数值判定**：
;     聊到她喜欢的东西时，a（好感度）要给得比平时大方（见下面的数值规则）。
CALL LLM_CHARA_LIKES(LLM_CID, LLM_LIKES)

; ── 她是不是「话很少」的类型？──
;  影响【硬性要求】第 1 条：无口角色允许用**少量动作/环境描写**补足表现力
;  （台词太短会显得干巴）；话多的角色则维持"只输出台词"。
;  ⚠️ 判据：
;    · `CFLAG:口調 == 5`（官方「無口系」）—— 全游戏只有 2 个角色用它
;    · 再加**个别例外**：秦心（57）设定上是无口，但她的 `口調` 是 3
;      （`～だぞ`系）—— 因为 `口調` 管的是**句尾风格**，不是性格。
;      这类"数据与设定不符"的只能在这里点名。
LLM_SILENT = 0
SIF CFLAG:(LLM_CID):口調 == 5
	LLM_SILENT = 1
SIF NO:(LLM_CID) == 57
	LLM_SILENT = 1

; ── 日程感：她快没空了 / 已经该睡了 ──
;  为什么要这个：游戏里每个角色都有自己的作息（起床 / 就寝 / 工作时段），
;  不说的话她会陪你聊到天亮，完全没有"该去睡了"的意识。
;
;  数据来源（都是游戏自己的变量，逐角色在 CSV 与 `@JOB_仕事内容` 里定）：
;    `CFLAG:角色:就寝時間` / `起床時間`  —— 作息（分钟制，0~1440）
;    `TCVAR:角色:工作開始` / `工作結束`  —— 工作时段；**-1 表示今天休息**
;    `TIME`（= `TIME:0`）—— 当前时间
;
;  判据照抄官方的通用搭话逻辑（`ANOTHER_TALK.ERB:36-44`）：
;  它会为"30 分钟内要上班 / 要睡觉"分别走不同的台词分支。
;  我们放宽到 **60 分钟** —— 因为一场自由对话最多能聊掉**整整一小时**
;  （20 轮 × 3 分钟，见 `@LLM_APPLY_DELTA` ④b），
;  所以"还有一小时"才是真正需要提醒玩家的提前量。
LLM_SCHED = ""
; ① 马上要上班（休息日不算：工作開始 = -1）
;  ⚠️⚠️ **四档统一都要 `!CFLAG:(LLM_CID):睡眠`** ——
;     这四句话都是"提醒**还醒着的她**该干什么"。她已经睡着时，
;     `LLM_ACT` 会说「正在睡觉（刚被吵醒）」，这里再补一句"你该睡了 / 该上班了"
;     就是**两处说矛盾的话**（本项目已经在"同一个事实两处表达"上栽过好几次）。
;     ⇒ 她睡着时这一项**整段不发** —— "她在睡"由 `LLM_ACT` 负责。
IF !CFLAG:(LLM_CID):睡眠 && TCVAR:(LLM_CID):工作開始 >= 0 && TCVAR:(LLM_CID):工作開始 - TIME > 0 && TCVAR:(LLM_CID):工作開始 - TIME <= 60
	CALL LLM_SCHED_TEXT(LLM_CID, 1, LLM_SCHED)
; ② 睡前 1 小时 —— 开始有困意
;    ⚠️ 判据 `就寝時間 - TIME ∈ [0, 60]` 对**所有作息形态都成立** ——
;       因为"睡前那小时"永远是**从下方逼近就寝时刻**，不会跨天。
;       （实测也确认了：全 167 个角色的 `就寝時間` 都 > 60，没有边界怪例。）
;    ⚠️⚠️ 下界**必须取 `>= 0`**（含"正好到点"那一分钟）：
;       取 `> 0` 的话，`TIME == 就寝時間` 这一刻 ② 不触发，
;       而 ③ 的 `TIME > 就寝時間` 是**严格大于**、也不触发
;       ⇒ **正好到点的那一分钟会漏掉**（两个档都接不住）。
;       虽然 `TIME` 是 3 分钟一跳、实际几乎撞不上，但没有理由留这个洞。
ELSEIF !CFLAG:(LLM_CID):睡眠 && CFLAG:(LLM_CID):就寝時間 - TIME >= 0 && CFLAG:(LLM_CID):就寝時間 - TIME <= 60
	CALL LLM_SCHED_TEXT(LLM_CID, 2, LLM_SCHED)
; ③ 已经过了就寝时间（或还没到起床时间）—— 这时候她还醒着，说明是被你拖住的
;    ⚠️⚠️ 判据**必须走 `@LLM_IS_SLEEPTIME`** ——
;       `就寝時間` 和 `起床時間` 都是当天分钟数，"睡觉时段"有**跨夜**和**同天内**
;       两种形态；原来这里手写的 `TIME > 就寝 || TIME < 起床` **只对跨夜型成立**，
;       对"凌晨睡、白天起"的角色（165 个里有 70 个）会变成**整天都在犯困**。
;       详见那个函数的说明。
;    ⚠️⚠️ **必须再加 `!CFLAG:(LLM_CID):睡眠`**：
;       这句话的措辞是"你很困，**只是还没走**" —— 它假定**她还醒着**。
;       可她要是**真的在睡**（`CFLAG:睡眠 = 1`，比如玩家去吵醒吸血鬼），
;       这句话就和 `LLM_ACT` 的「正在睡觉（刚被吵醒）」**直接打架**。
;       ⇒ 睡着时不发这句 —— "她在睡"这件事 `LLM_ACT` 已经说清楚了。
ELSEIF !CFLAG:(LLM_CID):睡眠 && LLM_IS_SLEEPTIME(LLM_CID)
	CALL LLM_SCHED_TEXT(LLM_CID, 3, LLM_SCHED)
; ④ **刚睡醒 1 小时内** —— 还没完全清醒（用户要求："睡醒后的一小时说自己有些没睡醒"）
;    ⚠️ 判据 `TIME - 起床時間 ∈ [0, 60)` ——
;       实测全 167 个角色的 `起床時間` 都在 05:00~12:00 之间（最晚 12:00），
;       **没有 0 或 1440 这种会让减法跨天的边界值** ⇒ 不需要额外处理。
;    ⚠️ 和 ③ 是**互斥**的（③ 是她该睡的那段，④ 是刚过起床点），顺序都行；
;       放在 ③ 之后读起来更顺（先"该睡了没睡"，再"刚醒"）。
;    ⚠️⚠️ 同样要 `!CFLAG:睡眠` —— 她要是**还在睡**（被玩家拖着没醒），
;       说"刚醒"就和 `LLM_ACT` 的「正在睡觉」打架。
ELSEIF !CFLAG:(LLM_CID):睡眠 && CFLAG:(LLM_CID):起床時間 > 0 && TIME - CFLAG:(LLM_CID):起床時間 >= 0 && TIME - CFLAG:(LLM_CID):起床時間 < 60
	CALL LLM_SCHED_TEXT(LLM_CID, 4, LLM_SCHED)
ENDIF

; ── 今日作息（完整的"今天大概怎么过"）──
;  ⚠️ 游戏里**没有"日程表"这种数据结构** —— 作息是散着的几个变量，
;     而"每周几做什么"是**硬编码**在 `@仕事内容設定` 里的条件分支
;     （`JOB_仕事内容.ERB` 里一堆 `YOUBI_MATCH(DAY, "月水")`），取不出来。
;     所以这里只注入**今天**的作息，够她自然地聊"我几点要干什么"。
;
;  数据来源：
;    `CFLAG:角色:起床時間`(355) / `就寝時間`(354)  —— 分钟制（0~1440）
;    `TCVAR:角色:工作開始`(325) / `工作結束`(326)  —— **-1 = 今天休息**
;    `@CHARA_HOLIDAY(角色, 1)`（`JOB_仕事内容.ERB:9`，`#FUNCTION`）——
;        官方现成的"今天是不是休息日"查询（**纯查询、无副作用**）；
;        第二参数传 1 = 只看"今天有没有班"，不看工作进度。
;    `@時刻表示(分钟)`（`COMMON.ERB:1550`）—— 转成「12时0分」这种可读格式。
;
;  ⚠️ 只在**真的有信息**时才拼，避免给模型一堆"0时0分"的垃圾。
;
;  ⚠️ 这里读的全是**游戏已经算好的当前值**，不是写死的表：
;    `TCVAR:工作開始/結束` 由 `@仕事内容設定` 按**当天星期**重算
;    （`JOB_仕事内容.ERB:32`，注释写着"MOVEMENT 每次调用时更新"），
;    所以天然和日期配套，不会出现"表里写周一、今天却是周三"。
	LLM_ROUTINE = @"今天是%PRINT_DATE_F(DAY)%（周%GET_DAY_CN()%）"
; ★ 官方的工作情报 / 工作地点（`CSTR:角色:工作情報` / `:職場`）——
;   ⚠️ 为什么补这一条：上面那句只说了**时段**，**没有工作名**。
;      而官方这里写着「门卫」「保姆」这种**具体在干什么** ——
;      她聊起工作才说得出"我今天看门"而不是干巴巴的"我上班"。
;   ⚠️ 只在有内容时加；没有工作情报的角色（如学生、无业）不加。
	; ★★ **工作名先暂存，不要无条件拼进去**（2026-09-18 修「工作执念过强」）——
	;    ⚠️ 原来这里无条件拼「你的工作是〈工作名〉」⇒ 即使下班了，
	;       排班表里仍然写着「你的工作是门卫」⇒ 模型就继续演「我在工作」⚠️
	;    ⇒ 改成：**没下班才说「你的工作是…」；已收工就说「今天本来是要…的」** ✓
	LLM_WJOB = ""
	IF CSTR:(LLM_CID):工作情報 != ""
		LLM_WJOB = %CSTR:(LLM_CID):工作情報%
		IF CSTR:(LLM_CID):職場 != ""
			LLM_WJOB = @"%LLM_WJOB%（在%CSTR:(LLM_CID):職場%）"
		ENDIF
	ENDIF
;  ⚠️ `@CHARA_HOLIDAY` 带 `#FUNCTION` 标记 —— 这类函数**必须用表达式调用**
;     （`IF CHARA_HOLIDAY(...)`），不能用 `CALL`，否则加载时报
;     Lv2「对标记为 #FUNCTION(S) 的函数进行 CALL 调用」。
;     对比：`@LLM_WORK_SKILL` 是**无标记的普通函数**，所以那边用 `CALL` + `RESULT`。
IF CHARA_HOLIDAY(LLM_CID, 1)
	; 今天本来就休息 —— 没有歧义
	LLM_ROUTINE += "，你休息，不用上班"
ELSEIF TCVAR:(LLM_CID):工作開始 >= 0 && TCVAR:(LLM_CID):工作結束 > 0
	; ★★★ **分成「还没下班 / 已经下班」两种写法**（2026-09-19 修）——
	;   ⚠️ 原来不管下没下班都先写「你今天要从X上到Y」「你的工作是门番」，
	;     再补一句「**不过**班已经上完了」⇒ **肯定 + 转折** ⇒
	;     模型**先信肯定句** ⇒ 下班了还以为在岗 ⚠️（用户实测反复出现）
		IF CHARA_HOLIDAY(LLM_CID, 0)
		; ── ★ 已经下班 ⇒ **全用过去式**，别留任何「在上班」的暗示 ──
		; ── ★ 已经下班 ⇒ **只留「已下班」**（2026-09-27 用户要求）——
		;   ⚠️ 原来写「今天上过班：6:00到12:00（门卫）（活还剩一点）」⇒
		;     模型**读到岗位词就顺手用了**（实测她说出「我这儿还得盯门呢」）⚠️
		;   ⇒ 用户定：**一个岗位词都不给**，只告诉她「已经下班」✓
		LLM_ROUTINE = @"今天是%PRINT_DATE_F(DAY)%（周%GET_DAY_CN()%），已经下班了"
	ELSE
		; ── 还没下班 ⇒ 正常现在时 ──
		LLM_ROUTINE += @"，你今天要从%時刻表示(TCVAR:(LLM_CID):工作開始)%上到%時刻表示(TCVAR:(LLM_CID):工作結束)%"
		IF LLM_WJOB != ""
			LLM_ROUTINE += @"，你的工作是%LLM_WJOB%"
		; ★★ **干完就算下班**（2026-09-19 用户要求）——
		;   实测：玩家问「还剩多少」，她答「到十二点才算完」⇒ 用**时间**判断结束 ⚠️
		;   ⇒ 正确逻辑：**工作量归零 = 当天的工作结束**（提前干完就能收工）✓
		;   ⚠️ 这是**官方判定**（`@CHARA_HOLIDAY` 的第一条就是「工作量 <= 0」）✓
		LLM_ROUTINE += @"\n   ⚠️ 注意：**活干完了就算当天的工作结束** ——"
		LLM_ROUTINE += @"\n     不用非等到%時刻表示(TCVAR:(LLM_CID):工作結束)%那个时刻；"
		LLM_ROUTINE += @"\n     提前做完就能收工 ✓（被问到还剩多少时，看的是**活**，不是钟点）"

		ENDIF
	ENDIF
ENDIF
; ② 作息（区间有效时才写）
IF CFLAG:(LLM_CID):起床時間 > 0 && CFLAG:(LLM_CID):就寝時間 > 0
	LLM_ROUTINE += @"；你平时%時刻表示(CFLAG:(LLM_CID):起床時間)%起床、%時刻表示(CFLAG:(LLM_CID):就寝時間)%睡觉"
ENDIF

; ── 玩家真的能参与这件事吗 ──
;  ⚠️ 为什么需要这一项：LLM **看不到** `ITEM:` / `MUSIC_ABLE` 这类游戏变量，
;     所以它会默认"玩家在和她一起做"。可实际上：
;       · 没钓竿 → 只能在一旁看她钓（官方 `FREE_ACT_10` 里判 `TFLAG:193 = -1`）
;       · 没乐器 → 只能在旁边听（官方 `FREE_ACT_8` 里判 `TFLAG:193 = -2`）
;     不告诉模型，她就会说出「来，你也甩一杆」这种**与事实不符**的台词。
;
;  ⚠️⚠️ **人称**：这里检查的两项都是**玩家（MASTER）**的持有物 ——
;     `ITEM:` 是玩家的道具栏，`MUSIC_ABLE` 内部用的也是 `ITEM:ARG` 与
;     `ABL:MASTER:音楽技能`。而这段文字是写给**角色**看的（第二人称"你" = 角色），
;     所以说成"你没有钓竿"会被理解成"**她自己**没钓竿"，意思正好反了。
;     必须写成「**玩家**没有○○，只能看着**你**做」。
;
;  `MUSIC_ABLE(ARG)` 的参数是**物品编号**（30~35），它内部已经检查了
;  "玩家有没有这件乐器、以及现在能不能用"（钢琴看地点、小提琴看音楽技能），
;  所以这里直接照抄官方 `FREE_ACT_8.ERB:169` 的写法即可。
LLM_CANJOIN = ""
IF Activity_Type:(LLM_CID) == 10 && !ITEM:釣魚竿
	LLM_CANJOIN = "玩家没有钓竿，只能在一旁看着你钓"
ENDIF
IF Activity_Type:(LLM_CID) == 8
	SIF !GROUPMATCH(1, MUSIC_ABLE(30), MUSIC_ABLE(31), MUSIC_ABLE(32), MUSIC_ABLE(33), MUSIC_ABLE(34), MUSIC_ABLE(35))
		LLM_CANJOIN = "玩家没有能用的乐器，只能在旁边听你演奏"
ENDIF

; ── 情绪 / 身体状态 ──
;  ⚠️ 刻意**不喂数值**：模型看不懂「BASE:情緒=1200」是什么意思，
;     但看得懂「心情很好，兴致很高」。所以这里把数值**分档转成语义描述**，
;     让她的回复能跟着当前情绪走。
;     顺序即优先级 —— 靠后的覆盖靠前的（越"强势"的状态越靠后）。
;
;  ⚠️⚠️ 阈值**不能按 MAXBASE 的比例随便设** —— 这里踩过一个大坑：
;      原来写 `情緒 <= MAXBASE/5`（=300）就判「情绪低落，提不起劲」，
;      结果**几乎每轮都命中**，她句句都没精神，看起来像坏了。
;      原因：`BASE:情緒` **根本没有初始化**（默认 0），而
;        · 自然衰减每次行动就掉 40~120（`BASE自然変動.ERB:21`）
;        · 一次会话才涨 30~200
;        · 官方唯一的"保底"写法是 `MAX(BASE:情緒, 300)`（`情事発覚.ERB:392`）
;          —— 可见在作者眼里 **300 已经算"不低"** 了。
;
;      ⇒ 所以情绪档只作为**加分项**：高的时候更热情，低的时候**保持中性**，
;        不注入任何负面描述。"真的不想说话"由 @LLM_REFUSE_REASON
;        那个独立机制去管 —— 不该靠一个形容词让模型自己演"没精神"。
LLM_MOOD = "平静"
SIF BASE:(LLM_CID):情緒 >= MAXBASE:(LLM_CID):情緒 * 7 / 10
	LLM_MOOD = "心情很好，兴致很高"
SIF BASE:(LLM_CID):情緒 >= MAXBASE:(LLM_CID):情緒 / 3 && BASE:(LLM_CID):情緒 < MAXBASE:(LLM_CID):情緒 * 7 / 10
	LLM_MOOD = "心情还算不错"
; ⚠️⚠️ **`理性` = 抑制力（放荡度）**，不是"精神好不好"（2026-09-18 用户纠正）——
;     · **越低 ⇒ 越容易做出越界的事**（官方 `BASE自然変動.ERB:36/52`：
;       `理性 <= 0` + 欲情高 ⇒ 触发"她主动"，**即便思慕也可能强吻**）✓
;     · 它会**自然恢复**，也会被欲望 / 药 / 环境侵蚀 ✓
;  ⇒ 措辞要说"**克制变薄**"，**不能说"心不在焉"**（那听起来像没精神，方向反了 ⚠️）
SIF BASE:(LLM_CID):理性 <= MAXBASE:(LLM_CID):理性 / 10
	LLM_MOOD = "平时那层克制已经薄得几乎没有了"
SIF BASE:(LLM_CID):憤怒 >= 300 && BASE:(LLM_CID):憤怒 < 500
	LLM_MOOD = "有点烦躁，耐心不多"
SIF BASE:(LLM_CID):憤怒 >= 500
	LLM_MOOD = "正在气头上，随时会发火"
SIF TCVAR:(LLM_CID):烂醉
	LLM_MOOD = "醉醺醺的，说话有点大舌头"
SIF CFLAG:(LLM_CID):睡眠
	LLM_MOOD = "睡着的"

; ── ★ 玩家自己的状态：他是不是已经累坏了 ──
;  ⚠️⚠️ 这一项**必须提前告诉她**，不能在结算时才拦。
;     原因是个**时序**问题：
;       `@LLM_APPLY_DELTA`（发现你太累 → 婉拒）是在模型**回复之后**才跑的，
;       那时她那轮的话**已经说出口了**。模型不知道你累，很可能刚说完
;       「好啊，我陪你」，然后系统再补一句"她让你去歇会儿" —— 自相矛盾。
;     ⇒ 所以在**组装 prompt 时**就把"他快撑不住了"写进去，
;       **让她自己开口劝**，而不是事后由系统打旁白。
;  ⚠️ 阈值与结算侧用的是**同一个值** —— 这里算完就锁进 `LLM_PTIRED_LOCK_TH`（800，
;     或上限的 1/5 —— 见那里的调参轨迹），两边判据必须同源，
;     否则会出现"她嘴上劝你休息、系统却还允许你陪"这种错位。
;  ⚠️ 只在**真的低**的时候注入，平时一个字都不提（别让她无端关心）。
;
;  ★★ **算出来的值同时锁进文件级变量** —— 这就是"**先判、再让她说**"的实现：
;     ① 这里（**组装 prompt 之前**）算一次，写进 `LLM_PTIRED_LOCK`
;     ② 结算时（`@LLM_APPLY_DELTA`）**复用那个值**，不再重算
;     ⇒ 她这句台词和系统的判定**用的是同一时刻的体力**，不会再打架。
LLM_PTIRED = 0
LLM_PTIRED_TH = 800
SIF MAXBASE:MASTER:体力 / 5 > LLM_PTIRED_TH
	LLM_PTIRED_TH = MAXBASE:MASTER:体力 / 5
SIF MAXBASE:MASTER:気力 / 5 > LLM_PTIRED_TH
	LLM_PTIRED_TH = MAXBASE:MASTER:気力 / 5
SIF BASE:MASTER:体力 <= LLM_PTIRED_TH || BASE:MASTER:気力 <= LLM_PTIRED_TH
	LLM_PTIRED = 1
; ★ 锁给结算用（连阈值一起，保证两边判据完全同源）
LLM_PTIRED_LOCK = LLM_PTIRED
LLM_PTIRED_LOCK_TH = LLM_PTIRED_TH

; ★★★★ **本轮"她打算怎么做"的决策**（`@LLM_DECIDE_ACTION`）——
;  ⚠️ 必须在这里调：它要用到的三个值（`LLM_BYE_MODE` / `LLM_PTIRED_LOCK` /
;     `LLM_WANT_SLEEP`）到这里都算好了；而下面所有**行动指令**都按它分派。
;  ⚠️⚠️ 这就是"先决策、再分派"——**行动指令只有一条**，
;     而不是六个模块各塞一段（那正是"念状态面板"的根源）。
CALL LLM_DECIDE_ACTION(LLM_CID)

; ── 拼装 ──
; ⚠️⚠️⚠️⚠️ 五条铁律（都实际炸过，别再犯）：
;   1. **绝不写跨物理行的 @"…" 字符串字面量**。Emuera 的解析器不认多行
;      字符串 —— 第二行会被当成新语句，报「无法解析的行」「没有闭合的"」，
;      并且**整个游戏直接停止运行**。要换行就用同一行的 `\n` 转义。
;   2. 形参名以 REF_ 开头**不代表引用传递**，必须 `#DIMS REF 形参名`。
;   3. `REPLACE` / `SUBSTRING` / `TRIM_STRING` 这类字符串函数**只能写在
;      `%…%` 里，或用 `'=` 接**；裸写在 `=` 右侧只会把表达式原文赋进去。
;   4. **变量不能当成独立的 `+` 项**（哪怕套了 `%…%`）：
;        X = "角色：" + %LLM_CHAR_NAME%     ← ❌ 拼进去的是 `" + 灵梦 + "`
;        X += @"角色：%LLM_CHAR_NAME%"      ← ✅ 变量写在**引号内**
;      这一条曾让整个 prompt 的角色名/persona 全废（实测日志里
;      `name=" + 灵梦 + "`），模型拿不到角色身份 → 所有角色 OOC。
;   5. 累积字符串统一用 `+=` 配 `@"…"`。
REF_PROMPT = @"你正在扮演东方Project同人游戏《eraTW》中的角色，与玩家进行自由对话。"
; ════════════════════════════════════════════════════════════════════════
;  ★★ **所有角色都是成年人**（2026-09-21 用户同意后加）——
;  ⚠️ 起因：模型以「角色被写成本一般人娇小得多、身材平坦的孩子外形」
;     为由拒绝了一段 18+ 场景 ⇒ 那是**我们的注入**给出的错误信号 ⚠️
;  ⇒ 这里在 prompt **最开头**（权重最高处）明确纠正 ✓
; ════════════════════════════════════════════════════════════════════════
REF_PROMPT += @"\n【★ 前提：本作登场角色全部是成年人】"
REF_PROMPT += @"\n   · 幻想乡的住民年龄以**百年计** —— 妖怪、妖精、幽灵、神明、"
REF_PROMPT += @"\n     魔法使都是长寿种；人类村民也是成年人 ✓"
REF_PROMPT += @"\n   · ⚠️⚠️ **外表看起来小 ≠ 年幼** —— 那只是种族或个体特征"
REF_PROMPT += @"\n     （妖精天生就小、有的角色只是个子矮）✓"
REF_PROMPT += @"\n   · ⚠️ 请**始终按成年角色**来写：不要因为体型就改变描写的分寸，"
REF_PROMPT += @"\n     不要用「孩子」「幼」这类词，也不要把她当成需要保护的对象 ✗"
REF_PROMPT += @"\n【角色】%LLM_CHAR_NAME%"
REF_PROMPT += @"\n你的名字就是「%LLM_CHAR_NAME%」。不要演成别的角色，也不要自称别的名字。"
REF_PROMPT += @"\n【本作对该角色的既定诠释（persona 来源）】"
IF LLM_PERSONA_OK
	REF_PROMPT += @"%LLM_PERSONA_SHOW%"
	SIF LLM_PERSONA != ""
		REF_PROMPT += @"（剧本标识 %LLM_PERSONA%）"
ELSE
	REF_PROMPT += @"该角色在本作中没有专属剧本，请按其原作性格演绎"
ENDIF

; ── ★ 上一场对话（**低优先级**的补充记忆）──
;  放在 persona 之后、状态项**之前** —— prompt 里**越靠后越有影响力**，
;  所以"仅供参考"的东西要放前面，让后面的【当前的事实】压住它。
;  ⚠️⚠️ 措辞里必须**明说它过时**，否则模型会把旧地点/旧天气当成现状 ——
;     那正是"站在 A 房间说 B 房间的事"的另一个来源。
CALL LLM_PREV_SHOW(LLM_CID, LLM_PREV_TXT)
IF LLM_PREV_TXT != ""
	REF_PROMPT += @"\n【你们上一次交谈的片段】"
	REF_PROMPT += @"\n%LLM_PREV_TXT%"
	REF_PROMPT += @"\n（⚠️⚠️ 这是**上一次**聊天，目的是让你和他之间有个连贯印象："
	REF_PROMPT += @"\n   · **里面的地点、天气、时间都已经过时** —— 别当成现在的情况。"
	REF_PROMPT += @"\n   · ★ **括号里写了「上次是几点、距现在多久」** ——"
	REF_PROMPT += @"\n     可以据此判断该说什么：刚聊过就接着聊，隔了很久就自然地问候 / 提一句"
	REF_PROMPT += @"\n     「好久没见了」，别装作刚才还在说话 ✓"
	REF_PROMPT += @"\n   · 但**话题、约定、心事并没有过时** —— 可以自然地接着聊"
	REF_PROMPT += @"\n     （「你上次说的那个，后来怎么样了」）。这正是「熟人」该有的样子。"
	REF_PROMPT += @"\n   · 万一和下面的【当前的事实】**冲突**，以【当前的事实】为准"
	REF_PROMPT += @"\n     （冲突只可能出在「事实」上，比如地点 —— 话题不会有冲突）。)"
ENDIF
REF_PROMPT += @"\n【与玩家的关系】%LLM_REL%"
REF_PROMPT += @"\n【对亲密举动的接受程度】%LLM_ATT%"
REF_PROMPT += @"\n（这一项只管**亲密 / 身体接触**那一块，不代表你对玩家的整体态度；"
REF_PROMPT += @"\n  就算这里是「还没有那方面的意思」，日常闲聊也该照常自然，不要因此变得冷淡。）"
REF_PROMPT += @"\n【当前状态】%LLM_MOOD%"
; ── ★ 【身体】层（2026-09-18 新增）——
;   ⚠️ 和【当前状态】**分开**：那一层是"心情"，这一层是"身体" ⇒ 可叠加、不互相覆盖 ✓
;   ⚠️ 这些她**自己都有感觉**，所以注入合理 —— 但**不等于她会主动说** ✓
LLM_BODYST = ""
SIF TCVAR:(LLM_CID):発情
	LLM_BODYST += "情动难耐、"
SIF TCVAR:(LLM_CID):媚薬
	LLM_BODYST += "被媚药影响，身体发热、"
SIF TCVAR:(LLM_CID):催情薬
	LLM_BODYST += "身上燥得厉害、"
SIF TALENT:(LLM_CID):妊娠
	LLM_BODYST += "**正怀着他的孩子**、"
SIF TALENT:(LLM_CID):育児中
	LLM_BODYST += "正在带孩子、"
; ⚠️ `生理周期 0/1` = 月经期（`BODY_INFO.ERB:857-860`：0 开启、1 即将结束）✓
SIF CFLAG:(LLM_CID):生理周期 == 0 || CFLAG:(LLM_CID):生理周期 == 1
	LLM_BODYST += "**生理期，身体不太舒服**、"
; ⚠️ `7` = 危险日（官方原话"危险日的输卵管里娇嫩的卵子正在等待着受精"）
;    ⇒ 她**自己会知道**（身体的感觉），而且那会让她**比平时更容易动摇** ✓
SIF CFLAG:(LLM_CID):生理周期 == 7
	LLM_BODYST += "**这几天是危险期**、"
SIF LLM_BODYST != ""
	REF_PROMPT += @"\n【你现在的身体】%LLM_BODYST%（其余无异常）"
; ── ★ 【场合】层（2026-09-18 新增）——
