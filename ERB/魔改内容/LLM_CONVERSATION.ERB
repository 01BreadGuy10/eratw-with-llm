			RESETCOLOR
		ENDIF
	ENDIF
		CALL LLM_MEMO_ADD(TARGET, LLM_MEMO_NEW, LLM_MEMO_W_NEW)
	;  ⚠️ 实测：`id=5` 的回复里 `###MEMO### [3] 他自报身份：红魔馆新来的佣人`
	;     格式完全正确，但 `[6]` 里没多出这条 ⇒ 要分清是**解析为空**还是**入库被拒** ⚠️
	;  这行同时显示"解析到什么"和"入库后的条数" ⇒ 一次就能定位 ✓
	;  ⚠️ 定位完删掉（搜「定位"模型写了」）
	; ⚠️⚠️ **这里原来有个青色回执「（她记住了这件事。）」，已删除**
	;    （2026-09-16 用户反馈："青色的提示一直出现在对话过程中"）
	;  ⚠️ 为什么它一直出现：**这一路的触发源是"模型输出了 `###MEMO###`"** ——
	;     而模型**每轮都可能写**（写同一条也一样，`@LLM_MEMO_ADD` 会幂等去重、
	;     不重复存，但**回执照打**）⇒ 看起来就是刷屏 ⚠️
	;  ⇒ **回执只保留 ERB 自己判定的那一路**（身份，见主循环开头）——
	;     那一路由**玩家的输入**触发、一轮最多一次，语义清楚 ✓
	;  ⚠️ 教训：**"让模型决定要不要写"= 回执频率也交给模型了**。
	;     这正是用户说的「为什么要通过 llm 记忆呢，不能直接判定然后写入吗」——
	;     判定在 ERB，回执自然就**确定**了 ✓
	; ⚠️ 约定仍走专用槽（`###PROMISE###` 正常，没有并发问题）✓
	; ★★ **对玩家的态度**（只在**开场白**那一轮生成）——
;  ⚠️ 它综合了"数值 + 长期记忆 + 上一场缓存"，所以**每场开头重算一次** ✓
CALL LLM_PARSE_NOTE(LLM_OUT, "###ATTITUDE###", LLM_NOTE_NEW)
	; ⚠️⚠️ **判据必须和开场白那处一致**（`:282`）——
	;    `!= ""` 判不出 `""`（空内容带引号，2 字符）⇒ 会把垃圾写进槽 ⚠️
	IF STRLENS(LLM_NOTE_NEW) >= 4
		; ★ **自由互动不写持久数据**（2026-09-21 用户要求）✓
		SIF LLM_MODE == 0
		LLM_ATTITUDE:(TARGET):0 '= @"%LLM_NOTE_NEW%"
	ENDIF
CALL LLM_PARSE_NOTE(LLM_OUT, "###PROMISE###", LLM_NOTE_NEW)
	IF LLM_NOTE_NEW != ""
		LLM_STRIP_WANT = %LLM_NOTE_NEW%
	ENDIF
	; ⚠️⚠️ **`###ADDR###` / `###CALL###` / `###CALLHER###` 的解析已删除**
	;    （2026-09-16 方案 B）—— 那三种事现在**统一写成 `###MEMO### [3]`**，
	;    走上面那个**验证过能工作**的解析器；下面靠 `LLM_MEMO_NEW` 的回执覆盖 ✓
	;  ⚠️ 那三个槽变量（`LLM_ADDRESS` / `LLM_CALLME` / `LLM_CALLHER`）**还留着**
	;     —— 删 `.ERH` 声明会影响存档偏移，风险不值当；它们只是不再被写入 ✓
	; ★ 脱衣部位（玩家说脱哪件，模型就报哪件）
	CALL LLM_PARSE_NOTE(LLM_OUT, "###STRIP###", LLM_NOTE_NEW)
	IF LLM_NOTE_NEW != ""
		LLM_STRIP_WANT = %LLM_NOTE_NEW%
	ENDIF
	; ⚠️⚠️ **`@LLM_PARSE_DELTA` 必须最后跑**（2026-09-16 修）——
	;    它会把 `LLM_OUT` 截成「`###DELTA###` 之前的那半」（那是它抠数值块的方式），
	;    所以**所有标记解析都得排在它前面**，否则 `###MEMO###` / `###PROMISE###` /
	;    `###STRIP###` 会被这一刀切掉 ⇒ **模型写了也存不下** ⚠️
		; ★★ **身体反应标记**（睡姦/醉姦系统，2026-09-20 用户设计）——
		;   ⚠️ **必须在 `@LLM_PARSE_DELTA` 之前** —— 那一刀会把 `LLM_OUT`
		;      截成 `###DELTA###` 之前的部分，排在它后面就解析不到了 ⚠️
		;   ⚠️ 解析完不用手动抠 —— `@LLM_SANITIZE_REPLY` 会从第一个 `###`
		;      起全部截掉 ⇒ 标记不会被念出来 ✓
		LLM_BODY_TAG = ""
		CALL LLM_INT_PARSE_BODY(LLM_OUT, LLM_BODY_TAG)
		; ★ 存一份给 [6] 诊断（2026-09-21）—— 用来确认解析对不对 ✓
		LLM_BODY_LAST = %LLM_BODY_TAG%
		SIF LLM_BODY_TAG != ""
			CALL LLM_INT_APPLY_BODY(TARGET, LLM_BODY_TAG)
		CALL LLM_PARSE_DELTA(LLM_OUT, LLM_D1, LLM_D2, LLM_D3, LLM_D4, LLM_D5, LLM_D6)
	LLM_GOT_DELTA = RESULT
	CALL LLM_SANITIZE_REPLY(LLM_OUT)
	SIF LLM_OUT == ""
		CONTINUE
	CALL LLM_SHOW_FIGURE(TARGET)
	CALL LLM_PRINT_REPLY(TARGET, LLM_OUT)
	; ★★ **觉醒判定**（2026-09-20 用户设计）——
	;   ⚠️ 放在**台词和旁白都出完之后** —— 她可能说完这句就醒了 ✓
	;   ⚠️ 骰法与好感/信赖挂钩：**越喜欢玩家越不容易醒** ✓
	;   ⚠️ 只在睡姦/醉姦时判 —— 清醒的诶嘿嘿不涉及「惊醒」⚠️
	IF LLM_MODE == 1 && (CFLAG:(TARGET):睡眠 || TCVAR:(TARGET):烂醉)
		CALL LLM_INT_WAKE_CHECK(TARGET)
		IF RESULT == 1
			; ★ 惊醒了 ⇒ 收拾东西退出互动 ✓
			PRINTFORML
			PRINTFORML 　%CALLNAME:TARGET%猛地睁开了眼 —— 她醒了。
			CALL LLM_INT_RESET
			CALL LLM_RESTORE_CLOTHES(TARGET)
			RETURN 1
		ENDIF
	ENDIF
	; ★ 约会路上时，在台词之下补一行提示（2026-09-18 用户要求）✓
	CALL LLM_SHOW_DATEHINT
	; 记下调用前的模式值 —— 用来判断这一轮是不是**刚建立**陪伴模式
	LLM_TG_BEFORE = %LLM_TOGETHER%
	; 数值提示跟在台词之后打印（@LLM_APPLY_DELTA 内部打印）
	CALL LLM_APPLY_DELTA(TARGET, LLM_D1, LLM_D2, LLM_D3, LLM_D4, LLM_D5, LLM_D6, LLM_ACC_FAVOR, LLM_ACC_MOOD, LLM_GOT_DELTA, LLM_TOGETHER)
	; 把本轮的愤怒增量累进"不快"计数器（负数可以把它压回去，所以能被哄好）。
	; 攒到阈值（@LLM_REFUSE_REASON 里的 LLM_ANGER_LIMIT）下一轮她就会赶人走。
	TCVAR:(TARGET):336 = MAX(TCVAR:(TARGET):336 + LLM_D3, 0)
	; ★ 只在**刚建立**陪伴模式时追加一句（否则模式跨轮保持，会每轮都多发一次请求）
	SIF LLM_TOGETHER != "" && LLM_TG_BEFORE == ""
		CALL LLM_TOGETHER_TALK(TARGET, LLM_TOGETHER)

	; ══ ★★★★ **道别成立 ⇒ 就在这一轮结束对话** ══
	;  ⚠️⚠️⚠️ **这段以前被插到了"开场白"那个块里（缩进 3），所以从来没生效过**——
	;     开场块运行时 `LLM_BYE_MODE` **还没被判定**（判定在主循环开头
	;     `@LLM_BYE_CHECK`，那是 L365 附近）⇒ 条件恒为假 ⇒ **道别退出=哑的** ⚠️
	;     （2026-09-16 用户实测「道别退出依旧无效」后，逐层核对缩进才发现）
	;  ⇒ **必须放在主循环里、`@LLM_APPLY_DELTA` 之后**（缩进 1）✓
	;
	;  ⚠️ 为什么"就在这一轮退"、不能留到下一轮（用户指出的关键）：
	;     **整个插件会话都在一个回合里** ⇒ 主循环的 `INPUTS`/`PRINT` 只是
	;     这一回合内部的模拟 ⇒ 留到下一轮处理时，屏幕已经被重新打印的输入区
	;     覆盖了 ⇒ 实测症状：【对话结束】出现在**下一次对话的输入画面**上 ⚠️
	;  ⚠️ 只认 `LLM_BYE_MODE == 1`（**她真的要走**）；
	;     等于 2 是「被你挽留下来」⇒ **当然不能退** ✓
	;  ⚠️ 用 `BREAK` 回收尾段（穿回衣服、`DRAWLINE`）再由那里 `RETURN 1`，
	;     **不要直接 `RETURN 1`** —— 那会跳过函数末尾的收尾 ⚠️
	IF LLM_BYE_MODE == 1
		; ★ 用户要求"更直观、更容易发现"——
		;  ⚠️ 立绘是**画在图形层**（`PRINT_FIGURE`/`PRINT_FACE`，固定屏幕坐标）
		;     ⇒ 文字本来就落在**立绘下方** ⇒ 不需要挪位置，缺的是**视觉强调** ✓
		;  ⚠️ 颜色用完必须 `RESETCOLOR`，否则会染到后面所有输出 ⚠️
		PRINTFORML
		SETCOLOR C_YELLOW
		PRINTL ──────────────────────────────────
		PRINTFORML 　【对话结束】
		PRINTL ──────────────────────────────────
		RESETCOLOR
		; ⚠️ 标记"这是道别结束" —— 让收尾段返回 1，
		;    上层菜单才会退出、**把这句告别和提示留在画面上** ✓
		LLM_BYE_ENDED = 1
		BREAK
	ENDIF

	; ⚠️⚠️ **刻意不做的事**（2026-09-16 讨论后决定）——
	;    曾经想加"**解析她的台词**，如果她说了告别词就结束对话"，
	;    但那样就**违反了本项目的核心架构**：
	;      · 正确做法是 **"先判、再让她说"**：在她说之前就定好"是去是留"，
	;        写进 `LLM_BYE_MODE`（见本轮开头 `@LLM_BYE_CHECK`），
	;        prompt 按它注入措辞、结算按它收尾 —— **三处同一个值** ✓
	;      · 反过来"看她说了什么再决定" = **她先说、系统后判**，
	;        正是 §17/§18 花了两轮才修掉的那个病根（台词和系统动作打架）⚠️
	;     ⇒ 所以这里**什么都不做**；要解决"她说要走却不退出"，
	;       **去把 `@LLM_IS_BYE` 的关键词表补全**（玩家说"你回去歇着吧"这类
	;       当时没被识别成道别 ⇒ 模式仍是 0 ⇒ 不退出）✓

	; ══ ★★ **玩家道别了，但她在挽留** ⇒ 给玩家一个明确的系统提示 ══
	;  用户要的效果：「你说了再见，但她似乎还不想让你走」——
	;  ⚠️ 不能只靠模型演：玩家分不清"她嘴上客气"和"系统真的不放你走" ✓
	;  ⚠️ `LLM_BYE_MODE` 是**这一轮的判定结果**（本轮开头 `@LLM_BYE_CHECK` 定的），
	;     所以只在"玩家这轮说了再见 + 她挽留"时才会成立 ✓
	;  ⚠️ 模式 1（她接受）**这里不提示** —— 那一轮的提示是【对话结束】，
	;     由**上面开场段的道别分支**在同一轮内打完并结束对话 ✓
	;     （⚠️ 不要再改成"下一轮再打"：**整个会话都在一个回合里**，
	;       跨轮的信息会跑到下一次对话的屏幕上 —— 2026-09-16 实测踩过）⚠️
	IF LLM_BYE_MODE == 2
		; ⚠️ 一句就够 —— 不需要区分"第几次挽留"（第一次挽留后 `LLM_BYE_KEPT` 就变 1，
		;    而下一轮她必放人，所以"第二次挽留"这个状态根本不会出现）✓
		; ★ 同样加视觉强调（用户要求"更直观、更容易发现"）✓
		SETCOLOR C_ORANGE
		PRINTFORML 　（你说了再见，但她似乎还不想让你走。）
		RESETCOLOR
	ENDIF

	; ── ★ 每轮结束都检查一次"累趴" ──
	;  帮忙 / 陪她做事会在**对话中**扣体力气力（见 @LLM_APPLY_DELTA ④b、④e），
	;  而官方的"体力不支"判定在**回合末**（`EVENTCOMEND.ERB:91-94`）——
	;  不管的话，你能一边掉体力一边无限聊，直到退出对话才突然晕倒。
	;  判定统一走 `@LLM_TOO_TIRED`，与入口处用的是同一个判据。
	;  ⚠️ 顺便清掉陪伴模式 —— 人都要倒下了，不该还挂着"正在陪她干活"。
	; ★ **自由互动时绕过「玩家累趴」中断**（2026-09-20）——
	;   ⚠️ 场景里玩家累不累和互动无关 ⇒ 不该被强制道别 ✗
	;   ⚠️ 前面已清 `RESULT` ⇒ RESULT 保持 0 ⇒ `IF RESULT` 不命中 ✓
	; ⚠️ **必须先清 RESULT** —— `SIF` 不成立时 CALL 不执行，
	;   RESULT 会保留上一次的残留值 ⇒ `IF RESULT` 会误判 ⚠️
	RESULT = 0
	SIF LLM_MODE == 0
		CALL LLM_TOO_TIRED
	IF RESULT
		PRINTFORML
		IF RESULT == 1
			PRINTFORML 　你眼前一阵发黑，实在撑不住了 —— 只能先跟她道别。
		ELSE
			PRINTFORML 　你已经累得连话都说不利索，只好先跟她道别。
		ENDIF
		LLM_TOGETHER = ""
		BREAK
	ENDIF

	LLM_ROUND ++
WEND

	; ══ ★★ **对话结束时把她脱掉的衣服穿回去** ══
	;  ⚠️ 已抽成 `@LLM_RESTORE_CLOTHES`（见下方）——
	;     因为**提前 `RETURN 1` 的路径会跳过这里**（拒绝交谈、累趴劝退），
	;     那些路径必须自己调一次，否则她会**半裸着走出对话** ⚠️
	CALL LLM_RESTORE_CLOTHES(TARGET)
DRAWLINE
	; ══ ★★ **道别退出的返回值** ══
	;  ⚠️⚠️ `BREAK` 只是跳出 `WHILE`，**函数返回值仍是 0** ⇒ 上层
	;     `@LLM_CHAT_BRIDGE` 的 `SIF RESULT == 1 / BREAK` 不成立 ⇒
	;     **菜单不会退出、画面会被 `WEND` 回头 `CALL RELINE` 清掉**
	;     ⇒ 她那句告别和【对话结束】**都会被冲掉** ⚠️
	;  ⇒ 所以用一个专门的标记把"这一场是道别结束"带到收尾段，
	;     在这里返回 1（与"拒绝交谈"同一条出口）✓
	;  ⚠️ 用完即清（否则会带到下一场）✓
	IF LLM_BYE_ENDED
		LLM_BYE_ENDED = 0
		RETURN 1
	ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  把她在对话里被脱掉的衣服穿回去
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ **必须在每一条"退出对话"的路径上调用** ——
;     `@LLM_CHAT_LOOP` 末尾那段收尾**只在正常 `BREAK` 出循环时才会跑到**，
;     而 `RETURN 1`（道别退出 / 拒绝交谈 / 累趴劝退）会**直接跳过它** ⚠️
;     （2026-09-16 加「对话结束」提示时发现的连带问题）
;
;  照抄官方 `AFTERTRA.ERB:80-91`（官方在**调教结束后**就是这么做的）✓
;  ⚠️ **不能改调 `SET_CURRENT_CLOTHES_VALUES`** ——
;     官方注释警告它会在 `基本服装セット==1000` 时**销毁玩家自定义衣装** ⚠️
;  ⚠️ 幂等：`LLM_STRIPPED` 为 0 时什么都不做，所以重复调用无害 ✓
;  ⚠️ **必须把角色 id 当参数传进来** —— 原来是内联在 `@LLM_CHAT_LOOP` 里、
;     直接用那里的 `LLM_CID`；抽成函数后那个变量**在这个函数里不存在**
;     （自查第 4 项「跨函数变量」当场抓到 ✓）
; ────────────────────────────────────────────────────────────────────────────
@LLM_RESTORE_CLOTHES(LLM_RC_CID)
#DIM LLM_RC_CID
#LOCALSIZE 2
IF LLM_STRIPPED && EXISTFUNCTION(@"CHANGE_CLOTHES")
	CALL CHANGE_CLOTHES(LLM_RC_CID, "复原衣服")
	SIF EXISTFUNCTION(@"CLOTHES_SETTING_TRAIN")
		CALL CLOTHES_SETTING_TRAIN(LLM_RC_CID)
	; ⚠️ 穿回来了 ⇒ 清掉标记，避免重复调用时再穿一次 ✓
	LLM_STRIPPED = 0
ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  玩家是不是已经累到不该再互动了
; ────────────────────────────────────────────────────────────────────────────
;  ★ **所有 LLM 交互入口统一调用这个** —— 开场白、主循环、拒绝台词、
;    陪伴后追加台词…一个都不漏。以后再加新的互动也照这个来。
;
;  为什么需要：帮忙 / 陪她做事会在**对话中**扣体力气力，而官方的
;  "体力不支"判定在**回合末**（`EVENTCOMEND.ERB:91-94`）。
;  不在对话内刹车的话，你能一边掉体力一边无限互动，退出时才突然晕倒。
;
;  返回值（用 `RESULT` 接）：
;     0 = 还行
;     1 = 体力见底（先扣体力，所以优先报它 —— 那是"要晕过去"更严重的那个）
;     2 = 气力见底
;  ⚠️ 顺序有讲究：体力比气力严重（体力 0 会直接触发官方的晕倒判定）。
;
;  ⚠️⚠️ **不要加 `#FUNCTIONS`**！返回的是**数值**，而 `#FUNCTIONS` 的函数
;     只能用 `RETURNF` 返回**字符串** —— 加了会报 Lv2「返回了数值类型」，
;     而且调用侧的 `CALL` 也会连带报「对标记为 #FUNCTION(S) 的函数进行 CALL 调用」。
;     这里用普通函数 + `RETURN`（返回值落在 `RESULT`），
;     与项目里的 `@LLM_WORK_SKILL` 写法一致。
; ────────────────────────────────────────────────────────────────────────────
@LLM_TOO_TIRED
SIF BASE:MASTER:体力 <= 0
	RETURN 1
SIF BASE:MASTER:気力 <= 0
	RETURN 2
RETURN 0


; ────────────────────────────────────────────────────────────────────────────
;  轮询一次带等待：等到模型回复、失败、或超时
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ 协议（2026-09 修正，勿改）：
;    Emuera 的 CALLSHARP **只会回填最后一个参数**，中间的参数即使写了也会被
;    引擎丢掉。所以状态码不能单独占一个参数 —— 上一版就是因为把状态放在
;    中间参数，导致 LLM_STATE 永远是 0、一直轮询到超时。
;    现在的约定是：插件把「状态码 + TAB + 文本」一起放进**最后一个参数**。
;
;  参数：LLM_REQ   = 请求 id（LLM_CHAT_SEND 返回的）
;        REF_STATE = 回填状态：0=超时 1=成功 -1=失败（**数值**变量，#DIM）
;        REF_TEXT  = 回填文本（成功时的回复 / 失败时的原因）（**字符串**变量，#DIMS）
;
;  插件回填格式（**首字符是状态码**）：
;        "0"            = 仍在等待
;        "1" + 文本     = 成功
;        "-1" + 原因    = 失败
;  ⇒ 状态码用 SUBSTRING(…,0,1) 取；文本从第 2 个字符("1")或第 3 个字符("-1")起。
; ────────────────────────────────────────────────────────────────────────────
@LLM_POLL(LLM_REQ, REF_STATE, REF_TEXT)
#DIM    LLM_REQ
; ⚠️⚠️ 形参名以 REF_ 开头**不代表**引用传递！必须写 `#DIM REF 名`，
;      否则是值传递：函数里的修改**传不回调用方**。
#DIM    REF REF_STATE
#DIMS   REF REF_TEXT
#LOCALSIZE 4
#LOCALSSIZE 4
#DIMS   LLM_RAW      ; 插件回填的原始串
#DIM    LLM_WAIT     ; 累计等待毫秒
#DIM    LLM_TRIES    ; 轮询次数

REF_STATE = 0
REF_TEXT  = ""
LLM_WAIT  = 0
LLM_TRIES = 0
LLM_RAW   = "0"

WHILE 1
	AWAIT 80
	LLM_TRIES += 1
	CALLSHARP LLM_CHAT_POLL(LLM_REQ, LLM_RAW)

	; ⚠️⚠️ `SUBSTRING` **只能在 %…% 里当函数用**！
	;     写成 `LLM_X = SUBSTRING(A,0,1)` 不会调用它，而是把
	;     "SUBSTRING(A,0,1)" 这串**字面文本**赋给 LLM_X ——
	;     于是状态码永远不等于 "0"，循环第一轮就误判"已出结果"→秒超时。
	;     正确写法：`LLM_X = %SUBSTRING(A,0,1)%`
	LLM_DBG_ST = %SUBSTRING(LLM_RAW, 0, 1)%
	LLM_DBG_RAW = %LLM_RAW%
	LLM_DBG_WAIT = LLM_WAIT
	LLM_DBG_TRIES = LLM_TRIES

	; 收到结果就退出
	SIF LLM_DBG_ST != "0"
		BREAK

	; 仍在等待 → 累计耗时，超时放弃
	;  ⚠️ 上限 **30 秒**（2026-09-16 由 20 秒放宽）——
	;     实测服务端（CommandCode + deepseek-v4.1-Flash）正常回复要 **17~22 秒**，
	;     20 秒会让**快要回来的回复被放弃并重发**，玩家体感就是"等了两轮"⚠️
	;  ⚠️ 和插件的 `HttpTimeoutSeconds` **必须配套**：
	;     插件侧是 35 秒（略大于这里的 30），否则请求会在服务端侧被切断、
	;     而 ERB 还在空等 —— 两边的关系见 `LlmClient.cs` 顶上那段注释 ✓
	LLM_WAIT += 80
	SIF LLM_WAIT >= 30000
		BREAK
WEND

SIF LLM_DBG_ST == "1"
	REF_STATE = 1
SIF LLM_DBG_ST == "-"
	REF_STATE = -1
IF REF_STATE == 1
	REF_TEXT = %SUBSTRING(LLM_RAW, 1)%
ELSEIF REF_STATE == -1
	REF_TEXT = %SUBSTRING(LLM_RAW, 2)%
ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  取当前 persona 快照
; ────────────────────────────────────────────────────────────────────────────
;  用返回值判断有无剧本，并**先清空** RESULTS 系列 —— 它们是引擎临时变量，
;  角色没有对应项时不会被写入，会残留上一个角色的内容。
; ────────────────────────────────────────────────────────────────────────────
@LLM_PERSONA_SNAPSHOT(LLM_CID)
#DIM LLM_CID
#LOCALSIZE 1
#LOCALSSIZE 2

VARSET RESULTS
LLM_PERSONA      = ""
LLM_PERSONA_LBL  = ""
LLM_PERSONA_DESC = ""
LLM_PERSONA_SHOW = ""

CALL KOJO_ACTIVE_INFO(LLM_CID)
LLM_PERSONA_OK = RESULT
IF LLM_PERSONA_OK
	LLM_PERSONA      = %RESULTS%
	LLM_PERSONA_LBL  = %RESULTS:1%
	LLM_PERSONA_DESC = %RESULTS:2%
	LLM_PERSONA_SHOW = %LLM_PERSONA_LBL%
	SIF LLM_PERSONA_SHOW == ""
		LLM_PERSONA_SHOW = %LLM_PERSONA_DESC%
	SIF LLM_PERSONA_SHOW == ""
		LLM_PERSONA_SHOW = 初始
ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  把游戏自己的"语气维度"翻译成人话
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ 光靠 persona（剧本名 + 说明文字）**约束不住语气** ——
;     模型看不到那个角色"实际怎么说话"，只会用通用 AI 腔。
;
;  游戏自己一直维护着两个**语气维度**（逐角色设在 `CSV\Chara\Chara*.csv`）：
;
;    `CFLAG:角色:口調`（编号 391）—— 句尾风格，6 种：
;       0 = ～のよ系（女性化口语腔）   1 = ～です系（敬体）
;       2 = ～だよ系（直率常体）       3 = ～だぞ系（粗犷豪爽）
;       4 = ～のじゃ系（老人腔）       5 = 無口系（沉默寡言）
;       （取值与用途见 `COMF484 スイカ割り.ERB:893-912` 的 SELECTCASE；
;         角色 CSV 里也直接写了注释，如 `2;～だよ系`）
;
;    `CFLAG:角色:性格傾向`（编号 560）—— 2=強気系（强势）/ 4=真面目系（认真）
;       （见 `一般依頼16_お悩み相談.ERB:893-904` 的 `@性格傾向語尾`）
;
;  把它翻成自然语言塞进 prompt，比写一堆"请符合角色性格"有效得多。
;  主 prompt 与**拒绝台词**共用这个函数，保证两处语气一致。
; ────────────────────────────────────────────────────────────────────────────
@LLM_TONE_OF(LLM_CID, REF_TONE)
#DIM  LLM_CID
#DIMS REF REF_TONE

REF_TONE = ""
SELECTCASE CFLAG:(LLM_CID):口調
	CASE 0
		REF_TONE = "女性化的口语腔：句尾常带「～哦」「～呢」「～啦」这类语气词，随性自然"
	CASE 1
		REF_TONE = "礼貌的敬体：说话有礼貌，句尾偏「～呢」「～吧」「～吗」，但不卑不亢"
	CASE 2
		REF_TONE = "直率的常体：说话干脆利落，不用敬语，怎么想就怎么说"
	CASE 3
		REF_TONE = "粗犷豪爽的口吻：说话直白豪迈，带点江湖气，不拘小节"
	CASE 4
		REF_TONE = "老人口吻：自称偏「老身」这类，句尾带「～呐」「～噢」的古朴语感"
	CASE 5
		REF_TONE = "沉默寡言：话很少，多用短句、省略号和停顿，不爱多解释"
	CASEELSE
		REF_TONE = "自然的口语"
ENDSELECT
; 性格倾向（目前只确证了 2 和 4 两个取值，其余不加描述 —— 宁缺勿错）
SIF CFLAG:(LLM_CID):性格傾向 == 2
	REF_TONE += @"；性格偏强势：嘴硬、不服输，被戳到会立刻顶回去"
SIF CFLAG:(LLM_CID):性格傾向 == 4
	REF_TONE += @"；性格认真：说话一本正经、爱讲道理，很少开玩笑"
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  组装 system prompt
; ────────────────────────────────────────────────────────────────────────────
;  刻意**不喂数值**，只喂"关系状态 / 态度 / 情绪"这类语义化结果 ——
;  数值对模型无意义，且容易被角色"报出来"。详见设计文档第 4 章。
; ────────────────────────────────────────────────────────────────────────────

@LLM_STRIP_PART(LLM_CID, LLM_WANT, REF_WHAT)
#DIM  LLM_CID
#DIMS LLM_WANT        ; 玩家想脱的那件（模型给的中文名 / 关键词）
#DIMS REF REF_WHAT    ; 回填：实际脱掉了什么（空 = 没脱成）
#LOCALSIZE 4
#LOCALSSIZE 4
#DIMS LLM_CW
#DIM  LLM_SLOT        ; ★ 正在处理的服装槽号
#DIM  LLM_IS_INNER    ; ★ 她想脱的是不是内衣（决定要不要检查分级）
; ── 槽分组（槽号见 `CSV\Equip.csv`）──
; ★ **上下装** —— 用户定："**上下装脱完才能脱内衣**"，所以分级**只看这一组** ✓
#DIM CONST LLM_BODY, 11 = 13, 14, 9, 10, 17, 16, 15, 12, 11, 18, 19
;   13 连衣裙 / 14 和服 / 9 体操服 / 10 紧身衣 / 17 上身衣服１ /
;   16 上身衣服２ / 15 裙子 / 12 下身衣服 / 11 裤子 / 18 外搭 / 19 其他１
; ★ **内衣** —— 必须上面那组全空才能碰 ✓
#DIM CONST LLM_INNER, 4 = 8, 7, 6, 5
;   8 胸罩(可敞) / 7 胸罩(不可敞) / 6 内裤(可挪) / 5 内裤(不可挪)
; ★ **全部可脱的槽**（匹配用）—— 含**鞋袜 / 配饰**（它们**不受分级限制**）✓
#DIM CONST LLM_ALL, 17 = 18, 2, 1, 22, 13, 14, 9, 10, 17, 16, 15, 12, 11, 3, 4, 19, 20
;   18 外搭 / 2 帽子 / 1 饰品 / 22 腕部 / 13 连衣裙 / 14 和服 / 9 体操服 /
;   10 紧身衣 / 17 上身衣服１ / 16 上身衣服２ / 15 裙子 / 12 下身衣服 /
;   11 裤子 / 3 鞋 / 4 袜子 / 19~20 其他
; ── ★★ **按玩家指定的那一件脱**（用户定案）──────────────────────────────
;  用户原话："**不要有自动脱衣，玩家通过输入决定要脱哪一件**"
;  ⇒ 所以这里**不再自己挑顺序** —— 只按 `LLM_WANT` 去匹配槽 ✓
;
;  分级（用户定："上下装脱完才能脱内衣，鞋袜和配饰不在这个限制内"）：
;    · **内衣**（胸罩 / 内裤）⇒ ★ **上下装还没脱完就拒绝** ✓
;    · **鞋袜 / 配饰** ⇒ **不受限制**，随时能脱 ✓
;  ⚠️ 分级在这里**兜底把关** —— prompt 里也说了，但**代码不能只靠模型自觉** ✓
;
;  ⚠️ 槽号来自 `CSV\Equip.csv`；匹配用**槽名 / 常见叫法**（`STRFIND`）✓
REF_WHAT = ""
SIF LLM_WANT == ""
	RETURN
SIF !EXISTFUNCTION(@"CLOTHNAME")
	RETURN
; ── ① 先判断她**想脱的到底是不是内衣** ⇒ 决定要不要检查分级 ──
LLM_IS_INNER = 0
SIF STRFIND(LLM_WANT, "胸罩") >= 0 || STRFIND(LLM_WANT, "内衣上") >= 0 || STRFIND(LLM_WANT, "上半身内衣") >= 0
	LLM_IS_INNER = 1
SIF STRFIND(LLM_WANT, "内裤") >= 0 || STRFIND(LLM_WANT, "内衣下") >= 0 || STRFIND(LLM_WANT, "下半身内衣") >= 0 || STRFIND(LLM_WANT, "胖次") >= 0
	LLM_IS_INNER = 1
; ── ② 内衣 ⇒ **上下装必须全脱完**（用户定的分级）✓ ──
IF LLM_IS_INNER
	FOR LOCAL, 0, 13
		LLM_SLOT = LLM_BODY:LOCAL
		SIF EQUIP:(LLM_CID):LLM_SLOT
			RETURN          ; ★ 上下装还在 ⇒ **拒绝**（回填空串，调用方会给她一句拒绝）
	NEXT
ENDIF
; ── ③ 按名字找槽：先试内衣，再试外衣/鞋袜/配饰 ──
FOR LOCAL, 0, 4
	LLM_SLOT = LLM_INNER:LOCAL
	SIF !EQUIP:(LLM_CID):LLM_SLOT
		CONTINUE
	LLM_CW = %CLOTHNAME(LLM_SLOT, EQUIP:(LLM_CID):LLM_SLOT, LLM_CID)%
	; ⚠️ 双向匹配：玩家可能说"胸罩"而她这件叫"粉色胸罩" ✓
	SIF STRFIND(LLM_CW, LLM_WANT) < 0 && STRFIND(LLM_WANT, LLM_CW) < 0
		CONTINUE
	EQUIP:(LLM_CID):LLM_SLOT = 0
	REF_WHAT = @"%LLM_CW%"
	RETURN
NEXT
FOR LOCAL, 0, 17
	LLM_SLOT = LLM_ALL:LOCAL
	SIF !EQUIP:(LLM_CID):LLM_SLOT
		CONTINUE
	LLM_CW = %CLOTHNAME(LLM_SLOT, EQUIP:(LLM_CID):LLM_SLOT, LLM_CID)%
	SIF STRFIND(LLM_CW, LLM_WANT) < 0 && STRFIND(LLM_WANT, LLM_CW) < 0
		CONTINUE
	EQUIP:(LLM_CID):LLM_SLOT = 0
	REF_WHAT = @"%LLM_CW%"
	RETURN
NEXT
; 没匹配上（她没穿那件 / 名字对不上）⇒ 空串 ✓
RETURN




; ── ★★ 「最爱」的 roll ──
;  用户设计："第一次揉胸或者第一次接吻的合意在自由对话内出现时，roll 一次是否为最爱"
;  ⚠️ **每个行为只 roll 一次**（靠 `LLM_FAVROLL` 的位标志记住）✓
;  ⚠️ 但**不同行为各 roll 一次** ⇒ 后来的中了会**顶掉**前面的（`LLM_FAV` 直接覆盖）✓
;  ⚠️ 概率：每个行为 **25%** —— 用户没指定，我先取这个值（6 个行为下来
;     至少中一个的概率约 82%）⇒ **想改就改这一行** ✓
@LLM_FAV_ROLL(LLM_CID, LLM_ACT)
#DIM LLM_CID
#DIM LLM_ACT
#DIM LLM_BIT          ; ★ 位号中转（避免"带表达式的参数"）
; 行为代码合法性（1~6）
SIF LLM_ACT < 1 || LLM_ACT > 7
	RETURN 0
; ⚠️ `LLM_FAVROLL` 的 bit0 对应 act 1 ⇒ 位号 = act - 1
;  ⚠️⚠️ **位号先算进普通变量再用** —— 项目里有"带表达式的参数不可靠"的记录
;     （`MARK:(CID):反発刻印` 那次）。多写一行，但一定对 ✓
LLM_BIT = LLM_ACT - 1
SIF GETBIT(LLM_FAVROLL:(LLM_CID):0, LLM_BIT)
	RETURN 0                    ; ★ 已经 roll 过了 —— 「只有一次机会」✓
; 标记"这个行为已经 roll 过"（无论中不中，都只有这一次）
SETBIT LLM_FAVROLL:(LLM_CID):0, LLM_BIT
; ★ 掷骰：25% 成为（新的）最爱
SIF RAND:100 >= 25
	RETURN 0
LLM_FAV:(LLM_CID):0 = LLM_ACT    ; ★ 直接覆盖 —— 后来的可以顶掉前面的 ✓
RETURN 1                       ; ★ 返回值 = "这次中了"（调用方用来给提示 / 加成）


; ── ★★ **给一个固定收益加 ±20% 的随机浮动** ──
;  用户要求："我们把固定加的好感度和信赖值也改成浮动吧"
;  ⚠️ 理由：固定值玩起来"手感发死" —— 每次摸都涨一样多，不像真人反应 ✓
;  ⚠️ **下限 1**：浮动不能把正收益浮成 0 或负数（那会变成"摸了白摸"）✓
;  ⚠️ 只用于**收益**（好感/信赖/情绪）；**欲求不满 / 理性**是百分比，不浮 ✓
;  ⚠️ 是 `#FUNCTION`（表达式调用），参数**值传递**，可以直接改 ✓
@LLM_VARY(LLM_V)
#FUNCTION
#DIM LLM_V
; 非正数原样返回（0 就还是 0，负收益也照样浮动）
SIF LLM_V == 0
	RETURNF 0
; 幅度 = 绝对值的 20%（至少 1）
LLM_V = LLM_V + RAND:(ABS(LLM_V) * 2 / 5 + 1) - ABS(LLM_V) / 5
; ⚠️ 本来是**正收益**的，浮动后不能 <= 0
SIF LLM_V < 1
	RETURNF 1
RETURNF LLM_V


