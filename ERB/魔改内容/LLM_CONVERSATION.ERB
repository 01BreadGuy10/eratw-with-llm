	SIF REF_OUT != ""
		REF_OUT += "　"
	REF_OUT += @"胸罩：%LLM_CW%"
ENDIF
LLM_CW = %ADD_CHECK_CLOTHES(LLM_CID, "PANTIES")%
IF LLM_CW != ""
	SIF REF_OUT != ""
		REF_OUT += "　"
	REF_OUT += @"内裤：%LLM_CW%"
ENDIF
RETURN


; ── ★★ 官方的「角色介绍 / 性格 / 人际关系」（照抄官方数据源）──
;  ⚠️ 介绍文用 `CSVCSTR`（官方自己就是这么做）✓
@LLM_CHARA_INTRO(LLM_CID, REF_OUT)
#DIM  LLM_CID
#DIMS REF REF_OUT
#LOCALSIZE 4
#LOCALSSIZE 4
#DIM  LLM_IDX
#DIMS LLM_NOTE_TXT
;  ⚠️⚠️ **字符串必须用 `#DIMS` 变量装** —— 之前写成 `LOCAL:1`，
;     那是**数值数组** ⇒ 报 Lv2「无法对数值型和字符串型使用二相运算符」⚠️
REF_OUT = ""
FOR LLM_IDX, 10, 20
	SIF CFLAG:(LLM_CID):面識 == 0
		BREAK
	LLM_NOTE_TXT = %CSVCSTR(NO:(LLM_CID), LLM_IDX)%
