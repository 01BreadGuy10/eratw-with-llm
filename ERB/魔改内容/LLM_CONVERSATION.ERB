; ════════════════════════════════════════════════════════════════════════════
;  ⚠️⚠️ **以下 8 个函数是 2026-09-16 事故后重建的** ——
;  文件被误截断，前 2100 行丢失；核心部分从 9/14 备份合并回来，
;  但**今天新加的这些函数备份里没有**，所以按记忆重写。
;  ⚠️ 行为大体一致，但**细节措辞可能与原版有差异**。
; ════════════════════════════════════════════════════════════════════════════

; ── 从模型回复里抠出 ###MEMO### 那一行（没有就返回空串）──
;  同时解析开头的 `[N]` 重要度（1~5）
@LLM_PARSE_MEMO(REF_TEXT, REF_MEMO, REF_W)
#DIMS REF REF_TEXT
#DIMS REF REF_MEMO
#DIM  REF REF_W
#LOCALSIZE 4
#LOCALSSIZE 4
#DIMS LLM_P, 2
REF_MEMO = ""
REF_W = 0
SIF STRFIND(REF_TEXT, "###MEMO###") < 0
	RETURN
SPLIT REF_TEXT, "###MEMO###", LLM_P
SPLIT LLM_P:1, "\n", LLM_P
; ★ 统一净化（去引号/括号 + TRIM + 判空）—— 见 `@LLM_CLEAN_VALUE` ✓
;  ⚠️ 放在解析 `[N]` 重要度**之前**：先去掉引号，`[5]` 才不会被当成内容 ✓
CALL LLM_CLEAN_VALUE(LLM_P:0, REF_MEMO)
SIF REF_MEMO == ""
	RETURN
; ⚠️⚠️ **必须 `IF/ENDIF`**：`SIF` 只绑紧随的一行 ⇒
;    写 `SIF ... / 赋值 / RETURN` 会让 **`RETURN` 无条件执行**（项目栽过多次）⚠️
; ⚠️⚠️ 阈值放宽到 120（同上，2026-09-16）—— 原来 40 字节 ≈ 13 个汉字，
;    稍微长一点的记忆（带地点的身份、一句约定）就会被丢掉 ⚠️
IF STRLENS(REF_MEMO) > 120
	REF_MEMO = ""
	RETURN
ENDIF
IF STRLENS(REF_MEMO) >= 4 && SUBSTRING(REF_MEMO, 0, 1) == "["
	LOCAL = STRFIND(REF_MEMO, "]")
	IF LOCAL > 1 && LOCAL <= 4
		LLM_P:0 = SUBSTRING(REF_MEMO, 1, LOCAL - 1)
		REF_W = TOINT(LLM_P:0)
		REF_MEMO '= SUBSTRING(REF_MEMO, LOCAL + 1, STRLENS(REF_MEMO) - LOCAL - 1)
		REF_MEMO '= TRIM_STRING(REF_MEMO)
		REF_W = LIMIT(REF_W, 1, 5)
	ENDIF
ENDIF
; ⚠️ 剥掉 `[N]` 之后**也可能变空**（模型只写了 `[5]`）⇒ 再判一次空 ✓
;    否则会存下一条"有重要度、没内容"的垃圾记忆
SIF REF_MEMO == ""
	RETURN
RETURN


; 把一条记忆存进该角色的持久槽位（32 槽，按重要度决定保留）
;  ⚠️ **新增：同类替换**（2026-09-16 按用户反馈加）——
;     用户的例子：「**我现在叫美铃姐，后面又叫姐姐了**」⇒
;     原来只会**再存一条**，旧的永远留着 ⇒ **冗余记忆**（`[6]` 里两条矛盾的叫法）⚠️
;  ⇒ 做法：新增的记忆如果命中了某个"同类标签"，**先把旧的同类条目清掉**再存 ✓
;  ⚠️ **由代码清，不靠模型自律**（用户没提、但我加的理由）：
;     模型每次写记忆都要它自己记得去清旧的 —— 那是**又一个"只做一半"**的坑；
;     代码清是**确定性的**，一次搞定 ✓
; ── ★ 这条记忆是不是"过了语义门槛"的（⇒ 免骰 ⇒ 一定会存下）──
;  用户定（2026-09-16）：称呼 / 身份 **不经掷骰**（她答应了就是答应了，
;  系统不该再按关系筛一次）；只有"共同经历"那种才由存储骰决定 ✓
;  ⚠️⚠️ **判据只此一处** —— 调用方（提示显示）和 `@LLM_MEMO_ADD`（是否掷骰）
;     都调它，避免"两处判据不同源"（那个坑本项目栽过多次）⚠️
; ── ★ 这条记忆**是不是已经记过了**（`RESULT`：1 = 已经有了）──
;  ⚠️ 用途：**决定要不要给玩家提示** —— 已经有的就别再提示一次
;     （用户实测过：「每次跟她对话都会出现（她记住了你说的事）」）✓
;  ⚠️⚠️ **必须定义**：`CALL` 一个没注册的函数在 ERB 里**不执行也不报错**，
;     但 `RESULT` 会保留**上一次调用的残留值** ⇒ 会误判成"已经有了" ⚠️
@LLM_MEMO_EXISTS(LLM_CID, LLM_TEXT)
#DIM  LLM_CID
#DIMS LLM_TEXT
#LOCALSIZE 2
#DIM  LLM_EXI
#DIM  LLM_MIX
SIF LLM_TEXT == ""
	RETURN 1
LLM_EXI = 0
FOR LOCAL, 0, LLM_MEMO_CNT:(LLM_CID):0
	LLM_MIX = LOCAL
	SIF LLM_MEMO:(LLM_CID):LLM_MIX == LLM_TEXT
		LLM_EXI = 1
	SIF LLM_EXI
		BREAK
NEXT
RETURN LLM_EXI


@LLM_MEMO_GATE(LLM_TEXT)
#DIMS LLM_TEXT
#FUNCTION
#LOCALSIZE 2
SIF STRFIND(LLM_TEXT, "叫我") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "管我叫") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "喊我") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "叫他") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "称呼") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "自报身份") >= 0
	RETURNF 1
SIF STRFIND(LLM_TEXT, "自称") >= 0
	RETURNF 1
RETURNF 0


@LLM_MEMO_ADD(LLM_CID, LLM_TEXT, LLM_W)
#DIM  LLM_CID
#DIMS LLM_TEXT
#DIM  LLM_W
#LOCALSIZE 8
#LOCALSSIZE 4
#DIM  LLM_MEMO_CHANCE
#DIM  LLM_MEMO_IDX
#DIMS LLM_MEMO_TMP
; ★★ **自由互动不写持久记忆**（2026-09-21 用户要求）——
;   用户原话：「不要让自由互动系统走和对话系统相同的路径
;             自由互动的一些东西不应该被存放到持久记忆里」
;   ⚠️ 在这里**一刀切**最可靠 —— 逐个写点加守卫会漏掉
;      `LLM_MEMO_CNT ++` 和 `LLM_MEMO_W` ⇒ 留下空槽 ⚠️
SIF LLM_MODE == 1
	RETURN
SIF LLM_TEXT == ""
	RETURN
LLM_W = LIMIT(LLM_W, 0, 5)
SIF LLM_W == 0
	LLM_W = 3
; ══ ★★ **同类替换**：先定出这条记忆属于哪一类，再把旧的同类清掉 ══
;  ⚠️ 两类**必须分开判**（方向相反，清错了就把另一件事删了）：
;     · 「他叫我」= 他对她的称呼   · 「我叫他」= 她对玩家的称呼
;  ⚠️ 判据用 `STRFIND` 找关键词，**和 `@LLM_CALLME_SHOW` 同一套词**（判据同源）✓
;  ⚠️ 顺序要紧：**先判定 + 清旧，再掷骰** ——
;     否则掷骰没中就 RETURN 了，旧的已经清掉却什么都没存 ⇒ **记忆净损失** ⚠️
LLM_MEMO_IDX = 0          ; 复用：0 = 不是同类，1 = 他叫她，2 = 她叫他，**3 = 他自报的身份**
	; ★★ 第 3 类：**他自报的身份**（2026-09-18 用户发现漏了）——
	;    ⚠️ 身份**会变**（先当佣人、后当食客）⇒ 必须**新的顶掉旧的**，
	;       否则会留下两条矛盾的记忆 ⇒ 她下次可能自相矛盾 ⚠️
	SIF STRFIND(LLM_TEXT, "自报身份") >= 0
		LLM_MEMO_IDX = 3

SIF STRFIND(LLM_TEXT, "叫我") >= 0
	LLM_MEMO_IDX = 1
SIF STRFIND(LLM_TEXT, "管我叫") >= 0
	LLM_MEMO_IDX = 1
SIF STRFIND(LLM_TEXT, "喊我") >= 0
	LLM_MEMO_IDX = 1
; ⚠️⚠️ **必须 `IF/ENDIF`** —— `SIF` 的下一行不能是 `SIF`
;     （自查第 11 项抓到；游戏会报「SIF的下一行"SIF"不能作为作用域」⚠️）
IF STRFIND(LLM_TEXT, "叫我") < 0 && STRFIND(LLM_TEXT, "管我叫") < 0 && STRFIND(LLM_TEXT, "喊我") < 0
	; ⚠️ 只有**没命中「他叫她」**时才看「她叫他」——
	;    「他喜欢被我叫姐姐」这种句子两个都含，方向由这里定 ✓
	SIF STRFIND(LLM_TEXT, "叫他") >= 0
		LLM_MEMO_IDX = 2
ENDIF
IF LLM_MEMO_IDX > 0
	; ⚠️ 只清**同类**的旧条目（方向相反的两类不能混清）✓
	FOR LOCAL, 0, LLM_MEMO_CNT:(LLM_CID):0
		LLM_MEMO_TMP = %LLM_MEMO:(LLM_CID):LOCAL%
		SIF LLM_MEMO_TMP == ""
			CONTINUE
		IF LLM_MEMO_IDX == 1 && STRFIND(LLM_MEMO_TMP, "叫我") >= 0
			LLM_MEMO:(LLM_CID):LOCAL = ""
		ENDIF
		IF LLM_MEMO_IDX == 2 && STRFIND(LLM_MEMO_TMP, "叫他") >= 0
			LLM_MEMO:(LLM_CID):LOCAL = ""
		ENDIF
		; ★ 第 3 类：他自报的身份（同类 ⇒ 清旧的）✓
		IF LLM_MEMO_IDX == 3 && STRFIND(LLM_MEMO_TMP, "自报身份") >= 0
			LLM_MEMO:(LLM_CID):LOCAL = ""
		ENDIF
	NEXT
ENDIF
; ══ ★★★★ **"已经过语义门槛"的事实 ⇒ 不再掷存储骰**（2026-09-16 用户指正）══
;  用户的指正（**整体框架层面的**，不是小修）：
;     「称呼在写入之前**本身就已经经过了是否接受的判断**」
;  ⇒ 这些条目**有两道闸门**，我原来让它们**叠了两层随机**：
;      · 第一层（语义）：「她**要不要接受**这个称呼」——
;        提示词里已经按 轻/中/重 × 关系分界线 × 性格 判过了，
;        而且那判断**本身就是随机**的（"关系浅就推辞"）✓
;      · 第二层（存储）：我又按关系掷了一次骰决定"系统记不记得住" ⚠️
;     ⇒ 结果：**她明明答应了，系统还可能把这条扔掉** ⇒ 逻辑上不成立 ⚠️
;  ⇒ 正确分工：
;     · **已经有语义门槛的**（称呼 / 身份）⇒ 过了第一层就**无条件存**
;     · **没有语义门槛的**（"一起看了樱花"这类共同经历）⇒ 才由存储骰决定
;       "关系浅的话她不会把共处的时光放在心上" ✓
;  ⚠️ 判据就复用上面的同类标签 + 身份关键词 —— **不新增第二套机制** ✓
LLM_MEMO_IDX = 0          ; 0 = 无门槛（要掷骰），1 = 已经过语义门槛（免骰）
LLM_MEMO_IDX = LLM_MEMO_GATE(LLM_TEXT)
; ⚠️⚠️ **免骰类（身份 / 称呼）至少是重要度 3**（2026-09-16 兜底）——
;   实测：模型写 `[3]`，但 `[6]` 里显示成 `[1]` ⇒ `[N]` 解析在某环节丢了 ⚠️
;   而重要度不是装饰：**3 才走同类替换**，**1 会在记忆满时被优先覆盖** ⚠️
;   ⇒ 能过语义门槛的，直接抬到 3（和 prompt 里"这两类填 3"同源）✓
;  ⚠️⚠️ **但"拒绝"类除外**（2026-09-16 用户定：拒绝 = 1、接受 = 3）——
;     「我拒绝了他叫我姐姐」是**记账**（只用来判断"是不是明知故犯"），
;     不该和有长期价值的"接受"同等级 ✓
IF LLM_MEMO_IDX == 1 && LLM_W < 3
	IF STRFIND(LLM_TEXT, "拒绝") < 0
		LLM_W = 3
	ENDIF
ENDIF
LLM_MEMO_CHANCE = LLM_REL_RATE(LLM_REL_LEVEL(LLM_CID), 3)
; ⚠️ 重要度 5 = 永不丢（跳过掷骰）
; ⚠️ 以及：**过了语义门槛的也跳过掷骰**（见上面那段）✓
IF LLM_W < 5 && LLM_MEMO_IDX == 0
	SIF RAND:100 >= LLM_MEMO_CHANCE
		RETURN
ENDIF
FOR LOCAL, 0, LLM_MEMO_CNT:(LLM_CID):0
	SIF LLM_MEMO:(LLM_CID):LOCAL == LLM_TEXT
		RETURN
NEXT
; ⚠️ **优先填被清空的槽**（同类替换留下的空位）——
;    否则空槽会一直烂在中间，`LLM_MEMO_CNT` 也只增不减 ✓
LLM_MEMO_IDX = -1
FOR LOCAL, 0, LLM_MEMO_CNT:(LLM_CID):0
	IF LLM_MEMO:(LLM_CID):LOCAL == ""
		LLM_MEMO_IDX = LOCAL
		BREAK
	ENDIF
NEXT
IF LLM_MEMO_IDX >= 0
	LLM_MEMO:(LLM_CID):LLM_MEMO_IDX = %LLM_TEXT%
ENDIF
SIF LLM_MEMO_IDX >= 0
	LLM_MEMO_W:(LLM_CID):LLM_MEMO_IDX = LLM_W
SIF LLM_MEMO_IDX >= 0
	RETURN
IF LLM_MEMO_CNT:(LLM_CID):0 < 32
	LLM_MEMO_IDX = LLM_MEMO_CNT:(LLM_CID):0
	LLM_MEMO:(LLM_CID):LLM_MEMO_IDX = %LLM_TEXT%
	LLM_MEMO_W:(LLM_CID):LLM_MEMO_IDX = LLM_W
	LLM_MEMO_CNT:(LLM_CID):0 ++
ELSE
	; 满了：从最旧的开始找第一个"重要度 < 5"的槽覆盖
	LLM_MEMO_IDX = -1
	FOR LOCAL, 0, 32
		IF LLM_MEMO_W:(LLM_CID):LOCAL < 5
			LLM_MEMO_IDX = LOCAL
			BREAK
		ENDIF
	NEXT
	SIF LLM_MEMO_IDX < 0
		LLM_MEMO_IDX = 0
	LLM_MEMO:(LLM_CID):LLM_MEMO_IDX = %LLM_TEXT%
	LLM_MEMO_W:(LLM_CID):LLM_MEMO_IDX = LLM_W
ENDIF
RETURN


; 把该角色的持久记忆拼成一段文字（最多 12 条；重要度 5 优先）
@LLM_MEMO_SHOW(LLM_CID, REF_OUT)
#DIM  LLM_CID
#DIMS REF REF_OUT
#DIM  LLM_MN
#DIM  LLM_MI          ; ★ 下标中转（CHARADATA 变量不能写三层下标）
#LOCALSIZE 4
#LOCALSSIZE 2
#DIMS LLM_MEMO_TMP
REF_OUT = ""
SIF LLM_MEMO_CNT:(LLM_CID):0 <= 0
	RETURN
LLM_MN = 0
FOR LOCAL, 0, LLM_MEMO_CNT:(LLM_CID):0
	SIF LLM_MN >= 12
		BREAK
	SIF LLM_MEMO_W:(LLM_CID):LOCAL < 5
		CONTINUE
	SIF LLM_MEMO:(LLM_CID):LOCAL == ""
		CONTINUE
	; ⚠️⚠️ **跳过脏数据**（2026-09-16）——
	;   历史遗留：`LLM_IDW = "佣人"` 那种**裸 `=` 赋值**在 Emuera 里会得到
	;   **含引号的字面量**（铁律第 1 条）⇒ 早期存进去的条目长这样：
	;       `@"他自报身份："""` / `@"他自报身份："佣人""`
	;   ⚠️ 那些**已经写进存档了**，改代码救不回来 ⇒ **这里过滤掉，不让它显示** ✓
	;   （只在**显示/注入**时跳过，**不动存档数据** —— 安全 ✓）
	CALL LLM_MEMO_IS_DIRTY(LLM_CID, LOCAL)
	SIF RESULT
		CONTINUE
	SIF REF_OUT != ""
		REF_OUT += "；"
	LLM_MEMO_TMP = %LLM_MEMO:(LLM_CID):LOCAL%
	REF_OUT += @"%LLM_MEMO_TMP%"
	LLM_MN ++
NEXT
LOCAL:1 = LLM_MEMO_CNT:(LLM_CID):0 - 1
WHILE LOCAL:1 >= 0 && LLM_MN < 12
	LLM_MI = LOCAL:1
	IF LLM_MEMO_W:(LLM_CID):LLM_MI >= 5
		LOCAL:1 --
		CONTINUE
	ENDIF
	IF LLM_MEMO:(LLM_CID):LLM_MI == ""
		LOCAL:1 --
		CONTINUE
	ENDIF
	SIF REF_OUT != ""
		REF_OUT += "；"
	LLM_MEMO_TMP = %LLM_MEMO:(LLM_CID):LLM_MI%
	REF_OUT += @"%LLM_MEMO_TMP%"
	LLM_MN ++
	LOCAL:1 --
WEND
RETURN


; ⚠️ **`@LLM_ADDR_SHOW` 已删除**（2026-09-16 方案 B）——
;    它读的是废弃槽 `LLM_ADDRESS`；身份现在是一条 `###MEMO### [3]` 记忆，
;    由【你还记得关于他的事】那段统一注入，不需要这个取值函数了 ✓


; ⚠️⚠️ **`@LLM_CALLME_SHOW` 已删除并改为内联**（2026-09-16）——
;    它原来被当表达式调用（`IF LLM_CALLME_SHOW(LLM_CID) == ""`），
;    但**定义处忘了写 `#FUNCTION`** ⇒ 游戏报
;    `Lv2: 对未被标记为 #FUNCTION 的函数进行了行内函数形式的调用` ⚠️
;    它的逻辑**只在一处用**（`@LLM_BUILD_SYSTEM_PROMPT` 里那段 ②b 判据），
;    所以直接**内联**在那里了 —— 不给它加 `#FUNCTION`，
;    少一个需要维护标记的函数 ✓（和 `@LLM_DECIDE_ACTION` 里那段睡眠判定同一种做法）


; 取"上一场对话"的文本（没有就返回空串）
@LLM_PREV_SHOW(LLM_CID, REF_OUT)
#DIM  LLM_CID
#DIMS REF REF_OUT
#LOCALSIZE 8
#LOCALSSIZE 8
#DIM LLM_ABS          ; 记录里的**绝对分钟数**（DAY*1440 + TIME）
#DIM LLM_AGOM         ; 距今多少**分钟**
#DIM LLM_PD           ; 那次对话的 DAY 值（用来取日期）
#DIMS LLM_E           ; 原始记录
#DIMS LLM_WHEN        ; 时间措辞（"昨天" / "3 小时前"）
#DIMS LLM_MON         ; 月份名
#DIMS LLM_DAY         ; 日
#DIMS LLM_TM          ; 时刻（"15时20分"）
REF_OUT = ""
	; ★ 优先用总结（2026-09-20）—— 它代表整场，比「最后一句」信息量大 ✓
	;   ⚠️ 没有总结（还没预取 / 预取失败）才退回 LLM_PREV ✓
	LLM_E = %LLM_LUMSUM:(LLM_CID):0%
	SIF LLM_E == ""
		LLM_E = %LLM_PREV:(LLM_CID):0%
IF LLM_E == ""
	RETURN
ENDIF
; ★ 拆 `<绝对分钟>|<文本>`；旧格式（无竖线）当纯文本 ✓
LOCAL = STRFIND(LLM_E, "|")
IF LOCAL < 0
	REF_OUT = %LLM_E%
	RETURN
ENDIF
; ★ **逐位试**取数字 —— 旧数据开头可能有杂物，TOINT 不跳过它 ⚠️
LLM_ABS = TOINT(SUBSTRING(LLM_E, 0, LOCAL))
SIF LLM_ABS <= 0 && LOCAL >= 2
	LLM_ABS = TOINT(SUBSTRING(LLM_E, 1, LOCAL - 1))
SIF LLM_ABS <= 0 && LOCAL >= 3
	LLM_ABS = TOINT(SUBSTRING(LLM_E, 2, LOCAL - 2))
; ★ **兼容旧格式**（那时存的是 DAY 而不是绝对分钟）：值很小就当成天数 ✓
SIF LLM_ABS > 0 && LLM_ABS < 9999
	LLM_ABS = LLM_ABS * 1440
; ★ 那次对话是哪一天（绝对分钟 → DAY）
LLM_PD = LLM_ABS / 1440
; ★ 距今多少分钟（实时算，跨天也对）
LLM_AGOM = DAY * 1440 + TIME - LLM_ABS
SIF LLM_AGOM < 0
	LLM_AGOM = 0
; ★ 时间措辞（按分钟分档，比只按天数准得多）
LLM_WHEN = "有一阵子了"
SIF LLM_AGOM <= 20160
	LLM_WHEN = "大概一周前"
SIF LLM_AGOM <= 10080
	LLM_WHEN = "前几天"
SIF LLM_AGOM <= 4320
	LLM_WHEN = "前两天"
SIF LLM_AGOM <= 2880
	LLM_WHEN = "昨天"
SIF LLM_AGOM <= 1440
	LLM_WHEN = "今天早些时候"
SIF LLM_AGOM <= 360
	LLM_WHEN = "几小时前"
SIF LLM_AGOM <= 120
	LLM_WHEN = "刚才"
; ★ 日期：自己拼（游戏没有"年"的概念，那个函数会硬凑 0）⚠️
;   ⚠️ 取模**不能写进 %..%**（裸 % 会数不清）⇒ 先落到 LOCAL ✓
LOCAL:2 = DAY_TO_DATE(LLM_PD)
LOCAL:3 = LOCAL:2 % 1000 / 100
LOCAL:4 = LOCAL:2 % 100
LLM_MON = %GET_MONTH(LOCAL:3)%
LLM_DAY = %TOSTR(LOCAL:4)%
; ★ 时刻（那天是几点几分）
LOCAL:5 = LLM_ABS % 1440
LLM_TM = %時刻表示(LOCAL:5)%
; ★ 组装：让她一眼看出"上次是什么时候、隔了多久" ✓
REF_OUT = @"（%LLM_WHEN% —— 上次是%LLM_MON%%LLM_DAY%日 %LLM_TM%，周%GET_DAY_CN(LLM_PD)%"
REF_OUT += @"；距现在约 {LLM_AGOM / 60} 小时）"
REF_OUT += @"\n%SUBSTRING(LLM_E, LOCAL + 1)%"
RETURN
@LLM_AGREE_SHOW(LLM_CID, REF_OUT)
#DIM  LLM_CID
#DIMS REF REF_OUT
#LOCALSIZE 4
#LOCALSSIZE 4
#DIMS LLM_AN
REF_OUT = ""
FOR LOCAL, 1, 8
	SIF LLM_AGREE:(LLM_CID):LOCAL < 2
		CONTINUE
	CALL LLM_AGREE_NAME(LOCAL, LLM_AN)
	SIF LLM_AN == ""
		CONTINUE
	SIF REF_OUT != ""
		REF_OUT += "、"
	; ★★ **带上程度**（2026-09-19 修）——
	;   ⚠️ 原来只输出行为名（「牵手、拥抱」）⇒ 读起来像"试了一下" ⚠️
	;     而 `LLM_AGREE` 里有档位：2 = 接受 / 3 = 乐意 ⇒ 那才是"亲密"的证据 ✓
	IF LLM_AGREE:(LLM_CID):LOCAL >= 3
		REF_OUT += @"%LLM_AN%（很乐意）"
	ELSE
		REF_OUT += @"%LLM_AN%（接受了）"
	ENDIF
NEXT
RETURN


; ── ★★ **她现在的穿着** ──
@LLM_SHOW_CLOTHES(LLM_CID, REF_OUT)
#DIM  LLM_CID
#DIMS REF REF_OUT
#LOCALSIZE 4
#LOCALSSIZE 4
#DIMS LLM_CW
