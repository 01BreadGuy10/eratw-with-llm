		;   ⚠️ 那句在函数末尾才扣（④d），所以这里先减掉，免得进度条偏小 ⚠️
		;   （实测偏差约 4%：门番 3600，陪 15 分钟 = 150 点）
		LLM_TOGP = MAX(BASE:(LLM_CID):工作量 - LLM_ELAPSE * 10, 0) * 100 / MAXBASE:(LLM_CID):工作量
				; 同上：百分号用全角 ％（半角 % 会被当成插值分隔符）
				LLM_MSG += @"（你继续帮她%LLM_FANAME% %LLM_BARSTR(100 - LLM_TOGP, 10)% %TOSTR(100 - LLM_TOGP)%％）"
			ENDIF
		ENDIF
	ELSE
		; ── 自由行动模式 ──
		; ★★ **结束判据必须用「有效剩余时间」`@LLM_ACT_REMAIN`，
		;     不能用 `Activity_Duration`** ——
		;     ⚠️ 后者只在**回合末**由 `@CHARA_MOVEMENT` → `@自由行動処理`
		;        递减（`MOVEMENT.ERB:118`），而自由对话**不是一个回合**。
		;        直接拿它判"她做完了没有"，**永远为真** ⇒
		;        「（…结束了）」这一句**永远不会触发**，
		;        玩家会看到"陪了十几轮她还在运动"（这就是陪不到结束的真根因）。
		;     ✅ `@LLM_ACT_REMAIN` 会扣掉本场对话已经推进掉的时间。
		LLM_ALEFT = LLM_ACT_REMAIN(LLM_CID)
		IF LLM_ALEFT > 0
			; 她还在忙。⚠️ 但她可能**已经换了一件事**（上一件做完了、
			; 立刻开始下一件）—— 那样 `REF_TOGETHER` 里存的还是旧名字，
			; 会一直显示成"（看书的事告一段落）"之后又接着"看书"，
			; 让人以为"明明没完却说完了"。所以这里**跟着她更新模式名**。
			LLM_FANAME = %FreeAct_Name(LLM_CID)%
			SIF LLM_FANAME != "" && LLM_FANAME != REF_TOGETHER
				REF_TOGETHER = %LLM_FANAME%
			; ⚠️⚠️ 显示名要取**更新后的 `REF_TOGETHER`**，不能直接用刚取到的
			;     `FreeAct_Name` —— 两者对"发呆"是**不一样的**：
			;         · 建立陪伴时存的是「发呆」（见 ⓪b 的 `REF_TOGETHER = "发呆"`）
			;         · `@FreeAct_Name` 返回的却是「在思考什么」（那是游戏 UI 的名字，
			;           `FREE_ACT_0.ERB`）
			;     直接用后者会出现「（你陪着她**在思考什么**）」这种别扭说法。
			;     统一读 `REF_TOGETHER` ⇒ 显示名和模式名永远一致。
			LLM_FANAME = %REF_TOGETHER%
			SIF LLM_FANAME == ""
				LLM_FANAME = "那件事"
			; ★★ **陪着她也要推进时间** —— 这是"陪不到结束"的另一半原因。
			;  ⚠️ 运动的 `Activity_Duration` 是 `60 + RAND:60`（`FREE_ACT_5.ERB:48`），
			;     即 **60~119 分钟**；而自由行动分支原来**只靠 ④b 的 3 分钟/轮**，
			;     陪 4~8 轮也才攒 12~24 分钟 —— **永远做不完**。
			;  ✓ 和工作分支保持一致：15 分钟/轮（④b 已加过 3，这里补差额）。
			;  ⚠️ **不能超过实际剩余** —— 否则会"陪过头"，
			;     剩余 5 分钟却推进 15 分钟，帐就对不上了。
			;  ⚠️ 刻意**不在这里扣体力/气力**：陪着 ≠ 一起干，消耗只在建立陪伴
			;     那一次（⓪b）结算过；每轮再扣会变成无底洞。
			;  ⚠️ 也刻意**不重复跑 `"ソース"`**：那会连刷好感度（见上方的说明）。
			LLM_ELAPSE = MIN(15, LLM_ALEFT)
			TIME += MAX(LLM_ELAPSE - 3, 0)
			SIF LLM_MSG != ""
				LLM_MSG += "　"
			; ⚠️ 这里**不能**写「你陪着她一起%LLM_FANAME%」——
			;    `@FreeAct_Name` 对运动返回的**本来就带"一起"**（"一起做运动"，
			;    `FREE_ACT_5.ERB:16`），再加一个就成了"一起一起做运动"。
			LLM_MSG += @"（你陪着她%LLM_FANAME%）"
			; ★ 这一轮推进完**刚好到点** → 当场收尾，别让她"超时还在运动"。
			;   （上面已经按 `LLM_ALEFT` 限制了推进量，所以不会"陪过头"。）
			IF LLM_ACT_REMAIN(LLM_CID) <= 0
				Activity_Duration:(LLM_CID) = 0
				SIF LLM_MSG != ""
					LLM_MSG += "　"
				; ★ 统一走"结束登记"入口 —— 它负责拼消息 + 登记
				;   `LLM_JUST_ENDED`（留给下一轮 prompt，理由见那个函数的说明）。
				CALL LLM_MARK_END(LLM_MSG, LLM_FANAME, "")
				REF_TOGETHER = ""
			ENDIF
		ELSE
			; 她手头那件事**实际到点了**（有效剩余归零）。
			; ⚠️⚠️ 必须**把帐面也一起清零**：`Activity_Duration` 在自由对话中
			;     不会自己减少（递减在回合末），不清的话会出现"认知不一致" ——
			;     我们已经说「结束了」，但 prompt 里的
			;     【你现在正在做的事】仍然写着"正在运动"，她会继续演下去。
			;     清零之后游戏那边也一致（回合末 `MAX(0-N, 0)` 仍是 0，
			;     并且会正常触发官方 `"完了"` 分支）。
			;  ⚠️ 措辞用"结束了"而不是"做完了" ——
			;     自由行动到点结束 ≠ 事情完成（官方 `@自由行動処理` 走的是
			;     `"完了"` 分支，但那只是"这次行动结束"；
			;     工作那种有明确"工作量"的才是"干完了"）。
			;     说"做完了"在她其实只是时间到了的时候会显得莫名其妙；
			;     而"结束了"两者都能盖住，所以用它。
			Activity_Duration:(LLM_CID) = 0
			; ★ 同上：统一走"结束登记"入口
			CALL LLM_MARK_END(LLM_MSG, LLM_TGKIND, "")
			REF_TOGETHER = ""
		ENDIF
	ENDIF
ENDIF


	; ══ ⓪c ★★ **轻微身体接触**（模型填 t=5）══════════════════════════════════
	;  ⚠️⚠️ **整套数值照抄官方 `COMF302 スキンシップ`**（"身体接觸"指令）——
	;     判据同源是这条项目的铁律：官方改平衡，我们自动跟着改。
	;
	;  用户的实际结算截图证实了这条链：
	;    情爱/露出/欢乐/征服/被动 + 双方气力-30 + 时间+10
	;    以及 PALAM 侧：恭顺/情欲/屈服/羞耻/好意/优越/反感
	;
	;  ⚠️ **先照抄 `@COM_ABLE302` 的前置条件** —— 不满足就当没发生：
	;     睡着 / 陪睡中 / 工作中 / 玩家气力 0 / 停止中，全都不行。
	;  ⚠️ 还有官方的**1 小时间隔**（记在 `TCVAR:303`），约会中豁免。
	;     不检查的话，模型每轮都填 5 就能刷好感。
