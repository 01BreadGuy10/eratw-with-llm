REF_PROMPT += @"\n   本轮唯一主行动：%LLM_ACT_TXT%"
ENDIF
REF_PROMPT += @"\n   ★ 当前场景卡优先于历史中冲突的地点、时间、天气、行动和意识状态。"
REF_PROMPT += @"\n   ★ 这些是理解场景的事实，不是要逐条念出的清单；只自然体现最相关的一两项。"
REF_PROMPT += @"\n   ★ 先从当前地点、当前意识/身体状态入手，再回应玩家刚才的输入。"
REF_PROMPT += @"\n   ★ 不要自行推进玩家没有做出的下一步，不要替玩家说话，不要解释规则。"
IF LLM_MODE == 1
REF_PROMPT += @"\n   ★ 互动回复中：动作/环境/身体反应用（），角色说话用「」；两者放在同一条回复里。"
ENDIF
; ════════════════════════════════════════════════════════════════════════
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  清洗模型输出
; ────────────────────────────────────────────────────────────────────────────
;  模型常带回引号、换行、以及"角色名："之类前缀，这里统一去掉。
;
;  ⚠️ 必须 `#DIMS REF REF_TEXT`：光把形参起名叫 REF_TEXT 没有用，
;     漏了 REF 就是值传递，函数里这一堆 REPLACE 的结果**传不回调用方**，
;     等于清洗从来没生效过（模型带的引号/换行会原样显示）。
;
;  ⚠️⚠️ 而且赋值必须用 `'=`（字符串**表达式**赋值），不能写 `REF_TEXT = REPLACE(...)`！
;     本作里字符串函数**裸写在 `=` 右侧不会被调用**，只会把 "REPLACE(...)" 这段
;     **表达式原文**赋给变量。原来这 14 行全是 `=`，因为同时漏了 REF（结果传不回来）
;     才没暴露；一旦补上 REF，它们立刻生效并把台词替换成字面文本
;     —— 实测台词直接显示成「REPLACE(REF_TEXT, "  ", " ")」。
;     规则见 LLM_ERB语法避坑.md 第 5e/5f 条：
;     **字符串函数只能出现在 `%…%` 内，或者用 `'=` 接**。
; ────────────────────────────────────────────────────────────────────────────
; ────────────────────────────────────────────────────────────────────────────
;  ★★ 约会总结（2026-09-19 新增）
; ────────────────────────────────────────────────────────────────────────────
;  在**约会结束时**（`IS_DATING_WITH_PLAYER` 由真变假）发一次独立请求，
;  让她用一句话总结这次约会 ⇒ 存进 `LLM_DATELOG` ⇒ 清历史 ✓
;
;  ⚠️ 为什么结束时才总结：约会期间消息记录**无限保留**（插件按角色存），
;     全部留着会撑爆上下文 ⇒ 总结一次、然后清掉，才可持续 ✓
;  ⚠️ `LLM_CHAT_SEND` 的第 4 参数传 **0** = **不记进历史**
;     （这是系统行为，不该污染对话记录；而且紧接着就要清）✓
;  ⚠️ **顺序不能错**：先拿到总结并**存好**，**再**清历史 ——
;     反过来会把要总结的内容先删掉 ⚠️
; ────────────────────────────────────────────────────────────────────────────
;  ★★ 开场前预取「本次态度 + 上一场总结」（2026-09-20 用户要求）
; ────────────────────────────────────────────────────────────────────────────
;  用户原话：「我想要这次的开场白也结合上次总结和本次态度发送 可以做到吗」
;
;  ⚠️ 为什么要单独发一次：态度的 prompt 原来是**和台词一起**要在同一条回复里的，
;     所以模型是"先说台词、再定态度" ⇒ **开场白永远用不上本次态度** ⚠️
;     这里把它拆出来**先要**，存进变量，开场白那轮组装 prompt 时就带上了 ✓
;
;  ⚠️ `record = 0`：这是**系统行为**，不该进对话历史（否则玩家会看到一句
;     "回忆一下"的怪话）✓
;  ⚠️ 失败（超时 / 报错）就**静默跳过** —— 宁可开场白少一层依据，
;     也不能把开场卡住 ✓
@LLM_PRESESSION(LLM_CID)
#DIM  LLM_CID
#LOCALSIZE 8
#LOCALSSIZE 8
#DIM  LLM_REQ
#DIM  LLM_STATE
#DIMS LLM_SYS
#DIMS LLM_OUT
#DIMS LLM_TMP
#DIMS LLM_ATT      ; 本次态度
#DIMS LLM_SUM      ; 上一场总结
LLM_SYS = @"你在扮演东方Project同人游戏《eraTW》里的角色。"
LLM_SYS += @"\n【角色】%CALLNAME:(LLM_CID)%"
LLM_SYS += @"\n【任务】你马上要和玩家开始一段新的对话。开口之前，先把两件事想清楚。"
LLM_SYS += @"\n  ① 你现在对他是什么态度（会决定你这一整场的语气）"
LLM_SYS += @"\n  ② 你们上一次聊了什么（一句话概括）"
; ★ 把"上一次的片段"给她看 —— 它就在 LLM_PREV 里（带时间戳，@LLM_PREV_SHOW 会格式化）
	; ⚠️ **不要带「上一次的片段」**（2026-09-20 用户报告）——
	;   那正是**上一次的总结** ⇒ 模型会把它当材料 ⇒ 旧事被写进新总结 ⚠️
	;   （实测：很早的「他说想亲我」被和新的「膝枕」混在一起）
	; ⇒ 只用**本场的原始台词**当材料 ✓
	SIF LLM_CHATRAW:(LLM_CID):0 != ""
		LLM_SYS += @"\n【这一场你们聊过的】%LLM_CHATRAW:(LLM_CID):0%"
LLM_SYS += @"\n###ATTITUDE###<你对他的态度，第一人称，30 字内>"
LLM_SYS += @"\n###PREVSUM###<上次聊了什么，第一人称，40 字内>"
LLM_SYS += @"\n   · ⚠️ 没有「上次」就写「还没有聊过什么」✓"
LLM_SYS += @"\n   · ⚠️ 两句都像**内心独白**，别写成数据或汇报 ✓"
CALLSHARP LLM_CHAT_SEND(LLM_CID, LLM_SYS, "（回想一下，然后准备开口。）", 0, LLM_TMP)
	; ⚠️⚠️ **必须把请求 id 接出来**（2026-09-20 修）——
	;   漏了这步的话 `LLM_REQ` 是**旧值** ⇒ `@LLM_POLL` 问的是上一个请求 ⇒
	;   **立即返回** ⇒ 总结永远拿不到 ⚠️（实测：id=10 发了但从未收到结果）
	IF TOINT(LLM_TMP) <= 0
		RETURN
	ENDIF
	LLM_REQ = TOINT(LLM_TMP)
CALL LLM_POLL(LLM_REQ, LLM_STATE, LLM_OUT)
; ⚠️ 失败就跳过，不阻塞开场
SIF LLM_STATE != 1
	RETURN
; ★ 解析两个标记
CALL LLM_PARSE_NOTE(LLM_OUT, "###ATTITUDE###", LLM_ATT)
CALL LLM_PARSE_NOTE(LLM_OUT, "###PREVSUM###", LLM_SUM)
; ★ 存进变量（门槛 4 字节 = 2 个中文字，挡住空值）✓
IF STRLENS(LLM_ATT) >= 4
	; ★ **自由互动不写持久数据**（2026-09-21 用户要求）✓
	SIF LLM_MODE == 0
	LLM_ATTITUDE:(LLM_CID):0 '= @"%LLM_ATT%"
ENDIF
IF STRLENS(LLM_SUM) >= 4
	; ★ 总结存进独立槽（2026-09-20）——
	;   ⚠️ 不能存 LLM_PREV：那个被 @LLM_PRINT_REPLY 每轮覆盖成台词 ⚠️
	;   ⇒ 总结刚写进去就被开场白冲掉了 ✓
	; ★ **自由互动不写持久数据**（2026-09-21 用户要求）✓
	SIF LLM_MODE == 0
	LLM_LUMSUM:(LLM_CID):0 '= @"{DAY * 1440 + TIME}|%LLM_SUM%"
ENDIF
RETURN


@LLM_DATE_SUMMARY(LLM_CID)
#DIM  LLM_CID
#LOCALSIZE 8
#LOCALSSIZE 8
#DIM  LLM_REQ
#DIM  LLM_STATE
#DIMS LLM_SYS
#DIMS LLM_OUT
#DIMS LLM_TMP
#DIM  LLM_IDX        ; ★ 约会日志的写入下标（避免下标套娃）
LLM_SYS = @"你在扮演东方Project同人游戏《eraTW》里的角色。"
LLM_SYS += @"\n【角色】%CALLNAME:(LLM_CID)%"
LLM_SYS += @"\n【任务】刚才你和玩家的一次**约会结束了**。"
	; ★ **把完整记录给她看**（2026-09-20）——
	;   ⚠️ 对话历史可能已经溢出（只有 30 条）⇒ 用暂存槽里那份完整的 ✓
	SIF LLM_DATERAW:(LLM_CID):0 != ""
		LLM_SYS += @"\n【这次约会的完整对话记录】%LLM_DATERAW:(LLM_CID):0%"
	LLM_SYS += @"\n请**具体**回忆一下这次约会 —— 按**发生的顺序**写下来。"
	LLM_SYS += @"\n   · **2~3 句，合计 100 字以内**（别只写一句，那装不下）"
	LLM_SYS += @"\n   · 要写到这些（有多少写多少，别硬凑）："
	LLM_SYS += @"\n     **去了哪里 → 一起做了什么 → 聊了什么 / 发生了什么 → 你的感受**"
	LLM_SYS += @"\n   · **第一人称**，像自己心里回味（不是报告，也不是流水账）"
	LLM_SYS += @"\n   · ⚠️⚠️ **只写「真的发生了的事」** ——"
	LLM_SYS += @"\n     一起吃了饭 / 一起看了花 / 一起走了很远的路 ⇒ 这些可以写 ✓"
	LLM_SYS += @"\n     ⚠️ 但**不要**写「他说要给我买什么」「他答应带我去哪」这类"
	LLM_SYS += @"\n        **只是说过的计划** —— 那**没有真的发生**，写进去就是记错了 ⚠️"
	LLM_SYS += @"\n   · ⚠️ 真的没什么事发生，就写感受（「走了很久，聊得还算开心」）——"
	LLM_SYS += @"\n     **宁可短一点，也别编** ✓"
	LLM_SYS += @"\n   · 只输出那几句话，**不要**任何标记、引号、标题、或分段符号"
	LLM_SYS += @"\n   · ⚠️ 别说「这次约会」这种系统腔，就当是自己想的"
; ★ record = 0 ⇒ 不记进对话历史（系统行为）
CALLSHARP LLM_CHAT_SEND(LLM_CID, LLM_SYS, "（这次约会到这里就结束了。总结一下吧。）", 0, LLM_TMP)
	; ⚠️⚠️ **必须把请求 id 接出来**（2026-09-20 修）——
	;   漏了这步 ⇒ LLM_REQ 是旧值 ⇒ @LLM_POLL 立即返回 ⇒ 总结永远拿不到 ⚠️
	;   （实测：日志里只有 CHAT-SEND 没有对应的 CHAT-OK）
	IF TOINT(LLM_TMP) <= 0
		RETURN
	ENDIF
	LLM_REQ = TOINT(LLM_TMP)
CALL LLM_POLL(LLM_REQ, LLM_STATE, LLM_OUT)
; ⚠️ 失败就不存（别存空的/半截的）
SIF LLM_STATE != 1
	RETURN
CALL LLM_SANITIZE_REPLY(LLM_OUT)
; ★ 存进约会日志：格式 `<DAY>|<总结>`
; ★★ **满了就左移**（2026-09-19 修）——
;   ⚠️ 原来是把 `CNT` 归零、写回槽 0 ⇒ 槽的顺序变成**环形**，
;      而注入是"倒着取最后 3 条" ⇒ **会取到旧的、漏掉最新的** ⚠️
;   ⇒ 改成左移：槽 0 永远最旧、末尾永远最新 ✓
SIF LLM_DATELOG_CNT:(LLM_CID):0 > 8
	LLM_DATELOG_CNT:(LLM_CID):0 = 8       ; 防御：万一手滑写大了
IF LLM_DATELOG_CNT:(LLM_CID):0 >= 8
	FOR LOCAL, 0, 7
		LLM_DATELOG:(LLM_CID):LOCAL = %LLM_DATELOG:(LLM_CID):(LOCAL + 1)%
	NEXT
	LLM_DATELOG_CNT:(LLM_CID):0 = 7
ENDIF
; ⚠️ 下标**不能套娃**（会被解析成 3 层，而 CHARADATA 只允许 2 层）
;    ⇒ 先用局部变量接住 ✓
LLM_IDX = LLM_DATELOG_CNT:(LLM_CID):0
	LLM_DATELOG:(LLM_CID):LLM_IDX = @"{DAY * 1440 + TIME}|%LLM_OUT%"
LLM_DATELOG_CNT:(LLM_CID):0 ++
	; ★ **清空约会暂存**（2026-09-20）—— 已经总结过了，留着只会越攒越长 ✓
	LLM_DATERAW:(LLM_CID):0 = ""
RETURN

; ────────────────────────────────────────────────────────────────────────────
;  ★★ 约会日志注入（2026-09-19）
; ────────────────────────────────────────────────────────────────────────────
;  把 `LLM_DATELOG` 拼成一段文字给模型看。
;  ⚠️ 存储里只有 `<DAY 值>|<总结>` ⇒「距今」和「日期」都**实时算** ✓
;     （写死「7 天前」的话，过几天再看就错了 —— 用户明确指出的坑）
;  ⚠️ 最多给**最近 3 次**（再多会挤占 prompt，而且早年的她也记不清了）
@LLM_SHOW_DATELOG(LLM_CID, REF_OUT)
#DIM  LLM_CID
#DIMS REF REF_OUT
#LOCALSIZE 8
#LOCALSSIZE 8
#DIM LLM_N            ; 已用条数
#DIM LLM_I            ; 循环
#DIM LLM_D            ; 那条记录的**绝对分钟数**（DAY*1440 + TIME）
#DIM LLM_AGO          ; 距今多少分钟
#DIM LLM_PD           ; 那次的 DAY 值（取日期用）
#DIMS LLM_E           ; 一条原始记录
#DIMS LLM_T           ; 总结文本
#DIMS LLM_WHEN        ; 措辞
#DIMS LLM_MON         ; 月份名
#DIMS LLM_DAY         ; 日
#DIMS LLM_TM          ; 时刻
REF_OUT = ""
LLM_N = LLM_DATELOG_CNT:(LLM_CID):0
SIF LLM_N <= 0
	RETURN
; ★ **倒着取**（存的是从旧到新，注入要给最近的）—— 最多 3 条
LLM_I = LLM_N - 1
WHILE LLM_I >= 0 && LLM_I >= LLM_N - 3
	LLM_E = %LLM_DATELOG:(LLM_CID):LLM_I%
	IF LLM_E == ""
		LLM_I --
		CONTINUE
	ENDIF
	LOCAL = STRFIND(LLM_E, "|")
	IF LOCAL < 0
		LLM_I --
		CONTINUE
	ENDIF
	; ★ **逐位试**取数字（旧数据开头可能有杂物，TOINT 不跳过它）⚠️
	LLM_D = TOINT(SUBSTRING(LLM_E, 0, LOCAL))
	SIF LLM_D <= 0 && LOCAL >= 2
		LLM_D = TOINT(SUBSTRING(LLM_E, 1, LOCAL - 1))
	SIF LLM_D <= 0 && LOCAL >= 3
		LLM_D = TOINT(SUBSTRING(LLM_E, 2, LOCAL - 2))
	; ★ **兼容旧格式**（那时存的是 DAY）：值很小就当成天数 ✓
	SIF LLM_D > 0 && LLM_D < 9999
		LLM_D = LLM_D * 1440
	LLM_T = %SUBSTRING(LLM_E, LOCAL + 1)%
	; ★ 那次约会哪一天
	LLM_PD = LLM_D / 1440
	; ★ 距今多少分钟（实时算，跨天也对）
	LLM_AGO = DAY * 1440 + TIME - LLM_D
	SIF LLM_AGO < 0
		LLM_AGO = 0
	; ★ 按分钟分档措辞（和"上一次总结"同一套）✓
	LLM_WHEN = "有一阵子了"
	SIF LLM_AGO <= 20160
		LLM_WHEN = "大概一周前"
	SIF LLM_AGO <= 10080
		LLM_WHEN = "前几天"
	SIF LLM_AGO <= 4320
		LLM_WHEN = "前两天"
	SIF LLM_AGO <= 2880
		LLM_WHEN = "昨天"
	SIF LLM_AGO <= 1440
		LLM_WHEN = "今天早些时候"
	SIF LLM_AGO <= 360
		LLM_WHEN = "几小时前"
	; ★ 日期 + 时刻（取模不能写进 %..%，先落 LOCAL）⚠️
	LOCAL:2 = DAY_TO_DATE(LLM_PD)
	LOCAL:3 = LOCAL:2 % 1000 / 100
	LOCAL:4 = LOCAL:2 % 100
	LLM_MON = %GET_MONTH(LOCAL:3)%
	LLM_DAY = %TOSTR(LOCAL:4)%
	LOCAL:5 = LLM_D % 1440
	LLM_TM = %時刻表示(LOCAL:5)%
	SIF REF_OUT != ""
		REF_OUT += @"\n"
	; ★ 总结变长了（2~3 句）⇒ 换行 + 缩进，别挤成一大行 ✓
	REF_OUT += @"· %LLM_WHEN%（%LLM_MON%%LLM_DAY%日 %LLM_TM%）——"
	REF_OUT += @"\n   %LLM_T%"
	LLM_I --
WEND
RETURN
@LLM_SANITIZE_REPLY(REF_TEXT)
#DIMS REF REF_TEXT
#LOCALSIZE 4

; ★★ **标记兜底：从第一个 `###` 起全部截掉**（2026-09-16 加）——
;  ⚠️ `###DELTA###` / `###MEMO###` / `###ATTITUDE###` / `###PROMISE###` /
;     `###STRIP###` 都在**末尾**，台词在**前面** ⇒ 这一刀能保证"标记永远不被念出来" ✓
;  ⚠️ 正常情况 `@LLM_PARSE_DELTA` 已经截过一次了（它会把 `###DELTA###` 之后的全丢掉），
;     但**万一模型把别的标记写在它前面**，就会露出来 ⇒ 这里是**双保险** ✓
;  ⚠️⚠️ 必须放在"换行 → 全角空格"**之前** —— 否则多行标记会先被压成一行、
;     截断位置就不对了 ✓
LOCAL = STRFIND(REF_TEXT, "###")
SIF LOCAL >= 0
	REF_TEXT '= SUBSTRING(REF_TEXT, 0, LOCAL)

REF_TEXT '= REPLACE(REF_TEXT, "\n", "　")
REF_TEXT '= REPLACE(REF_TEXT, "\r", "")

REF_TEXT '= REPLACE(REF_TEXT, "「", "")
REF_TEXT '= REPLACE(REF_TEXT, "」", "")
REF_TEXT '= REPLACE(REF_TEXT, "『", "")
REF_TEXT '= REPLACE(REF_TEXT, "』", "")
REF_TEXT '= REPLACE(REF_TEXT, "“", "")
REF_TEXT '= REPLACE(REF_TEXT, "”", "")
; 半角双引号：模型也常用（实测台词里出现过 叫我"小姐"）。
; ERB 里写 \" 表示一个 " 字符，见 Omogatari_STR.ERB:2186 的 @"\"%ARGS%\""
REF_TEXT '= REPLACE(REF_TEXT, "\"", "")

REF_TEXT '= REPLACE(REF_TEXT, @"%CALLNAME:TARGET%：", "")
REF_TEXT '= REPLACE(REF_TEXT, @"%CALLNAME:TARGET%:", "")
REF_TEXT '= REPLACE(REF_TEXT, "角色：", "")
REF_TEXT '= REPLACE(REF_TEXT, "回答：", "")
REF_TEXT '= REPLACE(REF_TEXT, "助手：", "")

REF_TEXT '= REPLACE(REF_TEXT, "  ", " ")
; ⚠️ 本作没有 `TRIM`，去首尾空白是 `TRIM_STRING`（#FUNCTIONS）→ 用 `'=` 接返回值
REF_TEXT '= TRIM_STRING(REF_TEXT)
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  解析模型给出的「回合结算」数值块
; ────────────────────────────────────────────────────────────────────────────
;  约定格式（见 @LLM_BUILD_SYSTEM_PROMPT 的【回合结算】段）：
;
;       （角色台词）
;       ###DELTA###
;       1,2,-1
;          │ │ └─ 愤怒  c
;          │ └─── 情緒  b
;          └───── 好感度 a
;
;  本函数只负责**拆出来**（并把数值块从台词里抠掉）；
;  真正写进游戏数值、以及打印提示，交给 @LLM_APPLY_DELTA。
;  拆成两步的好处：中间可以照常打印台词，提示自然落在台词之后。
;
;  ⚠️ 全程只用局部变量，**不依赖任何 .ERH 全局变量**
;     （.ERH 全局变量在本项目有过"莫名失效"的前科，能避则避）。
;
;  参数：REF_TEXT   = 完整回复（会被抠掉数值块，只留台词）
;        REF_D1/2/3 = 回填三个增减值；解析失败时都是 0
;  返回值（调用方读 RESULT）：1 = 回复里**确实带了**结算块，0 = 没有
;        —— 有了这个标志，就能区分"模型给了 0,0,0"和"模型压根没给块"。
; ────────────────────────────────────────────────────────────────────────────
@LLM_PARSE_DELTA(REF_TEXT, REF_D1, REF_D2, REF_D3, REF_D4, REF_D5, REF_D6)
#DIMS REF REF_TEXT
#DIM  REF REF_D1
#DIM  REF REF_D2
#DIM  REF REF_D3
#DIM  REF REF_D4      ; 这句话的"性质"：0=普通 1=亲昵调情 2=露骨性骚扰 3/4=陪伴
#DIM  REF REF_D5      ; **信赖度**档位（0~2，平时为 0）—— 稀有加分项
#DIM  REF REF_D6      ; **行为代码**：1牵手/2拥抱/3接吻/4摸胸/5摸屁股/6摸下面/7脱衣服（0=无）
#LOCALSIZE 4
; ⚠️⚠️ 字符串槽要**把数组的长度算进去**：
;     `#DIMS LLM_PART, 4` 占 4 槽，`#DIMS LLM_NUM, 8` 占 **8 槽** ——
;     合计 **12**，而这里原来只给了 8，**是实打实的溢出**
;     （运行时可能报 Lv2，也可能只是让局部变量静默错乱，很难查）。
;     提到 20 留足余量。
#LOCALSSIZE 24
;  ⚠️ 槽位账（改这里必须重算）：
;     `LLM_PART, 4` = 4 槽，`LLM_NUM, 12` = **12 槽**，合计 **16**，留 8 余量 ✓
;     ⚠️ `LLM_NUM` 从 8 提到 12，是因为它现在**还兼作"按换行拆台词"的容器**
;        （见函数末尾"块在开头"的处理）—— 台词多行时 8 槽会溢出 ⚠️
#DIMS LLM_PART, 4
#DIMS LLM_NUM, 12

REF_D1 = 0
REF_D2 = 0
REF_D3 = 0
REF_D4 = 0
REF_D5 = 0
REF_D6 = 0

; 没有数值块 → 原样返回（失败安全：绝不猜数值）
SIF STRFIND(REF_TEXT, "###DELTA###") < 0
	RETURN 0

SPLIT REF_TEXT, "###DELTA###", LLM_PART

; 清掉数值段里的空白再拆数字。
; ⚠️ 必须清：@LLM_SANITIZE_REPLY 会把换行替成**全角空格**，
;    残留空白会让 TOINT 读不出数（全角空格不算合法的数字前缀）。
LLM_PART:1 '= REPLACE(LLM_PART:1, "　", "")
LLM_PART:1 '= REPLACE(LLM_PART:1, " ", "")
LLM_PART:1 '= REPLACE(LLM_PART:1, "\n", "")
LLM_PART:1 '= REPLACE(LLM_PART:1, "\r", "")
SPLIT LLM_PART:1, ",", LLM_NUM

REF_D1 = TOINT(LLM_NUM:0)
REF_D2 = TOINT(LLM_NUM:1)
REF_D3 = TOINT(LLM_NUM:2)
; 第 4 个字段（言论性质）是可选的：模型只给 3 个数时按"普通"处理。
; 这样即使模型没跟上新格式，对话也不会坏 —— 只是没有分级效果。
REF_D4 = TOINT(LLM_NUM:3)
; 第 5 个字段（信赖度）同样可选 —— 老格式（只给 4 个数）时 TOINT 读空串得 0，
; 正好等于"本轮不给信赖"，是安全的降级。
REF_D5 = TOINT(LLM_NUM:4)
; 第 6 个字段（行为代码）同样可选 —— 老格式只给 5 个数时读空串得 0，
; 正好等于"没有具体行为"，是安全的降级 ✓
REF_D6 = TOINT(LLM_NUM:5)

; 抠掉数值块，台词保持干净。
;
; ⚠️⚠️ **两种排布都要处理**（用户实测踩到过第二种）：
;   ① **正常**：`台词 \n ###DELTA### \n 数值`
;      ⇒ 前半段就是台词，直接用 ✓
;   ② **模型没按格式**：`###DELTA### \n 数值 \n 台词`（块跑到了最前面）
;      ⇒ 前半段是**空的**。
;      原来这里"前半段为空就什么都不做" ⇒ **整串标记和数值都留在台词里**，
;      玩家会看到她念出「###DELTA### 1,20,0,0,0,0」⚠️（实测就是这个现象）
;      ⇒ 改成：**拆掉后半段的第一行（那一行是数值），剩下的就是台词** ✓
;  ⚠️ 仍然守住"不能让她不说话"：万一连换行都没有（彻底挤成一行），
;     那就退化成"整段留着"—— 至少她说了话，只是会带上数值。
LLM_PART:0 '= TRIM_STRING(LLM_PART:0)
IF STRLENS(LLM_PART:0) > 0
	REF_TEXT = %LLM_PART:0%
ELSE
	; ② 块在开头 ⇒ 拆换行，第 2 段起才是台词
	;  ⚠️ 此时 `SANITIZE_REPLY` **还没跑**，换行还完好 ✓（调用顺序见主循环）
	SPLIT LLM_PART:1, "\n", LLM_NUM
	REF_TEXT = %LLM_NUM:1%
	SIF STRLENS(REF_TEXT) <= 0
		REF_TEXT = %LLM_PART:1%
ENDIF
; 返回 1 = 确实解析到了结算块（供调用方区分"给了 0,0,0"与"没给块"）
RETURN 1


; ────────────────────────────────────────────────────────────────────────────
;  把解析出的增减值写进游戏数值，并在台词之后打印一行提示
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ 模型只提供"建议值"，**最终裁决在这里**：
;     · 每个数都被 LIMIT 钳到允许范围
;     · 好感度 / 情緒 还各受"单场累计"限制
;  这样模型就算输出 +999 也只能拿到上限值。
;
;  ── 数值为什么是这几个数（2026-09 调研后调整）──────────────────────────
;  对齐游戏自己的尺度（依据见 `LLM对话数值设计调研.md`）：
;    · 官方一次「会話」：好感度 +4~+10、情緒 +30~+200、愤怒 0
;    · 官方一次轻冒犯（捏脸 / 戳脸）：愤怒 +139 ~ +231；强吻 +578
;    · MAXBASE:情緒 ≈ 1500、MAXBASE:憤怒 ≈ 1000
;      （从角色 CSV 读，**各角色不同**，所以下面一律用 MAXBASE 而不是硬编码）
;    · 自然衰减：每 10 分钟 情緒掉 40~120、愤怒掉 50
;      旧值 ±2 只有自然衰减的 1/20~1/60，等于白给 —— 这就是本次调整的原因。
;
;  参数：REF_ACC_FAVOR = 本场已累计的好感度变化（单场 ±10）
;        REF_ACC_MOOD  = 本场已累计的情緒变化（单场 ±200）
;        LLM_GOT       = 模型这次是否给出了结算块（@LLM_PARSE_DELTA 的返回值）
;                        —— 用来区分"给了 0,0,0"（静默）与"压根没给块"（提示玩家）
;        LLM_D4        = **这句话的意图**：
;                          0 = 普通 / 1 = 亲昵调情 / 2 = 性骚扰越界 / 3 = 陪她一起做事
;                        （2 走下面的关系分级；**3 走 ⓪b 的「陪同行動」**）
;        ⚠️ `3` 是唯一会**改变游戏时间**的分支（`TIME += 投入时间`）——
;           它复用官方 `@COM368` 的逻辑，详见 ⓪b 的注释。
;
;  ── 关系分级：性质由模型判断，效果由这里决定 ──────────────────────────
;  为什么不让模型直接给效果：模型不知道 `REQUIRED_FAVOR_恋慕 = 3000` 这种门槛，
;  也不该让它知道（否则它会在台词里报数字）。所以模型只说"这句是不是性骚扰"，
;  **"该有什么反应"由游戏状态决定**。
;
;  思路照抄官方的「陥落素質」（`SOURCE_EXTRA.ERB:107-140`）：
;  行为本身产生的反感是固定的，**关系深的人会把它消解掉** ——
;  官方是 恋慕 ×0.2 / 愛欲 ×0.3 / 思慕 ×0.5。我们直接换成分档效果表。
;
;  | 关系 | 性骚扰(D4=2) 的效果 |
;  |---|---|
;  | 恋慕 / 愛欲 | 不是被冒犯而是**害羞**：情緒 +40、愤怒 −30、**欲情 +PALAMLV:3** |
;  | 思慕 或 好感 ≥ `REQUIRED_FAVOR_思慕` | 尴尬嗔怪：好感 −1、情緒 −20、愤怒 +40 |
;  | 其余（关系尚浅） | **讨厌 + 明显愤怒**：好感 −5、情緒 −40、愤怒 **+150** |
;
;  ⚠️ 欲情**必须用 `PALAMLV:N`**（"加 N 档"）而不能写绝对数 ——
;    `PALAMLV` 有两套阈值表（`初期設定.ERB:63-101`，取决于 DLC 开关），
;    写死 3000 在不同配置下会差 6 倍。
; ────────────────────────────────────────────────────────────────────────────
@LLM_APPLY_DELTA(LLM_CID, LLM_D1, LLM_D2, LLM_D3, LLM_D4, LLM_D5, LLM_D6, REF_ACC_FAVOR, REF_ACC_MOOD, LLM_GOT, REF_TOGETHER)

#DIM  LLM_CID
#DIM  LLM_D1
#DIM  LLM_D2
#DIM  LLM_D3
#DIM  LLM_D4
#DIM  LLM_D5        ; 信赖度档位（0~2，平时为 0）
#DIM  LLM_D6        ; 行为代码（1牵手/2拥抱/3接吻/4摸胸/5摸屁股/6摸下面/7脱衣服；0=无）
#DIM  REF REF_ACC_FAVOR
#DIM  REF REF_ACC_MOOD
#DIM  LLM_GOT
; 「陪伴」的结果：**空串 = 没发生**；非空 = 她手头那件事的名字（如「吃饭」）。
; 一次传两件事（有没有陪 / 陪的是什么），省得调用方事后再去取 ——
; 那时候行动可能已经因为时间推进而结束了，`FreeAct_Name` 会取到错的东西。
#DIMS REF REF_TOGETHER
; 数值局部：D / SEXY / ELAPSE / FACTOR / TG_GATE / DB0~DB3 / SKILL / WORKP /
;           TOG / COST_T / COST_K / TOGP / T0 / DT / STEP / COSTSTEP /
;           FIX_T / FIX_K / TRUST / TIRED / SELF / SRC_ANY / TRST_ANY / TF102
;           —— 共 27 个（参数不计入 LOCALSIZE）
; 字符串局部：MSG / FANAME / GAIN / TGKIND / **MEMO_TXT** 共 5 个
; ⚠️ 容量留足余量：本项目已经两次把它写满（24 写满、32 又接近），
;    溢出会直接报 Lv2 并让局部变量错乱。
#LOCALSIZE 40
#DIM  LLM_TOUCH_OK    ; ★ 身体接触（t=5）前置条件是否满足
#DIM  LLM_TOUCH_P     ; ★ 身体接触：她反感的扣分
#DIM  LLM_PMAX        ; ★ 玩家偏好：最高次数
#DIM  LLM_PTOP        ; ★ 玩家偏好：对应的行为代码
#DIMS LLM_STRIP_WHAT  ; ★ 这一轮脱掉了什么（提示用）
#DIM  LLM_FAV_HIT     ; ★ 这次 roll 有没有中「最爱」
#DIMS LLM_FAV_NAME    ; ★ 最爱行为的中文名（提示用）
#DIM  LLM_TF          ; ★ 身体接触的额外好感
#DIM  LLM_TT          ; ★ 身体接触的额外信赖
#DIM  LLM_TP          ; ★ 身体接触的欲求不满档位（百分点）
#DIM  LLM_TE          ; ★ 身体接触的情绪加成
#DIMS LLM_NM          ; ★ 她现在的名字（每轮通报用）
#DIM  LLM_SF          ; ★ 性骚扰(t=2)的好感
#DIM  LLM_SE          ; ★ 性骚扰的情绪
#DIM  LLM_SP          ; ★ 性骚扰的欲求不满档位（百分点）
#LOCALSSIZE 12
#DIMS LLM_MSG
#DIMS LLM_JOBNAME   ; ★ 具体工作名（2026-09-18）—— 给「结束登记」用
#DIMS LLM_FANAME    ; 她手头那件事的名字（取自 @FreeAct_Name）
#DIMS LLM_GAIN      ; 「本次结算」明细串（体力/气力/好感度…，拼好挂在台词后面）
#DIMS LLM_TGKIND    ; `REF_TOGETHER` 的**局部副本**，专门用来做字符串比较
#DIMS LLM_MEMO_TXT  ; 要写进持久记忆的一句话（如"劝他去休息"那次）
                    ; ⚠️ 局部变量**不跨函数**：`@LLM_TOO_TIRED_TALK` 里那个
                    ;    同名变量是**另一个**，这里必须自己再声明一次，
                    ;    否则报「变量未在此函数中定义」。
#DIM  LLM_D
#DIM  LLM_SEXY      ; 本次是否要给欲情（只有"关系已深 + 性骚扰"才给）
#DIM  LLM_ELAPSE    ; 「陪她一起」投入的分钟数
#DIM  LLM_FACTOR    ; 「陪她一起」的收益倍率
#DIM  LLM_TG_GATE   ; 「陪伴」的关系门槛（按动作分档；0 = 不设门槛）
; 调用「ソース」/官方指令**之前**的 DOWNBASE 快照 —— 用它算"这一次"的体力气力增减。
; DOWNBASE 是**累积待扣**的（由 @SOURCE_CHECK 在回合末消费并清零，
; 见 `SOURCE.ERB:1044-1066`），所以前后差值就是本次的量。
#DIM  LLM_DB0
#DIM  LLM_DB1
#DIM  LLM_DB2
#DIM  LLM_DB3
; 「帮忙干活」自己算时用到的量（照抄官方 COMF304，但不 CALL 它）

#DIM  LLM_SKILL     ; 对应職種的技能值
#DIM  LLM_WORKP     ; 帮忙出力基数
#DIM  LLM_TOG       ; 本次实际完成的工作量
#DIM  LLM_COST_T    ; 本次扣玩家的体力
#DIM  LLM_COST_K    ; 本次扣玩家的气力
#DIM  LLM_TOGP      ; 工作进度百分比（用来显示，比绝对数字直观）
#DIM  LLM_ALEFT     ; 她那件事"**实际**"还剩几分钟（`@LLM_ACT_REMAIN` 的返回值）
                    ; ⚠️ 不能用 `Activity_Duration` 代替 —— 那个在对话中**不会减少**
                    ;    （递减在回合末的 `@CHARA_MOVEMENT`），见那个函数的说明。
#DIM  LLM_T0        ; 进入本函数时的 TIME（用来算"本轮总共推进了几分钟"）
#DIM  LLM_DT        ; 本轮实际推进的分钟数
; ── 陪伴的「态度档位」（由模型判定：`t=3` 随口陪着 / `t=4` 认真帮忙）──
#DIM  LLM_STEP      ; 工作量推进份额（3 = 随口 / 10 = 认真）
#DIM  LLM_COSTSTEP  ; 消耗份额（0 = 用下面的固定值；>0 = 按職種全量缩放）
#DIM  LLM_FIX_T     ; 固定消耗：体力（仅 LLM_COSTSTEP == 0 时用）
#DIM  LLM_FIX_K     ; 固定消耗：气力
#DIM  LLM_TRUST     ; 信赖度档位
#DIM  LLM_TIRED     ; 本轮是否婉拒（= 组装 prompt 时锁下来的 LLM_PTIRED_LOCK）
#DIMS LLM_INT_MTR    ; ★ 互动计量表文本（高潮值/觉醒值，2026-09-21）
;  ⚠️ 原来这里还有个 `LLM_TIRED_TH`（本函数自己算的阈值）—— **已删除**。
;     现在阈值和"累不累"一起锁在文件级变量 `LLM_PTIRED_LOCK_TH` /
;     `LLM_PTIRED_LOCK` 里，由 `@LLM_BUILD_SYSTEM_PROMPT`（组装 prompt **之前**）算好。
;     留着两份阈值只会让人误以为可以在这里重算，而重算正是那个 bug 的来源。
#DIM  LLM_SELF      ; 她自己在这一轮推进的工作量（用于明细显示）
#DIM  LLM_SRC_ANY   ; 本轮是否写过 SOURCE（决定要不要 CALL FAVOR_CALC）
#DIM  LLM_TRST_ANY  ; 本轮是否写过信赖档位（决定要不要 CALL TRUST_CALC）
#DIM  LLM_TF102     ; 临时保存 TFLAG:102（官方结算的闸门）
#DIM  LLM_TF99      ; 临时保存 TFLAG:99（失败指令标志）
#DIM  LLM_T4B       ; ★ 结算前的信赖度（用来算实际差值）
#DIM  LLM_T4D       ; ★ 这一轮信赖度的**实际**变化
#DIM  LLM_TF0       ; ★ 浮动前的基准（用来判断偏高/偏低）
#DIM  LLM_TT0       ; ★ 同上（信赖）

; ════════════════════════════════════════════════════════════════════════
;  ★★ **睡姦 / 醉姦：不结算情绪和愤怒**（2026-09-21 用户重申）——
;  ⚠️ 用户原话：「睡梦和醉酒之中不应该减少情绪和增加愤怒
;              毕竟角色不知道这些事情 这些数据也需要另开一块计算」
;  ⚠️ 理由：她**睡着 / 醉倒** ⇒ 根本不知道发生了什么 ⇒
;     情绪下降、愤怒上升是**说不通**的（她凭什么生气？）⚠️
;  ⚠️ 实测过没守住的后果：情绪 -40、愤怒 +60（截图）⇒
;     那是模型按「被猥亵了」硬给的，但她并没有意识到 ⚠️
;  ⚠️ 放在函数**最前面** ⇒ 后面所有用到 D2/D3 的地方（含明细打印）自动为 0 ✓
;  ⚠️ 好感（D1）、信赖（D5）、行为（D6）**照常结算** —— 用户只说了情绪 ✓
; ════════════════════════════════════════════════════════════════════════
; ★ **好感 / 信赖也不结算**（2026-09-21 用户确认）——
;   ⚠️ 她没意识到是谁在碰她 ⇒ 谈不上「喜欢」和「信得过」⚠️
;   ⚠️ **醒来的那一瞬间**才结算（那时她才真的感知到）✓
;   ⚠️ 欲求不满**照涨**（生理反应是真实的）—— 用户确认 ✓
IF LLM_MODE == 1
	LLM_D1 = 0
ENDIF
IF LLM_MODE == 1
	LLM_D5 = 0
ENDIF
	IF LLM_MODE == 1
	LLM_D2 = 0
	ENDIF
IF LLM_MODE == 1
	LLM_D3 = 0
ENDIF

; ★★ **取一次具体工作名**（2026-09-18）—— 给下面 4 处「结束登记」用 ✓
;  ⚠️ 原来传的是字面量 `"工作"` ⇒ 她会说「刚把「工作」做完」，很生硬 ⚠️
;     改成具体名字后是「刚把「门番」做完，正在歇口气」✓
;  ⚠️ `@GET_JOBNAME` 带 `#FUNCTIONS` ⇒ **必须表达式调用**（不能 `CALL`）
;  ⚠️ 没工作的角色 ⇒ 退回「今天的活」✓
LLM_JOBNAME = %GET_JOBNAME(LLM_CID)%
SIF LLM_JOBNAME == ""
	LLM_JOBNAME = "今天的活"

LLM_MSG = ""
LLM_SEXY = 0
; ⚠️⚠️ **绝不要在这里给 `REF_TOGETHER` 赋值！**
;    它是 `#DIMS REF` 的**输入输出**参数 —— 进来时带着"当前陪伴模式"
;    （空 = 没在陪）。在这里清空就等于**把传进来的模式丢掉**，
;    表现为陪伴模式每轮都被重置、`ELSEIF REF_TOGETHER != ""` 永不成立。
;    它的"输出"只在各分支里按需赋值。
; ⚠️ 必须每轮清空：陪伴模式跨轮保持，第二轮不重新结算，
;    若不清空就会把**上一轮**的结算明细原样再显示一遍。
LLM_GAIN = ""
; ⚠️⚠️ `REF_TOGETHER` 是 `#DIMS REF` 的**引用参数**，实测直接拿它做
;     字符串比较/显示都不可靠（值里还会带引号，界面出现过「（"工作"停下来了）」）。
;     所以一进来就复制一份干净的局部副本，后面的比较与显示统一用它。
;     注意：这只是**进来时**的快照；分支里改了 `REF_TOGETHER` 之后要重新取。
LLM_TGKIND = %REF_TOGETHER%
LLM_TGKIND '= REPLACE(LLM_TGKIND, "\"", "")
; 官方结算的两个标志：每轮先清零，由各分支按"实际写了什么"置位（见 ④e）
LLM_SRC_ANY = 0
LLM_TRST_ANY = 0
; ★ 技能经验也同样每轮清零 ——
;   `@LLM_WORK_DO` 有**提前 RETURN** 的路径（活干完了 / 这两种職種不适用），
;   那时它走不到发布经验那一步，值就会**残留上一轮的**，
;   于是在明细里显示成"这一轮也涨了经验"。在这里兜底清零最稳。
LLM_LAST_EXP = 0
LLM_LAST_EXP_NAME = ""
LLM_LAST_EXP_PROG = ""
; ── ★ "太累"的判定：**直接复用组装 prompt 时锁下来的值** ──
;
;  ⚠️⚠️ 这就是"**先判、再让她说**"的核心：
;     判定发生在 `@LLM_BUILD_SYSTEM_PROMPT`（= **组装 prompt 之前**），
;     结果写进**文件级变量** `LLM_PTIRED_LOCK`（连阈值一起锁在 `..._LOCK_TH`）；
;     这里**只读那个值，不再重算**。
;
;  ⚠️ 为什么不能在这里重算（实测炸过）：
;     她的台词是**组装 prompt 时**用当时的体力生成的，
;     而结算发生在她说完之后 —— 陪伴扣掉的 150 体力已经在中间生效了。
;     于是"两套判定用两个时刻的体力值"，屏幕上同时出现三行互相矛盾的内容：
;         「好，我陪你」／（她没答应，让你先去歇会儿）／（推进+30）
;
;  ⚠️ 阈值也一起锁了：只锁"累不累"而阈值各算各的，
;     万一期间 `MAXBASE` 变了（换装 / 升级），两边还是会错开。
;
;  ⚠️ 哨兵值 9 = 本场还没判定过。理论上不会发生（每轮都会先组装 prompt），
;     但真发生时**必须兜底重算一次** —— 绝不能把"没判过"当成"不累"。
IF LLM_PTIRED_LOCK == 9
	LLM_PTIRED_LOCK_TH = 800
	SIF MAXBASE:MASTER:体力 / 5 > LLM_PTIRED_LOCK_TH
		LLM_PTIRED_LOCK_TH = MAXBASE:MASTER:体力 / 5
	SIF MAXBASE:MASTER:気力 / 5 > LLM_PTIRED_LOCK_TH
		LLM_PTIRED_LOCK_TH = MAXBASE:MASTER:気力 / 5
	LLM_PTIRED_LOCK = 0
	SIF BASE:MASTER:体力 <= LLM_PTIRED_LOCK_TH || BASE:MASTER:気力 <= LLM_PTIRED_LOCK_TH
		LLM_PTIRED_LOCK = 1
ENDIF
; （阈值 800 的来历见 `@LLM_BUILD_SYSTEM_PROMPT` 里那段调参轨迹：
;   必须盖住最大一次扣减 —— 500 硬线 + 250 认真帮忙 = 750 → 取 800。）
; 记下进来的时刻 —— 后面用它算"本轮总共推进了几分钟"（见 ④b）
LLM_T0 = TIME

; ⓪b 陪她一起做手头的事（D4=3）—— 这不只是台词，是一个**动作**
;  完全照抄官方的「陪同行動」（`COMF368 自由行動に付き合う.ERB:17-32`）：
;    · 投入时间 = min(她剩余的行动时间, 30 分钟)
;    · 收益倍率 = 投入时间 / 10（至少 1）
;    · 调该行动的 `"ソース"` 分支按倍率结算（好感度、体力恢复…）
;    · `TIME += 投入时间` —— **这一步让自由对话开始消耗游戏时间**
;
;  ⚠️ 刻意**不手动递减 `Activity_Duration`**：`@自由行動処理` 会在时间推进后
;     按 `TIME_PROGRESS` 自己递减（`MOVEMENT_自由行動.ERB:13`）。
;     手动再减一次就成了双重递减，她的行动会莫名提前结束。
;  ⚠️ 用 `TRYCALLFORM`：万一某个 Activity_Type 没有对应的 `自由行動内容_N`
;     函数，它会静默跳过，不会把对话搞崩。
;
;  ── 陪伴模式：一次建立，之后一直有效 ────────────────────────────────
;  语义：玩家一旦决定"陪你一起做××"，**这场对话就进入陪伴模式** ——
;        后续轮次即便不再说"陪你"，也仍然算在陪着，话题也围绕这件事展开。
;        直到：① 玩家退出自由对话（`LLM_TOGETHER` 是 @LLM_CHAT_LOOP 的局部
;        变量，退出即消失）② 这件事做完了（`Activity_Duration` 归零）。
;
;  `REF_TOGETHER` 在这里**兼作输入与输出**：
;      进来时 = 当前模式（空串 = 不在陪伴中）
;      出去时 = 更新后的模式
;  ⚠️ 结算只在**第一次**建立时做 —— 否则每轮都跑一次 `"ソース"`，
;     好感度会以"一次完整互动"的量级连刷，几轮就爆了。
;  ── 门槛：**按动作的亲密度分档**，不是一刀切 ──────────────────────
;  道理：一起玩、一起运动、一起钓鱼这类是**公开的社交活动** ——
;        不熟的人凑一局很自然，硬要"关系够近"反而不合理。
;        而一起吃饭、一起看书是**安静且私密的共处**（共享食物、并肩沉默），
;        关系不到位会显得唐突，所以她不会答应。
;
;  分档：
;    · 亲密类（`Activity_Type` = 2 吃饭 / 3 偷吃零食 / 6 看书）
;        → 要 **`REQUIRED_FAVOR_思慕`（1500）**
;    · 其余（玩 / 运动 / 打扫 / 钓鱼 / 采集 / 演奏…）
;        → **不设门槛**，谁都能一起做
;
;  （`REQUIRED_FAVOR_思慕 = 1500`、`恋慕 = 3000`，见 `DIM.ERH:11-15`。
;    门槛取思慕而不是恋慕：游戏里刷到恋慕相当费时，会把吃饭/看书这种
;    日常互动锁得太死。）
LLM_TG_GATE = 0
IF CFLAG:(LLM_CID):行動 != 5 && GROUPMATCH(Activity_Type:(LLM_CID), 2, 3, 6)
	LLM_TG_GATE = REQUIRED_FAVOR_思慕
ENDIF
; ⚠️⚠️ 她"手头有事在做"有**两条互斥的路**，这里必须都算上：
;    ① **自由行动** —— `Activity_Duration:(CID)` 非 0
;    ② **工作**     —— `CFLAG:行動 == 5`（此时 `Activity_Duration` 是 0！）
;       两者互斥：`@自由行動条件` 要求 `CFLAG:行動 == 0`。
;    只判 ① 的话，**陪她工作时整个分支都进不来** ——
;    表现就是"帮忙完全没有效果、工作量也不减、工作也不结束"。
;
;  ⚠️ `t` 有**两档陪伴**，由模型按玩家的「投入程度」判定：
;       t=3 = 随口陪着（边聊边搭手）    t=4 = 认真帮忙（撸起袖子干）
;     下面先把这两档翻译成一组档位参数，后面的分支统一用它们，
;     这样"吃饭 / 看书 / 发呆 / 干活"**全都自动享受同一套分档**。
;  ⚠️⚠️ **必须带 `LLM_TGKIND == ""` 这个条件**（实测漏了它）：
;    模型**每一轮**看到"我正在陪着她"，都会**再判一次 `t=3/4`**（"陪你"）——
;    于是这个"**建立**陪伴"的分支每轮都被抢走。
;    而它内部那段是 `IF LLM_TGKIND == ""` 保护的，已经在陪伴时**整段跳过**，
;    结果就是**什么都不做**：不推进时间、不扣消耗、界面一个字都不打，
;    也永远走不到下面那个 `ELSEIF LLM_TGKIND != ""`（"陪伴继续"）分支。
;    ⇒ 表现就是"**陪着运动/看书好像根本没进入陪伴状态**"。
;    加上这个条件后，"已在陪伴中"会**自然落到下面的继续分支**统一处理，
;    不需要在这里再抄一份"继续陪伴"的逻辑。
;  ⚠️ 自由行动那一侧用 `@LLM_ACT_REMAIN`（**有效剩余**）——
;     `Activity_Duration` 在对话中不减少，拿它判会出现
;     「她其实早该结束了，却还能被你陪着」（见 §28）。
IF (LLM_D4 == 3 || LLM_D4 == 4) && LLM_TGKIND == "" && (LLM_ACT_REMAIN(LLM_CID) > 0 || CFLAG:(LLM_CID):行動 == 5)
	; ── 把 `t` 翻译成档位参数 ──
	;   t=4 **认真帮忙**：30 分钟、进度份额 30、消耗按職種全量、信赖 +5
	;   t=3 **随口陪着**：15 分钟、进度份额 9、固定消耗（体力 −150 / 气力 −30）、信赖 +2
	;  "固定消耗 vs 按職種"，由 `LLM_COSTSTEP` 是否为 0 区分 —— 见 `@LLM_WORK_DO` ③。
	;  后面所有分支（工作 / 吃饭 / 看书 / 发呆…）统一读这组参数，
	;  所以两档待遇对**所有陪伴内容**都成立。
	;
	;  ⚠️ 份额的含义是"相对完整一份的倍率"（`@LLM_WORK_DO` 里 `× LLM_STEP / 10`）：
	;      10 = 一份、20 = 两倍、30 = 三倍。
	;  调过两轮：最初 3 / 10（太少，聊半天进度几乎不动）→ 翻倍 6 / 20
	;  → 再 ×1.5 成 **9 / 30**。
	;  目标是"**一场对话内真的能把她的活干完**"，所以宁可给足。
	LLM_STEP = 9
	LLM_COSTSTEP = 0
	LLM_ELAPSE = 15
	LLM_FIX_T = 150
	LLM_FIX_K = 30
	LLM_TRUST = 2
	IF LLM_D4 == 4
		LLM_STEP = 30
		LLM_COSTSTEP = 10
		LLM_ELAPSE = 30
		LLM_TRUST = 5
	ENDIF
	IF CFLAG:(LLM_CID):2 < LLM_TG_GATE
		; 关系不够 → 她不会答应，还会觉得这人有点没分寸
		; （好感度 −1 只是象征性的"不爽"，不是重罚）
		LLM_D1 = -1
		LLM_D2 = -20
		LLM_D3 = 30
		; ⚠️ 这是"**被拒绝**"不是"结束" —— 那件事还在继续，
		;    所以第三个参数传空串（**不登记** `LLM_JUST_ENDED`）。
		CALL LLM_MARK_END(LLM_MSG, "", "关系还不够近，她没答应")
		REF_TOGETHER = ""
	ELSEIF LLM_PTIRED_LOCK
		; ★ 玩家太累了 —— 她会**主动劝你歇着**，而不是让你硬撑着陪。
		;  ⚠️⚠️ 这里用的是**组装 prompt 时锁下来的判定**（`LLM_PTIRED_LOCK`），
		;     **不是当场重算** —— 这就是"先判、再让她说"：
		;     她刚才的台词就是在"知道你已经很累"的前提下生成的，
		;     所以这一句婉拒和她的台词**必然一致**。
		;  ⚠️ 阈值 800 的来历：必须盖住最大一次扣减 ——
		;     500（游戏濒临极限硬线）+ 250（认真帮忙最大消耗）= 750 → 取 800。
		;     用"上限的 20%"不够：上限 1000 时那是 200，
		;     而体力 350 就落进空档了 —— 游戏要判濒临极限、我们却放行。
		;  ⚠️ **例外：吃饭 / 偷吃零食**（自由行动 2 / 3）—— 那会恢复体力气力，
		;     所以累了去吃反而是对的，不该被拦。
		;  ⚠️ 这里**不加负面数值** —— 她是关心，不是生气。
		IF GROUPMATCH(Activity_Type:(LLM_CID), 2, 3) && CFLAG:(LLM_CID):行動 != 5
			; 让她去吃 —— 什么都不做，继续走下面的正常流程
		ELSE
			; ⚠️ 也不是"结束" —— 她的活还在那儿，只是不让你陪
			CALL LLM_MARK_END(LLM_MSG, "", "她看你一脸疲惫，让你先去歇会儿")
			REF_TOGETHER = ""
		ENDIF
	ELSEIF CFLAG:(LLM_CID):行動 == 5
		; ★ 她在**工作**（打工 / 被安排做事）—— 走官方的「帮忙干活」
		;
		;  ⚠️ 工作与自由行动**互斥**：`@自由行動条件` 要求 `CFLAG:行動 == 0`，
		;     所以工作时 `Activity_Duration` 一定是 0，上面那个条件抓不到她。
		;     这就是"帮忙完全没效果、工作量也不减"的根因。
		;
		;  ⚠️⚠️ 刻意**不直接 `CALL COM304`**：
		;     `@COM304` 是**指令函数**，由指令系统调用 —— 调用前系统会准备好
		;     整套上下文（`SELECTCOM` / `TARGET` / `TFLAG` / 各种 VARSET …）。
		;     从自由对话里直接 CALL 它，实测会让**自由对话被中断**
		;     （发出邀请后直接跳出对话界面）。
		;     所以只把它的**核心几步**抄过来，路径完全可控：
		;    · 帮忙出力 `L_帮忙 = WorkP + RAND:80 + RAND:80 + 10`（清洁类减半）
		;    · `BASE:工作量 -= L_帮忙`（工作量归零后游戏自己会结束工作）
		;    · `TFLAG:信頼度管理 += 5`
		;    · `SOURCE:歓楽` 按 従順 / 親密 / 好感度 分档
		;    · 按職種扣玩家体力 / 气力（用上面那两个小工具函数）
		;
		;  ⚠️ `BASE:工作量`（不带角色下标）= **当前 TARGET 的工作量**，
		;     而 `@LLM_CHAT_LOOP` 进来时已设过 `TARGET = LLM_CID`，
		;     所以不需要额外切换目标。
		; ★ 用**档位参数**（由 `t` 翻译好，见上面）：
		;   t=4 认真帮忙 → 30 分钟；t=3 随口陪着 → 15 分钟
		; 补差额：④b 已为这一轮对话推进过 3 分钟，这里只补剩下的，
		; 让这次帮忙的**总时间**正好 = `LLM_ELAPSE`（界面也按这个数显示）。
		TIME += MAX(LLM_ELAPSE - 3, 0)

		; ① 她还在干活吗？已经收工、或者这个職種本来就不让帮忙，就没什么可帮的
		;    （照抄官方 `@COM_ABLE304` 的判据，见 `COMF304:436-471`：
		;      宴会参加 / 酔いつぶれる 这两种状态不适用「帮忙干活」）
		IF BASE:(LLM_CID):工作量 <= 0
			; ★ 这是**真结束** —— 第三个参数传名字，会登记给下一轮 prompt
			CALL LLM_MARK_END(LLM_MSG, LLM_JOBNAME, "她的活已经干完了，没什么可帮的")
			REF_TOGETHER = ""
		ELSEIF GROUPMATCH(CFLAG:(LLM_CID):職種, 49, 51)
			; ⚠️ 这也不是"结束" —— 她的宴会还在进行，只是不让你帮手
			CALL LLM_MARK_END(LLM_MSG, "", "她这会儿正忙着应酬，插不上手")
			REF_TOGETHER = ""
		ELSE
			; ② 干活 —— 份量与消耗都由档位参数决定
			;    （`LLM_COSTSTEP == 0` 时 `@LLM_WORK_DO` 不扣，改用下面的固定值）
			CALL LLM_WORK_DO(LLM_CID, LLM_STEP, LLM_COSTSTEP)
			LLM_TOG = RESULT
			; ★ 记下这一轮的**成败**，供**下一轮** prompt 使用
			;   ⚠️ `TFLAG:193` 是当轮的；而 prompt 是下一轮才组装的 ——
			;     不存到跨轮变量里，她永远演不出"搞砸了/干得漂亮"。
			LLM_LAST_RESULT = TFLAG:193
			; `@LLM_WORK_DO` 里写了 `SOURCE:歓楽/受動` → 需要走官方结算（见 ④e）
			LLM_SRC_ANY = 1
			LLM_TRST_ANY = 1
			; 取回这一份实际扣掉的体力/气力，用来显示明细
			CALL LLM_WORK_COST(CFLAG:(LLM_CID):職種, LLM_COST_T, LLM_COST_K)
			; ③ 界面反馈（工作名同样取官方的，比笼统说"干活"具体）
			REF_TOGETHER = "工作"
			LLM_FANAME = %GET_JOBNAME(LLM_CID)%
			; ★ 把"他帮过我"记进持久记忆 ——
			;   ⚠️ 工作名是固定的（如「门番」），所以同一件工作**只会记一条**
			;      —— `@LLM_MEMO_ADD` 自带去重 —— 不会把 4 个槽位挤爆。
			;   ⚠️ 措辞用"帮我干过××"，是**她自己的回忆**口吻，不是系统报告。
			; ⚠️ 这里是**两行**，必须 `IF … ENDIF`（`SIF` 只绑紧随的一行，
			;    写成 `SIF` 的话 `CALL` 会无条件执行 —— 那样工作名为空时
			;    会记进去一条"他帮我干过"这种没头没尾的记忆）。
			IF LLM_FANAME != ""
				LLM_MEMO_TXT = @"他帮我干过%LLM_FANAME%"
				CALL LLM_MEMO_ADD(LLM_CID, LLM_MEMO_TXT, 5)
			ENDIF
			SIF LLM_FANAME == ""
				LLM_FANAME = "干活"
			SIF LLM_MSG != ""
				LLM_MSG += "　"
			LLM_TOGP = 100
			SIF MAXBASE:(LLM_CID):工作量 > 0
		; ★ **她自己这一轮还会推进 `LLM_ELAPSE * 10` 点**（每分钟 10 点）——
		;   ⚠️ 那句在函数末尾才扣（④d），所以这里先减掉，免得进度条偏小 ⚠️
		;   （实测偏差约 4%：门番 3600，陪 15 分钟 = 150 点）
		LLM_TOGP = MAX(BASE:(LLM_CID):工作量 - LLM_ELAPSE * 10, 0) * 100 / MAXBASE:(LLM_CID):工作量
			;  ⚠️ 百分号必须用**全角 ％**：`@"..."` 里半角 `%` 是**插值分隔符**，
			;     写成 `…%TOSTR(x)%%）` 时后面那个 `%` 会开启一段新的插值却找不到
			;     配对，于是加载时报 Lv2「没有闭合的"」。全角 `％` 不会被解析。
			; ★ 工作进度也用**进度条**（`@LLM_BARSTR`，方块字符，照官方样式）——
;   比一串"13％"直观得多：一眼就能看出还剩多少。
LLM_MSG += @"（你帮她%LLM_FANAME% %LLM_BARSTR(100 - LLM_TOGP, 10)% %TOSTR(100 - LLM_TOGP)%％）"
			; ── 本次结算明细（与"陪着"那套格式一致）──
			LLM_GAIN = ""
			IF LLM_COSTSTEP > 0
				; 认真帮忙：消耗按職種全量（`@LLM_WORK_DO` 已经按 COSTSTEP 扣过）
				CALL LLM_GAIN_COST(LLM_GAIN, "体力", MAX(LLM_COST_T * LLM_COSTSTEP / 10, 1))
				CALL LLM_GAIN_COST(LLM_GAIN, "气力", MAX(LLM_COST_K * LLM_COSTSTEP / 10, 1))
			ELSE
				; 随口陪着：固定消耗
				DOWNBASE:MASTER:体力 += LLM_FIX_T
				DOWNBASE:MASTER:気力 += LLM_FIX_K
				; ⚠️ 立刻结算 + 清零（`DOWNBASE` 只是待扣量，自由对话不是回合）
				CALL SOURCE_DOWNBASE(MASTER)
				DOWNBASE:MASTER:体力 = 0
				DOWNBASE:MASTER:気力 = 0
				CALL LLM_GAIN_COST(LLM_GAIN, "体力", LLM_FIX_T)
				CALL LLM_GAIN_COST(LLM_GAIN, "气力", LLM_FIX_K)
			ENDIF
			TFLAG:信頼度管理 += LLM_TRUST
			CALL LLM_GAIN_GET(LLM_GAIN, "工作量", LLM_TOG)
			CALL LLM_GAIN_GET(LLM_GAIN, "信赖度", LLM_TRUST)
			; ★ **玩家的技能经验 + 距下一级的进度条** ——
			;   经验是"帮了才涨、而且不一定每次都涨"（多数職種 25%），
			;   不显示的话玩家根本不知道自己练到了什么；
			;   进度条则回答"还差多少升级"，这才是继续帮下去的动力。
			;   ⚠️ 两项合成**一条**（`战斗经验＋1 Lv2 ■■□□□□□□ 4/10`），
			;      免得同一个技能名在明细里出现两遍。
			CALL LLM_GAIN_EXP(LLM_GAIN)
		ENDIF
	ELSEIF Activity_Type:(LLM_CID) == 0
		; ★ 特例：她在发呆（Activity_Type = 0）时，「一起发呆」≠ 聊天
		;
		;  ⚠️ 刻意**不走** `FREE_ACT_0` 的 `"ソース"` 分支 ——
		;     那个分支是"**找她搭话聊天**"的结算，会**扣**双方 20~40 气力
		;     （`FREE_ACT_0.ERB:113-120`），跟"安静地一起待着"的语义正相反。
		;     一起发呆应该是**休息**，所以这里反过来给气力。
		;
		;  · 气力 **+5** —— 正好抵消一轮自由对话的消耗
		;    （每轮双方各 −5，见本函数 ④b），等于"这一轮是白聊的"
		;  · 信赖度走**官方结算**：`TFLAG:信頼度管理` 会被
		;    `@TRACHECK_信頼度上昇処理` 按愤怒 / 态度 / 献身等修正后再写进
		;    `CFLAG:角色:信赖度`（`TRACHECK_信頼度上昇処理.ERB:266`）。
		;    档位取 **2** —— 官方"会话"成功给 1、"膝枕"给 5，
		;    陪发呆介于两者之间。（`FREE_ACT_0` 自己的 "ソース" 给的也是 1）
		;  · 时间照旧推进：陪伴总是要花时间的
		IF LLM_TGKIND == ""
			; ⚠️ 用 `@LLM_ACT_REMAIN`（**有效剩余**）而不是 `Activity_Duration` ——
			;    后者在对话中不减少，`MIN` 就起不到「别陪过头」的作用（见 §28）。
			LLM_ELAPSE = MIN(LLM_ACT_REMAIN(LLM_CID), 30)
			; 气力 +5 —— 正好抵消一轮对话的消耗（见 ④b 的 −5）
			BASE:MASTER:気力 = MIN(BASE:MASTER:気力 + 5, MAXBASE:MASTER:気力)
			; ⚠️ 发呆**不走** `"ソース"`（见上面的说明），所以官方没给过档位，
			;    这里直接按档位赋值（随口陪着 2 / 认真陪着 5）。
			;    只写信赖、不写 SOURCE —— 所以只置 `LLM_TRST_ANY`（见 ④e）。
			TFLAG:信頼度管理 = LLM_TRUST
			LLM_TRST_ANY = 1
			; ⚠️ 补**差额**：④b 已经为"这一轮对话"推进过 3 分钟了，
			;    所以这里只补剩下的部分 —— 让这次陪伴的**总时间**正好等于
			;    `LLM_ELAPSE`（界面也按这个数显示），而不是在 3 分钟之上再叠。
			TIME += MAX(LLM_ELAPSE - 3, 0)
			SIF LLM_MSG != ""
				LLM_MSG += "　"
			LLM_MSG += @"（你陪她一起发了会儿呆，过了%TOSTR(LLM_ELAPSE)%分钟）"
			LLM_GAIN = ""
			; 发呆给的气力 +5 正好抵掉一轮对话的 −5，所以净变化是 0（不会显示）
			CALL LLM_GAIN_COST(LLM_GAIN, "气力", -5 + 5)
			CALL LLM_GAIN_GET(LLM_GAIN, "信赖度", LLM_TRUST)
		ENDIF
		REF_TOGETHER = "发呆"
	ELSE
		IF LLM_TGKIND == ""
			; 用档位参数决定陪多久（t=4 认真 30 分钟 / t=3 随口 15 分钟），
			; 但不超过她那件事剩下的时间。
			; ⚠️ 同上：用**有效剩余**，否则会「陪过头」
			;    （剩余 5 分钟却推进 15 分钟，帐就对不上了）。
			LLM_ELAPSE = MIN(LLM_ELAPSE, LLM_ACT_REMAIN(LLM_CID))
			LLM_FACTOR = MAX(LLM_ELAPSE / 10, 1)
			TRYCALLFORM 自由行動内容_{Activity_Type:(LLM_CID)}(LLM_CID, "ソース", LLM_FACTOR)
			; 官方 `"ソース"` 分支会写 `SOURCE:*` 与信赖档位 → 需要走官方结算（见 ④e）
			LLM_SRC_ANY = 1
			LLM_TRST_ANY = 1
			; ⚠️ 补**差额**（④b 已推进 3 分钟），让这次陪伴的总时间 = `LLM_ELAPSE`
			TIME += MAX(LLM_ELAPSE - 3, 0)
			; ⚠️ 官方的 `"ソース"` 分支同样只是往 `DOWNBASE` 里**累积**待扣的量
			;    （`DOWNBASE:MASTER:体力 += N`），而结算要等回合结束。
			;    自由对话不是回合，所以这里立刻结算 + 清零 —— 否则玩家在对话里
			;    看到的「体力－40」不会真的扣（理由详见 @LLM_WORK_DO 里的说明）。
			;  ⚠️ 结算前先把"这次的待扣量"记下来给明细用 —— 清零之后就读不到了。
			LLM_COST_T = DOWNBASE:MASTER:体力
			LLM_COST_K = DOWNBASE:MASTER:気力
			CALL SOURCE_DOWNBASE(MASTER)
			CALL SOURCE_DOWNBASE(LLM_CID)
			DOWNBASE:MASTER:体力 = 0
			DOWNBASE:MASTER:気力 = 0
			DOWNBASE:(LLM_CID):体力 = 0
			DOWNBASE:(LLM_CID):気力 = 0
			; ★ 额外加成：一起玩 / 吃饭（含偷吃零食）
			;  这三件事是"纯粹愉快的相处"，官方结算之外再补一点好感与信赖。
			;  ⚠️ 只在这里（第一次建立陪伴）给 —— 陪伴模式跨轮保持，
			;     若每轮都给，好感度会连着刷。
			;  · 好感度直接加（不能走 SOURCE:歓楽 —— 官方刚才已经写过了，
			;    再写一次等于把它翻倍，量级就失控了）
			;  · 信赖度用 `TFLAG:信頼度管理 += N`：官方在 "ソース" 里已经按
			;    大成功/成功设过档位，这里是在**它的基础上**再加一档，
			;    而不是覆盖掉官方对成败的判断
			LLM_FANAME = %FreeAct_Name(LLM_CID)%
			SIF LLM_FANAME == ""
				LLM_FANAME = "那件事"
			SIF LLM_MSG != ""
				LLM_MSG += "　"
			LLM_MSG += @"（陪她%LLM_FANAME%，过了%TOSTR(LLM_ELAPSE)%分钟）"
			; ── 本次结算明细 ──
			;   ⚠️ 和「帮忙干活」那套保持一致：体力 / 气力 / 额外好感 / 信赖。
			;      官方 `"ソース"` 写的 `SOURCE:歓楽` 要等回合末才换算成好感度，
			;      对话里算不出来，所以这里只显示**能立刻确定**的部分。
			;      （时间经过由 ④d 统一追加，这里不重复）
			LLM_GAIN = ""
			CALL LLM_GAIN_COST(LLM_GAIN, "体力", LLM_COST_T)
			CALL LLM_GAIN_COST(LLM_GAIN, "气力", LLM_COST_K)
			IF GROUPMATCH(Activity_Type:(LLM_CID), 1, 2, 3)
				CFLAG:(LLM_CID):2 = LIMIT(CFLAG:(LLM_CID):2 + 2, 0, 1000000)
				TFLAG:信頼度管理 += LLM_TRUST
				CALL LLM_GAIN_GET(LLM_GAIN, "好感度", 2)
				CALL LLM_GAIN_GET(LLM_GAIN, "信赖度", LLM_TRUST)
			ELSE
				; 其余动作没有"额外好感"加成，只给信赖
				TFLAG:信頼度管理 += LLM_TRUST
				CALL LLM_GAIN_GET(LLM_GAIN, "信赖度", LLM_TRUST)
			ENDIF
		ENDIF
		LLM_FANAME = %FreeAct_Name(LLM_CID)%
		SIF LLM_FANAME == ""
			LLM_FANAME = "那件事"
		REF_TOGETHER = %LLM_FANAME%
		; ★ 把"他陪过我"记进持久记忆 ——
		;   ⚠️ 和"帮忙干活"同理：陪伴的事由是固定的（看书 / 钓鱼 / 打扫…），
		;      同一件事**只会记一条**（`@LLM_MEMO_ADD` 自带去重），
		;      所以这里放心写，不会把 4 个槽位挤爆。
		;   ⚠️ 措辞是**她自己的回忆**口吻：「有一次他陪我一起看书」——
		;      注入时读起来才像"她记得"，而不是系统日志。
		LLM_MEMO_TXT = @"有一次他陪我一起%LLM_FANAME%"
		CALL LLM_MEMO_ADD(LLM_CID, LLM_MEMO_TXT, 5)
	ENDIF
ELSEIF LLM_TGKIND != ""
	; ── 已在陪伴模式中（这一轮玩家没说"陪你"，但模式还在）──
	;
	;  ⚠️⚠️ 外层判断**必须用局部副本 `LLM_TGKIND`，不能直接用 `REF_TOGETHER`**！
	;     引用参数做字符串比较**不可靠**：实测模式其实已经是空的，
	;     但 `REF_TOGETHER != ""` 仍判为真，于是走进下面的"自由行动"分支，
	;     最后打出「（停下来了）」—— 而且名字是空的（因为副本确实是空）。
	;     这就是"（停下来了）一直反复出现"的根因。
	;
	;  ⚠️⚠️ **两种模式的语义完全不同，必须分开处理**：
	;    · **工作** → 你**人在帮着干**，所以要**每轮持续结算一小步**；
	;    · **自由行动** → 只是"陪着"，时间推进由 `@自由行動処理` 自己负责，
	;                     这里**不重复结算**（否则好感度会连着刷）。
	;
	;  ⚠️ 结束判据也不能统一用 `Activity_Duration`：
	;    · 自由行动 → `Activity_Duration` 归零 = 做完了
	;    · 工作     → **`Activity_Duration` 恒为 0**（工作与自由行动互斥！
	;                  `@自由行動条件` 要求 `CFLAG:行動 == 0`）
	;      所以拿它判工作会**当场误报"做完了"** ——
	;      实测表现就是她刚答应帮忙，界面立刻打出「（的事告一段落）」。
	;  ⚠️⚠️ 比较前先取一份**局部副本并去掉引号**：
	;     `REF_TOGETHER` 是 `#DIMS REF` 的引用参数，直接拿它做字符串比较
	;     实测会失败（界面明明写着「"工作"」，却走进了"自由行动"分支，
	;     于是工作陪伴被当场打断）。副本 + 去引号最稳。
	LLM_TGKIND = %REF_TOGETHER%
	LLM_TGKIND '= REPLACE(LLM_TGKIND, "\"", "")
	; ── ★★ 先看玩家是不是已经累垮了 ──
	;  体力或气力低于阈值时，她会**主动结束陪伴、劝你去休息**，
	;  而不是继续让你硬撑着陪（实测玩家会一路陪到自己昏过去）。
	;  ⚠️ **例外：吃饭 / 偷吃零食**（自由行动 2 / 3）—— 那两件事本身
	;     会恢复体力气力，所以"累了还继续吃"才是对的，不该被打断。
	;     （工作没有这个例外：它只会消耗。）
	;
	;  ⚠️⚠️⚠️ **为什么她常常"嘴上答应、系统却判婉拒"**（实测炸过）：
	;     屏幕上会同时出现三行互相矛盾的东西 ——
	;         「嗯，就这样。轻拿轻放，别急。」／（她没答应，让你先去歇会儿）／（推进+30）
	;
	;     根因是**两句判断用了两个不同时刻的体力值**：
	;         · 组装 prompt 时她还没被扣体力 → 注入里没强调"他快撑不住了"
	;           → 她顺着**历史**（上一轮刚答应过）继续说"好"
	;         · 本轮结算时体力已经掉到线下 → 系统又判婉拒
	;
	;  ⇒ 修法：**改成"先判、再让她说"** ——
	;     1. `@LLM_BUILD_SYSTEM_PROMPT`（**组装 prompt 之前**）算一次"他累不累"，
	;        写进文件级变量 `LLM_PTIRED_LOCK`，并据此告诉她该拒绝。
	;     2. **这里直接复用那个值**（不再重算）——
	;        她这句台词和这里的判定用的是**同一时刻的体力**，因此不会自相矛盾。
	;     3. 另外把"他累了"也写进【当前的事实（**优先级最高**）】那一段 ——
	;        那段的效力压过对话历史，她才会真的**改口**，
	;        而不是顺着"上一轮刚答应过"继续。
	;  ⚠️ 千万别写成"她答应了就不拦"：这个分支的进入条件本身就是
	;     `LLM_TGKIND != ""`（已在陪伴中），那样会让婉拒**彻底失效**。
	LLM_TIRED = LLM_PTIRED_LOCK
	SIF LLM_TIRED && LLM_TGKIND != "工作" && GROUPMATCH(Activity_Type:(LLM_CID), 2, 3)
		LLM_TIRED = 0
	IF LLM_TIRED
		; ⚠️ 这一轮她的台词**已经由模型说过了**（prompt 里提前告知了"他快撑不住"，
		;    所以她刚说的话本身就是"劝他休息"）—— 这里只补数值反馈。
		;    ⇒ 所以措辞写成**旁白式的结果**，不再冒充她的台词，免得重复。
		CALL LLM_MARK_END(LLM_MSG, "", "她没答应，让你先去歇会儿")
		REF_TOGETHER = ""
		; ★ 这件事也要进持久记忆 —— 和"累趴"那套一样，
		;   否则她下次完全不记得你曾在硬撑着陪她。
		;   ⚠️ 走 @LLM_MEMO_ADD 会自动按好感度掷骰 + 去重，多处调用也安全。
		LLM_MEMO_TXT = "有一次他累得快撑不住了还想陪我，被我赶去休息了"
		CALL LLM_MEMO_ADD(LLM_CID, LLM_MEMO_TXT, 5)
	ELSEIF LLM_TGKIND == "工作"
		IF CFLAG:(LLM_CID):行動 != 5
			CALL LLM_MARK_END(LLM_MSG, LLM_JOBNAME, "她的活干完了")
			REF_TOGETHER = ""
		ELSEIF CHARA_HOLIDAY(LLM_CID, 0)
			; ⚠️ 这里**不能只判 `工作量 <= 0`** —— 游戏的"工作结束"还有
			;    "**到点下班**"这一条（`TIME > TCVAR:工作結束`）。
			;    玩家帮忙让活提前完、或者干脆熬到下班时间时，
			;    `工作量` 可能还留着零头，但**游戏已经认为她下班了**；
			;    只判工作量的话，我们会**继续帮她干活**（而活已经不存在）。
			;    官方把三条判据都写在 `@CHARA_HOLIDAY(角色, 0)` 里，直接调它。
			; ⚠️ 这里必须 `IF … ELSE … ENDIF` ——
			;    **`SIF` 不能跟 `ELSE`**（会报 `Extra closing tag 'ENDIF'`，
			;    这是本项目栽过最多的一个坑，见避坑清单第 1、2 条）。
			; ⚠️ 分隔符由 `@LLM_MARK_END` 自己加，这里**不要**再补 `SIF … += "　"`。
			IF BASE:(LLM_CID):工作量 <= 0
				CALL LLM_MARK_END(LLM_MSG, LLM_JOBNAME, "活干完了，她可以歇口气了")
			ELSE
				CALL LLM_MARK_END(LLM_MSG, LLM_JOBNAME, "她的班已经下完了")
			ENDIF
			REF_TOGETHER = ""
		ELSE
			; ★ **闲聊着陪着**（陪伴模式下的每一轮）
			;
			;  数值是使用者定的，两档分工明确：
			;    · **这一档（闲聊陪着）**：15 分钟 / 体力 −150 / 气力 −30 / 信赖 +2
			;    · **认真帮忙**（玩家明确说「我帮你」那一次）：30 分钟
			;  两档都用**固定值**，不按職種缩放 —— 好预期、好平衡；
			;  職種差异只体现在"能推进多少工作量"上（`@LLM_WORK_DO` 内部照抄官方）。
			;
			;  ⚠️ 消耗**不走** `@LLM_WORK_DO`（那边传 `LLM_COSTSTEP = 0` 表示不扣），
			;     由这里按固定值扣 —— 否则会和職種缩放叠在一起，数值难控。
			;  ⚠️ 时间补差额：④b 已为这一轮推进过 3 分钟，这里只补剩下的，
			;     让这一轮的**总时间**正好 = 15 分钟。
			LLM_ELAPSE = 15
			TIME += MAX(LLM_ELAPSE - 3, 0)

			; ⚠️ 份额与「随口陪着」档（`t=3` 时的 `LLM_STEP = 9`）保持一致 ——
			;    陪伴模式里的普通轮次就相当于"继续随口陪着"，不该比邀请那次弱。
			;    调过两轮：最初 3 → 9（随两档一起 ×3）。
			CALL LLM_WORK_DO(LLM_CID, 9, 0)
			LLM_TOG = RESULT
			; ★ 同上：记下成败供下一轮演出用
			LLM_LAST_RESULT = TFLAG:193
			; 写了 `SOURCE` 与信赖档位 → 走官方结算（见 ④e）
			LLM_SRC_ANY = 1
			LLM_TRST_ANY = 1
			; ⚠️ 这里必须是 `IF … ENDIF`（多行），不能用 `SIF` ——
			;    `SIF` 只绑紧接的一行，后面几行会无条件执行。
			IF LLM_TOG > 0
				; 固定消耗（陪伴模式这一档）
				LLM_COST_T = 150
				LLM_COST_K = 30
				DOWNBASE:MASTER:体力 += LLM_COST_T
				DOWNBASE:MASTER:気力 += LLM_COST_K
				; ⚠️ 立刻结算 + 清零（`DOWNBASE` 只是待扣量，自由对话不是回合）
				CALL SOURCE_DOWNBASE(MASTER)
				DOWNBASE:MASTER:体力 = 0
				DOWNBASE:MASTER:気力 = 0
				TFLAG:信頼度管理 += 2
				LLM_GAIN = ""
				CALL LLM_GAIN_COST(LLM_GAIN, "体力", LLM_COST_T)
				CALL LLM_GAIN_COST(LLM_GAIN, "气力", LLM_COST_K)
				CALL LLM_GAIN_GET(LLM_GAIN, "工作量", LLM_TOG)
				CALL LLM_GAIN_GET(LLM_GAIN, "信赖度", 2)
				; ★ 同上：技能经验 + 距下一级的进度条
				CALL LLM_GAIN_EXP(LLM_GAIN)
				SIF LLM_MSG != ""
					LLM_MSG += "　"
				LLM_FANAME = %GET_JOBNAME(LLM_CID)%
				SIF LLM_FANAME == ""
					LLM_FANAME = "干活"
				; 显示**百分比**比绝对数字直观得多 ——
				; 门番总工作量 3600，光看"还剩3161"根本不知道算多还是算少。
				LLM_TOGP = 100
				SIF MAXBASE:(LLM_CID):工作量 > 0
