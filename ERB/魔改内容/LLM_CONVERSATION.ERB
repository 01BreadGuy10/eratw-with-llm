REF_PROMPT += @"\n【眼下发生的事】他刚还硬撑着要陪你/帮你，现在明显已经到极限了。"
REF_PROMPT += @"\n【要求】"
REF_PROMPT += @"\n1. 说一到两句**劝他去休息**的话，并且**明确不让他再陪你**。"
REF_PROMPT += @"\n2. ⚠️ 关心的程度必须符合上面的【你们的关系】。"
REF_PROMPT += @"\n3. ⚠️ 表达方式必须是你的风格 —— 别写成通用的温柔模板。"
REF_PROMPT += @"\n4. 只输出角色说出口的话：不要旁白、动作描写、括号说明。"
REF_PROMPT += @"\n5. 不要输出任何数值块或 ###DELTA### 分隔符。"
RETURN


; ── ★★ 通用：从回复里抠出 `###TAG###` 那一行的内容 ──
@LLM_PARSE_NOTE(REF_TEXT, LLM_TAG, REF_OUT)
#DIMS REF REF_TEXT
#DIMS LLM_TAG
#DIMS REF REF_OUT
#LOCALSIZE 2
#LOCALSSIZE 4
#DIMS LLM_P, 2
REF_OUT = ""
SIF STRFIND(REF_TEXT, LLM_TAG) < 0
	RETURN
SPLIT REF_TEXT, LLM_TAG, LLM_P
SPLIT LLM_P:1, "\n", LLM_P
; ★ 统一净化（去引号/括号 + TRIM + 判空）—— 见 `@LLM_CLEAN_VALUE` ✓
CALL LLM_CLEAN_VALUE(LLM_P:0, REF_OUT)
SIF REF_OUT == ""
	RETURN
; ⚠️⚠️ 阈值放宽到 90（2026-09-16）—— 原来写 30，
;    而 `STRLENS` 若按**字节**算（中文 1 字 = 3 字节）⇒ **10 个字就被当"太长"丢掉** ⚠️
;    ⇒ 90 字节 ≈ 30 个汉字，本意（防模型写一大段）照样管得住 ✓
SIF STRLENS(REF_OUT) > 90
	REF_OUT = ""
RETURN


; ── ★★ **标记值净化**：去引号/括号、TRIM，并判定"是不是空值" ──
;  为什么需要单独一个函数（2026-09-16）：
;    模型会**照抄格式**、输出 `###MEMO###""` / `###CALLHER###""` ——
;    原来的顺序是「先 TRIM、再清引号」⇒ 清完引号**没有第二次 TRIM** ⇒
;    抠出来的是 `""` 这两个字符 ⇒ **它不等于空串** ⇒
;      ① 被当成有效内容写进槽（实测：`[6]` 里出现过一条内容为 `""` 的垃圾记忆）
;      ② 回执每轮都误触发
;  ⇒ 统一在这里收口：**清引号 → TRIM → 判空**。
;  ⚠️ 两个解析函数（`@LLM_PARSE_NOTE` / `@LLM_PARSE_MEMO`）**共用它** ——
;     不要各写一份（本项目栽过 7 次"同一件事两处表达"）✓
;  ⚠️ 返回空串 = "这个标记不算数"，调用方据此跳过 ✓
; ────────────────────────────────────────────────────────────────────────────
@LLM_CLEAN_VALUE(REF_TEXT, REF_OUT)
#DIMS REF REF_TEXT
#DIMS REF REF_OUT
#LOCALSIZE 2
#DIMS LLM_CQ
; ⚠️⚠️ **不要用 `LLM_CQ = %TOSTR(34)%` 再拿变量去 REPLACE** ——
;   实测**不生效**（用户报：界面里出现 `[3] ""`，引号原样留着）⚠️
;   ⇒ 直接用 `\"` 字面量（项目里 `@LLM_SANITIZE_REPLY` 就是这么写的，可靠）✓
REF_OUT = %REF_TEXT%
REF_OUT '= REPLACE(REF_OUT, "\"", "")
REF_OUT '= REPLACE(REF_OUT, "「", "")
REF_OUT '= REPLACE(REF_OUT, "」", "")
REF_OUT '= TRIM_STRING(REF_OUT)
RETURN


; ── ★★ **在游戏里查看"她记得什么"**（[6] 按钮）──
@LLM_SHOW_MEMORY(LLM_CID)
#DIM  LLM_CID
#LOCALSIZE 8
#LOCALSSIZE 4
#DIMS LLM_TMP
#DIM  LLM_BIT
#DIMS LLM_NOTE_TXT
#DIM  LLM_A           ; ★ 约会日志显示用：距今几天
#DIMS LLM_DT          ; ★ 约会日志显示用：一条记录
PRINTFORML 【持久记忆】%CALLNAME:(LLM_CID)%
PRINTFORML 　（都是 `CHARADATA SAVEDATA` —— **跟着存档走，不会跨档**）
PRINTL
PRINTL ── 强制槽 ──
; ⚠️⚠️ **方案 B（2026-09-16 用户定）**：原来这里有三个专用槽
;    （他自报的身份 / 你平时叫他 / 他喜欢这么叫你）—— 现在**全部并入下面的长期记忆**
;    ;    （写成 `###MEMO### [3]`）。
;  ⚠️⚠️ **但它不是"永久保留"** —— 重要度 3 和 5 的区别是：
;     · **5** ⇒ 永不丢、不会被顶掉（用于真正的长久事实）
;     · **3** ⇒ **不掷骰**（称呼/身份过了语义门槛 ⇒ 一定会存进去），
;       但**记忆满 32 条时会被覆盖** ⚠️
;  ⇒ 之所以**刻意不填 5**：称呼是会变的，填 5 就等于焊死、以后改不掉，
;    而同类替换要靠"能被顶掉"才能工作 ✓（见 prompt 里那段说明）
;  ⚠️ 那三个**槽变量还留着**（没删 —— 动 `.ERH` 有存档偏移风险），但**不再由模型写入**。
;  ⚠️ 所以这里**必须显式说明"搬到下面了"** ——
;     否则玩家会以为"这几个功能没了"（**让信息消失比给信息更危险**）⚠️
PRINTL 　他自报的身份 / 你平时叫他 / 他喜欢这么叫你
PRINTL 　（☞ 已并入下方「长期记忆」，以重要度 [3] 的条目显示）
PRINTL
PRINTL ── 对玩家的态度（每场开场白重算）──
; ⚠️ 界面同样判"有没有实际内容" —— 否则会把 `""` 显示成 `" "` ⚠️
IF STRLENS(LLM_ATTITUDE:(LLM_CID):0) < 4
	PRINTL 　（还没定 —— 下一场对话开场时会生成）
ELSE
	PRINTFORML 　%LLM_ATTITUDE:(LLM_CID):0%
ENDIF
PRINTL
PRINTFORML ── 长期记忆（{LLM_MEMO_CNT:(LLM_CID):0} / 32 条）──
IF LLM_MEMO_CNT:(LLM_CID):0 <= 0
	PRINTL 　（空）
ELSE
	FOR LOCAL, 0, LLM_MEMO_CNT:(LLM_CID):0
		; ⚠️ 用 `@LLM_CLEAN_VALUE` 判空，**不能只判 `== ""`** ——
		;    旧解析器的 bug 往槽里写进过内容为 `""`（两个字面引号）的垃圾，
		;    `== ""` 挡不住它（实测 `[6]` 里就显示出一条 `[3] ""`）⚠️
		;  ⚠️ **必须先复制进 `LLM_TMP` 再传** —— 角色数据变量不能当引用参数 ⚠️
		LLM_TMP = %LLM_MEMO:(LLM_CID):LOCAL%
		CALL LLM_CLEAN_VALUE(LLM_TMP, LLM_TMP)
		SIF LLM_TMP == ""
			CONTINUE
		IF LLM_MEMO_W:(LLM_CID):LOCAL >= 5
			PRINTFORML 　[{LLM_MEMO_W:(LLM_CID):LOCAL}★] %LLM_TMP%
		ELSE
			PRINTFORML 　[{LLM_MEMO_W:(LLM_CID):LOCAL}] %LLM_TMP%
		ENDIF
	NEXT
ENDIF
PRINTL
PRINTL ── 试过的亲密行为（0没试过/1拒绝过/2接受/3乐意）──
CALL LLM_AGREE_SHOW(LLM_CID, LLM_TMP)
IF LLM_TMP == ""
	PRINTL 　（还没试过什么）
ELSE
	FOR LOCAL, 1, 8
		SIF LLM_AGREE:(LLM_CID):LOCAL == 0
			CONTINUE
		CALL LLM_AGREE_NAME(LOCAL, LLM_TMP)
		; ★ 显示程度（和注入给 LLM 的格式一致，2026-09-20）——
		SIF LLM_AGREE:(LLM_CID):LOCAL >= 3
			PRINTFORML 　%LLM_TMP%（很乐意）
		SIF LLM_AGREE:(LLM_CID):LOCAL == 2
			PRINTFORML 　%LLM_TMP%（接受了）
		SIF LLM_AGREE:(LLM_CID):LOCAL == 1
			PRINTFORML 　%LLM_TMP%（拒绝过）
	NEXT
ENDIF
PRINTL
PRINTL ── 这个存档的「最爱」（★ 换个档可能不同）──
IF LLM_FAV:(LLM_CID):0 >= 1 && LLM_FAV:(LLM_CID):0 <= 7
	CALL LLM_AGREE_NAME(LLM_FAV:(LLM_CID):0, LLM_TMP)
	PRINTFORML 　★ %LLM_TMP%
ELSE
	PRINTL 　（还没定 —— 某个行为第一次被接受时有四分之一几率成为最爱）
ENDIF
LLM_TMP = ""
FOR LOCAL, 1, 8
	LLM_BIT = LOCAL - 1
	SIF !GETBIT(LLM_FAVROLL:(LLM_CID):0, LLM_BIT)
		CONTINUE
	CALL LLM_AGREE_NAME(LOCAL, LLM_NOTE_TXT)
	SIF LLM_NOTE_TXT == ""
		CONTINUE
	SIF LLM_TMP != ""
		LLM_TMP += "、"
	LLM_TMP += @"%LLM_NOTE_TXT%"
NEXT
IF LLM_TMP == ""
	PRINTL 　（还没有行为 roll 过）
ELSE
	PRINTFORML 　已 roll 过：%LLM_TMP%（这些不会再 roll）
ENDIF
PRINTL
PRINTFORML ── 一起出去过（约会日志 {LLM_DATELOG_CNT:(LLM_CID):0} / 8 次）──
IF LLM_DATELOG_CNT:(LLM_CID):0 <= 0
	PRINTL 　（还没有 —— 约会结束时她会自己回味一句，存在这里）
ELSE
	FOR LOCAL, 0, LLM_DATELOG_CNT:(LLM_CID):0
		LLM_DT = %LLM_DATELOG:(LLM_CID):LOCAL%
		SIF LLM_DT == ""
			CONTINUE
		LOCAL:1 = STRFIND(LLM_DT, "|")
		SIF LOCAL:1 < 0
			CONTINUE
		LLM_A = DAY - TOINT(SUBSTRING(LLM_DT, 0, LOCAL:1))
		PRINTFORML 　{LOCAL + 1}. {LLM_A} 天前 —— %SUBSTRING(LLM_DT, LOCAL:1 + 1)%
	NEXT
ENDIF
PRINTL
PRINTL ── 上一场对话的片段 ──
SIF LLM_PREV:(LLM_CID):0 == ""
	PRINTL 　（空）
IF LLM_PREV:(LLM_CID):0 != ""
	; ★ 用 `@LLM_PREV_SHOW` 显示（它会拆出日期、转成人话）——
	;   ⚠️ 原来直接打印原始值 ⇒ 界面上是「@“6|人呢？…」这种存储格式 ⚠️（用户截图）
	CALL LLM_PREV_SHOW(LLM_CID, LLM_TMP)
	PRINTFORML 　%LLM_TMP%
	; ★ **LLM_PREV 原始内容诊断**（2026-09-20）—— 排查「@" 和多余引号」用
	;   ⚠️ 用「」包住 ⇒ 一眼看出前后有没有多余字符；并给长度 ✓
	PRINTFORML 　　【原始】「%LLM_PREV:(LLM_CID):0%」
	PRINTFORML 　　　长度 = {STRLENS(LLM_PREV:(LLM_CID):0)} 字节
	PRINTFORML 　　　含| = {STRFIND(LLM_PREV:(LLM_CID):0, "|")}
ENDIF
RETURN


; ⚠️⚠️ **兼容空壳** —— 事故重建的临时产物
;  原本这里是"按玩家指定部位脱一件"（`@LLM_STRIP_PART` 的前身）。
;  重建时它被新的 `@LLM_STRIP_PART` 取代，但 `@LLM_APPLY_DELTA` 里还有一处旧调用，
;  为了**结构完整、能加载**，这里先放一个空壳。
;  ⚠️ **"脱衣服"功能目前不生效** —— 需要把调用点接到 `@LLM_STRIP_PART`
;     并把 `###STRIP###` 的解析补齐（见待做清单）。
@LLM_STRIP_ONE(LLM_CID, REF_WHAT)
#DIM  LLM_CID
#DIMS REF REF_WHAT
REF_WHAT = ""
RETURN


; ── ★ 这条记忆是不是**早期格式错误留下的脏数据** ──
;  ⚠️ 判据：**含 `@"` 或 连续两个引号** —— 那都是裸 `=` 赋值的产物 ✓
;  ⚠️ 只用于**显示 / 注入时跳过**，**不删存档数据**（安全，可逆）✓
@LLM_MEMO_IS_DIRTY(LLM_CID, LLM_IDX)
#DIM  LLM_CID
#DIM  LLM_IDX
#LOCALSIZE 2
#LOCALSSIZE 2
#DIMS LLM_MEMO_DT
; ⚠️ 全部用 `IF/ENDIF`（不用 `SIF`）——
;     `SIF` 只绑紧随的一个语句，而这里中间夹着注释，容易让人（和自查）看错作用域 ⚠️
IF LLM_MEMO:(LLM_CID):LLM_IDX == ""
	RETURN 1
ENDIF
LLM_MEMO_DT = %LLM_MEMO:(LLM_CID):LLM_IDX%
; ⚠️ 早期 bug 留下的垃圾：内容带 `@"` 或 `""`
IF STRFIND(LLM_MEMO_DT, "@\"") >= 0
	RETURN 1
ENDIF
IF STRFIND(LLM_MEMO_DT, "\"\"") >= 0
	RETURN 1
ENDIF
; ⚠️ 「值是空的」那种（`他自报身份：` 后面没内容）——
;     ⚠️⚠️ `STRLENS` 数的是**字节**（中文 1 字 = 2）⇒ 阈值 12（6 个字 × 2）；
;     原来写 6 ⇒ 那个条件永远不成立 ⇒ 这类脏数据漏过去了 ⚠️
IF STRFIND(LLM_MEMO_DT, "他自报身份：") >= 0
	SIF STRLENS(LLM_MEMO_DT) <= 12
		RETURN 1
ENDIF
RETURN 0
