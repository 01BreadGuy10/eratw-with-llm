; ────────────────────────────────────────────────────────────────────────────
;  角色的「特性 / 能力」—— **只写会影响日常对话的那部分**
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ 写法要求（很重要）：
;    · **一句话就够**，别写设定集。要的是"她聊天时会因此怎么表现"，
;      而不是能力清单。
;    · 标准格式：**能力 → 由此产生的行为/忌讳 →（如果有）与关系的联动**
;      样板（铃仙）：
;        「眼睛是「狂气之瞳」，会让看到的人发狂 —— 所以她平时避免与人对视；
;          但对你（关系够近时）能坦然对视」
;    · 只收**真的会体现在闲聊里**的：会带来忌讳、习惯、口头禅、身体反应的。
;      单纯"很强"的能力（比如"能操纵天气"）不必写。
;    · 拿不准就**留空** —— 返回空串时 prompt 不会注入这一段。
; ────────────────────────────────────────────────────────────────────────────
@LLM_CHARA_FEATURE(LLM_CID, REF_FEAT)
#DIM  LLM_CID
#DIMS REF REF_FEAT
REF_FEAT = ""
SELECTCASE NO:(LLM_CID)
	CASE 1
		REF_FEAT = "直觉极准（「妖怪退治的直觉」），常凭感觉下判断，自己也说不清理由"
	CASE 15
		REF_FEAT = "能停止时间 —— 所以对「一瞬间」的事有超常的掌控感，也习惯了别人看不见她做过什么"
	CASE 26
		REF_FEAT = "能操纵境界、用隙间穿越空间 —— 说话常带「从缝隙里看人」的旁观者视角"
	CASE 30
		REF_FEAT = "审判亡者的阎魔 —— 习惯性地评判对错、爱说教，但那是职责，不是针对你"
	CASE 38
		REF_FEAT = "**无意识**：能操纵无意识，也因此读不到她的心 —— 她的想法跳脱、来去无踪，别人很难预测她"
	CASE 49
		REF_FEAT = "**读心**：能读到别人的心思 —— 所以她常提前答出你没说出口的话，也习惯被人忌惮；对她撒谎没有意义"
	CASE 50
		REF_FEAT = "能破坏一切 —— 所以她被关在地下，很少接触外面；**对「弄坏东西」没有分寸感**，但不含恶意"
	CASE 52
		REF_FEAT = "眼睛是「**狂气之瞳**」，会让看到的人发狂 —— 所以她平时**避免与人对视**、习惯低着头；但对你（关系够近时）能坦然对视"
	CASE 61
		REF_FEAT = "**不老不死**：吃下蓬莱之药，不会死 —— 因此对生死、危险和疼痛都看得很淡"
	CASE 62
		REF_FEAT = "**不老不死**、来自月都 —— 时间对她没有意义，所以说话总带着一种超然的余裕"
	CASE 66
		REF_FEAT = "能操纵死亡、引导亡灵 —— 对生死轻描淡写，常把危险说得像家常话"
	CASE 68
		REF_FEAT = "能操纵花与自然，也是最强的妖怪之一 —— 说话礼貌却带压迫感，别人多半不敢顶撞她"
	CASE 72
		REF_FEAT = "月之贤者、天才药师 —— 对药理和人心都极熟，说话像医生诊断一样精准"
	CASE 76
		REF_FEAT = "死神（摆渡人）—— 对生死看得开、爱偷懒，常拿「反正迟早的事」当口头禅"
	CASE 80
		REF_FEAT = "**过目不忘**：读过的书全都记得 —— 说话常引经据典，对细节异常清楚"
	CASE 82
		REF_FEAT = "能看见结界、常做关于异界的梦 —— 对「另一个世界」的话题特别来劲"
ENDSELECT
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  角色的「爱好 / 喜欢的东西」（按角色编号匹配）
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ 为什么手写：游戏里**没有**这种数据 ——
;    · `plugins/tw_taste_chs.xml` 是**服装名称的中日翻译表**（taste 指"品味/着装"），
;      不是角色喜好；
;    · 礼物系统（`贈り物.ERB`）是"**生成物品 + 按属性算分**"（`CREATE_GIFT` →
;      `GIFT_SCORE`），并不查"某角色喜欢什么"；
;    · 口上剧本里也许有（收到特定礼物的反应），但 Emuera 没有读文件接口，取不到。
