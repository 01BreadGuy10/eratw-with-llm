; ★ 她对别人的关系（官方 `RELATION`）—— 取最好 3 个 + 最差 3 个
@LLM_CHARA_RELATION(LLM_CID, REF_OUT)
#DIM  LLM_CID
#DIMS REF REF_OUT
#LOCALSIZE 8
#LOCALSSIZE 2
#DIM  LLM_VAL
#DIM  LLM_GOOD
#DIM  LLM_BAD
; ── ★ 她对别人的关系（官方 `RELATION`）──
;  ⚠️ 只列**两头**的：`>= 200` 很亲近、`< 60` 很不合；
;     各最多 3 个 —— 中间的（普通关系）没必要占 prompt ✓
;  ⚠️ 排除 `== 100`（那是"不认识/中性"的默认值）✓
;  ⚠️ 分档照抄官方 `QoL_ShowRelation.ERB`：
;     <60 很不对付 / <100 有点疏远 / 100 / <130 还算亲近 / <200 关系很好 / >=200 非常亲近
REF_OUT = ""
LLM_GOOD = 0
LLM_BAD = 0
FOR LOCAL, 0, CHARANUM
	SIF LOCAL == LLM_CID
		CONTINUE
	SIF !CFLAG:LOCAL:面識
		CONTINUE
	LLM_VAL = RELATION:(LLM_CID):LOCAL
	SIF LLM_VAL == 100
		CONTINUE
	IF LLM_VAL >= 200
		SIF LLM_GOOD >= 3
			CONTINUE
		LLM_GOOD ++
		CALL LLM_REL_APPEND(LOCAL, LLM_VAL, REF_OUT)
	ELSEIF LLM_VAL < 60
		SIF LLM_BAD >= 3
			CONTINUE
		LLM_BAD ++
		CALL LLM_REL_APPEND(LOCAL, LLM_VAL, REF_OUT)
	ENDIF
NEXT
RETURN


