; ============================================================================
;  LLM_CONVERSATION.ERB —— 自由对话的对话引擎
; ============================================================================
;  职责：
;    · 组装 persona + 局面状态（system prompt）
;    · 用 LLM_CHAT_SEND / LLM_CHAT_POLL 配合 AWAIT 做**非阻塞**等待
;    · 清洗模型输出并打印
;
;  依赖：plugins\LLMBridge.dll
;
;  ⚠️ 本文件是**新增文件**，不修改任何现有 ERB / CSV；删除即恢复原状。
;
;  ⚠️ 实现约定（踩过的坑，勿改）：
;    1. 字符串变量拷内容必须用 FORM 语法：`A = %B%`；裸写 `A = B` 得到字面量。
;    2. 本作 `STRING VARIABLE ASSIGNMENT ... :NO`，所以 `'=` 不能用于普通字符串变量。
;    3. `%...%` 求值要求结果是字符串，别放 #DIM 整数变量。
;    4. CALLSHARP 只能回填**最后一个参数**，故 POLL 用 (id, 状态, 文本) 的顺序。
;    5. 数值变量用 #DIM，字符串变量用 #DIMS —— 用错会在比较时报
;       「无法对字符串型和数值型使用二相运算符」。
;    6. **跨函数共享的变量必须放在 .ERH 头文件里**（见 LLM_KOJO.ERH）。
;       直接写在 .ERB 文件级会报 Lv1「#行只能在函数声明后立刻使用」。
; ============================================================================


; ────────────────────────────────────────────────────────────────────────────
;  对话主循环
; ────────────────────────────────────────────────────────────────────────────
@LLM_CHAT_LOOP(LLM_CID)
#DIM  LLM_CID
#LOCALSIZE 6
#LOCALSSIZE 8
#DIMS LLM_SYS        ; system prompt
#DIMS LLM_INPUT      ; 玩家输入
#DIMS LLM_OUT        ; 模型回复
#DIMS LLM_TMP
#DIM  LLM_STATE      ; 轮询状态：0=等待 1=成功 -1=失败（数值！）
#DIMS LLM_APINAME    ; 当前接口名（显示用）
#DIM  LLM_REQ        ; 请求 id
#DIM  LLM_ROUND      ; 本轮已对话次数
#DIMS LLM_REASON     ; 拒绝理由（她会不愿意交谈时用来喂给模型）
#DIM  LLM_ACC_FAVOR  ; 本场自由对话已累计给过的好感度（用于单场 ±5 上限）
; 说明：等待/超时逻辑都在 @LLM_POLL 里，这里不再需要 LLM_WAIT

; ⚠️ 参数名**不能**叫 CHARA：CHARA 是 Emuera 内置变量名，被拿来当形参有风险。
;    同理 ARG / ARGS / RESULT / RESULTS / TARGET / LOCAL / LOCALS / TIME 等都不能用。
;
; ⚠️⚠️ 这里曾经把上面那段说明放在 `@LLM_CHAT_LOOP` 与 `#DIM` 之间 —— 那就等于
;     「#行不是紧跟在函数声明后面」，会报
;        Lv1「#行只能在函数声明后立刻使用」
;     而 **Lv1 会让这个函数整个不被注册**：外面 CALL 它时不会有任何输出，
;     表现为"点开始对话后直接卡住/什么都不打印"。
;     ⇒ 任何注释都必须放在**全部 #DIM/#LOCALSIZE 之后**。

TARGET = LLM_CID

; ── 本场计数器先清零 ──
;  ⚠️ 必须在下面的拒绝判定**之前**清零。
;     LLM_ANGER_ACC 是文件级变量：如果先判定再清零，上一场聊到一半
;     攒下的"不快"会残留到这一次，导致她一进门就拒绝（明明刚见面）。
LLM_ROUND = 0
LLM_ACC_FAVOR = 0    ; 本场好感度累计（单场上限 ±5 从这里算）
LLM_ANGER_ACC = 0    ; 本场"不快"累积（聊到一半被激怒就看它）

; ────────────────────────────────────────────────────────────────────────────
;  【临时停用】拒绝交谈判定
; ────────────────────────────────────────────────────────────────────────────
;  症状：点「开始对话」后，连 @LLM_CHAT_LOOP 的第一行都没有输出
;        （而 [5] 自检显示本函数 OK），说明它在执行到这里之前就抛异常，
;        异常又被 @COM381 的 TRYCALLFORM 静默吞掉。
;  这一段是进入路径上唯一的新增代码，先整段停用，回到"能正常对话"的状态，
;  等确认恢复后再逐条启用、逐条定位。
;
; RESULT = 0
; CALL LLM_REFUSE_REASON(LLM_CID, LLM_REASON)
; IF RESULT
; 	CALL LLM_REFUSE_TALK(LLM_CID, LLM_REASON, "")
; 	RETURN 1
; ENDIF

; 显示当前接口，让玩家知道在用哪个
CALLSHARP LLM_API_ACTIVE_NAME(LLM_APINAME)
SIF LLM_APINAME == ""
	LLM_APINAME = 未配置

; 取一次 persona（写入文件级变量，后续每轮复用）
CALL LLM_PERSONA_SNAPSHOT(TARGET)

; ────────────────────────────────────────────────────────────────────────────
;  开场白：一进对话就让角色先说一句
;  目的：让玩家一眼看出"链路通不通"，不用先自己想话题。
;  说明：这一轮**不记入历史**（第4参数传 0），避免把"请开始对话"这种
;        指令性文本留在上下文里。
; ────────────────────────────────────────────────────────────────────────────
CALL LLM_BUILD_SYSTEM_PROMPT(TARGET, LLM_SYS)
CALLSHARP LLM_CHAT_SEND(TARGET, LLM_SYS, "（现在开始自由对话，请你先开口。这是玩家走到你面前时的第一句话。）", 0, LLM_TMP)
IF TOINT(LLM_TMP) > 0
	LLM_REQ = TOINT(LLM_TMP)
	PRINTFORML 　.....%CALLNAME:TARGET%正在思考.....
	CALL LLM_POLL(LLM_REQ, LLM_STATE, LLM_OUT)
	IF LLM_STATE == 1
		; ⚠️ 顺序要紧：**先**解析数值块（此时换行还完好），**再**清洗台词。
		;    反过来做的话，SANITIZE 会把换行换成全角空格，数值段就拆不干净了。
		CALL LLM_APPLY_DELTA(TARGET, LLM_OUT, LLM_ACC_FAVOR)
		CALL LLM_SANITIZE_REPLY(LLM_OUT)
		IF LLM_OUT != ""
			CALL LLM_SHOW_FIGURE(TARGET)
			CALL LLM_PRINT_REPLY(TARGET, LLM_OUT)
			SIF LLM_DELTA_MSG != ""
				PRINTFORML %LLM_DELTA_MSG%
		ENDIF
	ELSEIF LLM_STATE == 0
		CALLSHARP LLM_CHAT_CANCEL(LLM_REQ, LLM_TMP)
		PRINTFORML 　[超时] 开场白没有回复（链路可能有问题，见下方提示）
		CALL LLM_SHOW_API_HINT
	ELSE
		PRINTFORML 　[开场失败] %LLM_OUT%
		CALL LLM_SHOW_API_HINT
	ENDIF
ELSE
	PRINTFORML 　[无法发起请求]
	CALL LLM_SHOW_API_HINT
ENDIF
PRINTL

WHILE 1
	SIF LLM_ROUND >= 20
		BREAK

	; ── 取玩家输入 ──
	CLEARTEXTBOX
	DRAWLINE
	PRINTFORML 【自由对话】与 %CALLNAME:TARGET% 交谈
	PRINTFORML 　接口：%LLM_APINAME%
	PRINTFORML 　persona：%LLM_PERSONA_SHOW%
	PRINTFORML 　直接输入要说的话后回车；输入空内容即结束
	DRAWLINE
	INPUTS
	LLM_INPUT = %RESULTS%
	SIF LLM_INPUT == ""
		BREAK

	; ── 【临时停用】聊到一半被激怒就中断 ──
	;  （与进入时那段一起停用，原因见那边注释）
	; RESULT = 0
	; CALL LLM_REFUSE_REASON(TARGET, LLM_REASON)
	; IF RESULT
	; 	CALL LLM_REFUSE_TALK(TARGET, LLM_REASON, LLM_INPUT)
	; 	RETURN 1
	; ENDIF

	; ── 组装 system prompt ──
	CALL LLM_BUILD_SYSTEM_PROMPT(TARGET, LLM_SYS)

	; ── 发起请求（立即返回 id）──
	CALLSHARP LLM_CHAT_SEND(TARGET, LLM_SYS, LLM_INPUT, LLM_TMP)
	IF TOINT(LLM_TMP) <= 0
		PRINTFORML 　[发起失败]
		CALL LLM_SHOW_API_HINT
		BREAK
	ENDIF
	LLM_REQ = TOINT(LLM_TMP)

	; ── 非阻塞等待：AWAIT 让出，轮询结果 ──
	PRINTFORML 　.....%CALLNAME:TARGET%正在思考.....
	CALL LLM_POLL(LLM_REQ, LLM_STATE, LLM_OUT)

	; 清掉"正在思考"那行
	CLEARLINE 1

	IF LLM_STATE == 0
		; 超时：放弃跟踪，但不影响后续
		CALLSHARP LLM_CHAT_CANCEL(LLM_REQ, LLM_TMP)
		PRINTFORML 　[超时] 等太久没回复，已放弃这次请求
		CONTINUE
	ENDIF

	IF LLM_STATE != 1
		PRINTFORML 　[出错] %LLM_OUT%
		CALL LLM_SHOW_API_HINT
		BREAK
	ENDIF

	; ── 清洗并输出 ──
	; ⚠️ 顺序要紧：**先**解析数值块（此时换行还完好），**再**清洗台词
	CALL LLM_APPLY_DELTA(TARGET, LLM_OUT, LLM_ACC_FAVOR)
	CALL LLM_SANITIZE_REPLY(LLM_OUT)
	SIF LLM_OUT == ""
		CONTINUE
	CALL LLM_SHOW_FIGURE(TARGET)
	CALL LLM_PRINT_REPLY(TARGET, LLM_OUT)
	SIF LLM_DELTA_MSG != ""
		PRINTFORML %LLM_DELTA_MSG%

	LLM_ROUND ++
WEND

DRAWLINE
; 返回 0 = 正常对话结束（不是拒绝），菜单继续留着
RETURN 0


; ────────────────────────────────────────────────────────────────────────────
;  轮询一次带等待：等到模型回复、失败、或超时
; ────────────────────────────────────────────────────────────────────────────
;  ⚠️ 协议（2026-09 修正，勿改）：
;    Emuera 的 CALLSHARP **只会回填最后一个参数**，中间的参数即使写了也会被
;    引擎丢掉。所以状态码不能单独占一个参数 —— 上一版就是因为把状态放在
;    中间参数，导致 LLM_STATE 永远是 0、一直轮询到超时。
;    现在的约定是：插件把「状态码 + TAB + 文本」一起放进**最后一个参数**。
;
;  参数：LLM_REQ   = 请求 id（LLM_CHAT_SEND 返回的）
;        REF_STATE = 回填状态：0=超时 1=成功 -1=失败（**数值**变量，#DIM）
;        REF_TEXT  = 回填文本（成功时的回复 / 失败时的原因）（**字符串**变量，#DIMS）
;
;  插件回填格式（**首字符是状态码**）：
;        "0"            = 仍在等待
;        "1" + 文本     = 成功
;        "-1" + 原因    = 失败
;  ⇒ 状态码用 SUBSTRING(…,0,1) 取；文本从第 2 个字符("1")或第 3 个字符("-1")起。
; ────────────────────────────────────────────────────────────────────────────
@LLM_POLL(LLM_REQ, REF_STATE, REF_TEXT)
#DIM    LLM_REQ
; ⚠️⚠️ 形参名以 REF_ 开头**不代表**引用传递！必须写 `#DIM REF 名`，
;      否则是值传递：函数里的修改**传不回调用方**。
#DIM    REF REF_STATE
#DIMS   REF REF_TEXT
#LOCALSIZE 4
#LOCALSSIZE 4
#DIMS   LLM_RAW      ; 插件回填的原始串
#DIMS   LLM_ST       ; 状态码（单字符）
#DIM    LLM_WAIT     ; 累计等待毫秒

REF_STATE = 0
REF_TEXT  = ""
LLM_WAIT  = 0
LLM_RAW   = "0"

WHILE 1
	AWAIT 80
	CALLSHARP LLM_CHAT_POLL(LLM_REQ, LLM_RAW)

	; ⚠️⚠️ `SUBSTRING` **只能在 %…% 里当函数用**！
	;     写成 `LLM_X = SUBSTRING(A,0,1)` 不会调用它，而是把
	;     "SUBSTRING(A,0,1)" 这串**字面文本**赋给 LLM_X ——
	;     于是状态码永远不等于 "0"，循环第一轮就误判"已出结果"→秒超时。
	;     正确写法：`LLM_X = %SUBSTRING(A,0,1)%`
	LLM_ST = %SUBSTRING(LLM_RAW, 0, 1)%

	; 收到结果就退出
	SIF LLM_ST != "0"
		BREAK

	; 仍在等待 → 累计耗时，超时放弃
	LLM_WAIT += 80
	SIF LLM_WAIT >= 90000
		BREAK
WEND

SIF LLM_ST == "1"
	REF_STATE = 1
SIF LLM_ST == "-"
	REF_STATE = -1
IF REF_STATE == 1
	REF_TEXT = %SUBSTRING(LLM_RAW, 1)%
ELSEIF REF_STATE == -1
	REF_TEXT = %SUBSTRING(LLM_RAW, 2)%
ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  解析并应用模型给出的数值增减
; ────────────────────────────────────────────────────────────────────────────
;  约定的回复格式（见 @LLM_BUILD_SYSTEM_PROMPT 的【回合结算】段）：
;
;       （角色台词）
;       ###DELTA###
;       1,2,-1
;          │ │ └─ 愤怒  c
;          │ └─── 情緒  b
;          └───── 好感度 a
;
;  ⚠️ 模型只提供"建议值"，**最终裁决在本函数**：
;      · 每个数都会被 LIMIT 钳到允许范围
;      · 好感度还受"单场累计 ±5"限制（REF_ACC 记录本场已给过多少）
;      · 没有数值块 / 拆不出数字 → 什么都不改，台词照常显示
;
;  参数：REF_TEXT  = 完整回复。函数会把数值块**抠掉**，只留台词。
;        REF_ACC   = 本场已累计的好感度变化（调用方持有，跨轮传递）
; ────────────────────────────────────────────────────────────────────────────
@LLM_APPLY_DELTA(LLM_CID, REF_TEXT, REF_ACC)
#DIM  LLM_CID
#DIMS REF REF_TEXT
#DIM  REF REF_ACC
#LOCALSIZE 4
#LOCALSSIZE 8          ; 下面声明了 2 个 4 元素字符串数组，留足槽位
#DIMS LLM_PART, 4     ; SPLIT 结果：0=台词 1=数值块
#DIMS LLM_NUM, 4      ; 数值块按逗号再分
#DIM  LLM_D

LLM_DELTA_MSG = ""

; 没有数值块 → 原样返回（失败安全：绝不猜数值）
SIF STRFIND(REF_TEXT, "###DELTA###") < 0
	RETURN

SPLIT REF_TEXT, "###DELTA###", LLM_PART

; 清掉数值段里的空白再拆数字。
; ⚠️ 必须清：@LLM_SANITIZE_REPLY 会把换行替成**全角空格**，
;    残留的空白会让 TOINT 读不出数（全角空格不算合法的数字前缀）。
LLM_PART:1 = %REPLACE(LLM_PART:1, "　", "")%
LLM_PART:1 = %REPLACE(LLM_PART:1, " ", "")%
LLM_PART:1 = %REPLACE(LLM_PART:1, "\n", "")%
LLM_PART:1 = %REPLACE(LLM_PART:1, "\r", "")%
SPLIT LLM_PART:1, ",", LLM_NUM

; 抠掉数值块，台词保持干净。
; ⚠️ 本作**没有** `TRIM`，去空白要用 `TRIM_STRING`（#FUNCTIONS，见
;    PRINT_STATE_BODYGRAPH.ERB:216）。用不存在的函数名会报
;    Lv2「无法解析的标识符」，而且判断会静默失效。
LLM_PART:0 '= TRIM_STRING(LLM_PART:0)
; 只在前半段确实有台词时才抠 —— 万一模型把数值块放在了台词前面，
; 照抠会把整句台词丢掉（那种情况宁可留着块，也不能让角色不说话）。
SIF STRLENS(LLM_PART:0) > 0
	REF_TEXT = %LLM_PART:0%

; ① 好感度：单轮 ±3，且单场累计不超过 ±5
LLM_D = LIMIT(TOINT(LLM_NUM:0), -3, 3)
SIF REF_ACC + LLM_D > 5
	LLM_D = 5 - REF_ACC
SIF REF_ACC + LLM_D < -5
	LLM_D = -5 - REF_ACC
IF LLM_D != 0
	CFLAG:(LLM_CID):2 += LLM_D
	; 0 ~ 1000000 是游戏自己用的界限（TRACHECK_好感度上昇処理.ERB:415）
	CFLAG:(LLM_CID):2 = LIMIT(CFLAG:(LLM_CID):2, 0, 1000000)
	REF_ACC += LLM_D
	CALL LLM_APPEND_DELTA_MSG("好感度", LLM_D)
ENDIF

; ② 情緒：单轮 ±2（上限用游戏自己的 MAXBASE）
LLM_D = LIMIT(TOINT(LLM_NUM:1), -2, 2)
IF LLM_D != 0
	BASE:(LLM_CID):情緒 += LLM_D
	BASE:(LLM_CID):情緒 = LIMIT(BASE:(LLM_CID):情緒, 0, MAXBASE:(LLM_CID):情緒)
	CALL LLM_APPEND_DELTA_MSG("情緒", LLM_D)
ENDIF

; ③ 愤怒：单轮 ±2
LLM_D = LIMIT(TOINT(LLM_NUM:2), -2, 2)
IF LLM_D != 0
	BASE:(LLM_CID):憤怒 += LLM_D
	BASE:(LLM_CID):憤怒 = LIMIT(BASE:(LLM_CID):憤怒, 0, MAXBASE:(LLM_CID):憤怒)
	CALL LLM_APPEND_DELTA_MSG("愤怒", LLM_D)
ENDIF

; 对话内"不快"累积。
; 为什么不直接看 BASE:憤怒：它的"在气头上"判定阈值是 500，而单轮只动 ±2，
; 靠它根本到不了；何况游戏自己也会改 BASE:憤怒，不适合当计数器。
; 负增量允许把累积值压回去（道歉、哄她），但不低于 0。
LLM_ANGER_ACC = MAX(LLM_ANGER_ACC + LLM_D, 0)
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  往本轮提示行上追加一项（如「好感度＋1」）
; ────────────────────────────────────────────────────────────────────────────
;  写成文件级变量 LLM_DELTA_MSG，由调用方在台词之后打印。
@LLM_APPEND_DELTA_MSG(LLM_NAME, LLM_VAL)
#DIMS LLM_NAME
#DIM  LLM_VAL
#LOCALSIZE 1

SIF LLM_DELTA_MSG != ""
	LLM_DELTA_MSG += "　"
SIF LLM_VAL > 0
	LLM_DELTA_MSG += @"%LLM_NAME%＋%TOSTR(LLM_VAL)%"
SIF LLM_VAL < 0
	LLM_DELTA_MSG += @"%LLM_NAME%－%TOSTR(-LLM_VAL)%"
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  她愿不愿意进行自由对话？
; ────────────────────────────────────────────────────────────────────────────
;  返回值（调用方读 RESULT）：1 = 拒绝，0 = 愿意
;  拒绝理由写进 REF_REASON，之后喂给模型，让拒绝的语气与处境对得上。
;
;  判定条件（阈值想调就改这里）：
;    · CFLAG:睡眠                     睡着了，被吵醒很烦
;    · CFLAG:ブチギレ                  暴怒（游戏里最强的愤怒态）
;    · MARK:反発刻印                   对玩家有反感刻印
;    · BASE:憤怒 >= 500               正在气头上
;        （500 是游戏自己的"愤怒"判定阈值，见 QOL_IMAGE.ERB:1494）
;    · 心情 == -1 且 情緒 < MAXBASE/3  心情糟糕且提不起劲
;    · LLM_ANGER_ACC >= LLM_ANGER_LIMIT   **这场对话里被她被惹毛了**（累积值）
;        这条专管"聊到一半被激怒"：模型每轮给的愤怒 +1/+2 会累积起来，
;        攒够了下一轮就拒绝继续。约 3 轮明显冒犯即可触发（默认阈值 6）。
;        想让她更耐烦就把 LLM_ANGER_LIMIT 调大。
;
;  顺序即优先级：越靠前越强势。
;  ⚠️ 这里刻意**不**看模型脸色 —— 愿不愿意由本地状态判定，行为可预测。
;     模型只能通过"愤怒增减"间接影响那个累积值，最终裁决仍在这里。
; ────────────────────────────────────────────────────────────────────────────
@LLM_REFUSE_REASON(LLM_CID, REF_REASON)
#DIM  LLM_CID
#DIMS REF REF_REASON
; ⚠️ `#LOCALSIZE` 只是分配槽位，变量本身仍然要 `#DIM` 声明，
;    否则会报「无法解析的标识符」。
#DIM  LLM_ANGER_LIMIT
#LOCALSIZE 1

REF_REASON = ""

; 睡着了
IF CFLAG:(LLM_CID):睡眠
	REF_REASON = "你现在正睡得迷迷糊糊，刚被吵醒，很困也很不耐烦"
	RETURN 1
ENDIF
; 暴怒
IF CFLAG:(LLM_CID):ブチギレ
	REF_REASON = "你现在正在暴怒，气得不想跟任何人说话"
	RETURN 1
ENDIF
; 对玩家有反感刻印
;  ⚠️ 下标**不要加括号**：本作 MARK 的既有写法都是 `MARK:变量:元素`
;     （如 FORTUNE.ERB 的 `MARK:target_id:反発刻印`、QoL_Com_Order.ERB 的
;      `MARK:mCID:不埒刻印`），没有一处写 `MARK:(变量):元素`。
;     之前写成带括号的版本，怀疑正是它让整条对话链路在这里断掉。
IF MARK:LLM_CID:反発刻印
	REF_REASON = "你心里对眼前这个人有根刺（反感），不想给他好脸色"
	RETURN 1
ENDIF
; 正在气头上
IF BASE:(LLM_CID):憤怒 >= 500
	REF_REASON = "你现在正在气头上，心里很烦躁"
	RETURN 1
ENDIF
; 这场对话里被惹毛了（累积阈值）
LLM_ANGER_LIMIT = 6
IF LLM_ANGER_ACC >= LLM_ANGER_LIMIT
	REF_REASON = "刚才的对话让你很不痛快，火气已经压不住了"
	RETURN 1
ENDIF
; 心情糟糕 + 情绪低落
IF TALENT:(LLM_CID):心情 == -1 && BASE:(LLM_CID):情緒 < MAXBASE:(LLM_CID):情緒 / 3
	REF_REASON = "你心情很糟，提不起劲跟人闲聊"
	RETURN 1
ENDIF

RETURN 0


; ────────────────────────────────────────────────────────────────────────────
;  拒绝台词用的 system prompt
; ────────────────────────────────────────────────────────────────────────────
;  和主 prompt 的区别：这里明确要求"只输出一句拒绝"，不要展开对话。
;  persona 部分与主 prompt 同源（都走 @LLM_PERSONA_SNAPSHOT），
;  所以拒绝时的语气仍是这个角色本人的。
; ────────────────────────────────────────────────────────────────────────────
@LLM_BUILD_REFUSE_PROMPT(LLM_CID, REF_REASON, REF_PROMPT, LLM_PLAYER_SAY)
#DIM  LLM_CID
#DIMS REF_REASON
#DIMS REF REF_PROMPT
#DIMS LLM_PLAYER_SAY    ; 玩家刚说的话；开场就被拒绝时传空串
#LOCALSSIZE 4
#DIMS LLM_CHAR_NAME

; 现取一次 persona，避免多用同一角色时残留上一次的内容
CALL LLM_PERSONA_SNAPSHOT(LLM_CID)
LLM_CHAR_NAME = %CALLNAME:(LLM_CID)%

REF_PROMPT = @"你正在扮演东方Project同人游戏《eraTW》中的角色。"
REF_PROMPT += @"\n【角色】%LLM_CHAR_NAME%"
REF_PROMPT += @"\n你的名字就是「%LLM_CHAR_NAME%」。不要演成别的角色，也不要自称别的名字。"
REF_PROMPT += @"\n【本作对该角色的既定诠释（persona 来源）】"
IF LLM_PERSONA_OK
	REF_PROMPT += @"%LLM_PERSONA_SHOW%"
ELSE
	REF_PROMPT += @"该角色在本作中没有专属剧本，请按其原作性格演绎"
ENDIF
REF_PROMPT += @"\n【你现在的状态】%REF_REASON%"
; 两种情形：① 一开始就不想理 ② 聊到一半被惹毛，直接不聊了
IF LLM_PLAYER_SAY != ""
	REF_PROMPT += @"\n【刚刚发生的事】你们本来在随便聊聊，玩家对你说：「%LLM_PLAYER_SAY%」"
	REF_PROMPT += @"\n【要求】"
	REF_PROMPT += @"\n1. 这句话让你彻底不想再聊下去了。只输出一到两句把他打发走的话，可以针对他刚说的内容。"
ELSE
	REF_PROMPT += @"\n【眼下发生的事】玩家走到你面前，想和你自由地聊几句。"
	REF_PROMPT += @"\n【要求】"
	REF_PROMPT += @"\n1. 你现在**不愿意**和他交谈。只输出一到两句拒绝的话。"
ENDIF
REF_PROMPT += @"\n2. 语气必须符合上面的角色性格与当前状态。"
REF_PROMPT += @"\n3. 只输出角色说出口的话：不要旁白、动作描写、括号说明、引号本身。"
REF_PROMPT += @"\n4. 不要长篇大论，也不要借机说教，一到两句就够。"
REF_PROMPT += @"\n5. 不要提到自己是 AI、模型或程序，不要输出解释或任何格式标记。"
REF_PROMPT += @"\n6. 不要输出任何结算用的数值块或分隔符（例如 ###DELTA###）。"
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  拒绝：让模型按 persona 说一句拒绝台词，然后结束
; ────────────────────────────────────────────────────────────────────────────
@LLM_REFUSE_TALK(LLM_CID, REF_REASON, LLM_PLAYER_SAY)
#DIM  LLM_CID
#DIMS REF_REASON
#DIMS LLM_PLAYER_SAY    ; 玩家刚说的话；开场就被拒绝时传空串
#LOCALSIZE 4
#LOCALSSIZE 4
#DIMS LLM_SYS
#DIMS LLM_TMP
#DIMS LLM_OUT
#DIM  LLM_STATE
#DIM  LLM_REQ

; 第 4 参数传 0 = **不记入对话记忆**：拒绝不算"聊过"，
; 免得污染之后正式对话的上下文。
CALL LLM_BUILD_REFUSE_PROMPT(LLM_CID, REF_REASON, LLM_SYS, LLM_PLAYER_SAY)
IF LLM_PLAYER_SAY != ""
	CALLSHARP LLM_CHAT_SEND(LLM_CID, LLM_SYS, @"（玩家对你说：「%LLM_PLAYER_SAY%」）", 0, LLM_TMP)
ELSE
	CALLSHARP LLM_CHAT_SEND(LLM_CID, LLM_SYS, "（玩家走到你面前，想和你自由地聊几句。）", 0, LLM_TMP)
ENDIF
IF TOINT(LLM_TMP) <= 0
	; 请求都发不出去时也得给个反馈，不能什么都不显示
	PRINTFORML 「……我现在不想说话。」
	RETURN
ENDIF
LLM_REQ = TOINT(LLM_TMP)
PRINTFORML 　.....%CALLNAME:(LLM_CID)%正在思考.....
CALL LLM_POLL(LLM_REQ, LLM_STATE, LLM_OUT)
CLEARLINE 1
IF LLM_STATE == 1
	CALL LLM_SANITIZE_REPLY(LLM_OUT)
	SIF LLM_OUT != ""
		CALL LLM_PRINT_REPLY(LLM_CID, LLM_OUT)
ELSEIF LLM_STATE == 0
	CALLSHARP LLM_CHAT_CANCEL(LLM_REQ, LLM_TMP)
	PRINTFORML 「……我现在不想说话。」
ELSE
	PRINTFORML 「……我现在不想说话。」
ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  取当前 persona 快照
; ────────────────────────────────────────────────────────────────────────────
;  用返回值判断有无剧本，并**先清空** RESULTS 系列 —— 它们是引擎临时变量，
;  角色没有对应项时不会被写入，会残留上一个角色的内容。
; ────────────────────────────────────────────────────────────────────────────
@LLM_PERSONA_SNAPSHOT(LLM_CID)
#DIM LLM_CID
#LOCALSIZE 1
#LOCALSSIZE 2

VARSET RESULTS
LLM_PERSONA      = ""
LLM_PERSONA_LBL  = ""
LLM_PERSONA_DESC = ""
LLM_PERSONA_SHOW = ""

CALL KOJO_ACTIVE_INFO(LLM_CID)
LLM_PERSONA_OK = RESULT
IF LLM_PERSONA_OK
	LLM_PERSONA      = %RESULTS%
	LLM_PERSONA_LBL  = %RESULTS:1%
	LLM_PERSONA_DESC = %RESULTS:2%
	LLM_PERSONA_SHOW = %LLM_PERSONA_LBL%
	SIF LLM_PERSONA_SHOW == ""
		LLM_PERSONA_SHOW = %LLM_PERSONA_DESC%
	SIF LLM_PERSONA_SHOW == ""
		LLM_PERSONA_SHOW = 初始
ENDIF
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  组装 system prompt
; ────────────────────────────────────────────────────────────────────────────
;  刻意**不喂数值**，只喂"关系状态 / 态度 / 情绪"这类语义化结果 ——
;  数值对模型无意义，且容易被角色"报出来"。详见设计文档第 4 章。
; ────────────────────────────────────────────────────────────────────────────
@LLM_BUILD_SYSTEM_PROMPT(LLM_CID, REF_PROMPT)
#DIM  LLM_CID
; ⚠️ `REF_PROMPT` 这个**名字**没有任何魔力：必须写 `#DIMS REF REF_PROMPT`
;    才是引用传递。之前漏了 REF，函数里拼好的 prompt 传不回调用方
;    → 日志里 sysLen=0，persona 从未送给模型。
#DIMS REF REF_PROMPT
#LOCALSIZE 4
#LOCALSSIZE 8
#DIMS LLM_REL      ; 关系（字符串，必须 #DIMS + 引号）
#DIMS LLM_ATT      ; 态度
#DIMS LLM_MOOD     ; 情绪
#DIMS LLM_CHAR_NAME ; 角色名（先接住再插值：CALLNAME:xxx 不能直接进 %...%）

; ⚠️ 每次请求前都**重新取一次快照**，绝不依赖"进对话时取过一次"。
;    原因：LLM_PERSONA* 是**文件级变量**，如果只在进入对话时取一次，
;    那么和多个角色对话后这些变量会残留上一个角色的内容，
;    导致后来的角色"以为自己是上一个角色"（实测：和灵梦聊完再找别人，
;    别人也自称灵梦）。每次组装 prompt 前重取，才能保证 persona 与
;    当前 LLM_CID 严格对应。
CALL LLM_PERSONA_SNAPSHOT(LLM_CID)

; 角色名先落到字符串变量里，供下面插值
LLM_CHAR_NAME = %CALLNAME:(LLM_CID)%

; ── 关系状态：读 TALENT 布尔量（与口上剧本同源）──
;  数组下标写成 (LLM_CID)：下标用变量时必须加括号（本作既有写法，
;  见 COMMON_KOJO.ERB:10 的 CFLAG:(ARG:1):現在位置）。
LLM_REL = "初次见面"
SIF CFLAG:(LLM_CID):面識
	LLM_REL = "认识的人"
SIF TALENT:(LLM_CID):思慕
	LLM_REL = "对你有好感（思慕）"
SIF TALENT:(LLM_CID):恋慕
	LLM_REL = "爱慕着你（恋慕）"
SIF TALENT:(LLM_CID):恋人
	LLM_REL = "恋人"
SIF TALENT:(LLM_CID):炮友
	LLM_REL = "炮友关系"
SIF TALENT:(LLM_CID):愛欲
	LLM_REL = "沉溺于欲望（爱欲）"

; ── 态度（合意判定聚合后的结果，一个值顶十几个变量）──
LLM_ATT = "冷淡"
SIF CFLAG:(LLM_CID):6 == 1
	LLM_ATT = "勉强接受"
SIF CFLAG:(LLM_CID):6 == 2
	LLM_ATT = "愿意配合"
SIF CFLAG:(LLM_CID):6 == 3
	LLM_ATT = "主动迎合"

; ── 情绪 ──
LLM_MOOD = "平静"
SIF TCVAR:(LLM_CID):烂醉
	LLM_MOOD = "醉醺醺"
SIF CFLAG:(LLM_CID):318
	LLM_MOOD = "正在气头上"
SIF CFLAG:(LLM_CID):睡眠
	LLM_MOOD = "睡着的"
SIF TCVAR:(LLM_CID):発情
	LLM_MOOD = "情动难耐"
SIF TCVAR:(LLM_CID):媚薬
	LLM_MOOD = "被媚药影响"

; ── 拼装 ──
; ⚠️⚠️⚠️⚠️ 五条铁律（全部实际炸过，改这段前先读一遍）：
;   1. **绝不写跨物理行的 @"…" 字符串字面量**。Emuera 不认多行字符串，
;      第二行起会被当成新语句，报「无法解析的行」「没有闭合的"」，
;      并且**整个游戏停止运行**。换行一律用同一行的 `\n`。
;   2. 形参名以 REF_ 开头**不代表引用传递**，必须 `#DIMS REF 形参名`。
;   3. `SUBSTRING` 等字符串函数**只能写在 %…% 里**，裸写会变成字面文本。
;   4. 变量名裸写在 `+` 里 → 拼进去的是**变量名原文**（如 "LLM_CHAR_NAME"）。
;   5. ⚠️ 把变量当**独立的 `+` 项**（哪怕套了 `%…%`）也会拼进引号和加号！
;        X = "…" + %LLM_CHAR_NAME%     ← ❌ 结果里有 `" + 灵梦 + "` 这种垃圾
;        X += @"…%LLM_CHAR_NAME%…"     ← ✅ 变量必须写在**字符串内部**
;      第 4、5 条合起来曾导致 prompt 里角色名/persona 全废，
;      模型拿不到角色身份 → 所有角色 OOC、自称博丽灵梦/八云紫/上白泽慧音。
;      **唯一安全写法：用 `+=` 配 `@"…%变量%…"`（变量在引号内）。**
REF_PROMPT = @"你正在扮演东方Project同人游戏《eraTW》中的角色，与玩家进行自由对话。"
REF_PROMPT += @"\n【角色】%LLM_CHAR_NAME%"
REF_PROMPT += @"\n你的名字就是「%LLM_CHAR_NAME%」。不要演成别的角色，也不要自称别的名字。"
REF_PROMPT += @"\n【本作对该角色的既定诠释（persona 来源）】"
IF LLM_PERSONA_OK
	REF_PROMPT += @"%LLM_PERSONA_SHOW%"
	SIF LLM_PERSONA != ""
		REF_PROMPT += @"（剧本标识 %LLM_PERSONA%）"
ELSE
	REF_PROMPT += @"该角色在本作中没有专属剧本，请按其原作性格演绎"
ENDIF
REF_PROMPT += @"\n【与玩家的关系】%LLM_REL%"
REF_PROMPT += @"\n【当前态度】%LLM_ATT%"
REF_PROMPT += @"\n【当前状态】%LLM_MOOD%"
REF_PROMPT += @"\n\n【硬性要求】"
REF_PROMPT += @"\n1. 台词部分只写这个角色说出口的话，一个字都不要多。"
REF_PROMPT += @"\n   不要写动作描写、不要加括号说明、不要写旁白。"
REF_PROMPT += @"\n   不要输出引号本身，不要输出解释、前言或任何格式标记。"
REF_PROMPT += @"\n   （唯一的例外是末尾【回合结算】要求的数值块，那不算多余内容）"
REF_PROMPT += @"\n2. 用中文回复，控制在 1~3 句，像日常对话那样自然。"
REF_PROMPT += @"\n3. 严格按【与玩家的关系】【当前态度】把握亲密度："
REF_PROMPT += @"\n   关系尚浅时不要过分亲昵；关系深入时才可以用更亲近的语气。"
REF_PROMPT += @"\n4. 不要声称发生了任何游戏内的状态变化。"
REF_PROMPT += @"\n5. 不要提到自己是 AI、模型或程序。"
REF_PROMPT += @"\n\n【成熟内容与角色扮演规则】"
REF_PROMPT += @"\n1. 这是虚构角色扮演；只有设定明确所有参与者均为成年人且双方自愿时，才可发展成人亲密内容。"
REF_PROMPT += @"\n2. 面对调情、身体话题、成人笑话或亲密气氛，不要仅因题材成熟就说教、退出角色或转移话题。"
REF_PROMPT += @"\n3. 严格依照角色性格、关系阶段、羞耻心和主动程度回应；可以表达欲望、拒绝、犹豫、害羞或期待，不要机械顺从。"
REF_PROMPT += @"\n4. 在允许范围内使用自然、直接的中文；若具体表达不能继续，保持角色口吻改用含蓄表达或自然拒绝，不提政策、审查或模型身份。"
REF_PROMPT += @"\n5. 始终只输出角色说出口的台词，不写旁白、动作、心理、括号说明、标题、免责声明或解释。"
; ── 回合结算：让模型顺带回传"这句话对你造成了什么影响" ──
;  ERB 侧由 @LLM_APPLY_DELTA 解析；模型给的只是建议值，最终会被钳制。
REF_PROMPT += @"\n\n【回合结算（必须输出）】"
REF_PROMPT += @"\n说完台词后，另起一行，原样输出下面这个数值块（分隔符一字不改地照抄）："
REF_PROMPT += @"\n###DELTA###"
REF_PROMPT += @"\na,b,c"
REF_PROMPT += @"\n含义：a=好感度变化(-3~+3)　b=情緒变化(-2~+2)　c=愤怒变化(-2~+2)"
REF_PROMPT += @"\n判定规则："
REF_PROMPT += @"\n· 只反映**玩家这一句话**给你的即时感受，不要累积、不要参考之前的轮次。"
REF_PROMPT += @"\n· 让你觉得亲近、开心、被逗笑 → a、b 取正；冒犯、无礼、轻浮、越界 → a、b 取负、c 取正。"
REF_PROMPT += @"\n· 受伤、失落、害羞这类情绪起伏主要影响 b。"
REF_PROMPT += @"\n· 平平无奇的寒暄就填 0,0,0。**多数轮次应该是 0 或 ±1**，不要每轮都给大数。"
REF_PROMPT += @"\n· 这三个数字是系统内部结算用的，玩家看不到：不要在台词里提到、解释或复述它们。"
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  清洗模型输出
; ────────────────────────────────────────────────────────────────────────────
;  模型常带回引号、换行、以及"角色名："之类前缀，这里统一去掉。
;
;  ⚠️ 必须 `#DIMS REF REF_TEXT`：光把形参起名叫 REF_TEXT 没有用，
;     漏了 REF 就是值传递，函数里这一堆 REPLACE 的结果**传不回调用方**，
;     等于清洗从来没生效过（模型带的引号/换行会原样显示）。
; ────────────────────────────────────────────────────────────────────────────
@LLM_SANITIZE_REPLY(REF_TEXT)
#DIMS REF REF_TEXT
#LOCALSIZE 4

REF_TEXT = REPLACE(REF_TEXT, "\n", "　")
REF_TEXT = REPLACE(REF_TEXT, "\r", "")

REF_TEXT = REPLACE(REF_TEXT, "「", "")
REF_TEXT = REPLACE(REF_TEXT, "」", "")
REF_TEXT = REPLACE(REF_TEXT, "『", "")
REF_TEXT = REPLACE(REF_TEXT, "』", "")
REF_TEXT = REPLACE(REF_TEXT, "“", "")
REF_TEXT = REPLACE(REF_TEXT, "”", "")

REF_TEXT = REPLACE(REF_TEXT, @"%CALLNAME:TARGET%：", "")
REF_TEXT = REPLACE(REF_TEXT, @"%CALLNAME:TARGET%:", "")
REF_TEXT = REPLACE(REF_TEXT, "角色：", "")
REF_TEXT = REPLACE(REF_TEXT, "回答：", "")
REF_TEXT = REPLACE(REF_TEXT, "助手：", "")

REF_TEXT = REPLACE(REF_TEXT, "  ", " ")
; ⚠️ 本作没有 `TRIM`，去首尾空白是 `TRIM_STRING`（#FUNCTIONS）→ 用 `'=` 接返回值
REF_TEXT '= TRIM_STRING(REF_TEXT)
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  显示角色图（立绘 / 颜绘）
; ────────────────────────────────────────────────────────────────────────────
;  为什么不自己拼 <img>：本作已有现成的显示层，直接复用最稳 ——
;  资源名解析、差し替え適用、特效层、边框、缩放、多尺寸，它都处理好了。
;
;    @PRINT_FACE(CID, 表情, 服装, 差分, エフェクト, …)
;        颜绘（半身）。这是本作"对话 / 事件配图"的惯例做法。
;    @PRINT_FIGURE(CID, 表情, 服装, 差分, エフェクト, "立絵", …)
;        立绘（全身）。
;
;  ⚠️ 这两个接口**内部自己会检查**：
;       · 顔絵付きメッセージ（设置里的"对话或事件中的配图"）
;       · FLAG:画像表示（设置里的"显示立绘"）
;     玩家关掉任一项时它们会直接 RETURN、什么都不画。
;     所以这里**不要**再绕过它强行显示，也不需要在外面重复判断。
;
;  挑选规则：跟随玩家自己的"角色绘的类型"设置
;      `FLAG:立ち絵種類` 为真 = 颜绘，为假 = 立绘
;      （语义见 SHOP関連\OPTION.ERB:929 的 `\@ FLAG:立絵種類 ? [颜绘] # [立绘] \@`）
;  若玩家选的是立绘、但该角色没有立绘资源，则退回颜绘（不会什么都不显示）。
;
;  ── 表情联动（立绘会随角色状态变）──────────────────────────────────
;  默认表情是按**角色当前状态**推出来的，不是写死的「通常」：
;    · 心情/情緒 高、喝醉          → 笑顔
;    · 心情 差、ブチギレ、憤怒 高   → 憤怒
;    · TCVAR 発情                  → 発情
;    · 睡眠中                      → 睡眠
;  判定条件抄自游戏自己的日常表情逻辑
;  （ERB\魔改内容\QOL_IMAGE.ERB:1478-1533 @CALC_EXPRESSION_CORE），
;  但**刻意去掉**了其中依赖 `SELECTCOM` 的「愛撫 / 自慰 / 性交」分支 ——
;  那是调教中才成立的表情，自由对话时 SELECTCOM 只是残留值，照抄会显示错表情。
;
;  ⚠️ 构建层在"表情图不存在"时**不会**自动兜底，会画出空白。
;     所以挑完表情必须用 GET_BASE_RESOURCE 验一次，取不到就退回「通常」。
;
;  说明：等「自由对话增减数值」做完后，这里会自动跟着变 ——
;        因为上面读的 情緒 / 憤怒 / 発情 正是那套数值要改的量。
; ────────────────────────────────────────────────────────────────────────────
@LLM_SHOW_FIGURE(LLM_CID)
#DIM LLM_CID
#LOCALSIZE 4
#LOCALSSIZE 4
#DIM LLM_HAS_FIG
#DIMS LLM_STYLE     ; "顔絵" 或 "立絵"
#DIMS LLM_EXPR      ; 表情名（由当前状态推出）

SIF LLM_CID < 1 || LLM_CID >= CHARANUM
	RETURN

; ① 颜绘 / 立绘：跟随玩家设置；选立绘但没资源时退回颜绘
LLM_STYLE = "顔絵"
IF !FLAG:立ち絵種類
	LLM_HAS_FIG = HAS_STANDING(LLM_CID)
	SIF LLM_HAS_FIG
		LLM_STYLE = "立絵"
ENDIF

; ② 按角色当前状态挑表情（顺序即优先级：越靠后越强势）
LLM_EXPR = "通常"
SIF TALENT:(LLM_CID):心情 == 1 || TCVAR:(LLM_CID):烂醉
	LLM_EXPR = "笑顔"
SIF BASE:(LLM_CID):情緒 >= MAXBASE:(LLM_CID):情緒 * 7 / 10
	LLM_EXPR = "笑顔"
SIF TALENT:(LLM_CID):心情 == -1 || CFLAG:(LLM_CID):ブチギレ
	LLM_EXPR = "憤怒"
SIF BASE:(LLM_CID):憤怒 >= 500
	LLM_EXPR = "憤怒"
SIF TCVAR:(LLM_CID):発情
	LLM_EXPR = "発情"
SIF CFLAG:(LLM_CID):睡眠
	LLM_EXPR = "睡眠"

; ③ 该表情在当前服装下没有图 → 退回「通常」（否则会画出空白）
CALL GET_BASE_RESOURCE(LLM_CID, LLM_STYLE, "", LLM_EXPR)
SIF !RESULT
	LLM_EXPR = "通常"

; ④ 输出
CALL PRINT_FIGURE(LLM_CID, LLM_EXPR, "", "", "", LLM_STYLE)
RETURN


; ────────────────────────────────────────────────────────────────────────────
;  输出一条角色台词
