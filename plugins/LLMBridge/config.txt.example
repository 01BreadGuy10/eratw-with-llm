; ============================================================================
;  LLMBridge 配置文件  (config.txt)
; ============================================================================
;  改完保存即生效（热重载，默认 200ms 内检测），不需要重启游戏。
;
;  语法：
;    · 以 ; 或 # 开头  → 注释
;    · 键值分隔可用 = 或 空白
;    · 布尔值：1/0, true/false, yes/no, on/off, 开/关, 是/否
;    · 每角色行值格式： <自由对话>,<自由亲密>     例： 1,0
;
;  默认：全关。只有在这里显式列出的角色才会开启。
; ============================================================================


; ────────────────────────────────────────────────────────────────────────────
;  一、全局总开关
; ────────────────────────────────────────────────────────────────────────────

; 0 = 所有角色的「自由对话」一律关闭（无视下面的每角色设置）
; 1 = 按每角色设置生效
enable_free_talk        = 1

; 0 = 所有角色的「自由亲密」一律关闭
; 1 = 按每角色设置生效
enable_free_intimate    = 1

; 1 = 写日志到 plugins/LLMBridge/debug.log（排查问题时打开）
debug_log               = 1

; 配置热重载检查间隔（毫秒），建议 100~1000
scan_interval_ms        = 200

; 未在上面/下面显式列出的角色，默认值
; 格式： <自由对话>,<自由亲密>
default_talk_intimate   = 0,0


; ────────────────────────────────────────────────────────────────────────────
;  二、每角色开关
; ────────────────────────────────────────────────────────────────────────────
;
;  键的两种写法：
;    idx:<N>   运行时索引  = ERB 里的 NO:角色 / TARGET / 循环下标
;                          优点：调试时直接用 LLM_DEBUG 打印出的 [idx] 值
;                          缺点：存档中角色增删后会偏移
;
;    no:<N>    角色编号    = CSV\Chara\Chara<N> ...csv 的文件号
;                          优点：稳定，与存档无关
;                          缺点：需要查 CSV 文件名
;
;    只写数字（如 "1 = 1,1"）→ 插件会同时按 idx 和 no 两种含义匹配
;
;  值： <自由对话>,<自由亲密>      1=开  0=关
;
;  ── 角色编号 no 对照（摘自 CSV\Chara\ 文件名）──
;     no=1   博丽 灵梦          no=2   留琴
;     no=10  萃香               no=11  雾雨 魔理沙
;     no=12  露米娅             no=14  琪露诺
;     no=15  十六夜 咲夜        no=16  蕾米莉亚
;     no=17  爱丽丝             no=23  妖梦
;     no=26  八云 紫            no=38  古明地 恋
;     no=49  古明地 觉          no=50  芙兰朵露
;     no=51  河城 荷取          no=54  帕秋莉
;  ── 完整对照请查 CSV\Chara\ 目录，或游戏内执行 LLM_DEBUG ──
;
; ── 示例配置（取消注释即生效）──

; 灵梦：自由对话开，自由亲密关
idx:1 = 1,1

; 魔理沙：两项都开
no:11 = 1,1

; 芙兰：只开自由亲密
; idx:50 = 0,1

; 用裸数字（两种含义都匹配）
; 16 = 1,1


; ────────────────────────────────────────────────────────────────────────────
;  三、调试用记录区
; ────────────────────────────────────────────────────────────────────────────
;
;  游戏内执行 CALLSHARP LLM_DEBUG(0)
;  → 会打印出当前全部角色的 [idx] / no / 名字 / 两个开关状态
;  → 把要开启的角色的 idx 或 no 抄到上面的第二节即可
;
;  也可以单查某个角色：
;    #DIMS R
;    CALLSHARP LLM_DUMP(TARGET, R)
;    PRINTFORML %R%
;
